# Copy to .dev.vars for local dev. Never commit .dev.vars.

# --- Razorpay ---
# Two key sets, one selector. Leave a set blank until you have it; with the ACTIVE set
# incomplete the store is browse-only and /api/checkout answers 503 not_configured.
# The webhook secrets are strings YOU invent (openssl rand -hex 32) and paste into the
# matching test/live webhook in the Razorpay dashboard — Razorpay does not issue them.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=

# Confirmation email. Leave RESEND_API_KEY unset to skip sending entirely —
# orders still complete, the send is just logged and skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Until a domain is verified in Resend, sending falls back to onboarding@resend.dev,
# which ONLY delivers to the address that owns the Resend account. Once a domain is
# verified, set this and real student addresses start working.
# MAIL_FROM=Anvesha '26 <orders@yourdomain>


# Local dev only. Overrides the production list in wrangler.jsonc so `wrangler dev`
# can serve the Astro dev server; never deployed, because this file is git-ignored.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,https://anvesha26.in
