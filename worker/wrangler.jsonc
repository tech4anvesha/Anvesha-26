{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "anvesha-merch-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	// Same reason as the events Worker: *.workers.dev is on ad blocklists, and the whole
	// of merch — catalogue, checkout, admin, distribution — went through it.
	// COMMENTED OUT until anvesha26.in is a zone on this Cloudflare account — see the
	// note on the same line in worker-events/wrangler.jsonc.
	// "routes": [{ "pattern": "merch-api.anvesha26.in", "custom_domain": true }],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "anvesha",
			"database_id": "55c2dd34-3151-4167-9799-2bf9b2c8d06b"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "anvesha-merch"
		}
	],
	// One binding, 30 req/60s per key. The Worker keys by `route:ip`, so checkout and
	// pay get independent budgets per visitor rather than sharing one pool — a burst
	// of legitimate checkouts must not lock a student out of paying. namespace_id is
	// not a resource you create (unlike D1/R2); it's an arbitrary account-scoped id
	// that keeps separate limiters apart. Bindings aren't inherited into named
	// environments, so this is repeated in env.production below.
	"ratelimits": [
		{ "name": "MONEY_RL", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
	],
	// Fan-out point for live catalogue updates. Workers share no memory, so the list of
	// connected browsers has to live somewhere single-instance.
	"durable_objects": {
		"bindings": [{ "name": "HUB", "class_name": "CatalogueHub" }]
	},
	// new_sqlite_classes, not new_classes: the SQLite backend is the one available on
	// the Workers free plan.
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["CatalogueHub"] }],
	"vars": {
		"ENVIRONMENT": "development",
		// Who the order confirmation comes from. Not a secret — it is printed in every
		// email — so it lives here in version control rather than in `wrangler secret`.
		//
		// The mailbox does not have to exist to SEND. It does have to exist if anyone is
		// ever going to read a reply, and people reply to order confirmations, so point
		// it at something a human reads. The domain must be the one verified in Resend;
		// without this the Worker falls back to onboarding@resend.dev, which only
		// delivers to the address that owns the Resend account.
		"MAIL_FROM": "Anvesha '26 <orders@anvesha26.in>",
		// Comma-separated, and LIVE: `wrangler deploy` with no `--env` ships this block,
		// not env.production below, so anything listed here is reachable from the open
		// internet.
		//
		// localhost is NOT on this list. It was, briefly, so the Astro dev server could
		// drive the deployed API; `npm run dev:testpay` against a local `wrangler dev`
		// does that job without widening what the internet-facing Worker will answer.
		// localhost belongs in .dev.vars, which overrides this under `wrangler dev`.
		"ALLOWED_ORIGINS": "https://anvesha26.in,https://www.anvesha26.in,https://anvesha-26.vercel.app"
		// RAZORPAY_MODE is NOT a var here. It is loaded as a secret — not because it is
		// secret, but because secrets take effect the moment they are put, with no
		// deploy, and a var does not:
		//   wrangler secret put RAZORPAY_MODE      (type: test  or  live)
		// Unset or anything other than "live" reads as test. The `npm run switch` CLI
		// wraps this and purges the catalogue cache afterwards.
		//
		// The keys — `wrangler secret put <NAME>`:
		//   RAZORPAY_TEST_KEY_ID   RAZORPAY_TEST_KEY_SECRET   RAZORPAY_TEST_WEBHOOK_SECRET
		//   RAZORPAY_LIVE_KEY_ID   RAZORPAY_LIVE_KEY_SECRET   RAZORPAY_LIVE_WEBHOOK_SECRET
		// Both sets can be loaded at once; RAZORPAY_MODE picks which one is used. With
		// the active set incomplete, nothing can be bought: the storefront's checkout
		// stays off and POST /api/checkout answers 503 not_configured.
		//
		// Whether sales are OPEN is not here at all — that is the admin panel's sales
		// switch (merch_release.sale_activation). This block only decides whether there
		// is a gateway behind it.
		//
		// DIRECT_PAY is deliberately absent. It was the interim counter path, which
		// trusts the buyer's own browser to say it paid — see README.md. Never set it
		// beside a live gateway: it would let anyone mark any order paid.
	},
	// Secrets are NOT set here — see the RAZORPAY_MODE note above for the six names.
	// For local dev put them in .dev.vars (git-ignored).
	"env": {
		"production": {
			"vars": {
				"ENVIRONMENT": "production",
				"MAIL_FROM": "Anvesha '26 <orders@anvesha26.in>",
				"ALLOWED_ORIGINS": "https://anvesha26.in,https://www.anvesha26.in,https://anvesha-26.vercel.app"
				// DIRECT_PAY and RAZORPAY_STUB deliberately absent; RAZORPAY_MODE is a secret.
			},
			"ratelimits": [
				{ "name": "MONEY_RL", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
			],
			"durable_objects": {
				"bindings": [{ "name": "HUB", "class_name": "CatalogueHub" }]
			}
		}
	}
}