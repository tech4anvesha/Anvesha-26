{
  "name": "anvesha-events-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --persist-to ../worker/.wrangler/state",
    "deploy": "wrangler deploy",
    "test": "node --import ./test/cloudflare-stub.mjs --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:local": "wrangler d1 execute anvesha --local --persist-to ../worker/.wrangler/state --file=./schema.sql",
    "db:remote": "wrangler d1 execute anvesha --remote --file=./schema.sql",
    "sweep:local": "wrangler d1 execute anvesha --local --persist-to ../worker/.wrangler/state --command \"SELECT event_id, name, ends_at FROM events_scheduled ORDER BY ends_at\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
