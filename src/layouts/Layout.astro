---
import { ClientRouter } from 'astro:transitions';
const { title = 'Astro Basics' } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{/* client-side routing: only the page body is swapped, so the shell never reloads */}
		<ClientRouter />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		/* Matches the card's own dvh sizing. `height: 100%` resolves against the initial
		   containing block, which on a phone is the address-bar-retracted viewport — so
		   the shell stayed taller than the screen and left the page scrollable by exactly
		   the height of the browser chrome. */
		height: 100dvh;
	}
</style>
