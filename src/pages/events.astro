---
import SiteLayout from '../layouts/SiteLayout.astro';
import { EVENTS_API } from '../lib/api';

import iMic from 'lucide-static/icons/mic-vocal.svg?raw';
import iTelescope from 'lucide-static/icons/telescope.svg?raw';
import iGlobe from 'lucide-static/icons/globe.svg?raw';
import iBrain from 'lucide-static/icons/brain.svg?raw';
import iWrench from 'lucide-static/icons/wrench.svg?raw';
import iBot from 'lucide-static/icons/bot.svg?raw';
import iCode from 'lucide-static/icons/code.svg?raw';
import iTrophy from 'lucide-static/icons/trophy.svg?raw';
import iAtom from 'lucide-static/icons/atom.svg?raw';
import iFlask from 'lucide-static/icons/flask-conical.svg?raw';
import iUsers from 'lucide-static/icons/users.svg?raw';
import iPresentation from 'lucide-static/icons/presentation.svg?raw';
import iCalendar from 'lucide-static/icons/calendar-days.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';
import iChevL from 'lucide-static/icons/chevron-left.svg?raw';
import iChevR from 'lucide-static/icons/chevron-right.svg?raw';
import iArrowRight from 'lucide-static/icons/arrow-right.svg?raw';

/**
 * event_type -> icon. The column is free text typed by an organiser, so this is a
 * lookup with a fallback rather than a switch that can be exhaustive: an unrecognised
 * type gets the calendar and the page still renders.
 *
 * ponytail: matched on a lowercased SUBSTRING, so 'Guest Talk', 'Invited talk' and
 * 'talk' all land on the microphone without anyone having to type an exact enum.
 * Order matters — the first hit wins, so the specific entries come before the vague.
 */
const ICONS: [string, string][] = [
	['workshop', iWrench],
	['competition', iTrophy],
	['hackathon', iCode],
	['robot', iBot],
	['quiz', iBrain],
	['panel', iUsers],
	['expo', iAtom],
	['exhibit', iAtom],
	['observ', iTelescope],
	['star', iTelescope],
	['lab', iFlask],
	['screening', iPresentation],
	['outreach', iGlobe],
	['talk', iMic],
	['lecture', iMic],
	['keynote', iMic],
	['ceremony', iPresentation],
];

// Handed to the client once, as JSON. The API base has to travel this way too — it is
// baked in at build time from PUBLIC_EVENTS_API_URL and a module script cannot read
// import.meta.env of the *page*.
const PAYLOAD = { icons: ICONS, fallbackIcon: iCalendar, api: EVENTS_API };
---

<SiteLayout title="Events · Anvesha '26">
	<div class="page">
		<!-- ============ ARCHIVE CALENDAR ============ -->
		<section class="section history" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Past editions</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta" id="histMeta">&nbsp;</span>
			</div>

			{/* A calendar, not a dial. The dial carried nine dates on a ring and read as a
			    puzzle: you could not tell which month you were in, how many sessions a day
			    held, or how to reach a date three turns away. A month grid answers all
			    three at a glance, and every fest edition is a handful of consecutive days
			    in one month — which is exactly the shape a calendar is for. */}
			<div class="cal" id="calWrap">
				<div class="cal-side">
					<div class="cal-months" id="calMonths" role="tablist" aria-label="Months with sessions"></div>

					<div class="cal-bar">
						<button class="btn cbtn" id="calPrev" aria-label="Earlier month" set:html={iChevL}></button>
						<h3 class="cal-title" id="calTitle">—</h3>
						<button class="btn cbtn" id="calNext" aria-label="Later month" set:html={iChevR}></button>
					</div>

					<div class="cal-grid" id="calGrid"></div>
					<p class="cal-hint">Marked days held sessions.</p>
				</div>

				<div class="cal-read">
					<p class="cal-ed" id="calEdition">&nbsp;</p>
					<h3 class="cal-date" id="calDate">Loading…</h3>
					<ol class="arc-list" id="arcList"></ol>
				</div>
			</div>

			{/* Replaces the whole calendar when there is nothing behind us yet, or when the
			    fetch fails. Hidden by default; the script decides. */}
			<p class="ev-note" id="histNote" hidden></p>
		</section>

		<!-- separator between what happened and what is coming -->
		<div class="band" data-reveal>
			<span class="band-label">Upcoming</span>
		</div>

		<!-- ============ TIMELINE ============ -->
		{/* One section per day, built at runtime from /api/events. Static markup here
		    would freeze the schedule into whichever build shipped it — and the whole
		    point of the events Worker is that a day moves itself into History the
		    moment its last event ends. */}
		<div id="tlDays" data-reveal></div>
		<p class="ev-note" id="tlNote">Loading the schedule…</p>
	</div>

	<Fragment slot="overlays">
		<!-- ============ FILE POPUP ============ -->
		<div id="fileWrap" class="file-wrap" aria-hidden="true">
			<div class="file" role="dialog" aria-modal="true" aria-labelledby="fName">
				<!-- ink header band, like the top of a records form -->
				<div class="file-bar">
					<span class="file-kind">Event File</span>
					<span class="file-ref" id="fRef">ANV / E-00</span>
					<button class="btn x file-x" id="fClose" aria-label="Close file" set:html={iX}></button>
				</div>

				<div class="file-inner">
					<!-- punched margin: the strongest single cue that this is a file -->
					<div class="file-margin" aria-hidden="true">
						<span></span><span></span><span></span>
					</div>

					<div class="file-content">
						{/* Only ever in the file, never in the timeline: a poster per row would
						    turn a schedule into a gallery and bury the times, which are the
						    thing a schedule is read for. */}
						<figure class="file-poster" id="fPosterWrap" hidden>
							<img id="fPoster" alt="" loading="lazy" />
						</figure>

						<span class="file-chip" id="fTrack">TALK</span>
						<h2 class="file-title" id="fName"></h2>

						<dl class="file-rows" id="fRows"></dl>

						<p class="file-full" id="fFull"></p>

						<div class="file-sum" id="fSum" hidden>
							<span class="file-sum-label">Summary</span>
							<p id="fSumText"></p>
						</div>
					</div>
				</div>

				<div class="file-foot">
					<span class="file-stamp" id="fStamp" hidden>ARCHIVED</span>
					<a class="cta file-reg" id="fReg" href="#">
						<span id="fRegLabel">REGISTER</span>
						<span set:html={iArrowRight} />
					</a>
				</div>
			</div>
		</div>

		<script type="application/json" id="evData" set:html={JSON.stringify(PAYLOAD)} is:inline></script>
	</Fragment>
</SiteLayout>

<script>
	import { gsap } from 'gsap';
	import { onCatalogueChange } from '../lib/admin';

	/** Exactly the columns the events Worker returns. */
	type Row = {
		event_id: string; name: string; venue: string; description: string;
		starts_at: string; ends_at: string; event_type: string;
		registration_link?: string | null;
		gallery_link?: string | null;
		summary?: string | null;
		has_poster?: number | boolean;
	};
	/** A Row plus the two strings only the page cares about. */
	type Rec = Row & { when: string; clock: string; past: boolean };
	type Ring = { iso: string; day: string; date: string; edition: string; ids: string[] };
	type Day = { iso: string; label: string; items: Rec[] };

	// ponytail: same shape as /merch — Astro module scripts run once per session, so with
	// the client router this must re-init against each freshly swapped DOM.
	let ac: AbortController | null = null;
	let inited: HTMLElement | null = null;
	// Module scope on purpose: a live refresh tears the calendar down and rebuilds it,
	// and someone reading February 2023 should not be snapped back to the newest month
	// because the cron archived something.
	let lastArchive = '';
	let stopLive: (() => void) | null = null;

	// Timestamps from the Worker are naive IST ('2026-02-14 15:00'). Everything here
	// compares them as STRINGS, which is chronological for that format and, unlike
	// new Date(...), gives the same answer on a laptop set to another timezone.
	const IST_OFFSET_MIN = 330;
	const istNow = () =>
		new Date(Date.now() + IST_OFFSET_MIN * 60_000).toISOString().slice(0, 16).replace('T', ' ');

	const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
	const MONTH = ['January', 'February', 'March', 'April', 'May', 'June',
		'July', 'August', 'September', 'October', 'November', 'December'];
	const WD = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
	/** Parsed as UTC, so the calendar day an organiser typed is the one that renders. */
	function dparts(iso: string) {
		const d = new Date(iso + 'T00:00:00Z');
		return {
			wd: WD[d.getUTCDay()],
			dd: String(d.getUTCDate()).padStart(2, '0'),
			mon: MON[d.getUTCMonth()],
			yr: d.getUTCFullYear(),
		};
	}

	// Every string below comes out of D1, typed by an organiser, and goes into innerHTML.
	// Escaping is the only thing between a pasted `<img onerror>` and running script.
	const esc = (s: unknown) =>
		String(s ?? '').replace(/[&<>"']/g, (c) =>
			({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

	async function initEvents() {
		const wrap = document.getElementById('fileWrap');
		if (!wrap || wrap === inited) return;
		inited = wrap;
		ac?.abort();
		ac = new AbortController();
		const { signal } = ac;

		const $ = <T extends HTMLElement>(id: string): T => {
			const el = document.getElementById(id);
			if (!el) console.error(`[events] missing #${id}`); // fail loudly, not three calls deep
			return el as T;
		};
		const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const pad = (n: number) => String(n).padStart(2, '0');

		const cfg: { icons: [string, string][]; fallbackIcon: string; api: string } =
			JSON.parse($('evData').textContent || '{"icons":[],"fallbackIcon":"","api":""}');

		/** First substring hit wins; an unknown type still gets a calendar. */
		const iconFor = (t: string) => {
			const k = (t || '').toLowerCase();
			return (cfg.icons.find(([n]) => k.includes(n)) ?? [, cfg.fallbackIcon])[1];
		};

		const tlDays = $('tlDays'), tlNote = $('tlNote'), histNote = $('histNote'), histMeta = $('histMeta');
		const calWrap = $('calWrap');

		// ---------- load ----------
		let upcoming: Row[] = [], past: Row[] = [];
		try {
			const get = async (path: string) => {
				const res = await fetch(cfg.api + path, { signal });
				if (!res.ok) throw new Error(`${path} -> ${res.status}`);
				return (await res.json()).events as Row[];
			};
			[upcoming, past] = await Promise.all([get('/api/events'), get('/api/events/past')]);
		} catch (err) {
			if (signal.aborted) return;
			console.error('[events] load failed', err);
			// Both notes, not one. The calendar and the timeline are separate columns and one
			// of them is display:none on a phone — a message written only into the hidden
			// one is a blank page with no explanation.
			tlDays.innerHTML = '';
			tlNote.textContent = 'Could not reach the schedule. Refresh, or try again in a moment.';
			tlNote.hidden = false;
			calWrap.style.display = 'none';
			histNote.textContent = 'Past editions are unavailable right now.';
			histNote.hidden = false;
			histMeta.textContent = 'offline';
			return;
		}
		if (signal.aborted) return;

		// ---------- shape it ----------
		const clockOf = (r: Row) => `${r.starts_at.slice(11)} – ${r.ends_at.slice(11)}`;

		/** Rows -> one group per calendar date, in the order the rows arrived. */
		function byDate(rows: Row[]): { iso: string; items: Row[] }[] {
			const out: { iso: string; items: Row[] }[] = [];
			for (const r of rows) {
				const iso = r.starts_at.slice(0, 10);
				let g = out.find((x) => x.iso === iso);
				if (!g) out.push((g = { iso, items: [] }));
				g.items.push(r);
			}
			return out;
		}

		const data: Record<string, Rec> = {};

		const days: Day[] = byDate(upcoming).map((g) => {
			const p = dparts(g.iso);
			const label = `${p.wd} ${p.dd} ${p.mon}`;
			for (const r of g.items) data[r.event_id] = { ...r, when: label, clock: clockOf(r), past: false };
			return { iso: g.iso, label, items: g.items as Rec[] };
		});

		// /api/events/past comes back newest-first (ORDER BY ends_at DESC), which is the
		// order the calendar wants — but it also reverses the events WITHIN a day, so each
		// group is flipped back so a day reads forward.
		// No cap any more. Twelve was the point a DIAL stopped being readable; a calendar
		// holds a whole month per screen and pages between them, so every archived date
		// gets a place.
		const ring: Ring[] = byDate(past)
			.map((g) => {
				const p = dparts(g.iso);
				const date = `${p.dd} ${p.mon} ${p.yr}`;
				const edition = `Anvesha '${String(p.yr).slice(2)}`;
				const items = [...g.items].reverse();
				for (const r of items) data[r.event_id] = { ...r, when: `${edition} · ${date}`, clock: clockOf(r), past: true };
				return { iso: g.iso, day: p.dd, date, edition, ids: items.map((i) => i.event_id) };
			});

		// ---------- timeline ----------
		function cardHTML(r: Row): string {
			return `<li class="tl-item" data-at="${esc(r.starts_at)}">
				<time class="tl-time">${esc(r.starts_at.slice(11))}</time>
				<span class="tl-rail" aria-hidden="true"><span class="tl-dot"></span></span>
				<button class="tl-card" data-ev="${esc(r.event_id)}" aria-label="Open ${esc(r.name)}">
					<span class="tl-top">
						<span class="tl-track">${esc(r.event_type)}</span>
						<span class="tl-next" hidden>Next up</span>
						<span class="tl-venue">${esc(r.venue)}</span>
					</span>
					<span class="tl-head">
						<span class="tl-icon">${iconFor(r.event_type)}</span>
						<span class="tl-name">${esc(r.name)}</span>
					</span>
					<span class="tl-short">${esc(r.description)}</span>
				</button>
			</li>`;
		}

		tlDays.innerHTML = days
			.map(
				(d) => `<section class="section tl-day">
					<div class="sechead">
						<span class="sechead-label">${esc(d.label)}</span>
						<span class="sechead-rule"></span>
						<span class="sechead-meta"><b>${d.items.length}</b> ${d.items.length === 1 ? 'event' : 'events'}</span>
					</div>
					<div class="tl-scroll scroll-y"><ol class="tl">${d.items.map(cardHTML).join('')}</ol></div>
				</section>`,
			)
			.join('');

		tlNote.hidden = days.length > 0;
		if (!days.length) tlNote.textContent = 'Nothing on the schedule yet — the programme goes up closer to the fest.';

		// Not [data-reveal]: the page's entrance tween captured its targets before this
		// fetch resolved, so these would sit at opacity 0 until the watchdog cleared the
		// gate. Their own tween is both simpler and correctly timed.
		if (!rm) gsap.from(tlDays.children, { opacity: 0, y: 14, duration: 0.4, stagger: 0.06, ease: 'power3.out' });

		// ---- next up ----
		// Marked here rather than at build time: a static build would freeze whichever
		// event was next when the site was compiled.
		const nowStamp = istNow();
		const rows = Array.from(document.querySelectorAll<HTMLElement>('.tl-item[data-at]'));
		const next = rows.find((li) => li.dataset.at! > nowStamp);
		if (next) {
			next.classList.add('next');
			next.querySelector('.tl-next')?.removeAttribute('hidden');
		}

		// ---------- file popup ----------
		const fileEl = wrap.querySelector('.file') as HTMLElement;
		const fTrack = $('fTrack'), fRef = $('fRef'), fName = $('fName'), fRows = $('fRows');
		const fFull = $('fFull'), fSum = $('fSum'), fSumText = $('fSumText');
		const fStamp = $('fStamp'), fReg = $<HTMLAnchorElement>('fReg'), fRegLabel = $('fRegLabel');
		const fPosterWrap = $('fPosterWrap'), fPoster = $<HTMLImageElement>('fPoster');

		let fileOpen = false;
		gsap.set(wrap, { autoAlpha: 0 });
		gsap.set(fileEl, { y: 18 });

		function openFile(id: string) {
			const r = data[id];
			if (!r) return;

			// Set before the dialog opens, so the browser has the request in flight by the
			// time the panel has finished animating in. `alt` is the event's own name —
			// the poster is the artwork for it, not a separate thing needing description.
			const hasPoster = Boolean(r.has_poster);
			fPosterWrap.hidden = !hasPoster;
			if (hasPoster) {
				fPoster.src = `${cfg.api}/api/events/${encodeURIComponent(id)}/poster`;
				fPoster.alt = `Poster for ${r.name}`;
			} else {
				fPoster.removeAttribute('src');
			}

			fTrack.textContent = (r.event_type || 'Event').toUpperCase();
			fRef.textContent = `ANV / ${id}`;
			fName.textContent = r.name;
			fRows.innerHTML = ([
				['When', r.when], ['Time', r.clock], ['Venue', r.venue], ['Type', r.event_type],
			] as [string, string][])
				.map(([k, v]) => `<div class="file-row"><dt>${esc(k)}</dt><span class="file-lead"></span><dd>${esc(v)}</dd></div>`)
				.join('');
			fFull.textContent = r.description || '';

			// A past record swaps the register call-to-action for the gallery, and gains
			// the stamp. The flag is set where the two lists are shaped, not sniffed from
			// which columns came back: an archived event with no summary written up yet is
			// still past, and would fail a truthiness test on the value.
			fSum.hidden = !r.summary;
			fStamp.hidden = !r.past;
			if (r.summary) fSumText.textContent = r.summary;

			const link = r.past ? r.gallery_link : r.registration_link;
			fRegLabel.textContent = r.past ? 'VIEW GALLERY' : 'REGISTER';
			// display, not [hidden]: `.cta` sets display itself and would win the cascade.
			fReg.style.display = link ? '' : 'none';
			if (link) fReg.href = link;

			setFile(true);
		}

		function setFile(on: boolean) {
			fileOpen = on;
			wrap.setAttribute('aria-hidden', String(!on));
			gsap.to(wrap, { autoAlpha: on ? 1 : 0, duration: rm ? 0 : 0.2 });
			gsap.to(fileEl, { y: on ? 0 : 18, duration: rm ? 0 : 0.3, ease: 'power3.out' });
			if (on) $('fClose').focus();
		}

		$('fClose').onclick = () => setFile(false);
		wrap.addEventListener('click', (e) => { if (e.target === wrap) setFile(false); }, { signal });
		addEventListener('keydown', (e) => { if (e.key === 'Escape' && fileOpen) setFile(false); }, { signal });

		// every timeline row opens its own file
		for (const b of document.querySelectorAll<HTMLElement>('[data-ev]'))
			b.onclick = () => openFile(b.dataset.ev!);

		// ---------- archive calendar ----------
		// One month grid, and a row of chips for the months that actually hold sessions.
		// Stepping month by month through a year of empty grids to reach February would
		// be the dial's problem in a different shape, so prev/next walk the chips.
		histMeta.innerHTML = `<b>${past.length}</b> ${past.length === 1 ? 'session' : 'sessions'} · <b>${ring.length}</b> ${ring.length === 1 ? 'date' : 'dates'}`;

		if (!ring.length) {
			calWrap.style.display = 'none';
			histNote.textContent = 'No past sessions on record yet. Events land here automatically once they finish.';
			histNote.hidden = false;
			return;
		}

		type Month = { key: string; label: string; edition: string; days: typeof ring };
		// ring is already newest-first; this keeps that order and groups by month.
		const months: Month[] = [];
		for (const r of ring) {
			const key = r.iso.slice(0, 7);
			let m = months.find((x) => x.key === key);
			if (!m) months.push((m = {
				key, label: `${MONTH[+key.slice(5) - 1]} ${key.slice(0, 4)}`, edition: r.edition, days: [],
			}));
			m.days.push(r);
		}

		const calMonths = $('calMonths'), calGrid = $('calGrid'), calTitle = $('calTitle');
		const calEdition = $('calEdition'), calDate = $('calDate'), arcList = $('arcList');

		let monthIdx = 0;
		let activeIso = '';

		calMonths.innerHTML = months
			.map((m, i) => `<button class="cal-month" data-m="${i}" role="tab" aria-selected="${i === 0}">
				${esc(m.label)}<i>${m.days.reduce((n, d) => n + d.ids.length, 0)}</i>
			</button>`)
			.join('');
		for (const b of calMonths.querySelectorAll<HTMLElement>('[data-m]'))
			b.onclick = () => showMonth(Number(b.dataset.m));

		const WDS = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];

		function showMonth(i: number, keepDay = false) {
			monthIdx = ((i % months.length) + months.length) % months.length;
			const m = months[monthIdx];
			calTitle.textContent = m.label;

			for (const b of calMonths.querySelectorAll<HTMLElement>('[data-m]')) {
				const on = Number(b.dataset.m) === monthIdx;
				b.classList.toggle('on', on);
				b.setAttribute('aria-selected', String(on));
			}

			const [y, mo] = m.key.split('-').map(Number);
			// UTC throughout: a browser in another timezone must not shift which day a
			// session falls on, and Date's local-time constructor would do exactly that.
			const first = new Date(Date.UTC(y, mo - 1, 1));
			// Monday-first, so the weekend sits together at the end where a fest lives.
			const lead = (first.getUTCDay() + 6) % 7;
			const len = new Date(Date.UTC(y, mo, 0)).getUTCDate();

			const cells: string[] = WDS.map((d) => `<span class="cal-wd">${d}</span>`);
			for (let n = 0; n < lead; n++) cells.push('<span class="cal-day cal-pad"></span>');
			for (let d = 1; d <= len; d++) {
				const iso = `${m.key}-${String(d).padStart(2, '0')}`;
				const day = m.days.find((x) => x.iso === iso);
				cells.push(day
					? `<button class="cal-day has" data-iso="${iso}" aria-label="${esc(day.date)}, ${day.ids.length} sessions">
						<b>${d}</b><i>${day.ids.length}</i></button>`
					: `<span class="cal-day">${d}</span>`);
			}
			// Trailing blanks so the grid always closes on a full week rather than a ragged
			// row — the border lands on a rectangle either way.
			while ((cells.length - 7) % 7) cells.push('<span class="cal-day cal-pad"></span>');
			calGrid.innerHTML = cells.join('');

			for (const b of calGrid.querySelectorAll<HTMLElement>('[data-iso]'))
				b.onclick = () => showDay(b.dataset.iso!);

			// Keep the open day if it is in this month; otherwise open the month's last.
			const stay = keepDay && m.days.some((d) => d.iso === activeIso);
			showDay(stay ? activeIso : m.days[0].iso);
		}

		function showDay(iso: string) {
			const m = months[monthIdx];
			const day = m.days.find((x) => x.iso === iso) ?? m.days[0];
			activeIso = day.iso;
			lastArchive = day.iso;

			for (const b of calGrid.querySelectorAll<HTMLElement>('[data-iso]'))
				b.classList.toggle('on', b.dataset.iso === day.iso);

			calEdition.textContent = day.edition;
			calDate.textContent = day.date;

			// The write-up is what makes an archived session worth reading — the blurb was
			// written before it happened and the summary after. Prefer the summary.
			arcList.innerHTML = day.ids.map((id) => {
				const e = data[id];
				return `<li><button class="arc-ev" data-ev="${esc(id)}">
					<span class="arc-time">${esc(e.starts_at.slice(11))}</span>
					<span class="arc-body">
						<span class="arc-name">${esc(e.name)}</span>
						<span class="arc-text">${esc(e.summary || e.description)}</span>
					</span>
					<span class="arc-go" aria-hidden="true">→</span>
				</button></li>`;
			}).join('');
			for (const b of arcList.querySelectorAll<HTMLElement>('[data-ev]'))
				b.onclick = () => openFile(b.dataset.ev!);
			if (!rm) gsap.from(arcList.children, { opacity: 0, x: -8, duration: 0.3, stagger: 0.05, ease: 'power3.out' });
		}

		$('calPrev').onclick = () => showMonth(monthIdx + 1);   // chips run newest-first
		$('calNext').onclick = () => showMonth(monthIdx - 1);

		// Restore whatever was open before a live refresh rebuilt this.
		const back = months.findIndex((m) => m.days.some((d) => d.iso === lastArchive));
		activeIso = lastArchive;
		showMonth(back < 0 ? 0 : back, back >= 0);
	}

	/**
	 * Re-run the whole page against the same DOM. initEvents already aborts its previous
	 * listeners and clears its intervals through the AbortController, which is exactly
	 * what a client-router navigation does — so a refresh is the same code path that is
	 * exercised on every navigation rather than a second, less-tested one.
	 */
	function refresh() {
		inited = null;
		initEvents();
	}

	function boot() {
		initEvents();
		// One socket for the page, not one per init: subscribing inside initEvents would
		// tear the connection down and dial a new one on every single update.
		if (stopLive || !document.getElementById('evData')) return;
		const { api } = JSON.parse(document.getElementById('evData')!.textContent || '{}');
		if (api) stopLive = onCatalogueChange(refresh, ['events'], api);
	}

	// Dropped when navigating away, or the socket outlives the page that opened it.
	document.addEventListener('astro:before-swap', () => { stopLive?.(); stopLive = null; });
	document.addEventListener('astro:page-load', boot);
	boot();
</script>

<style is:global>
	/* Loading, empty and offline all speak through one line. It sits in the page flow
	   rather than inside either column, because the calendar's read panel is display:none on
	   a phone and a message written only there would be a blank page with no reason. */
	.ev-note {
		margin: 0; padding: clamp(22px, 4vw, 34px) clamp(16px, 3vw, 28px);
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 12.5px; letter-spacing: .04em; text-align: center; color: var(--ink-40);
	}
	.ev-note[hidden] { display: none; }

	/* ============ TIMELINE ============
	   Time in the gutter, a continuous rail, and each event as a real plate. The rail is
	   one absolutely-positioned line on the list, not a border per row — stacked borders
	   leave a hairline gap at every seam. */
	/* three cards visible, rest scrolls — per day, independently.
	   ponytail: the wrapper scrolls; .tl itself stays a plain block that grows to its
	   full natural height. If .tl were the scroll container instead, its ::before rail
	   (positioned via top/bottom relative to .tl's OWN box) would be clipped to the
	   fixed 3-row height and vanish for anything scrolled below it — wrapping keeps the
	   rail spanning the true full list while the wrapper does the clipping. */
	.tl-scroll {
		--tl-row: 124px; /* approximate: card content height varies with wrapped text */
		--tl-rows: 3;
		max-height: calc(var(--tl-rows) * var(--tl-row));
		overflow-y: auto; overscroll-behavior: contain;
	}

	.tl {
		/* ponytail: the rail and the grid read the SAME three values. They were two
		   independent numbers before, so the line sat 12px off the dots. */
		--tl-time: 58px;
		--tl-gap: 12px;
		--tl-rail: 26px;
		position: relative; list-style: none; margin: 0; padding: 0;
