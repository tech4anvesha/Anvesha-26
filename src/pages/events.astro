	.cal-grid {
		display: grid; grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 1.5px; padding: 1.5px;
		background: var(--hair);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.cal-wd {
		display: grid; place-items: center; padding: 7px 0;
