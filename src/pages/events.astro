		gap: clamp(24px, 3.5vw, 52px); align-items: start;
	}
	.cal-side { display: flex; flex-direction: column; gap: 14px; min-width: 0; }

	/* the months that actually hold sessions — a year of empty grids is not navigation */
	.cal-months { display: flex; flex-wrap: wrap; gap: 6px; }
	.cal-month {
		display: inline-flex; align-items: center; gap: 7px;
		padding: 6px 10px; appearance: none; cursor: pointer;
		background: var(--primary); color: var(--secondary);
		border: 1.5px solid var(--hair); border-radius: var(--r);
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase;
		transition: background .13s ease, color .13s ease, border-color .13s ease;
	}
	.cal-month i { font-style: normal; font-size: 8.5px; color: var(--ink-60); }
	.cal-month:hover { border-color: var(--secondary); }
	.cal-month.on { background: var(--secondary); color: var(--primary); border-color: var(--secondary); }
	.cal-month.on i { color: var(--accent-lit); }

	.cal-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
	.cal-title {
		margin: 0; flex: 1; text-align: center;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(14px, 1.6vw, 17px);
		letter-spacing: .02em; text-transform: uppercase;
	}

	/* One ink ground with a 1.5px gap between cells draws every rule in the grid at
