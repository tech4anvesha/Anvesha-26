	.file-content { padding: 22px 22px 24px; min-width: 0; }

	/* Full-bleed inside the content column, and framed like everything else on the page.
	   max-height so a tall portrait poster cannot push the title, the record rows and the
	   register button below the fold on a laptop — the file is a record first. */
	.file-poster {
		margin: 0 0 16px;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		background: var(--sink); overflow: hidden; line-height: 0;
	}
	.file-poster img {
		display: block; width: 100%; height: auto;
		/* A poster is portrait and would happily take the whole dialog; capped so the
		   title, the record rows and the register button are on screen with it. The rest
		   of the image is one scroll away, which is the right trade for a file. */
		max-height: min(330px, 38vh); object-fit: contain;
	}
	.file-poster[hidden] { display: none; }

	.file-chip {
		display: inline-block; margin-bottom: 12px; padding: 5px 11px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .18em; text-transform: uppercase;
		color: var(--accent); border: 1.5px solid var(--accent); border-radius: var(--r);
	}
	.file-title {
		margin: 0 0 20px;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(22px, 3vw, 32px);
		line-height: 1; letter-spacing: -0.01em; text-transform: uppercase;
	}

	/* form rows: label, dotted leader, value — reads as a filled-in record */
	.file-rows { margin: 0 0 20px; display: flex; flex-direction: column; gap: 9px; }
	.file-row {
		display: grid; grid-template-columns: auto 1fr auto; gap: 9px; align-items: baseline;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 11.5px;
	}
	.file-row dt {
		font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-40);
	}
	.file-lead { border-bottom: 1.5px dotted var(--hair); transform: translateY(-3px); }
	.file-row dd { margin: 0; color: var(--secondary); text-align: right; }

	.file-full { margin: 0; font-size: 13.5px; line-height: 1.68; color: var(--ink-60); }

	.file-sum { margin-top: 20px; padding-top: 16px; border-top: var(--stroke) solid var(--secondary); }
	.file-sum-label {
		display: inline-block; margin-bottom: 9px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--accent);
	}
	.file-sum p { margin: 0; font-size: 13px; line-height: 1.65; color: var(--ink-60); }

	.file-foot {
		display: flex; align-items: center; justify-content: flex-end; gap: 16px;
		padding: 14px 18px;
		border-top: var(--stroke) solid var(--secondary);
		background: var(--sink);
	}
	.file-reg { padding: 13px 19px; font-size: 11.5px; }
	/* rubber stamp, tilted so it reads as pressed on rather than laid out */
	.file-stamp {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: 12px; letter-spacing: .18em;
		color: var(--accent); border: 2.5px solid var(--accent);
		padding: 6px 13px; border-radius: 3px;
		transform: rotate(-4deg); opacity: .85;
	}

	@media (max-width: 900px) {
		/* The grid stops being a sensible 340px column here and the ledger needs the
		   width more than the calendar does. */
		.cal { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 720px) {
		.tl { --tl-time: 44px; --tl-gap: 8px; --tl-rail: 22px; }
		.tl-time { font-size: 12px; }
		.tl-venue { display: none; }
		.file-inner { grid-template-columns: 30px 1fr; }
		.file-content { padding: 18px 16px 20px; }
	}
</style>
