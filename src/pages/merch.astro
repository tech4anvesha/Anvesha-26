			let i = 0;
			clearInterval(segTimer);
			segTimer = setInterval(() => {
				if (i >= segs.length - 1) return;
				setSegs(++i);
			}, 110) as unknown as number;
		}
		function finishProgress() { clearInterval(segTimer); setSegs(segs.length); }
		function resetProgress() { clearInterval(segTimer); setSegs(0); }
		resetProgress();

		let currentOrder: string | null = null;
		type ReceiptData = {
			order_id: string; transaction_id: string; total_price_paise: number;
			items: { name: string; size: string | null; quantity: number; line_total_paise: number }[];
			name: string;
		};
		let lastReceipt: ReceiptData | null = null;

		// The popup has three faces; `face` decides which one shows. Driving all three from
		// one call means two can never be on screen together.
		const payModal = $('payModal'), payPanel = payModal.querySelector('.modal') as HTMLElement;
		const payTitle = $('payTitle'), payClose = $<HTMLButtonElement>('payClose');
		let payOpen = false;
		gsap.set(payModal, { autoAlpha: 0 });
		gsap.set(payPanel, { scale: 0.96 });

		const TITLES = { details: 'CHECKOUT', processing: 'PROCESSING', paid: 'PAID' };
		function setFace(face: 'details' | 'processing' | 'paid') {
			payForm.hidden = face !== 'details';
			processingEl.hidden = face !== 'processing';
			receiptEl.hidden = face !== 'paid';
			payTitle.textContent = TITLES[face];
			// No bailing out mid-payment: the money is already moving and closing here
			// would strand the shopper with no order id and no receipt.
			payClose.disabled = face === 'processing';
		}
		setFace('details');

		function openPay(on: boolean) {
			payOpen = on;
			payModal.setAttribute('aria-hidden', String(!on));
			// Locks everything behind the popup — including the bag drawer, which sits
			// above the scrim in stacking order and would otherwise stay clickable through it.
			document.body.classList.toggle('pay-lock', on);
			gsap.to(payModal, { autoAlpha: on ? 1 : 0, duration: rm ? 0 : 0.22 });
			gsap.to(payPanel, { scale: on ? 1 : 0.96, duration: rm ? 0 : 0.26, ease: 'power2.out' });
			gsap.to(scrim, { autoAlpha: on || cartOpen ? 1 : 0, duration: rm ? 0 : 0.22 });
			// Closing always resets to the form: an order already paid for must not reopen
			// on its receipt and invite a second PAY on a stale order id.
			if (!on) { setFace('details'); currentOrder = null; }
		}
		$('payClose').onclick = () => openPay(false);

		// ---- 1. cart -> order ----
		checkoutEl.onclick = async () => {
			const lines = Object.values(cart);
			if (!lines.length) return;

			checkoutEl.disabled = true;
			orderErr.hidden = true;
			try {
				// Only ids, quantities and sizes cross the wire — the total shown in the
				// cart is for the shopper's benefit and is recalculated server-side.
				const res = await fetch(API + '/api/checkout', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ cart: lines }),
				});
				const data = await res.json();
				if (!res.ok) throw new Error(data.message || data.error || 'Checkout failed');

				currentOrder = data.order_id;
				orderItems.innerHTML = data.items
					.map((l: any) =>
						`<li><span>${l.name}${l.size ? ' · ' + l.size : ''} × ${l.quantity}</span>` +
						`<b>${rupees(l.line_total_paise)}</b></li>`)
					.join('');
				// Both read the server's total, not the browser's — if they ever disagree,
				// the shopper sees the number they will actually be charged.
				orderTotal.textContent = rupees(data.total_price_paise);
				payAmount.textContent = rupees(data.total_price_paise);
				setFace('details');
				openPay(true);
				fName.focus();
			} catch (e) {
				// Reported in the bag, not the popup — the popup never opened.
				orderErr.textContent = (e as Error).message;
				orderErr.hidden = false;
			} finally {
				checkoutEl.disabled = false;
			}
		};

		// ---- 2. details -> paid ----
		payForm.onsubmit = async (e) => {
			e.preventDefault();
			if (!currentOrder) return;

			payBtn.disabled = true;
			payErr.hidden = true;

			// The form is replaced, not merely disabled — the details behind a payment in
			// flight must not be editable, and there is nothing to do here but wait.
			setFace('processing');
			startProgress();

			try {
				const res = await fetch(API + '/api/pay', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						order_id: currentOrder,
						name: fName.value,
						phone: fPhone.value,
						email: fEmail.value,
					}),
				});
				const data = await res.json();
				// The server validates name/phone/email; its message is the one shown,
				// so the browser never has to keep a second copy of those rules.
				if (!res.ok) throw new Error(data.message || data.error || 'Payment failed');

				// Light the last tile and hold a beat, so the bar is seen completing rather
				// than the face snapping away the instant the response lands.
				finishProgress();
				await new Promise((r) => setTimeout(r, 420));

				orderIdEl.textContent = data.order_id;
				txnIdEl.textContent = data.transaction_id;
				paidTotal.textContent = rupees(data.total_price_paise);
				receiptNameEl.textContent = data.customer?.name ?? '';
				receiptItemsEl.innerHTML = data.items
					.map((l: any) =>
						`<li><span>${l.name}${l.size ? ' · ' + l.size : ''} × ${l.quantity}</span>` +
						`<b>${rupees(l.line_total_paise)}</b></li>`)
					.join('');
				lastReceipt = { order_id: data.order_id, transaction_id: data.transaction_id,
					total_price_paise: data.total_price_paise, items: data.items, name: data.customer?.name ?? '' };
				drawQR(qrCanvas, data.order_id);

				// The order is settled server-side; clear the bag so a refresh cannot
				// re-checkout the same items.
				cart = {}; saveCart(); renderCart();
				payForm.reset();
				setFace('paid');
			} catch (err) {
				// Back to the form with the details intact, so a rejected phone or email can
				// be corrected and resubmitted against the same order.
				setFace('details');
				payErr.textContent = (err as Error).message;
				payErr.hidden = false;
			} finally {
				payBtn.disabled = false;
				resetProgress();
			}
		};

		$('receiptDone').onclick = () => { openPay(false); openCart(false); };

		// ---- QR ----
		// Drawn by hand into a canvas rather than using the library's own image output:
		// it keeps the modules on the site's palette and gives a real PNG to download.
		function drawQR(canvas: HTMLCanvasElement, text: string) {
			const qr = qrcode(0, 'M');
			qr.addData(text);
			qr.make();

			const count = qr.getModuleCount();
			const quiet = 4;                       // required silent margin, in modules
			const scale = 8;                       // device px per module
			const size = (count + quiet * 2) * scale;
			canvas.width = size;
			canvas.height = size;

			const ctx = canvas.getContext('2d')!;
			ctx.fillStyle = '#ffffff';
			ctx.fillRect(0, 0, size, size);
			ctx.fillStyle = '#0b0b0f';
			for (let r = 0; r < count; r++)
				for (let c = 0; c < count; c++)
					if (qr.isDark(r, c))
						ctx.fillRect((c + quiet) * scale, (r + quiet) * scale, scale, scale);
		}

		/** Composites the QR and the receipt text into one downloadable card — the
		 *  screenshot the shopper takes should not need to also crop in the order id. */
		function buildReceiptCard(receipt: ReceiptData): HTMLCanvasElement {
			const pad = 28, lineH = 22, headerH = 34, qrSize = qrCanvas.width;
			const width = Math.max(qrSize + pad * 2, 440);
			const rows = 2 + receipt.items.length + 2; // order + name + items + total + txn
			const height = pad + qrSize + pad + headerH + rows * lineH + pad + 24;

			const canvas = document.createElement('canvas');
			canvas.width = width; canvas.height = height;
			const ctx = canvas.getContext('2d')!;

			ctx.fillStyle = '#ffffff';
			ctx.fillRect(0, 0, width, height);
			ctx.strokeStyle = '#0b0b0f';
			ctx.lineWidth = 3;
			ctx.strokeRect(4, 4, width - 8, height - 8);

			ctx.drawImage(qrCanvas, (width - qrSize) / 2, pad);

			let y = pad + qrSize + pad;
			ctx.fillStyle = '#0b0b0f';
			ctx.textAlign = 'center';
			ctx.font = "700 15px 'Archivo', sans-serif";
			ctx.fillText("ANVESHA '26 — ORDER RECEIPT", width / 2, y);
			y += headerH;

			const row = (label: string, value: string, bold = false) => {
				ctx.textAlign = 'left';
				ctx.font = "13px 'DM Mono', ui-monospace, monospace";
				ctx.fillText(label, pad, y);
				ctx.textAlign = 'right';
				ctx.font = (bold ? '700 ' : '') + "13px 'DM Mono', ui-monospace, monospace";
				ctx.fillText(value, width - pad, y);
				y += lineH;
			};

			row('Order', receipt.order_id);
			row('Name', receipt.name);
			for (const it of receipt.items)
				row(`${it.name}${it.size ? ' · ' + it.size : ''} × ${it.quantity}`, rupees(it.line_total_paise));
			row('Total', rupees(receipt.total_price_paise), true);
			row('Transaction', receipt.transaction_id);

			y += 10;
			ctx.textAlign = 'left';
			ctx.fillStyle = '#666';
			ctx.font = "italic 11px 'Archivo', sans-serif";
			ctx.fillText('Take a screenshot of this QR code as proof of payment.', pad, y);

			return canvas;
		}

		$('qrDownload').onclick = async () => {
			if (!lastReceipt) return;
			await document.fonts.ready; // canvas text only renders correctly once webfonts are loaded
			const card = buildReceiptCard(lastReceipt);
			const a = document.createElement('a');
			a.href = card.toDataURL('image/png');
			a.download = `anvesha-${lastReceipt.order_id}.png`;
			a.click();
		};

		// ---- mobile shop ----
		function renderMCats() {
			mCats.innerHTML = '';
			for (const c of catalog) {
				const b = document.createElement('button');
				b.className = 'btn m-cat' + (c.id === catId ? ' active' : '');
				b.setAttribute('role', 'tab');
				b.setAttribute('aria-selected', String(c.id === catId));
				b.textContent = c.name;
				b.onclick = () => { catId = c.id; renderMCats(); renderMGrid(); };
				mCats.appendChild(b);
			}
		}

		function renderMGrid() {
			const cat = catalog.find((c) => c.id === catId)!;
			mGrid.innerHTML = '';
			for (const it of cat.items) {
				const b = document.createElement('button');
				b.className = 'btn m-card';
				// The card leads with the product's own photo — artHTML keeps the category
				// icon underneath for anything with nothing in R2 yet.
				b.innerHTML =
					`<span class="m-card-art art">${artHTML(it, 0)}</span>` +
					`<span class="m-card-name">${it.name}</span>` +
					`<span class="m-card-price">${rupees(it.price_paise)}</span>`;
				b.onclick = () => { selectItem(it); openSheet(true); };
				mGrid.appendChild(b);
			}
		}

		let sheetOpen = false;
		gsap.set(mSheet, { autoAlpha: 0 });
		gsap.set(mSheetPanel, { yPercent: 14 });
		function openSheet(on: boolean) {
			sheetOpen = on;
			mSheet.setAttribute('aria-hidden', String(!on));
			gsap.to(mSheet, { autoAlpha: on ? 1 : 0, duration: rm ? 0 : 0.22 });
			gsap.to(mSheetPanel, { yPercent: on ? 0 : 14, duration: rm ? 0 : 0.32, ease: 'power3.out' });
			// selecting a category on the grid should follow the item you just opened
			if (!on) { renderMCats(); renderMGrid(); }
		}
		$('mSheetClose').onclick = () => openSheet(false);
		mSheet.addEventListener('click', (e) => { if (e.target === mSheet) openSheet(false); });
		mSizeBtn.onclick = () => openSize(true);

		// ---- boot ----
		// Everything above is wiring; nothing renders until the catalogue arrives.
		try {
			catalog = await loadCatalog();
		} catch (e) {
			// A dead API must say so plainly. Silently showing an empty shop would look
			// like the fest sold out.
			treeEl.innerHTML =
				`<p class="load-err">Could not reach the shop.<br /><small>${(e as Error).message}` +
				`<br />Is the worker running on ${API}?</small></p>`;
			return;
		}
		if (!catalog.length) {
			treeEl.innerHTML = `<p class="load-err">No merch on sale yet.</p>`;
			return;
		}

		catId = catalog[0].id;
		openCat = catId;
		buildTree(); renderCart(); renderMCats(); renderMGrid();
		selectItem(catalog[0].items[0]);

		// ---- live catalogue ----
		// An admin adding or repricing an item reaches open tabs immediately. The
		// shopper's place is kept: the same item stays selected if it still exists, and
		// the bag is untouched — renderCart() drops any line whose item has vanished.
		stopLive?.();
		stopLive = onCatalogueChange(async () => {
			const openId = item?.id;
			const fresh = await loadCatalog().catch(() => null);
			if (!fresh?.length) return; // a blip must not blank a working shop

			catalog = fresh;
			buildTree();
			renderMCats();
			renderMGrid();
			renderCart();

			const stillThere = catalog.flatMap((c) => c.items).find((i) => i.id === openId);
			selectItem(stillThere ?? catalog[0].items[0]);
		});
	}

	let stopLive: (() => void) | null = null;
	document.addEventListener('astro:before-swap', () => { stopLive?.(); stopLive = null; });
	document.addEventListener('astro:page-load', initMerch);
	// ...and run now, in case this module was inserted mid-navigation and page-load
	// has already fired. The `inited` guard makes the duplicate call a no-op.
	initMerch();

</script>

<style is:global>
	/* ponytail: is:global because renderTree/renderSizes/renderViews build .tnode/.size/
	   .vbox with createElement — those never receive Astro's data-astro-cid-* attribute,
	   so scoped rules silently skip them. Tokens, .btn and the shell live in SiteLayout. */

	/* page-local micro-type. SiteLayout only ships the generic .mono helper. */
