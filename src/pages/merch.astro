		text-transform: uppercase; margin: 0;
	}

	.opt { display: flex; align-items: center; gap: 20px; margin-top: 10px; }
	/* dotted underline is the affordance — conventional for "more info", and quiet
	   enough that the label still reads as a label */
	.opt-label {
		appearance: none; -webkit-appearance: none;
		padding: 0 0 2px; background: transparent; border: 0;
		border-bottom: 1.5px dotted var(--ink-40); cursor: pointer;
