	.ctrack { display: flex; gap: 14px; padding: 4px; justify-content: safe center; min-width: 100%; width: max-content; }

	.vbox {
		position: relative; overflow: hidden;
		flex: 1 1 auto; min-width: 200px; max-width: 320px;
		height: clamp(150px, 19vh, 200px);
