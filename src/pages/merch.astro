	.modal-note {
		margin: 16px 0 0; font-size: 11.5px; font-style: italic; line-height: 1.55;
		color: var(--ink-40);
	}

	.scrim { opacity: 0; visibility: hidden; position: fixed; inset: 0; z-index: 25; background: color-mix(in srgb, var(--secondary) 45%, transparent); }

	/* ---- checkout lock ---- */
	/* The bag drawer sits above the scrim (z-30 vs z-25) so it would otherwise stay
	   sharp and clickable right through a dimmed background. pointer-events: none is
	   the actual lock; the blur is just what makes that lock visible. */
	/* .botnav used to be listed here; the mobile bottom bar is gone, replaced by the
	   menu panel, which cannot be open behind checkout. */
	body.pay-lock .card,
	body.pay-lock #cart {
		filter: blur(6px);
		pointer-events: none;
		transition: filter .25s ease;
	}

