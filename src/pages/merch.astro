	}
	.buy:disabled { opacity: .25; cursor: not-allowed; box-shadow: none; }

	/* ---- CENTRE: magnified view, no container ---- */
	.col-stage {
		/* one length drives both the bracket box and the icon, so they scale together */
		--vf: clamp(240px, 42vh, 450px);
		display: flex; flex-direction: column; align-items: center;
		gap: 18px; padding: 34px clamp(20px, 3.5vw, 52px) 30px; position: relative;
		background:
			radial-gradient(circle at 50% 38%, color-mix(in srgb, var(--accent) 5%, transparent), transparent 62%);
	}
	/* flex:1 hands the stage every pixel the carousel below doesn't claim */
	.stage-frame { flex: 1; width: 100%; display: grid; place-items: center; min-height: 0; }
	/* ponytail: both children occupy the SAME grid cell, so they share one centring
	   pass. Centring them independently (grid item vs. absolute + translate) left the
	   icon off-axis from the brackets. */
	.stage-frame > * { grid-area: 1 / 1; }
	/* The SAME square as the viewfinder, so the two are concentric by construction
	   rather than by two independent centring passes agreeing.
	   min-height:0 is what makes that hold: as a grid item this box's automatic minimum
	   is its content size, which let a tall image stretch it past the aspect-ratio and
	   left every percentage inside with nothing definite to resolve against. */
	.stage-view {
		position: relative; overflow: hidden;
		width: min(var(--vf), 86%); aspect-ratio: 1;
		min-width: 0; min-height: 0;
	}
	/* Absolutely positioned with all four insets, which is the one way to give this a
	   height the browser treats as definite. `height: 100%` against an aspect-ratio box
	   is not reliable — that is why max-height: 95% on the image kept being ignored and
	   a tall poster ran on behind the carousel. inset: 2.5% IS the 95% frame. */
	.stage-view .big {
		position: absolute; inset: 2.5%;
		display: grid; place-items: center; line-height: 0;
	}

	/* ---- camera viewfinder ---- */
	.viewfinder {
		position: relative;
		width: min(var(--vf), 86%); aspect-ratio: 1;
		pointer-events: none;
	}
	.vf-c { position: absolute; width: 26px; height: 26px; border: 0 solid var(--secondary); }
	.vf-c.tl { top: 0; left: 0; border-top-width: var(--stroke); border-left-width: var(--stroke); }
	.vf-c.tr { top: 0; right: 0; border-top-width: var(--stroke); border-right-width: var(--stroke); }
	.vf-c.bl { bottom: 0; left: 0; border-bottom-width: var(--stroke); border-left-width: var(--stroke); }
	.vf-c.br { bottom: 0; right: 0; border-bottom-width: var(--stroke); border-right-width: var(--stroke); }
	/* rule-of-thirds guides, four 1px lines from one background shorthand */
	.vf-grid {
		position: absolute; inset: 0;
		background:
			linear-gradient(var(--hair), var(--hair)) 33.33% 0 / 1px 100% no-repeat,
			linear-gradient(var(--hair), var(--hair)) 66.66% 0 / 1px 100% no-repeat,
			linear-gradient(var(--hair), var(--hair)) 0 33.33% / 100% 1px no-repeat,
			linear-gradient(var(--hair), var(--hair)) 0 66.66% / 100% 1px no-repeat;
	}
	.vf-hud {
		position: absolute; display: flex; align-items: center; white-space: nowrap;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .14em; color: var(--ink-40);
	}
	.hud-tl { top: -21px; left: 0; }
	.hud-tr { top: -21px; right: 0; }
	.hud-bl { bottom: -21px; left: 0; }
	.hud-br { bottom: -21px; right: 0; }
	.vf-rec {
		width: 7px; height: 7px; margin-right: 7px; border-radius: 50%;
		background: var(--accent); animation: vf-blink 1.6s steps(1, end) infinite;
	}
	@keyframes vf-blink { 50% { opacity: .15; } }
	@media (prefers-reduced-motion: reduce) { .vf-rec { animation: none; } }
	/* ponytail: explicit height, not max-height:100% — a percentage height here would
	   resolve against an auto-height chain and collapse. Derived from --vf so the icon
	   keeps a fixed margin inside the brackets at every viewport size. */
	.stage-view svg {
