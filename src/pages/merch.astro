			(viewListEl.children[viewIdx] as HTMLElement)?.focus();
		});

		// ---- GSAP reveal ----
		// ponytail: displacement only — never animate opacity here, and always fromTo + clearProps.
		// gsap.from() paints the START state immediately and only reaches the end state if the
		// tween actually runs; a stalled ticker (backgrounded tab, throttled rAF) left the title
		// grey and the whole buy block at opacity 0 — the buy button vanished. Worst case now is
		// an element sitting a few px off its mark, still fully visible and clickable.
		function animateSelect() {
			if (rm) return;
			const active = treeEl.querySelector('.titem.active');
			const tl = gsap.timeline();
			const slide = { duration: 0.4, ease: 'power3.out', clearProps: 'transform' };
			if (active) tl.fromTo(active, { x: -12 }, { x: 0, ...slide }, 0);
			tl.fromTo([pNameEl, pDescEl, pDesignerEl], { y: 18 }, { y: 0, stagger: 0.05, ...slide }, 0.05)
				.fromTo(sizesEl.children, { y: 8 }, { y: 0, stagger: 0.04, ...slide }, '-=0.2')
				.fromTo(addBtn, { y: 12 }, { y: 0, ...slide }, '-=0.2')
				.fromTo(viewListEl.children, { x: 16 }, { x: 0, stagger: 0.06, ...slide }, '-=0.3');
		}

		function addToBag() {
			if (!item) return;
			const key = cartKey(item.id, size);
			cart[key] ??= { merch_id: item.id, quantity: 0, size };
			cart[key].quantity++;
			// Adding an item only bumps the counter — it does not yank the shopper into
			// the bag. They open it deliberately, via the bag button, when ready.
			saveCart(); renderCart();
			if (!rm) gsap.fromTo('#cartCount, #cartCount2', { scale: 1.8 }, { scale: 1, duration: 0.45, ease: 'back.out(3)' });
		}
		addBtn.onclick = addToBag;
		mAdd.onclick = () => { addToBag(); openSheet(false); };

		// ---- cart drawer ----
		const cartEl = $('cart'), scrim = $('scrim');
		const cartItemsEl = $('cartItems'), cartEmptyEl = $('cartEmpty');
		const cartTotalEl = $('cartTotal'), cartCountEl = $('cartCount'), cartCount2El = $('cartCount2');
		const checkoutEl = $<HTMLButtonElement>('checkout'), orderErr = $('orderErr');
		gsap.set(cartEl, { xPercent: 100, visibility: 'visible' });
		gsap.set(scrim, { autoAlpha: 0 });

		function renderCart() {
			cartItemsEl.innerHTML = '';
			let total = 0, count = 0;
			// A line whose item has vanished from the catalogue is dropped, not drawn.
			for (const [key, line] of Object.entries(cart)) {
				const it = itemById(line.merch_id);
				if (!it) { delete cart[key]; continue; }

				const lineTotal = it.price_paise * line.quantity;
				total += lineTotal; count += line.quantity;

				const li = document.createElement('li');
				li.innerHTML = `
					<span class="cmeta">
						<span class="cn">${it.name}${line.size ? ' · ' + line.size : ''}</span>
					</span>
					<span class="cq">
						<button class="btn" data-act="dec" data-id="${key}" aria-label="Decrease quantity">${iMinus}</button>
						<b>${line.quantity}</b>
						<button class="btn" data-act="inc" data-id="${key}" aria-label="Increase quantity">${iPlus}</button>
					</span>
					<span class="cl">${rupees(lineTotal)}</span>`;
				cartItemsEl.appendChild(li);
			}
			const ids = Object.keys(cart);
			cartEmptyEl.style.display = ids.length ? 'none' : 'flex';
			cartItemsEl.style.display = ids.length ? 'flex' : 'none';
			cartTotalEl.textContent = rupees(total);
			cartCountEl.textContent = String(count);
			cartCount2El.textContent = String(count);
			checkoutEl.disabled = ids.length === 0;
		}

		cartItemsEl.addEventListener('click', (e) => {
			const t = (e.target as HTMLElement).closest('button');
			if (!t) return;
			const id = t.dataset.id!;
			if (t.dataset.act === 'inc') cart[id].quantity++;
			else if (--cart[id].quantity <= 0) delete cart[id];
			saveCart(); renderCart();
		});

		let cartOpen = false;
		function openCart(on: boolean) {
			cartOpen = on;
			cartEl.setAttribute('aria-hidden', String(!on));
			gsap.to(cartEl, { xPercent: on ? 0 : 100, duration: rm ? 0 : 0.4, ease: 'power3.out' });
			gsap.to(scrim, { autoAlpha: on ? 1 : 0, duration: rm ? 0 : 0.3 });
		}
		$('cartToggle').onclick = () => openCart(!cartOpen);
		$('cartClose').onclick = () => openCart(false);

		// ---- size chart ----
		// ponytail: one scrim serves both overlays — a second identical layer would only
		// create a z-order to get wrong.
		const sizeModal = $('sizeModal'), sizePanel = sizeModal.querySelector('.modal') as HTMLElement;
		const sizeBtn = $<HTMLButtonElement>('sizeBtn');
		let sizeOpen = false;
		gsap.set(sizeModal, { autoAlpha: 0 });
		gsap.set(sizePanel, { scale: 0.96 });

		function openSize(on: boolean) {
			sizeOpen = on;
			sizeModal.setAttribute('aria-hidden', String(!on));
			// mark the row for the size already chosen, so the chart lands in context
			if (on) sizeModal.querySelectorAll<HTMLElement>('[data-size]')
				.forEach((r) => r.classList.toggle('on', r.dataset.size === size));

			gsap.to(sizeModal, { autoAlpha: on ? 1 : 0, duration: rm ? 0 : 0.22 });
			gsap.to(sizePanel, { scale: on ? 1 : 0.96, duration: rm ? 0 : 0.26, ease: 'power2.out' });
			// The shared scrim is deliberately NOT touched: the chart carries its own
			// backdrop now, and driving the scrim from here would yank it out from under
			// an open bag drawer on close.
			(on ? $<HTMLButtonElement>('sizeClose') : sizeBtn).focus();
		}
		sizeBtn.onclick = () => openSize(true);
		$('sizeClose').onclick = () => openSize(false);
		// The backdrop is the wrapper itself, so it takes the tap-outside-to-close that
		// the scrim used to handle. `e.target === sizeModal` keeps a drag that started
		// inside the panel from dismissing it.
		sizeModal.addEventListener('click', (e) => {
			if (e.target === sizeModal) openSize(false);
		});

		scrim.onclick = () => {
			if (payOpen) openPay(false);
			else if (sizeOpen) openSize(false);
			else openCart(false);
		};
		addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			if (payOpen) openPay(false);
			else if (sizeOpen) openSize(false);
			else if (sheetOpen) openSheet(false);
			else if (cartOpen) openCart(false);
		}, { signal });

		// ---- checkout: cart -> details -> paid ----
		// The drawer has three faces; `stage` decides which one shows. Keeping it on one
		// attribute means the CSS owns the switching and no two faces can be open at once.
		const payForm = $<HTMLFormElement>('payForm'), receiptEl = $('receipt');
		const orderItems = $('orderItems'), orderTotal = $('orderTotal'), payAmount = $('payAmount');
		const orderIdEl = $('orderId'), txnIdEl = $('txnId'), paidTotal = $('paidTotal');
		const receiptItemsEl = $('receiptItems'), receiptNameEl = $('receiptName');
		const payErr = $('payErr'), payBtn = $<HTMLButtonElement>('payBtn');
		const processingEl = $('processing'), payProgress = $('payProgress');
		const segs = [...payProgress.querySelectorAll<HTMLElement>('.seg')];
		const fName = $<HTMLInputElement>('fName'), fPhone = $<HTMLInputElement>('fPhone');
		const fEmail = $<HTMLInputElement>('fEmail');
		const qrCanvas = $<HTMLCanvasElement>('qrCanvas');

