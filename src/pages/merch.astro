		// ---- 3. pay -> received ----
		// The screenshot, previewed before it is sent. An object URL rather than a
		// FileReader: no decode pass, and revoking it is the only cleanup needed.
		let proofUrl: string | null = null;
		function showProof(file: File | null) {
			if (proofUrl) { URL.revokeObjectURL(proofUrl); proofUrl = null; }
			proofBox.classList.toggle('has-file', Boolean(file));
			proofName.textContent = file ? file.name : '';
			if (!file) { proofImg.removeAttribute('src'); return; }
			proofUrl = URL.createObjectURL(file);
			proofImg.src = proofUrl;
		}

		/**
		 * Paints the UPI QR for THIS order.
		 *
		 * A UPI intent URI, which every Indian payment app understands:
		 *
		 *   upi://pay?pa=<vpa>&pn=<payee>&am=<amount>&cu=INR&tn=<note>
		 *
		 * `am` is why this is worth doing — the student confirms an amount rather than
		 * typing one, which is the single likeliest place for a payment to go wrong by a
		 * digit. `tn` puts the order id in the transaction narration, so the admin
		 * checking the bank statement can see which order a credit belongs to without
		 * cross-referencing anything.
		 *
		 * Only the five well-supported fields. `tr` (merchant reference) is deliberately
		 * left out: its handling varies between PSPs, and a QR some apps refuse to parse
		 * is far worse than one missing a field nobody reads.
		 */
		function paintUpiQr(orderId: string, paise: number) {
			// Rupees with two decimals — `am` is a decimal amount, never paise.
			const amount = (paise / 100).toFixed(2);
			// Stripped to what bank narration systems reliably carry — but the underscore
			// is kept, because it is the only punctuation an order id contains and the
			// whole point of the note is that it matches the order id EXACTLY. A
			// statement line reading ORD-4E3R… against a panel showing ORD_4E3R… is a
			// reconciliation papercut on every single order.
			const note = `Anvesha26 ${orderId}`.replace(/[^A-Za-z0-9 _-]/g, '-').slice(0, 50);

