	.bag-lookup {
		margin: 0 0 10px;
		font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-40);
	}
	.bag-lookup a { color: var(--secondary); }

	.sales-soon {
		display: flex; align-items: center; gap: 8px; margin: 0 0 10px;
		font-size: 10px; letter-spacing: .16em; text-transform: uppercase;
		color: var(--ink-60);
	}
	.sales-soon-dot {
		flex: none; width: 7px; height: 7px; border-radius: 50%;
		background: var(--accent);
	}
	.checkout {
		width: 100%;
		display: flex; align-items: center; justify-content: space-between;
		font-size: 12.5px; font-weight: 800; letter-spacing: .14em;
		padding: 16px 20px;
		color: var(--primary); background: var(--secondary);
		box-shadow: var(--pop);
	}
	.checkout:hover:not(:disabled) { background: var(--accent); color: var(--primary); border-color: var(--accent); }
	.checkout:hover:not(:disabled) .chk-arrow { transform: translateX(4px); }
	.chk-arrow { display: grid; place-items: center; transition: transform .18s ease; }
	.chk-arrow svg { width: 16px; height: 16px; stroke-width: 2.2; }
	.checkout:disabled { opacity: .25; cursor: not-allowed; box-shadow: none; }

	/* ---- size chart modal ---- */
	/* the wrapper centres and fades; the panel scales. Keeping them separate avoids
	   GSAP's scale fighting a translate(-50%,-50%) on the same element. */
	/* z-index above the mobile product sheet (45) and the cart drawer (30) — at 40 the
	   size chart opened *behind* the sheet that summoned it.
	   It also carries its own backdrop rather than borrowing the shared .scrim: the
	   scrim sits at 25, below the sheet, so it could never dim the thing in front of it.
	   The blur is what makes the chart read as being on top rather than merely over. */
	.modal-wrap {
		opacity: 0; visibility: hidden;
		position: fixed; inset: 0; z-index: 50;
		display: grid; place-items: center; padding: 20px;
		background: color-mix(in srgb, var(--secondary) 42%, transparent);
		/* Standard property only — the build's CSS pass adds the -webkit- prefix itself,
		   and hand-writing both made it keep the prefixed one and drop the standard,
		   which left the blur working in Safari but nowhere else. */
		backdrop-filter: blur(7px);
		pointer-events: auto;
	}
	.modal {
		pointer-events: auto;
		width: min(430px, 100%);
		padding: 24px;
		background: var(--primary); color: var(--secondary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.modal-head {
		display: flex; justify-content: space-between; align-items: center;
		margin-bottom: 18px;
	}
	.modal-title {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 14px; letter-spacing: .1em;
	}
	.sizetable {
		width: 100%; border-collapse: collapse;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 12.5px;
	}
	.sizetable th, .sizetable td {
		padding: 9px 6px; text-align: right; border-bottom: 1.5px solid var(--hair);
	}
	.sizetable th:first-child, .sizetable td:first-child { text-align: left; }
	.sizetable th {
		font-size: 9.5px; font-weight: 500; letter-spacing: .12em;
		text-transform: uppercase; color: var(--ink-40);
	}
	.sizetable tbody tr:last-child td { border-bottom: 0; }
	.sizetable tbody tr.on td { background: var(--secondary); color: var(--primary); }
	.sizetable tbody tr.on td:first-child { font-weight: 500; }
	/* The first column holds the longest label (3XL) and must not wrap it onto two
	   lines; the measurement columns can share what is left. */
	.sizetable th:first-child, .sizetable td:first-child { width: 22%; white-space: nowrap; }

	.modal-note {
		margin: 16px 0 0; font-size: 11.5px; font-style: italic; line-height: 1.55;
		color: var(--ink-40);
	}

	.scrim { opacity: 0; visibility: hidden; position: fixed; inset: 0; z-index: 25; background: color-mix(in srgb, var(--secondary) 45%, transparent); }

	/* ---- checkout lock ---- */
	/* The bag drawer sits above the scrim (z-30 vs z-25) so it would otherwise stay
	   sharp and clickable right through a dimmed background. pointer-events: none is
	   the actual lock; the blur is just what makes that lock visible. */
	/* .botnav used to be listed here; the mobile bottom bar is gone, replaced by the
	   menu panel, which cannot be open behind checkout. */
	body.pay-lock .card,
	body.pay-lock #cart {
		filter: blur(6px);
		pointer-events: none;
		transition: filter .25s ease;
	}

	:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

	/* ---- image with an icon fallback underneath ---- */
	/* ponytail: the <img> only becomes visible once it has actually loaded, so an item
	   with nothing in R2 shows its category icon instead of a broken-image box. */
	.art { display: grid; place-items: center; }
	/* min-*: 0 is load-bearing. A grid item's automatic minimum size is its CONTENT
	   size, and for an <img> that is the file's intrinsic pixels — so a 1200x1800
	   photo ignored `width: 95%` and stretched the stage, and the page with it. */
	.art > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
	.art-img { display: none; max-width: 100%; height: auto; object-fit: contain; }
	.art-img.ok { display: block; }
	.art-img.ok ~ .art-icon { display: none; }
	/* Fits whatever the 95% frame above gives it, keeping its own proportions: a tall
	   poster caps on height, a wide one on width. */
	.stage-view .art-img {
		width: 100%; height: 100%;
		max-width: 100%; max-height: 100%;
		object-fit: contain;
	}
	/* Fits the framed stage rather than filling its width: a tall poster would otherwise
	   be forced to full width and cropped by the frame's overflow. */
	.m-stage-icon .art-img {
		width: auto; height: auto;
		max-width: 100%; max-height: 100%;
		object-fit: contain;
	}

	/* The chip thrown at the bag on add. z-index above everything it flies over: the
	   checkout popup (50), the mobile sheet (45) and the drawer (30). top/left stay 0 —
	   GSAP places it with a transform, which is the only thing that should move. */
	.fly {
		position: fixed; top: 0; left: 0; z-index: 60;
		width: 56px; height: 56px;
		pointer-events: none; overflow: hidden;
		background: var(--sink);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		box-shadow: var(--pop);
	}
	.fly img { display: block; width: 100%; height: 100%; object-fit: cover; }

	.load-err {
		margin: 0; padding: 18px 2px;
		font-size: 13px; line-height: 1.6; color: var(--ink-60);
	}
	.load-err small { color: var(--ink-40); font-family: 'DM Mono', ui-monospace, monospace; font-size: 11px; }

	/* ---- checkout popup ---- */
	/* The popup is capped to the viewport and scrolls internally, so a long bag or a
	   short laptop screen can never push the PAY button off-screen. */
	.paymodal { display: flex; flex-direction: column; max-height: min(86vh, 760px); }

	.pay-form, .receipt, .pay-step {
		min-height: 0; overflow-y: auto; overflow-x: hidden;
		display: flex; flex-direction: column; gap: 14px;
		/* Setting only overflow-y leaves overflow-x computed as 'auto' per spec, not
		   'visible' — that phantom horizontal scrollbar under the PAY button was this.
		   But every input/button's hover-focus effect (translate(-2,-2) + a 3px hard
		   shadow) needs a few px of clearance on every side, or this same overflow clips
		   it right at the scroll box's edge — a 100%-width field has nowhere else to go.
		   6px comfortably covers the 2px shift and the 1px net shadow overshoot. */
		padding: 6px;
		margin: -6px;
	}
	/* An author `display` rule outranks the UA sheet's [hidden]{display:none} at equal
	   specificity, so without this the face marked hidden stays on screen — which is
	   exactly how all three faces ended up stacked at once. */
	/* Explicit, because the author `display` above outranks the UA's [hidden] rule. */
	.pay-form[hidden], .receipt[hidden], .pay-step[hidden] { display: none; }

	/* ---- received ---- */
	.recv {
		display: flex; flex-direction: column; align-items: center; gap: 10px;
		padding: 22px 16px 20px; text-align: center;
		background: var(--sink);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	/* A tick drawn from two borders — no icon file for one mark. */
	.recv-mark {
		width: 44px; height: 44px; flex: none;
		display: grid; place-items: center;
		background: var(--accent); border-radius: 999px;
	}
	.recv-mark::after {
		content: ''; width: 13px; height: 23px;
		border: solid var(--primary); border-width: 0 3px 3px 0;
		transform: rotate(45deg) translate(-2px, -2px);
	}
	.recv-title {
		margin: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: 21px; letter-spacing: -.01em; text-transform: uppercase;
	}
	.recv-text { margin: 0; max-width: 34ch; font-size: 13px; line-height: 1.6; color: var(--ink-60); }
	.recv-id {
		display: flex; flex-direction: column; gap: 2px;
		padding: 12px 14px;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.order-note a { color: var(--secondary); }

	.order-row {
		display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
		padding-top: 12px; border-top: 1.5px solid var(--hair);
		font-size: 13px;
	}
	.order-row b { font-family: 'Archivo Expanded', sans-serif; font-size: 19px; }
	.order-row .txn {
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 11px;
		word-break: break-all; text-align: right;
	}

	/* ---- form fields, in the same retro chassis as the buttons ---- */
	.field { display: flex; flex-direction: column; gap: 6px; }
	.field-label {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
	}
	/* This project has no global border-box reset, so a `width: 100%` control adds its
	   own padding and border on top of the full width and hangs over the right edge —
	   which is exactly where the popup's overflow clipped the inputs' right border off.
	   Scoped to the controls that actually declare width: 100%. */
	.field-input, .paybtn, .qrdl, .orderback, .checkout { box-sizing: border-box; }

	/* An id, so it reads as one: monospace and tracked out, matching how order ids are
	   set everywhere else. The JS uppercases the value itself — text-transform alone
	   only changes how it looks, and the raw lowercase would still be what got sent. */
	.roll-input {
		font-family: 'DM Mono', ui-monospace, monospace;
		letter-spacing: .1em; text-transform: uppercase;
	}

	.field-input {
		appearance: none; -webkit-appearance: none;
		width: 100%; padding: 12px 13px;
		font-family: 'Archivo', sans-serif; font-size: 13.5px;
		color: var(--secondary); background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		transition: box-shadow .12s ease, transform .12s ease;
	}
	.field-input::placeholder { color: var(--ink-40); }
	.field-input:focus {
		outline: none;
		transform: translate(-2px, -2px);
		box-shadow: var(--pop);
	}
	/* :user-invalid, not :invalid — :invalid paints every field red before the shopper
	   has typed a single character. */
	.field-input:user-invalid { border-color: var(--accent); }

	.paybtn {
		display: flex; align-items: center; justify-content: center; gap: 13px;
		width: 100%; padding: 17px 20px; margin-top: 4px;
		color: var(--primary); background: var(--secondary);
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 13px; letter-spacing: .14em;
	}
	.paybtn b { font-family: 'Archivo Expanded', sans-serif; font-size: 17px; letter-spacing: -0.01em; }
	.paybtn:disabled { opacity: .45; cursor: wait; }

	/* ---- processing face ---- */
	/* Tiles fill while POST /api/pay is genuinely in flight and the last one is held
	   back until the server confirms, so the bar can never read complete before the
	   payment is. */
	.processing {
		display: flex; flex-direction: column; align-items: center; gap: 20px;
		padding: 26px 0 22px;
	}
	.processing[hidden] { display: none; }
	.proc-icon {
		display: grid; place-items: center;
		width: 68px; height: 68px;
		background: var(--sink);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.proc-icon svg { width: 32px; height: 32px; stroke-width: 1.8; }
	.proc-label {
		margin: 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
		color: var(--ink-60);
	}
	.pay-progress { display: flex; gap: 4px; width: 100%; }
	.pay-progress .seg {
		flex: 1; height: 16px;
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		transition: background .16s ease;
	}
	.pay-progress .seg.on { background: var(--accent); }
	@media (prefers-reduced-motion: reduce) { .pay-progress .seg { transition: none; } }

	.order-note { margin: 0; font-size: 12px; line-height: 1.6; font-style: italic; color: var(--ink-40); }
	.pay-err { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--accent); }

	/* ============ MOBILE SHOP ============
	   Desktop and mobile are two presentations of one state; exactly one is displayed,
	   so there is never a duplicate control competing for the same click. */
	.m-shop, .m-sheet { display: none; }

	@media (max-width: 720px) {
		.hero { display: none; }

		/* ---- ticket on a phone ---- */
		/* Same two-part ticket, tightened: the modal is only ~280px wide at 320px, and the
		   stub's QR and its caption have to stay side by side for it to still read as a
		   torn stub rather than as a QR with a note under it. */
		.tk-head, .tk-body, .tk-stub { padding-left: 12px; padding-right: 12px; }
		.tk-stub { gap: 12px; }
		.qr { width: 104px; height: 104px; }
		.tk-brand { font-size: 12px; }
		.tk-kind { font-size: 8px; letter-spacing: .12em; }
		.tk-id { font-size: 15px; }
		.tk-cell-paid b { font-size: 16px; }
		.tk-serial { display: none; }

		.m-shop {
			display: block; flex: 1; min-height: 0;
			overflow-y: auto; overscroll-behavior: contain;
		}

		/* category tabs stay put while the grid scrolls under them */
		.m-cats {
			position: sticky; top: 0; z-index: 2;
			display: flex; gap: 8px;
			padding: 15px 16px;
			background: var(--primary);
			border-bottom: var(--stroke) solid var(--secondary);
			overflow-x: auto; scrollbar-width: none;
		}
		.m-cats::-webkit-scrollbar { display: none; }
		.m-cat {
			flex: none; padding: 10px 15px;
			font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
		}
		.m-cat.active { background: var(--secondary); color: var(--primary); }

		.m-grid {
			display: grid; grid-template-columns: repeat(2, 1fr);
			gap: 12px; padding: 16px;
		}
		.m-card {
			display: flex; flex-direction: column; align-items: flex-start; gap: 10px;
			padding: 14px 14px 16px; text-align: left;
		}
		/* The photo, filling the card's width. A fixed aspect keeps the grid on an even
		   baseline whatever shape the uploads are, and the fallback icon sits in the
		   same cell for items with nothing in R2 yet. */
		.m-card-art {
			width: 100%; aspect-ratio: 1; overflow: hidden;
			border: 1.5px solid var(--secondary); border-radius: var(--r);
			background: var(--sink);
		}
		.m-card-art .art-img {
			width: 100%; height: 100%; max-width: none; object-fit: cover;
		}
		.m-card-art .art-icon { display: grid; place-items: center; color: var(--ink-40); }
		.m-card-art .art-icon svg { width: 46px; height: 46px; stroke-width: 1.4; }
		.m-card-name { font-size: 13px; font-weight: 700; line-height: 1.3; }
		.m-card-price {
			font-family: 'DM Mono', ui-monospace, monospace;
			font-size: 12px; color: var(--accent);
		}

		/* ---- product sheet ---- */
		.m-sheet {
			opacity: 0; visibility: hidden;
			display: block; position: fixed; inset: 0; z-index: 45;
			background: color-mix(in srgb, var(--secondary) 45%, transparent);
		}
		/* Taller sheet, looser stack. Nearly the full screen and a wider gap between
		   blocks — the stage, carousel, copy and buy bar were reading as one dense slab. */
		.m-sheet-panel {
			position: absolute; left: 0; right: 0; bottom: 0;
			max-height: 98%; overflow-y: auto; overscroll-behavior: contain;
			display: flex; flex-direction: column; gap: 20px;
			padding: 0 18px 30px;
			background: var(--primary);
			border-top: var(--stroke) solid var(--secondary);
			border-radius: 18px 18px 0 0;
		}
		/* The panel is a flex column with a max-height, so every block in it was a
		   shrinkable flex item: on a short window — a phone with the browser's URL bar and
		   toolbar both showing — the stage was squashed to fit instead of the panel
		   scrolling. Measured at 369x555: the 4/3 stage came out 333x40, an 8.24:1 slot
		   with the shirt cropped to a strip. flex:none makes them keep their size and lets
		   overflow-y do its job. */
		.m-sheet-panel > * { flex: none; }
		.m-sheet-bar {
			position: sticky; top: 0; z-index: 1;
			display: flex; align-items: center; justify-content: space-between;
			padding: 12px 0 10px; background: var(--primary);
		}
		.m-grab { width: 42px; height: 4px; border-radius: 999px; background: var(--hair); }

		/* A framed stage, like the admin preview's — the picture sits in a bordered box
		   rather than floating loose above the copy. */
		.m-stage {
			display: grid; place-items: center; overflow: hidden;
			aspect-ratio: 3 / 4;
			background: var(--sink);
			border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		}
		.m-stage-icon { display: grid; place-items: center; width: 100%; height: 100%; }
		.m-stage-icon > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
		.m-stage-icon .big { width: 100%; height: 100%; }
		.m-stage-icon svg { width: clamp(96px, 34vw, 150px); height: auto; stroke-width: 1.1; }

		/* Pulled back up against the stage: it captions the picture, so it belongs with
		   it rather than floating a full gap away from everything. */
		.m-stage-label {
			margin: -11px 0 0;
			font-family: 'DM Mono', ui-monospace, monospace;
			font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
		}

		.m-viewport { overflow-x: auto; scrollbar-width: none; margin: 0 -18px; padding: 0 18px; }
		.m-viewport::-webkit-scrollbar { display: none; }
		.m-views { display: flex; gap: 9px; width: max-content; padding: 3px; }
		/* flex:none — .vbox is `flex: 1 1 auto` for the desktop carousel and would stretch here.
		   Landscape and photo-filled, matching the admin preview's frames. */
		.m-views .vbox {
			flex: none; width: 108px; height: 76px;
			min-width: 0; max-width: none; gap: 0; padding: 0;
		}
		.m-views .vicon svg { width: 24px; height: 24px; }
		.m-views .vlabel { font-size: 8px; padding: 2px 6px; }
		.m-views .vnum { font-size: 8px; }

		/* ---- pager, mirroring the desktop stage ---- */
		.m-pager { display: flex; align-items: center; gap: 10px; }
		.m-parrow { display: grid; place-items: center; width: 30px; height: 30px; padding: 0; flex: none; }
		.m-parrow svg { width: 14px; height: 14px; stroke-width: 2.2; }
		.m-parrow:disabled { opacity: .3; cursor: not-allowed; }
		.m-pcount {
			flex: none;
			font-family: 'DM Mono', ui-monospace, monospace;
			font-size: 9.5px; font-weight: 400; letter-spacing: .1em; color: var(--ink-40);
		}
		.m-pcur { color: var(--secondary); }
		.m-pslider { flex: 1; min-width: 40px; }

		.m-name {
			margin: 4px 0 0;
			font-family: 'Archivo Expanded', 'Archivo', sans-serif;
			font-weight: 900; font-size: 25px; line-height: 1; text-transform: uppercase;
		}
		.m-desc { margin: 0; font-style: italic; font-size: 13px; line-height: 1.6; color: var(--ink-60); }
		/* Hangs right, as on the desktop stage and the admin preview — this used to
		   override .designer's own align-self and pin it left. */
		.m-designer { align-self: flex-end; }
		.m-opt { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; }
		.m-sheet .buy { margin-top: 4px; }

		/* the drawer is full-width on a phone */
		.drawer { width: 100%; max-width: none; }
	}

	/* ============ SHOP CLOSED ============
	   Deliberately quiet: one card on the page's own dot matrix. A closed shop should
	   read as "not yet", not as an error, so it borrows the site's furniture — the
	   accent tick from .crumb, the cross-rule from .divider — rather than inventing a
	   look of its own. */
	.soon {
		flex: 1; min-height: 0;
		display: grid; place-items: center;
		padding: clamp(24px, 5vw, 60px);
		background-image: radial-gradient(circle at center, var(--dot) 1.2px, transparent 1.4px);
		background-size: 22px 22px;
	}
	.soon-card {
		width: min(560px, 100%);
		display: flex; flex-direction: column; align-items: center; text-align: center;
		padding: clamp(28px, 4.5vw, 46px) clamp(22px, 4vw, 44px);
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		box-shadow: var(--pop-lg);
	}
	.soon-kick {
		display: flex; align-items: center; gap: 11px; margin: 0 0 18px;
		font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase;
		color: var(--ink-40);
	}
	.soon-tick { flex: none; width: 16px; height: 1.5px; background: var(--accent); }
	.soon-title {
		margin: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(38px, 7vw, 68px);
		line-height: .9; letter-spacing: -0.02em; text-transform: uppercase;
		/* Same guard as .title: a long word in a display face outgrows its box and
		   would run straight out of the card. */
		overflow-wrap: anywhere;
	}
	.soon-text {
		margin: 18px 0 0; max-width: 46ch;
		font-style: italic; font-size: 14px; line-height: 1.62; color: var(--ink-60);
		text-wrap: pretty;
