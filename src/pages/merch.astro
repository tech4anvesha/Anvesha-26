		// NEXT, not PAY: nothing is charged here, and nothing is stored either. The
		// details are only checked, by the server that owns the rules for them, so a
		// mistyped email is caught here rather than after the student has paid. They
		// travel for real with the submission in step 3.
		payForm.onsubmit = async (e) => {
			e.preventDefault();
			if (!currentOrder) return;

			payBtn.disabled = true;
			payErr.hidden = true;

			try {
				const res = await fetch(`${API}/api/orders/${encodeURIComponent(currentOrder)}/customer`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						name: fName.value,
						roll_number: fRoll.value,
						phone: fPhone.value,
						email: fEmail.value,
