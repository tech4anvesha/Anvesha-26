---
import SiteLayout from '../layouts/SiteLayout.astro';
// The catalogue rail, shared with the admin panel so both browse the same component.
import '../styles/catalogue-tree.css';
// TRIAL: the index skin for the rail. Scoped to `.tree-index` — delete this line
// and the class on #tree below to go back to the tree, nothing else is involved.
import '../styles/catalogue-index.css';
// .tk-eyebrow / .tk-id are borrowed by the pay and received faces.
import '../styles/ticket.css';
// The QR + reference + screenshot block, shared with /order's resubmit form.
import '../styles/paystep.css';
import chevronLeft from 'lucide-static/icons/chevron-left.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import shoppingCart from 'lucide-static/icons/shopping-cart.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';
import iArrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import iBagEmpty from 'lucide-static/icons/shopping-basket.svg?raw';
// Placeholder for the processing state — swap for real artwork when there is some.
import iProcessing from 'lucide-static/icons/circle-help.svg?raw';
import iDownload from 'lucide-static/icons/download.svg?raw';
import iCopy from 'lucide-static/icons/copy.svg?raw';

// Where the money goes. Printed under the QR so a student whose camera will not focus
// can still pay by typing it — and so the amount and the payee are checkable against
// what their UPI app shows before they confirm.
const UPI_ID = 'sbibhim.022211900804305-ym662729@sbipay';
---

<SiteLayout
	title="Merch · Anvesha '26"
	description="Official Anvesha '26 merchandise — tees, hoodies and more from the IISER Thiruvananthapuram science fest."
>
	<button slot="tools" id="cartToggle" class="btn bagbtn" aria-label="Open bag">
		<span class="bagicon" set:html={shoppingCart}></span>
		<span class="bagword">BAG</span>
		<b id="cartCount">0</b>
	</button>

	<main class="hero scroll-y">
				<!-- ============ LEFT: items in selected type + product info ============ -->
				<section class="col-left">
					<div class="crumb" data-reveal>
						<span class="crumb-tick" aria-hidden="true"></span>
						<span class="crumb-label">Catalog</span>
						<span class="crumb-rule" aria-hidden="true"></span>
						<span class="crumb-count"><b id="crumbCount">0</b> items</span>
					</div>

					<div id="tree" class="tree tree-index" data-reveal role="tree" aria-label="Merch catalogue"></div>
					<div class="divider" data-reveal aria-hidden="true">
						<span class="dv-line"></span>
						<span class="dv-cross"></span>
						<span class="dv-line"></span>
					</div>

					<div class="product" data-reveal>
						<div class="copy">
							<h1 id="pName" class="title">SELECT<br />AN ITEM</h1>
							<p id="pDesc" class="desc"></p>
							<p id="pDesigner" class="designer"></p>
						</div>

						<div id="opt" class="opt">
							<p class="opt-head">
								<span class="opt-word">Sizes:</span>
								<button id="sizeBtn" class="opt-label" type="button" aria-haspopup="dialog">
									Click here to view size chart
								</button>
							</p>
							<div id="sizes" class="sizes"></div>
						</div>

						<button id="addBtn" class="btn buy" disabled>
							<!-- ponytail: drawn, not the ↗ glyph — that falls back to a hairline symbol font -->
							<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M6 18 L18 6 M8.5 6 H18 V15.5" />
							</svg>
							<span class="buy-label">ADD TO BAG</span>
							<span class="buy-dot" aria-hidden="true"></span>
							<b id="pPrice" class="buy-price">—</b>
						</button>
					</div>
				</section>

				<!-- ============ CENTER: magnified view + view carousel ============ -->
				<section class="col-stage">
					<div class="stage-frame" data-reveal>
						<!-- camera viewfinder furniture: decorative only, hidden from AT -->
						<div class="viewfinder" aria-hidden="true">
							<span class="vf-c tl"></span><span class="vf-c tr"></span>
							<span class="vf-c bl"></span><span class="vf-c br"></span>
							<span class="vf-grid"></span>
							<span class="vf-hud hud-tl"><i class="vf-rec"></i>REC</span>
							<span class="vf-hud hud-tr">ANV·26</span>
							<span class="vf-hud hud-bl">f/2.8 · 1/125 · ISO400</span>
							<span class="vf-hud hud-br" id="vfFrame">FRM 00/00</span>
						</div>
						<div id="stageView" class="stage-view" aria-live="polite"></div>
					</div>
					<span id="stageLabel" class="stage-label" data-reveal></span>

					<div class="carousel" data-reveal>
						<button id="prevView" class="btn cbtn" aria-label="Previous view" set:html={chevronLeft}></button>
						<div id="viewport" class="cviewport">
							<div id="viewList" class="ctrack" role="tablist" aria-label="Product views"></div>
						</div>
						<button id="nextView" class="btn cbtn" aria-label="Next view" set:html={chevronRight}></button>
					</div>

					<div class="pager" data-reveal>
						<span id="pgCur">00</span>
						<input
							id="pgSlider" class="pgslider" type="range"
							min="1" max="1" step="1" value="1" aria-label="Jump to view"
						/>
						<span id="pgTot">00</span>
					</div>
				</section>
	</main>

	<!-- ============ MOBILE: category tabs -> product grid ============ -->
	<div class="m-shop scroll-y">
		<div class="m-cats" id="mCats" role="tablist" aria-label="Merch categories"></div>
		<div class="m-grid" id="mGrid"></div>
	</div>

	<!-- ============ SHOP CLOSED ============
	     Shown instead of everything above when the release switch is off. Hidden by
	     default rather than shown-then-hidden: the shop is open far more often than it
	     is shut, and a closed panel flashing on every load would be worse than the one
	     frame of empty catalogue it saves. -->
	<section class="soon scroll-y" id="soon" hidden>
		<div class="soon-card">
			<p class="soon-kick mono">
				<span class="soon-tick" aria-hidden="true"></span>Anvesha &rsquo;26 &middot; Merch
			</p>
			<h1 class="soon-title">DROPPING<br />SOON</h1>
			<p class="soon-text">
				The store is being stitched together. Tees, stickers and the rest of it go on
				sale here shortly &mdash; check back, or watch our socials for the drop.
			</p>
			<div class="soon-rule" aria-hidden="true">
				<span></span><b></b><span></span>
			</div>
			<p class="soon-meta mono">Bag stays where you left it</p>
		</div>
	</section>

	<Fragment slot="overlays">
		<!-- ============ CART DRAWER ============ -->
<aside id="cart" class="drawer" aria-label="Your bag" aria-hidden="true">
	<div class="drawer-head">
		<span class="drawer-title">YOUR BAG <i id="cartCount2">0</i></span>
		<button id="cartClose" class="btn x" aria-label="Close bag" set:html={iX}></button>
	</div>

	<ul id="cartItems" class="cart-items scroll-y"></ul>

	<div id="cartEmpty" class="empty">
		<span class="empty-mark" set:html={iBagEmpty} />
		<p>Bag's empty.<br />Go pick something good.</p>
	</div>

	<div class="drawer-foot">
		<div class="row"><span>Total</span><span id="cartTotal">₹0</span></div>
		<p class="order-err" id="orderErr" hidden></p>
		<!-- Shown while the shop is browse-only. Above the button, not in place of it:
		     a disabled CHECKOUT with no reason next to it reads as broken. -->
		<p class="bag-lookup mono">
			Already ordered? <a href="/order">Check its status</a>
		</p>
		<p class="sales-soon mono" id="salesSoon" hidden>
			<span class="sales-soon-dot" aria-hidden="true"></span>Merch sales going live soon
		</p>
		<button id="checkout" class="btn checkout" disabled>
			<span>CHECKOUT</span><span class="chk-arrow" set:html={iArrowRight} />
		</button>
	</div>
</aside>
<!-- ============ SIZE CHART ============ -->
<div id="sizeModal" class="modal-wrap" aria-hidden="true">
	<div class="modal" role="dialog" aria-modal="true" aria-labelledby="sizeTitle">
		<div class="modal-head">
			<span id="sizeTitle" class="modal-title">SIZE CHART</span>
			<button id="sizeClose" class="btn x" aria-label="Close size chart" set:html={iX}></button>
		</div>
		{/* Half-chest is the measurement that is actually taken — the garment laid flat,
		    seam to seam. Chest is twice it, listed because that is the number people know
		    their own body by. */}
		<table class="sizetable">
			<thead>
				<tr><th>Size</th><th>Half-chest</th><th>Chest</th><th>Length</th></tr>
			</thead>
			<tbody>
				<tr data-size="XS"><td>XS</td><td>17&Prime;</td><td>34&Prime;</td><td>25&Prime;</td></tr>
				<tr data-size="S"><td>S</td><td>18&Prime;</td><td>36&Prime;</td><td>26&Prime;</td></tr>
				<tr data-size="M"><td>M</td><td>19&Prime;</td><td>38&Prime;</td><td>27&Prime;</td></tr>
				<tr data-size="L"><td>L</td><td>20&Prime;</td><td>40&Prime;</td><td>28&Prime;</td></tr>
				<tr data-size="XL"><td>XL</td><td>21&Prime;</td><td>42&Prime;</td><td>29&Prime;</td></tr>
				<tr data-size="2XL"><td>2XL</td><td>22&Prime;</td><td>44&Prime;</td><td>30&Prime;</td></tr>
				<tr data-size="3XL"><td>3XL</td><td>23&Prime;</td><td>46&Prime;</td><td>31&Prime;</td></tr>
			</tbody>
		</table>
		<p class="modal-note">All measurements in inches, garment laid flat. Sizes may vary by &plusmn;0.5&Prime;. Between sizes? Take the larger.</p>
	</div>
</div>
<!-- ============ CHECKOUT POPUP ============ -->
<!-- Same chassis as the size chart so the shop only ever has one kind of popup.
     Two faces: details -> paid. The bag stays behind it, untouched. -->
<div id="payModal" class="modal-wrap" aria-hidden="true">
	<div class="modal paymodal" role="dialog" aria-modal="true" aria-labelledby="payTitle">
		<div class="modal-head">
			<span id="payTitle" class="modal-title">CHECKOUT</span>
			<button id="payClose" class="btn x" aria-label="Close checkout" set:html={iX}></button>
		</div>

		<!-- FACE 1: who is buying -->
		<!-- No `novalidate`: the required/pattern attributes below ARE the frontend lock.
		     The browser refuses to fire submit until name, phone and email are filled and
		     well-formed, and points at the offending field itself. -->
		<form id="payForm" class="pay-form">
			<ul class="order-items" id="orderItems"></ul>
			<div class="order-row"><span>Total</span><b id="orderTotal">₹0</b></div>

			<label class="field">
				<span class="field-label">Full name</span>
				<input class="field-input" id="fName" name="name" type="text" autocomplete="name"
				       maxlength="80" required />
			</label>
			<label class="field">
				<span class="field-label">Roll number</span>
				{/* No pattern: IMS is not the only roll scheme on campus, and the
				    @iisertvm.ac.in email is what decides who may buy. Typing is uppercased
				    on the way in, so the box shows the same form the server stores. */}
				<input class="field-input roll-input" id="fRoll" name="roll_number" type="text"
				       autocomplete="off" spellcheck="false" maxlength="20" placeholder="IMS24101"
				       required />
			</label>
			<label class="field">
				<span class="field-label">Phone</span>
				<input class="field-input" id="fPhone" name="phone" type="tel" inputmode="numeric"
				       autocomplete="tel" placeholder="10-digit mobile" required />
			</label>
			<label class="field">
				<span class="field-label">College email</span>
				<input class="field-input" id="fEmail" name="email" type="email" autocomplete="email"
				       maxlength="120" placeholder="you@iisertvm.ac.in"
				       pattern="[^\s@]+@iisertvm\.ac\.in" title="Must be an @iisertvm.ac.in address" required />
			</label>

			<p class="pay-err" id="payErr" hidden></p>
			<!-- NEXT, not PAY: this step charges nothing. It only puts a name to the
			     order before the student goes to their UPI app. -->
			<button class="btn paybtn" id="payBtn" type="submit">
				<span>NEXT</span><span class="buy-dot" aria-hidden="true"></span><b id="payAmount">₹0</b>
			</button>
		</form>

		<!-- FACE 2: pay — the QR to scan, then the evidence that it worked. No money
		     moves through this site; the student pays in their own banking app and
		     comes back with a reference and a screenshot. -->
		<form id="payStepForm" class="pay-step" hidden>
			<div class="pay-card">
				<p class="upi-step mono"><b>1</b> Pay in your UPI app</p>

				<div class="upi-main">
					{/* Drawn per order, so scanning it fills in the amount and a note
					    naming the order — the student confirms rather than types, and the
					    transaction lands on our statement already labelled.
					    The static image underneath is the fallback: it carries no amount,
					    but a QR that still works beats none if the canvas draw fails. */}
					<div class="upi-qr" id="upiQrBox">
						<img src="/img/pay/upi-qr.png" alt="UPI payment QR code for Anvesha '26"
						     width="200" height="200" />
						<canvas id="upiQr" class="upi-qr-live" width="220" height="220"
						        aria-label="UPI payment QR code with the amount filled in"></canvas>
					</div>
					<div class="upi-side">
						<p class="tk-eyebrow">Amount</p>
						<b class="upi-amount" id="upiAmount">₹0</b>
						<p class="tk-eyebrow upi-vpa-label">UPI ID</p>
						<button class="upi-vpa mono" id="upiVpa" type="button"
						        title="Copy this UPI ID">
							<span>{UPI_ID}</span>
							<i class="upi-copy" aria-hidden="true" set:html={iCopy} />
						</button>
					</div>
				</div>

				{/* An anchor, whose href the script swaps for a blob of the live canvas —
				    so what gets saved is the QR carrying this order's amount, not the
				    generic one. iOS Safari ignores `download` and opens the image in a tab
				    instead, which still works: the student long-presses to save. */}
				<a class="btn upi-dl" id="upiDl" href="/img/pay/upi-qr.png"
				   download="anvesha-upi-qr.png">
					<span set:html={iDownload} />SAVE QR
				</a>
				<p class="upi-hint">If you have already paid previously, please resubmit the details following the instructions given again.</p>
			</div>

			<div class="pay-card">
				<p class="upi-step mono"><b>2</b> Then tell us about it</p>

				<label class="field">
					<span class="field-label">Transaction / UTR reference</span>
					<input class="field-input mono" id="fTxn" name="payment_ref" type="text"
					       autocomplete="off" spellcheck="false" minlength="4" maxlength="64"
					       placeholder="from your UPI app" required />
				</label>

				<label class="field">
					<span class="field-label">Payment screenshot</span>
				<!-- The input is the whole box: a label wrapping a hidden file input is
				     the one way to restyle a file picker without a click shim. -->
					<span class="proof" id="proofBox">
						<input id="fProof" name="proof" type="file"
						       accept="image/jpeg,image/png,image/webp" required />
						<img class="proof-img" id="proofImg" alt="" />
						<span class="proof-hint">
							<b>Tap to attach</b>
						<span>a screenshot showing the payment succeeded with <strong>the transaction id visible clearly</strong>: Screenshots without visible transaction id will not be accepted</span>
						</span>
						<span class="proof-name mono" id="proofName"></span>
					</span>
				</label>
			</div>

			<p class="pay-err" id="payErr2" hidden></p>
			<button class="btn paybtn" id="submitBtn" type="submit">
				<span>SUBMIT PAYMENT</span>
			</button>
			<button class="btn orderback" id="payBack" type="button">BACK</button>
		</form>

		<!-- FACE 2: settling — replaces the form so the details cannot be edited mid-flight -->
		<div id="processing" class="processing" hidden>
			<span class="proc-icon" set:html={iProcessing} />
			<p class="proc-label">Sending your payment details</p>
			<div id="payProgress" class="pay-progress" role="progressbar"
			     aria-label="Payment progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
				{Array.from({ length: 14 }).map(() => <span class="seg" />)}
			</div>
		</div>

		<!-- FACE 4: received — deliberately NOT a pass. Nobody has checked this
		     payment yet, and handing over a collection QR now would make the whole
		     review pointless. -->
		<div id="received" class="pay-step" hidden>
			<div class="recv">
				<span class="recv-mark" aria-hidden="true"></span>
				<h3 class="recv-title">Order received</h3>
				<p class="recv-text">
					Thanks<span id="recvName"></span> — we've got your payment details. Someone
					checks them against our statement, usually within a day, and your collection
					pass lands in your inbox the moment it's confirmed.
				</p>
			</div>

			<div class="recv-id">
				<p class="tk-eyebrow">Order no.</p>
				<p class="tk-id" id="recvId">ORD_</p>
			</div>

			<p class="order-note">
				Lost the email? Look it up at <a href="/order">anvesha26.in/order</a> with your
				roll number and mobile.
			</p>
			<button class="btn orderback" id="recvDone">DONE</button>
		</div>
	</div>
</div>
<!-- ============ MOBILE: product sheet ============ -->
<div id="mSheet" class="m-sheet" aria-hidden="true">
	<div class="m-sheet-panel" role="dialog" aria-modal="true" aria-labelledby="mName">
		<div class="m-sheet-bar">
			<span class="m-grab" aria-hidden="true"></span>
			<button id="mSheetClose" class="btn x" aria-label="Close" set:html={iX}></button>
		</div>

		<div class="m-stage"><div id="mStage" class="m-stage-icon"></div></div>
		<p id="mStageLabel" class="m-stage-label">01 / FRONT</p>

		<div id="mViewport" class="m-viewport">
			<div id="mViews" class="m-views" role="tablist" aria-label="Product views"></div>
		</div>

		<!-- Same pager as the desktop stage: arrows that wrap, a scrub slider, and the
		     frame counter split across the track. -->
		<div class="m-pager">
			<button id="mPrev" class="btn m-parrow" type="button"
			        aria-label="Previous view" set:html={chevronLeft}></button>
			<b class="m-pcount m-pcur" id="mCur">01</b>
			<input id="mSlider" class="pgslider m-pslider" type="range" min="1" max="1" value="1"
			       aria-label="View" />
			<span class="m-pcount" id="mTot">01</span>
			<button id="mNext" class="btn m-parrow" type="button"
			        aria-label="Next view" set:html={chevronRight}></button>
		</div>

		<h2 id="mName" class="m-name"></h2>
		<p id="mDesc" class="m-desc"></p>
		<p id="mDesigner" class="designer m-designer"></p>

		<div id="mOpt" class="m-opt">
			<p class="opt-head">
				<span class="opt-word">Sizes:</span>
				<button id="mSizeBtn" class="opt-label" type="button" aria-haspopup="dialog">
					Click here to view size chart
				</button>
			</p>
			<div id="mSizes" class="sizes"></div>
		</div>

		<button id="mAdd" class="btn buy">
			<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 L18 6 M8.5 6 H18 V15.5" /></svg>
			<span class="buy-label">ADD TO BAG</span>
			<span class="buy-dot" aria-hidden="true"></span>
			<b id="mPrice" class="buy-price">—</b>
		</button>
	</div>
</div>
<div id="scrim" class="scrim"></div>
	</Fragment>
</SiteLayout>

<script>
	import { gsap } from 'gsap';
		// Shared with the admin panel: one socket helper, one reconnect policy.
	import { API } from '../lib/api';
	import { onCatalogueChange } from '../lib/admin';
	import { drawQR } from '../lib/ticket';

	// lucide-static ships each icon as a standalone SVG; ?raw hands us the markup to inject.
	import caretRight from 'lucide-static/icons/chevron-right.svg?raw';
	import iMinus from 'lucide-static/icons/minus.svg?raw';
	import iPlus from 'lucide-static/icons/plus.svg?raw';
	// Category fallbacks. No images are in R2 yet, and an item may never get one —
	// these draw instead of a broken-image box. See artHTML().
	import icApparel from 'lucide-static/icons/shirt.svg?raw';
	import icAccessories from 'lucide-static/icons/shopping-bag.svg?raw';
	import icStationery from 'lucide-static/icons/notebook.svg?raw';
	import pkg from 'lucide-static/icons/package.svg?raw';

	// `url` is absent only for an item with no pictures at all, where the category icon
	// stands in — see artHTML().
	type View = { label: string; icon: string; url?: string };
	type Item = {
		id: string; name: string; desc: string; designer: string;
		price_paise: number; has_size: boolean; image_url: string;
		icon: string; views: View[];
	};
	type Cat = { id: string; name: string; items: Item[] };

	/** Shape returned by GET /api/merch. */
	type ApiMerch = {
		id: string; name: string; description: string; designer: string;
		category: string; price_paise: number; has_size: boolean; image_url: string;
		views?: { label: string; url: string }[];
	};

	const SIZES = ['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL'];

	const CATEGORY_ICON: Record<string, string> = {
		apparel: icApparel, accessories: icAccessories, stationery: icStationery,
	};

	// ponytail: the catalogue is now server state, so it starts empty and is filled by
	// loadCatalog(). Everything downstream already read from this array, so nothing else
	// had to change shape.
	let catalog: Cat[] = [];

	/** Money lives in paise end to end; rupees exist only for display. */
	const rupees = (paise: number) =>
		'₹' + (paise % 100 === 0 ? String(paise / 100) : (paise / 100).toFixed(2));

	/**
	 * @param bypassCache  Skip every cache between here and D1.
	 *
	 * /api/merch is served `max-age=60` and is held BOTH in the browser's HTTP cache and
	 * at the Cloudflare edge — and the Worker's edge purge only reaches the colo that ran
	 * the admin's request, not the one serving the shopper. So a live event saying "this
	 * changed" followed by a plain refetch reads back the very copy the event just said
	 * was stale, and the change does not land until that minute expires. The unique `t`
	 * misses both caches (it is part of the cache key), and `no-store` stops the answer
	 * being kept either. Only for event-driven refetches: doing it on first load would
	 * throw the edge cache away for every visitor.
	 */
	async function loadCatalog(bypassCache = false): Promise<{ released: boolean; salesOpen: boolean; cats: Cat[] }> {
		const url = API + '/api/merch' + (bypassCache ? `?t=${Date.now()}` : '');
		const res = await fetch(url, bypassCache ? { cache: 'no-store' } : undefined);
		if (!res.ok) throw new Error('Catalogue request failed: ' + res.status);
		const { merch, released, sales_open } =
			(await res.json()) as { merch: ApiMerch[]; released?: boolean; sales_open?: boolean };
		// Absent means an API older than the switch, which is open by definition —
		// matching the worker's own default, so the two cannot disagree.
		const open = released !== false;
		// Same reasoning for sales: an API that predates the flag could always sell.
		const selling = sales_open !== false;

		// Group into the tree's category buckets, preserving the order the API sent.
		const byCat = new Map<string, Cat>();
		for (const m of merch) {
			const key = m.category.toLowerCase();
			if (!byCat.has(key)) byCat.set(key, { id: key, name: m.category, items: [] });
			byCat.get(key)!.items.push({
				id: m.id,
				name: m.name,
				desc: m.description,
				designer: m.designer,
				price_paise: m.price_paise,
				has_size: m.has_size,
				image_url: m.image_url,
				icon: CATEGORY_ICON[key] ?? pkg,
				// One view per stored image, primary first. The category icon rides along
				// on each so a view whose file is missing from R2 still draws something.
				views: (m.views?.length ? m.views : [{ label: 'Front', url: m.image_url }]).map((v) => ({
					label: v.label,
					url: v.url,
					icon: CATEGORY_ICON[key] ?? pkg,
				})),
			});
		}
		return { released: open, salesOpen: selling, cats: [...byCat.values()] };
	}

	/**
	 * Image with an icon underneath it. The <img> stays hidden until it actually loads,
	 * so an item with no file in R2 shows its category icon rather than a broken box.
	 */
	function artHTML(it: Item, view = 0): string {
		const url = it.views[view]?.url ?? it.image_url;
		// NOT loading="lazy": .art-img starts at display:none and only becomes visible in
		// its onload. A lazy image with no layout box never intersects the viewport, so
		// the browser never fetches it, so onload never fires — the image would stay
		// hidden forever and every item would show its category icon instead.
		return `<img class="art-img" src="${API}${url}" alt=""
		             onload="this.classList.add('ok')" /><span class="art-icon">${it.icon}</span>`;
	}

	// ponytail: Astro-processed module scripts run ONCE per browser session. With the
	// client router that means a second visit to /merch would render markup with no
	// behaviour at all — dead tree, dead cart. Everything below re-runs on
	// astro:page-load against the freshly swapped DOM.
	let ac: AbortController | null = null;
	let inited: HTMLElement | null = null;

	async function initMerch() {
		const tree = document.getElementById('tree');
		// not the merch page, or this exact DOM is already wired
		if (!tree || tree === inited) return;
		inited = tree;
		ac?.abort();          // drop the previous visit's window-level listeners
		ac = new AbortController();
		const { signal } = ac;

		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const pad = (n: number) => String(n).padStart(2, '0');

		// ---- mobile elements (same state, second presentation) ----
		const mCats = $('mCats'), mGrid = $('mGrid');
		const mSheet = $('mSheet'), mSheetPanel = mSheet.querySelector('.m-sheet-panel') as HTMLElement;
		const mStage = $('mStage'), mViews = $('mViews'), mViewport = $('mViewport'), mSizes = $('mSizes');
		const mName = $('mName'), mDesc = $('mDesc'), mDesigner = $('mDesigner'), mPrice = $('mPrice');
		const mAdd = $<HTMLButtonElement>('mAdd'), mSizeBtn = $<HTMLButtonElement>('mSizeBtn');

		// ---- cart ----
		// ponytail: a line stores ONLY what the API accepts — {merch_id, quantity, size}.
		// No name, no price. Everything shown is looked up live from the catalogue, so a
		// stale cart cannot display a price the server would not honour, and an item
		// pulled from sale simply drops out instead of lingering as a phantom.
		type CartLine = { merch_id: string; quantity: number; size: string | null };

		const KEY = 'anvesha-cart';
		const cartKey = (merchId: string, sz: string | null) => merchId + '::' + (sz ?? '');
		const itemById = (id: string) => catalog.flatMap((c) => c.items).find((i) => i.id === id);

		let cart: Record<string, CartLine> = (() => {
			try {
				const raw = JSON.parse(localStorage.getItem(KEY) || '{}');
				// Drop anything that is not the current shape — an older cart from before
				// the API existed would otherwise poison every price on the page.
				return Object.fromEntries(
					Object.entries(raw as Record<string, CartLine>).filter(
						([, l]) => l && typeof l.merch_id === 'string' && Number.isInteger(l.quantity),
					),
				);
			} catch {
				return {};
			}
		})();
		const saveCart = () => localStorage.setItem(KEY, JSON.stringify(cart));

		// ---- state ----
		let catId = '';
		let item: Item | null = null;
		let viewIdx = 0;
		let size: string | null = null;

		// ---- catalogue tree ----
		const treeEl = $('tree'), crumbCount = $('crumbCount');
		let openCat: string | null = null; // accordion — one branch open at a time

		// ponytail: the catalogue is static, so the tree is built ONCE and every branch keeps
		// its rows in the DOM. Rebuilding on each toggle is what made collapsing impossible
		// to animate — the rows were gone before they could move.
		const folderOf = new Map<string, HTMLElement>();
		const kidsOf = new Map<string, HTMLElement>();

		function buildTree() {
			treeEl.innerHTML = '';
			crumbCount.textContent = String(catalog.reduce((n, c) => n + c.items.length, 0));

			catalog.forEach((c) => {
				const folder = document.createElement('button');
				folder.className = 'tnode tcat';
				folder.setAttribute('role', 'treeitem');
				folder.innerHTML =
					`<span class="tcaret">${caretRight}</span>` +
					`<span class="tname">${c.name}</span>` +
					`<span class="tmeta">${c.items.length} item${c.items.length === 1 ? '' : 's'}</span>`;
				folder.onclick = () => {
					const opening = openCat !== c.id;
					openCat = opening ? c.id : null;
					// Reveal the branch that just OPENED, not the selected product. The
					// product usually lives in a different category — the one that just
					// collapsed — so centring it after a folder click sent the list
					// somewhere unrelated to what was tapped.
					syncTree(true, opening ? 'cat' : null);
				};
				// A section box per category. The folder bar is sticky in the index skin,
				// and sticky is bounded by its containing block — as flat siblings every
				// bar pinned to the same offset and they stacked on top of each other.
				// Inside a section, each bar is pushed out by the next one, as intended.
				const sec = document.createElement('div');
				sec.className = 'tsec';
				treeEl.appendChild(sec);
				sec.appendChild(folder);
				folderOf.set(c.id, folder);

				const kids = document.createElement('div');
				kids.className = 'tkids';
				c.items.forEach((it, ii) => {
					const b = document.createElement('button');
					// .last stops the vertical stem at the elbow, closing the run
					b.className = 'tnode titem' + (ii === c.items.length - 1 ? ' last' : '');
					b.setAttribute('role', 'treeitem');
					b.innerHTML =
						`<i class="tnum">${pad(ii + 1)}</i>` +
						`<span class="tname">${it.name}</span>` +
						`<b class="tmeta tprice">${rupees(it.price_paise)}</b>`;
					b.onclick = () => selectItem(it);
					kids.appendChild(b);
				});
				sec.appendChild(kids);
				kidsOf.set(c.id, kids);
			});

			syncTree(false);
		}

		function setBranch(c: Cat, animate: boolean) {
			const open = openCat === c.id;
			const folder = folderOf.get(c.id)!, kids = kidsOf.get(c.id)!;
			const changed = kids.dataset.open !== String(open);
			kids.dataset.open = String(open);
			folder.classList.toggle('open', open);
			folder.setAttribute('aria-expanded', String(open));

			// a collapsed branch must leave the tab order, not just shrink out of sight
			if (open) kids.removeAttribute('inert');
			const settle = () => { if (!open) kids.setAttribute('inert', ''); };

			if (!animate || rm || !changed) {
				gsap.set(kids, { height: open ? 'auto' : 0 });
				settle();
				return;
			}
			gsap.to(kids, {
				height: open ? 'auto' : 0,
				duration: 0.34, ease: 'power2.inOut', overwrite: true, onComplete: settle,
			});
			// displacement only — a stalled tween must never leave a row invisible
			if (open) gsap.fromTo(kids.children,
				{ y: -7 },
				{ y: 0, stagger: 0.035, duration: 0.3, ease: 'power2.out', clearProps: 'transform' });
		}

		/** What the rail should bring into view once the branches have finished moving. */
		type Reveal = 'item' | 'cat' | null;

		function syncTree(animate = true, reveal: Reveal = 'item') {
			catalog.forEach((c) => {
				setBranch(c, animate);
				c.items.forEach((it, ii) => {
					const row = kidsOf.get(c.id)!.children[ii];
					const on = item?.id === it.id;
					row.classList.toggle('active', on);
					row.setAttribute('aria-selected', String(on));
				});
			});

			revealInTree(reveal, animate);
		}

		// ponytail: rect deltas, not offsetTop — offsetTop is measured from the nearest
		// positioned ancestor, which isn't the scroll container here, so the maths would
		// silently drift the moment anything above gains `position`.
		function scrollCentre(box: HTMLElement, el: HTMLElement, axis: 'top' | 'left') {
			const r = el.getBoundingClientRect(), b = box.getBoundingClientRect();
			const size = axis === 'top' ? 'height' : 'width';
			const delta = (r[axis] + r[size] / 2) - (b[axis] + b[size] / 2);
			box.scrollBy({ [axis]: delta, behavior: rm ? 'auto' : 'smooth' });
		}

		/**
		 * Bring a row into view WHILE the branches above it are still opening.
		 *
		 * setBranch tweens every branch's height for 340ms. The old code measured the
		 * target in the same tick it started those tweens, so the number it scrolled by
		 * described a layout that no longer existed a frame later: the opening branch
		 * still had height 0 and the closing ones still had their full height. Picking a
		 * category near the bottom meant every branch above it was about to collapse by
		 * several hundred px, which is exactly why the rail shot past to the end.
		 *
		 * So the target is re-read every frame and the scroll eases toward wherever it
		 * currently is. A moving target needs no prediction — only repeated measurement.
		 */
		let revealRaf = 0;

		function revealInTree(reveal: Reveal, animate: boolean) {
			if (!reveal) return;
			// The SECTION for a category, not the bar. The bar is sticky, and a stuck
			// element reports its pinned rect rather than its position in flow — measuring
			// it would say "already at the top" the moment it glued itself there, and the
			// rail would creep instead of landing.
			const el = reveal === 'cat'
				? (openCat ? folderOf.get(openCat)?.closest<HTMLElement>('.tsec') ?? null : null)
				: treeEl.querySelector<HTMLElement>('.titem.active');
			if (!el) return;

			// A category header goes near the TOP, so the rows that just appeared are what
			// fills the rail beneath it. A product centres, as it always did.
			const targetFor = () => {
				const r = el.getBoundingClientRect(), b = treeEl.getBoundingClientRect();
				const delta = reveal === 'cat'
					? r.top - b.top - 6
					: (r.top + r.height / 2) - (b.top + b.height / 2);
				const want = treeEl.scrollTop + delta;
				return Math.max(0, Math.min(want, treeEl.scrollHeight - treeEl.clientHeight));
			};

			cancelAnimationFrame(revealRaf);
			if (!animate || rm) { treeEl.scrollTop = targetFor(); return; }

			// Runs a little past the 340ms branch tween, then lands exactly.
			const until = performance.now() + 460;
			const step = () => {
				const t = targetFor();
				if (performance.now() >= until) { treeEl.scrollTop = t; return; }
				treeEl.scrollTop += (t - treeEl.scrollTop) * 0.2;
				revealRaf = requestAnimationFrame(step);
			};
			revealRaf = requestAnimationFrame(step);
		}

		// ---- selection ----
		const stageViewEl = $('stageView'), stageLabelEl = $('stageLabel');
		const pNameEl = $('pName'), pDescEl = $('pDesc'), pPriceEl = $('pPrice');
		const pDesignerEl = $('pDesigner');
		const addBtn = $<HTMLButtonElement>('addBtn'), sizesEl = $('sizes');
		const optEl = $('opt'), mOptEl = $('mOpt');

		function selectItem(it: Item) {
			item = it; viewIdx = 0;
			catId = catalog.find((c) => c.items.some((x) => x.id === it.id))!.id;
			openCat = catId; // selecting inside a closed branch opens it, closing the others
			size = it.has_size ? SIZES[0] : null;
			syncTree(); renderHero(); renderSizes(); renderViews();
			animateSelect();
		}

		function renderHero() {
			if (!item) return;
			const v = item.views[viewIdx];
			stageViewEl.innerHTML = `<span class="big art">${artHTML(item, viewIdx)}</span>`;
			stageLabelEl.textContent = `${pad(viewIdx + 1)} / ${v.label}`;
			// Wrapped on width, not on word count. The old rule put the LAST word on its own
			// line regardless of how much room was left, so "Reflection of Eden" became
			// "REFLECTION OF" + "EDEN" — and since REFLECTION OF is itself wider than the
			// column at 46px, the browser wrapped it again and stranded OF on a line alone.
			// Letting the text wrap normally is what "break when the width runs out" means.
			// textContent, not innerHTML: there is no markup to insert any more, and the
			// name comes from the admin catalogue.
			pNameEl.textContent = item.name;
			pDescEl.textContent = item.desc;
			pDesignerEl.innerHTML = `Design <b>${item.designer}</b>`;
			pPriceEl.textContent = rupees(item.price_paise);
			addBtn.disabled = false;
			// the size row only exists for items the catalogue says are sized
			optEl.hidden = !item.has_size;
			mOptEl.hidden = !item.has_size;

			// mirror into the mobile sheet — one state, two presentations
			mStage.innerHTML = `<span class="big art">${artHTML(item, viewIdx)}</span>`;
			mName.textContent = item.name;
			mDesc.textContent = item.desc;
			mDesigner.innerHTML = `Design <b>${item.designer}</b>`;
			mPrice.textContent = rupees(item.price_paise);
			// ponytail: scale only, never opacity — see animateSelect().
			// overwrite so dragging the slider restarts the pop instead of stacking tweens
			if (!rm) gsap.fromTo(stageViewEl.querySelector('.big'),
				{ scale: 0.92 },
				{ scale: 1, duration: 0.45, ease: 'back.out(1.4)', overwrite: 'auto', clearProps: 'transform' });
		}

		// ponytail: desktop and mobile are two views of ONE state. Rendering into both
		// hosts costs a loop; keeping two parallel state machines in sync would cost far
		// more, and would drift the moment either side changed.
		const sizeHosts = [sizesEl, mSizes];
		function renderSizes() {
			const list = item?.has_size ? SIZES : []; // has_size is the catalogue's call, not ours
			for (const host of sizeHosts) {
				host.innerHTML = '';
				for (const s of list) {
					const b = document.createElement('button');
					b.className = 'btn size' + (s === size ? ' active' : '');
					b.textContent = s;
					b.setAttribute('aria-pressed', String(s === size));
					b.onclick = () => { size = s; renderSizes(); };
					host.appendChild(b);
				}
			}
		}

		const viewListEl = $('viewList'), viewportEl = $('viewport');
		const pgCur = $('pgCur'), pgTot = $('pgTot'), pgSlider = $<HTMLInputElement>('pgSlider');
		const vfFrame = $('vfFrame');
		const prevBtn = $<HTMLButtonElement>('prevView'), nextBtn = $<HTMLButtonElement>('nextView');
		// The sheet's own pager. Both drive the one viewIdx, so they can never disagree.
		const mStageLabel = $('mStageLabel');
		const mCur = $('mCur'), mTot = $('mTot'), mSlider = $<HTMLInputElement>('mSlider');
		const mPrev = $<HTMLButtonElement>('mPrev'), mNext = $<HTMLButtonElement>('mNext');

		// full rebuild — only when the item changes
		const viewHosts = [
			{ track: viewListEl, box: viewportEl },
			{ track: mViews, box: mViewport },
		];
		function renderViews() {
			if (!item) return;
			for (const { track } of viewHosts) {
				track.innerHTML = '';
				item.views.forEach((v, i) => {
					const b = document.createElement('button');
					b.className = 'btn vbox';
					b.setAttribute('role', 'tab');
					// Same trick as the stage: the thumbnail only appears once it loads, so
					// a view with nothing in R2 shows the category icon instead of a break.
					b.innerHTML =
						`<span class="vicon art">` +
						(v.url
							? `<img class="art-img vthumb" src="${API}${v.url}" alt=""
							        onload="this.classList.add('ok')" />`
							: '') +
						`<span class="art-icon">${v.icon}</span></span>` +
						`<small class="vlabel">${v.label}</small><i class="vnum">${pad(i + 1)}</i>`;
					b.onclick = () => goView(i);
					track.appendChild(b);
				});
			}
			pgTot.textContent = pad(item.views.length);
			pgSlider.max = String(item.views.length);
			mTot.textContent = pad(item.views.length);
			mSlider.max = String(item.views.length);
			// arrows wrap, so they only go dead when there's nothing to move between
			const single = item.views.length < 2;
			prevBtn.disabled = nextBtn.disabled = pgSlider.disabled = single;
			mPrev.disabled = mNext.disabled = mSlider.disabled = single;
			syncViews();
		}

		// ponytail: a view change only re-marks the existing boxes. Rebuilding the strip on
		// every slider tick would thrash the DOM and restart the smooth scroll mid-drag.
		function syncViews() {
			for (const { track, box } of viewHosts) {
				Array.from(track.children).forEach((el, i) => {
					el.classList.toggle('active', i === viewIdx);
					el.setAttribute('aria-selected', String(i === viewIdx));
				});
				const el = track.children[viewIdx] as HTMLElement | undefined;
				if (el) scrollCentre(box, el, 'left');
			}
			pgCur.textContent = pad(viewIdx + 1);
			pgSlider.value = String(viewIdx + 1);
			vfFrame.textContent = `FRM ${pad(viewIdx + 1)}/${pad(item!.views.length)}`;

			mCur.textContent = pad(viewIdx + 1);
			mSlider.value = String(viewIdx + 1);
			mStageLabel.textContent = `${pad(viewIdx + 1)} / ${item!.views[viewIdx]?.label ?? 'FRONT'}`;
		}

		function goView(i: number) {
			if (!item) return;
			const n = item.views.length;
			viewIdx = ((i % n) + n) % n; // wrap both directions
			renderHero(); syncViews();
		}

		prevBtn.onclick = () => goView(viewIdx - 1);
		nextBtn.onclick = () => goView(viewIdx + 1);
		pgSlider.oninput = () => goView(Number(pgSlider.value) - 1);
		mPrev.onclick = () => goView(viewIdx - 1);
		mNext.onclick = () => goView(viewIdx + 1);
		mSlider.oninput = () => goView(Number(mSlider.value) - 1);

		// arrow keys drive the carousel while focus is inside it
		viewListEl.addEventListener('keydown', (e) => {
			if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
			e.preventDefault();
			goView(viewIdx + (e.key === 'ArrowRight' ? 1 : -1));
			(viewListEl.children[viewIdx] as HTMLElement)?.focus();
		});

		// ---- GSAP reveal ----
		// ponytail: displacement only — never animate opacity here, and always fromTo + clearProps.
		// gsap.from() paints the START state immediately and only reaches the end state if the
		// tween actually runs; a stalled ticker (backgrounded tab, throttled rAF) left the title
		// grey and the whole buy block at opacity 0 — the buy button vanished. Worst case now is
		// an element sitting a few px off its mark, still fully visible and clickable.
		function animateSelect() {
			if (rm) return;
			const active = treeEl.querySelector('.titem.active');
			const tl = gsap.timeline();
			const slide = { duration: 0.4, ease: 'power3.out', clearProps: 'transform' };
			if (active) tl.fromTo(active, { x: -12 }, { x: 0, ...slide }, 0);
			tl.fromTo([pNameEl, pDescEl, pDesignerEl], { y: 18 }, { y: 0, stagger: 0.05, ...slide }, 0.05)
				.fromTo(sizesEl.children, { y: 8 }, { y: 0, stagger: 0.04, ...slide }, '-=0.2')
				.fromTo(addBtn, { y: 12 }, { y: 0, ...slide }, '-=0.2')
				.fromTo(viewListEl.children, { x: 16 }, { x: 0, stagger: 0.06, ...slide }, '-=0.3');
		}

		/**
		 * Throws a chip of the product from the add button up to the bag.
		 *
		 * Pure decoration: it draws itself on <body>, cleans up after itself and never
		 * touches cart state, so a thrown error here cannot cost anyone their order. One
		 * function for both views — #cartToggle is the target in each, it just sits in a
		 * different corner. Fixed positioning because the sheet closes underneath it on
		 * a phone and an absolutely positioned chip would go with it.
		 */
		function flyToBag(from: HTMLElement) {
			if (rm || !item) return;
			const a = from.getBoundingClientRect();
			const b = $('cartToggle').getBoundingClientRect();
			const S = 56;

			const chip = document.createElement('div');
			chip.className = 'fly';
			chip.setAttribute('aria-hidden', 'true');
			if (item.image_url) chip.innerHTML = `<img src="${API}${item.image_url}" alt="" />`;
			document.body.appendChild(chip);

			gsap.set(chip, {
				x: a.left + a.width / 2 - S / 2,
				y: a.top + a.height / 2 - S / 2,
				scale: 0.55, opacity: 0,
			});
			// x and y are tweened separately with different eases — that difference IS the
			// arc. One tween to the corner would draw a straight diagonal.
			gsap.timeline({ onComplete: () => chip.remove() })
				.to(chip, { opacity: 1, scale: 1, duration: 0.16, ease: 'power2.out' }, 0)
				.to(chip, { x: b.left + b.width / 2 - S / 2, duration: 0.6, ease: 'power1.inOut' }, 0)
				.to(chip, { y: b.top + b.height / 2 - S / 2, duration: 0.6, ease: 'power2.in' }, 0)
				.to(chip, { scale: 0.2, opacity: 0, duration: 0.2, ease: 'power2.in' }, 0.42);
		}

		function addToBag(from: HTMLElement) {
			if (!item) return;
			const key = cartKey(item.id, size);
			cart[key] ??= { merch_id: item.id, quantity: 0, size };
			cart[key].quantity++;
			// Adding an item only bumps the counter — it does not yank the shopper into
			// the bag. They open it deliberately, via the bag button, when ready.
			saveCart(); renderCart();
			flyToBag(from);
			// Delayed to land with the chip: the counter jumping before anything has
			// visibly arrived reads as two unrelated events rather than one.
			if (!rm) gsap.fromTo('#cartCount, #cartCount2',
				{ scale: 1.8 }, { scale: 1, duration: 0.45, delay: 0.5, ease: 'back.out(3)' });
		}
		addBtn.onclick = () => addToBag(addBtn);
		mAdd.onclick = () => { addToBag(mAdd); openSheet(false); };

		// ---- cart drawer ----
		const cartEl = $('cart'), scrim = $('scrim');
		const cartItemsEl = $('cartItems'), cartEmptyEl = $('cartEmpty');
		const cartTotalEl = $('cartTotal'), cartCountEl = $('cartCount'), cartCount2El = $('cartCount2');
		const checkoutEl = $<HTMLButtonElement>('checkout'), orderErr = $('orderErr');
		const salesSoonEl = $('salesSoon');
		// Whether money can be taken right now — read off the catalogue response, so the
		// button and the server's checkout gate are fed by one answer. Assumed open until
		// the first load says otherwise, so the notice never flashes on a working shop.
		let salesOpen = true;
		gsap.set(cartEl, { xPercent: 100, visibility: 'visible' });
		gsap.set(scrim, { autoAlpha: 0 });

		function renderCart() {
			cartItemsEl.innerHTML = '';
			let total = 0, count = 0;
			// A line whose item has vanished from the catalogue is dropped, not drawn.
			for (const [key, line] of Object.entries(cart)) {
				const it = itemById(line.merch_id);
				if (!it) { delete cart[key]; continue; }

				const lineTotal = it.price_paise * line.quantity;
				total += lineTotal; count += line.quantity;

				const li = document.createElement('li');
				li.innerHTML = `
					<span class="cmeta">
						<span class="cn">${it.name}${line.size ? ' · ' + line.size : ''}</span>
					</span>
					<span class="cq">
						<button class="btn" data-act="dec" data-id="${key}" aria-label="Decrease quantity">${iMinus}</button>
						<b>${line.quantity}</b>
						<button class="btn" data-act="inc" data-id="${key}" aria-label="Increase quantity">${iPlus}</button>
					</span>
					<span class="cl">${rupees(lineTotal)}</span>`;
				cartItemsEl.appendChild(li);
			}
			const ids = Object.keys(cart);
			cartEmptyEl.style.display = ids.length ? 'none' : 'flex';
			cartItemsEl.style.display = ids.length ? 'flex' : 'none';
			cartTotalEl.textContent = rupees(total);
			cartCountEl.textContent = String(count);
			cartCount2El.textContent = String(count);
			// Browse-only beats a full bag: nothing can be bought, however much is in it.
			checkoutEl.disabled = ids.length === 0 || !salesOpen;
			salesSoonEl.hidden = salesOpen;
		}

		cartItemsEl.addEventListener('click', (e) => {
			const t = (e.target as HTMLElement).closest('button');
