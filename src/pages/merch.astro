		 * matters, because a reload would re-read the still-stale cached catalogue and
		 * bounce the shopper straight back to the closed notice.
		 *
		 * @param keepId  Item to stay on if it still exists.
		 */
		function renderShop(keepId?: string) {
			if (!catalog.length) {
				treeEl.innerHTML = `<p class="load-err">No merch on sale yet.</p>`;
				return;
			}
			// Only on the first draw. On a live update the shopper's open branch is
			// theirs, not ours to reset.
			if (!catId) { catId = catalog[0].id; openCat = catId; }
			buildTree(); renderCart(); renderMCats(); renderMGrid();
			const keep = keepId ? catalog.flatMap((c) => c.items).find((i) => i.id === keepId) : undefined;
			selectItem(keep ?? catalog[0].items[0]);
		}

		// Closed on purpose is not the same as empty: the API sent no items, so there is
		// nothing to draw and the notice goes up in the shop's place.
		setShopOpen(released);
		if (released) renderShop();

		// ---- live catalogue ----
		// One subscription, both directions. An admin adding an item, repricing one, or
		// flipping the whole store on or off reaches open tabs immediately. The shopper's
		// place is kept: the same item stays selected if it still exists, and the bag is
		// untouched — renderCart() drops any line whose item has vanished.
		/** Re-reads the catalogue, uncached, and redraws whatever it now says. */
		async function refresh() {
			const openId = item?.id;
			// Uncached: whatever triggered this is proof that what the caches hold is
			// out of date, and a plain read would just hand that same copy back.
			const fresh = await loadCatalog(true).catch(() => null);
			if (!fresh) return;

			// A deliberate close is the one case that MAY blank a working shop, so it is
			// checked before the guard below rather than being caught by it.
			if (!fresh.released) { catalog = []; setShopOpen(false); return; }
			if (!fresh.cats.length) return; // a blip must not blank a working shop

			catalog = fresh.cats;
			salesOpen = fresh.salesOpen; // renderShop -> renderCart redraws the button
			setShopOpen(true);
			renderShop(openId);
		}

		stopLive?.();
		stopLive = onCatalogueChange(refresh);

		// Second way in, because the first one is not always available: a socket can be
		// dropped by a proxy, a flaky network or an extension, and the store opening
		// would then only reach the shopper when the 60s cache lapsed and they happened
		// to reload. Coming back to the tab is the moment they are most likely looking.
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') void refresh();
		}, { signal });
	}

	let stopLive: (() => void) | null = null;
	document.addEventListener('astro:before-swap', () => { stopLive?.(); stopLive = null; });
	document.addEventListener('astro:page-load', initMerch);
	// ...and run now, in case this module was inserted mid-navigation and page-load
	// has already fired. The `inited` guard makes the duplicate call a no-op.
	initMerch();

</script>

