		border-right: var(--stroke) solid var(--secondary);
	}
	/* blue tick borrowed from .designer, flexible hairline from .pager — the header
	   is built from motifs the page already uses rather than a new one */
	.crumb {
		display: flex; align-items: center; gap: 11px;
		font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase;
		color: var(--ink-40); margin-bottom: 20px;
	}
	.crumb-tick { flex: none; width: 16px; height: 1.5px; background: var(--accent); }
