				drawQR(upiQr, uri);
				// Only now is the static fallback hidden: if drawQR threw, the generic QR
				// underneath is still on screen and the student can still pay.
				upiQrBox.classList.add('live');
			} catch (e) {
				console.warn('[merch] could not draw the UPI QR, falling back to the static one', e);
				return;
