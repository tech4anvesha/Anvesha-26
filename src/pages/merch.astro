	   laid out at its intrinsic pixel size and only looks right because of overflow. */
	.vbox .vicon > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
	/* The icon is a placeholder, so it stays small and centred; the photo covers. */
	.vbox .vicon svg { width: 46px; height: 46px; stroke-width: 1.5; }
