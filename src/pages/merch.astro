		color: var(--primary); background: var(--secondary);
		border-right: var(--stroke) solid var(--secondary);
		border-bottom: var(--stroke) solid var(--secondary);
		border-bottom-right-radius: var(--r);
	}
	.vbox.active { background: var(--secondary); color: var(--primary); }
	.vbox.active .vlabel {
		color: var(--primary); background: var(--secondary); border-color: var(--primary);
	}
	.vbox.active .vnum { background: transparent; color: var(--primary); border-color: var(--primary); }

	.pager {
		display: flex; align-items: center; gap: 14px; width: 100%;
		font-size: 11px; letter-spacing: .06em; color: var(--ink-40);
	}
	#pgCur { color: var(--secondary); }

	/* native range — drag, keyboard and a11y for free; only the skin is ours */
	.pgslider {
		flex: 1; appearance: none; -webkit-appearance: none;
		background: transparent; cursor: pointer; height: 20px; margin: 0;
	}
	.pgslider::-webkit-slider-runnable-track {
		height: 2px; border-radius: 0;
		background: color-mix(in srgb, var(--secondary) 30%, transparent);
	}
	.pgslider::-webkit-slider-thumb {
		appearance: none; -webkit-appearance: none;
		width: 16px; height: 16px; margin-top: -7px;
		background: var(--accent); border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		transition: transform .12s ease, box-shadow .12s ease;
	}
	.pgslider::-moz-range-track {
		height: 2px; background: color-mix(in srgb, var(--secondary) 30%, transparent);
	}
	.pgslider::-moz-range-thumb {
		width: 16px; height: 16px; box-sizing: border-box;
		background: var(--accent); border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		transition: transform .12s ease, box-shadow .12s ease;
	}
	.pgslider:hover::-webkit-slider-thumb { box-shadow: 2px 2px 0 var(--secondary); }
	.pgslider:hover::-moz-range-thumb { box-shadow: 2px 2px 0 var(--secondary); }
	.pgslider:active::-webkit-slider-thumb { transform: scale(1.15); box-shadow: none; }
	.pgslider:active::-moz-range-thumb { transform: scale(1.15); box-shadow: none; }
	.pgslider:disabled { opacity: .35; cursor: not-allowed; }

	/* ============ CART DRAWER ============ */
	/* ponytail: overlays hide themselves in CSS, not only via gsap.set() at init.
	   A single init-time exception used to leave the drawer, the size chart and the
	   scrim all sitting open over a half-built page. Now a JS failure costs
	   interactivity, never a broken-looking screen. */
	.drawer {
		/* ponytail: visibility, NOT transform. GSAP reads the computed matrix when it
		   first touches an element, so a CSS translateX(100%) is parsed as x:400px and
		   xPercent:100 then stacks on top of it — the drawer never slides back in.
		   GSAP owns the transform; CSS only owns the pre-JS hidden state. */
		visibility: hidden;
		position: fixed; top: 0; right: 0; height: 100%; z-index: 30;
		width: 400px; max-width: 92vw;
		display: flex; flex-direction: column;
		background: var(--primary);
		border-left: var(--stroke) solid var(--secondary);
		box-shadow: -14px 0 34px color-mix(in srgb, var(--accent) 14%, transparent);
	}
	.drawer-head {
		display: flex; justify-content: space-between; align-items: center;
		padding: 22px 24px; border-bottom: var(--stroke) solid var(--secondary);
	}
	.drawer-title {
		display: flex; align-items: center; gap: 10px;
		font-family: 'Archivo Expanded', sans-serif;
		font-weight: 800; font-size: 14px; letter-spacing: .08em;
	}
	.drawer-title i {
		font-style: normal; display: inline-grid; place-items: center;
		min-width: 22px; height: 20px; padding: 0 6px;
		font-family: 'DM Mono', monospace; font-size: 11px;
		background: var(--accent); color: var(--primary);
		border: var(--stroke) solid var(--accent); border-radius: var(--r);
	}
	/* ponytail: no hover colour rule, same as .bagbtn and .buy — the chassis gives the
	   blue shadow on hover and nothing else. */
	.x { display: grid; place-items: center; width: 30px; height: 30px; padding: 0; }
	.x svg { width: 14px; height: 14px; stroke-width: 2.2; }

	.cart-items {
		list-style: none; margin: 0; padding: 8px 24px;
		display: flex; flex-direction: column; overflow-y: auto; flex: 1;
	}
	.cart-items li {
		display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'meta price' 'qty price';
		align-items: center; column-gap: 14px; row-gap: 8px;
