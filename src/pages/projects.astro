---
/**
 * Projects — every exhibit on the Aficionados floor, one tab per subject.
 *
 * Opened from the "View projects" button on /expo. One page, not one per subject: the
 * subjects are tabs, switched in place, and the chosen subject is named beside the
 * page title. A project opens as a folder over the page — photo across the top, record below.
 *
 * Everything comes off HALLS in src/lib/expo.ts. The cards are server-rendered; the
 * folder is filled from a JSON copy of the same data, so there is one source and
 * nothing to fetch.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import { HALLS } from '../lib/expo';

import iArrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import iCamera from 'lucide-static/icons/camera.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';

const pad = (n: number) => String(n).padStart(2, '0');
const code = (h: (typeof HALLS)[number]) => (h.short ?? h.name).slice(0, 3).toUpperCase();
const total = HALLS.reduce((n, h) => n + h.projects.length, 0);

/**
 * A barcode for each subject, drawn from its code and count ("BIO02"): every character's
 * low seven bits become seven bars, wide for a 1 and thin for a 0, between guard bars
 * at either end. Five characters, so every subject's code is about the same length.
 * ponytail: decorative, not a real symbology — nothing scans it.
 */
function barcode(seed: string) {
	const bars: { x: number; w: number }[] = [];
	let x = 0;
	const bar = (w: number) => { bars.push({ x, w }); x += w + 1; };
	bar(1); bar(1);
	for (const ch of seed) for (let b = 6; b >= 0; b--) bar((ch.charCodeAt(0) >> b) & 1 ? 2 : 1);
	bar(1); bar(1);
	return { bars, width: x - 1 };
}

// What the folder needs, keyed by subject. The icon rides along as its SVG string —
// it is our own static markup, not anything a visitor typed.
const CARDS = Object.fromEntries(
	HALLS.map((h) => [h.slug, { name: h.name, code: code(h), icon: h.icon, projects: h.projects }]),
);
// `<` escaped so a "</script>" in any copy cannot close the data block early.
const cardsJson = JSON.stringify(CARDS).replace(/</g, '\\u003c');
---

<SiteLayout
	title="Projects · Expo · Anvesha '26"
	description="Every project on the Aficionados floor at Anvesha '26, subject by subject — what each team built and who built it."
>
	<div class="page pj-page">
		{/* ---- the head: centred, on its own dot ground, the way /outreach opens ----
		    The chosen subject sits beside the title rather than in a block of its own:
		    one label per subject, server-rendered and stacked in one cell, switched with
		    the tabs below — so the page is complete before any script runs. */}
		<header class="page-head pj-head" data-reveal>
			<p class="eyebrow">Aficionados &middot; Anvesha &rsquo;26</p>

			<div class="pj-title-row">
				<h1 class="page-title">Projects</h1>
				<span class="pj-title-rule" aria-hidden="true"></span>
				<div class="pj-heads" aria-live="polite">
					{HALLS.map((h, i) => (
						<div class:list={['pj-sub', i === 0 && 'is-on']} id={`head-${h.slug}`} data-sub={h.slug}>
							<p class="pj-sub-name" title={h.short ? h.name : undefined}>
								<span class="pj-sub-icon" set:html={h.icon} aria-hidden="true" />
								{h.short ?? h.name}
							</p>
							<p class="pj-sub-count mono">
								<span><b>{pad(h.projects.length)}</b> {h.projects.length === 1 ? 'project' : 'projects'}</span>
								{(() => {
									const bc = barcode(`${code(h)}${pad(h.projects.length)}`);
									return (
										<svg class="pj-bar" viewBox={`0 0 ${bc.width} 10`} width={bc.width * 1.5}
										     preserveAspectRatio="none" aria-hidden="true">
											{bc.bars.map((b) => <rect x={b.x} y="0" width={b.w} height="10" />)}
										</svg>
									);
								})()}
							</p>
						</div>
					))}
				</div>
			</div>

			<p class="lede">
				Every exhibit on the floor, subject by subject. Open a project to see what the
				team built, and who to ask about it at the table.
			</p>
			<p class="pj-meta pj-meta-all mono"><b>{total}</b> projects &middot; <b>{HALLS.length}</b> subjects</p>
			{/* Phone only: the chosen subject's code and count, in place of the totals —
			    the count has left the subject block there, so it lands here instead. */}
			<div class="pj-meta-subs">
				{HALLS.map((h, i) => (
					<p class:list={['pj-meta pj-meta-sub mono', i === 0 && 'is-on']} data-sub={h.slug}>
						<b>{code(h)}</b> &middot; <b>{pad(h.projects.length)}</b> {h.projects.length === 1 ? 'project' : 'projects'}
					</p>
				))}
			</div>
		</header>

		{/* ---- the tabs ----
		    Centred, and sticky to the top of the scroller so switching is one tap from
		    anywhere in a long list. Real tabs: arrow keys move between them. */}
		<div class="pj-tabs" id="pjTabs" role="tablist" aria-label="Subjects">
			{HALLS.map((h, i) => (
				<button class="btn pj-tab" type="button" role="tab"
				        id={`tab-${h.slug}`} aria-controls={`panel-${h.slug}`} data-slug={h.slug}
				        aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
				        title={h.short ? h.name : undefined}>
					<span class="pj-tab-icon" set:html={h.icon} />
					<span>{h.short ?? h.name}</span>
					<i class="pj-tab-n mono">{h.projects.length}</i>
				</button>
			))}
		</div>

		<div data-reveal>
			{HALLS.map((h, i) => (
				<section class="section pj-panel" role="tabpanel" id={`panel-${h.slug}`}
				         aria-labelledby={`tab-${h.slug}`} hidden={i !== 0}>
					{h.projects.length ? (
						<ol class="pj-grid">
							{h.projects.map((p, j) => (
								<li class="pj-card">
									<figure class:list={['pj-shot', !p.image && 'is-empty']}>
										{p.image && (
											<img src={p.image} alt="" loading="lazy"
											     onerror="this.parentElement.classList.add('is-empty')" />
										)}
										<span class="pj-shot-empty" set:html={iCamera} />
										<i class="pj-num mono">{code(h)}-{pad(j + 1)}</i>
									</figure>

									<div class="pj-body">
										{/* The button carries the name and stretches over the card with
										    ::after — one click target, announced as the project's title. */}
										<h3 class="pj-name">
											<button class="pj-open" type="button" aria-haspopup="dialog"
											        data-s={h.slug} data-j={j}>{p.title}</button>
										</h3>
										<p class="pj-summary">{p.summary}</p>
										<ul class="pj-chips pj-team">
											{p.team.map((m) => <li class="pj-chip">{m}</li>)}
										</ul>
									</div>

									<span class="pj-go mono" aria-hidden="true">
										View project <span set:html={iArrowUpRight} />
									</span>
								</li>
							))}
						</ol>
					) : (
						<p class="pj-empty">
							Projects for {h.name} go up here once teams are confirmed.
						</p>
					)}
				</section>
			))}
		</div>
	</div>

	<Fragment slot="overlays">
		<script type="application/json" id="pjData" set:html={cardsJson} />

		{/* ============ THE FOLDER ============
		    A project folder: a tab with its code standing up off the top edge, the photo
		    across the full width, the record under it, and a ruled strip of fields along
		    the foot like the label on an index card. */}
		<div id="pmWrap" class="pm-wrap" aria-hidden="true">
			<div class="pm" role="dialog" aria-modal="true" aria-labelledby="pmTitle">
				<span class="pm-tab mono"><span class="pm-tab-icon" id="pmIcon"></span><span id="pmCode"></span></span>
				<button class="btn pm-x" id="pmClose" type="button" aria-label="Close" set:html={iX} />

				<figure class="pm-media" id="pmMedia">
					<img id="pmImg" alt="" />
					<span class="pm-media-empty" set:html={iCamera} />
				</figure>

				<div class="pm-body">
					<h2 class="pm-title" id="pmTitle"></h2>
					<div class="pm-cols">
						<p class="pm-summary" id="pmSummary"></p>
						<div class="pm-team">
							<p class="pm-label mono">Team</p>
							<ol class="pm-members" id="pmTeam"></ol>
						</div>
					</div>
				</div>

				<dl class="pm-fields">
					<div><dt>Subject</dt><dd id="pmFSubject"></dd></div>
					<div><dt>Exhibit</dt><dd id="pmFCode"></dd></div>
					<div><dt>Members</dt><dd id="pmFCount"></dd></div>
				</dl>
			</div>
		</div>
	</Fragment>
</SiteLayout>

<script>
	import { gsap } from 'gsap';

	type Project = { title: string; summary: string; team: string[]; image?: string };
	type Cards = Record<string, { name: string; code: string; icon: string; projects: Project[] }>;

	// Listeners hang off one controller per visit: ClientRouter swaps the DOM without
	// reloading, so anything bound to window must be torn down before the next bind.
	let ac: AbortController | null = null;

	function init() {
		ac?.abort();
		const tablist = document.getElementById('pjTabs');
		const wrap = document.getElementById('pmWrap');
		const dataEl = document.getElementById('pjData');
		if (!tablist || !wrap || !dataEl) return;

		ac = new AbortController();
		const { signal } = ac;
		const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const cards = JSON.parse(dataEl.textContent || '{}') as Cards;
		const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

		// ---------- tabs ----------
		const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

		let current = tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0];

		function select(tab: HTMLButtonElement, focus = false) {
			if (focus) tab.focus();
			if (tab === current) return;
			// Which way the cards travel: in from the right when moving right along the
			// tabs, from the left when moving back — the list reads as sliding past.
			const dir = tabs.indexOf(tab) > tabs.indexOf(current) ? 1 : -1;
			current = tab;

			for (const t of tabs) {
				const on = t === tab;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				$(t.getAttribute('aria-controls')!).hidden = !on;
				for (const el of document.querySelectorAll(`[data-sub="${t.dataset.slug}"]`))
					el.classList.toggle('is-on', on);
			}

			if (!rm) {
				const panel = $(tab.getAttribute('aria-controls')!);
				const head = $(`head-${tab.dataset.slug}`);
				// clearProps hands the transform back to CSS when done — the cards lift on
				// hover with their own transform, which an inline one left behind would pin.
				gsap.fromTo(panel.querySelectorAll('.pj-card, .pj-empty'),
					{ opacity: 0, x: 36 * dir },
					{ opacity: 1, x: 0, duration: 0.42, stagger: 0.06, ease: 'power3.out', overwrite: true, clearProps: 'opacity,transform' });
				gsap.fromTo(head, { opacity: 0, y: 8 },
					{ opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', overwrite: true, clearProps: 'opacity,transform' });
				// The code wipes in left to right, like a scanner passing over it. One clip on
				// the whole svg, not a scale per bar: a bar scaled from 0 has a zero-height
				// box, GSAP reads its origin off that, and the bars end up shifted off the top.
				gsap.fromTo(head.querySelector('.pj-bar'), { clipPath: 'inset(0 100% 0 0)' },
					{ clipPath: 'inset(0 0% 0 0)', duration: 0.5, ease: 'power2.inOut', delay: 0.08, overwrite: true, clearProps: 'clipPath' });
			}

			// On a phone the strip scrolls sideways; keep the chosen tab in sight.
			// block:'nearest' so only the strip moves, never the page.
			tab.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: rm ? 'auto' : 'smooth' });
		}

		for (const t of tabs) t.addEventListener('click', () => select(t), { signal });
		tablist.addEventListener('keydown', (e) => {
			const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
			if (i < 0) return;
			const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
			if (to === undefined) return;
			e.preventDefault();
			select(tabs[(to + tabs.length) % tabs.length], true);
		}, { signal });

		// ---------- the folder ----------
		const pm = wrap.querySelector('.pm') as HTMLElement;
		const media = $('pmMedia'), img = $<HTMLImageElement>('pmImg');
		let opener: HTMLElement | null = null;
		let open = false;

		gsap.set(wrap, { autoAlpha: 0 });
		gsap.set(pm, { y: 24, scale: 0.98 });

		// A photo that fails falls back to the drawn frame, same as the cards.
		img.onerror = () => media.classList.add('is-empty');

		function show(slug: string, j: number, from: HTMLElement) {
			const s = cards[slug];
			const p = s?.projects[j];
			if (!p) return;
			opener = from;

			media.classList.toggle('is-empty', !p.image);
			if (p.image) img.src = p.image; else img.removeAttribute('src');

			const ref = `${s.code}-${String(j + 1).padStart(2, '0')}`;
			$('pmIcon').innerHTML = s.icon;
			// textContent from here on: every value below is free text from the data file.
			$('pmCode').textContent = ref;
			$('pmTitle').textContent = p.title;
			$('pmSummary').textContent = p.summary;
			$('pmFSubject').textContent = s.name;
			$('pmFCode').textContent = ref;
			$('pmFCount').textContent = String(p.team.length).padStart(2, '0');
			$('pmTeam').replaceChildren(...p.team.map((m) => {
				const li = document.createElement('li');
				li.textContent = m;
				return li;
			}));

			wrap.scrollTop = 0;
			setOpen(true);
		}

		function setOpen(on: boolean) {
			open = on;
			wrap.setAttribute('aria-hidden', String(!on));
			gsap.to(wrap, { autoAlpha: on ? 1 : 0, duration: rm ? 0 : 0.2 });
			gsap.to(pm, { y: on ? 0 : 24, scale: on ? 1 : 0.98, duration: rm ? 0 : 0.32, ease: 'power3.out' });
			// Focus goes into the folder on open and back to the card it came from on
			// close, or a keyboard reader is left stranded at the top of the page.
			if (on) $('pmClose').focus();
			else opener?.focus();
		}

		for (const b of document.querySelectorAll<HTMLButtonElement>('.pj-open'))
			b.addEventListener('click', () => show(b.dataset.s!, Number(b.dataset.j), b), { signal });
		$('pmClose').addEventListener('click', () => setOpen(false), { signal });
		wrap.addEventListener('click', (e) => { if (e.target === wrap) setOpen(false); }, { signal });
		addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) setOpen(false); }, { signal });
	}

	document.addEventListener('astro:page-load', init);
	document.addEventListener('astro:before-swap', () => ac?.abort());
</script>

<style>
	/* ============ HEAD ============
	   The /outreach opening: centred, over the page's own dot matrix, which fades out
	   before the reading starts. */
	.pj-page { position: relative; }
	.pj-page::before {
		content: ''; position: absolute; inset: 0; pointer-events: none;
		background-image: radial-gradient(circle at center, var(--dot) 1.2px, transparent 1.4px);
		background-size: 22px 22px;
		mask-image: linear-gradient(#000 0%, #000 14%, transparent 36%);
	}
	/* Positioned so they paint over the pseudo; the tabs keep their own sticky. */
	.pj-head, .pj-panel { position: relative; }

	.pj-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
	.pj-head .lede { max-width: 60ch; }
	/* Smaller than the shared .page-title: it shares the row with the subject now, and
	   at full size it dwarfed it. */
	.pj-head .page-title { font-size: clamp(30px, 4.2vw, 56px); }
	.pj-meta {
		margin: 22px 0 0;
		font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-60);
	}
	.pj-meta b { color: var(--accent); font-weight: 500; }

	/* ============ THE CHOSEN SUBJECT ============
	   Beside the title, behind a rule: mark + name on top, count + code under it. */
	.pj-title-row {
		display: flex; align-items: center; justify-content: center;
		flex-wrap: wrap; gap: 14px clamp(18px, 2.6vw, 32px);
	}
	.pj-title-rule { align-self: stretch; width: var(--stroke); background: var(--secondary); }
	/* All six labels share one grid cell and only the chosen one is visible, so the cell
	   is always as wide as the widest subject. With [hidden] it took the width of
	   whichever was showing, and the centred row — PROJECTS with it — slid sideways on
	   every tab switch. visibility also takes the hidden ones out of the a11y tree. */
	.pj-heads { display: grid; text-align: left; }
	.pj-sub { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 10px; visibility: hidden; }
	.pj-sub.is-on { visibility: visible; }
	.pj-sub-name {
		display: flex; align-items: center; gap: 12px; margin: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(20px, 2.4vw, 30px);
		line-height: 1; letter-spacing: -.01em; text-transform: uppercase;
	}
	/* The subject's mark as a pressed key: ink tile, accent offset. */
	.pj-sub-icon {
		display: grid; place-items: center; flex: none;
		width: 1.5em; aspect-ratio: 1;
		color: var(--primary); background: var(--secondary);
		border-radius: var(--r); box-shadow: var(--pop);
	}
	.pj-sub-icon :global(svg) { width: 58%; height: 58%; stroke-width: 1.8; }
	.pj-sub-count {
		display: flex; align-items: center; gap: 12px;
		margin: 0;
		font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-60);
	}
	.pj-sub-count b { color: var(--accent); font-weight: 500; }
	.pj-bar { display: block; height: 14px; fill: var(--secondary); }

	/* Stacked in one cell like the subject labels, so the line never changes height.
	   Before the phone query below, which turns it on — after it, this would win. */
	.pj-meta-subs { display: none; }
	.pj-meta-sub { grid-area: 1 / 1; visibility: hidden; }
	.pj-meta-sub.is-on { visibility: visible; }

	/* Under 640px the row cannot hold both: the subject drops under the title, centred,
	   and the rule turns sideways to sit between them. */
	@media (max-width: 640px) {
		.pj-title-row { flex-direction: column; }
		.pj-title-rule { align-self: center; width: 48px; height: var(--stroke); }
		.pj-heads { text-align: center; }
		.pj-sub { align-items: center; }
		/* The count moves down to the meta line; the barcode stays under the name. */
		.pj-sub-count { justify-content: center; }
		.pj-sub-count > span { display: none; }

		.pj-meta-all { display: none; }
		.pj-meta-subs { display: grid; }
	}

	/* black name chips: the same construction as the coordinators on /expo */
	.pj-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
	.pj-chip {
		padding: 5px 10px;
		font-size: 12px; font-weight: 700; letter-spacing: -.01em;
		background: var(--secondary); color: var(--primary);
		border-radius: var(--r);
	}

	/* ============ TABS ============ */
	.pj-tabs {
		position: sticky; top: 0; z-index: 5;
		flex: none;
		display: flex; gap: 8px;
		padding: 14px clamp(20px, 3.5vw, 52px);
		background: var(--primary);
		border-bottom: var(--stroke) solid var(--secondary);
		overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none;
	}
	.pj-tabs::-webkit-scrollbar { display: none; }
	/* Centred with auto margins, not justify-content:center — that one centres an
	   overflowing row too, pushing the first tabs off the left edge where a phone can
	   never scroll back to them. Auto margins only take up space that is spare. */
	.pj-tab:first-child { margin-left: auto; }
	.pj-tab:last-child { margin-right: auto; }
	.pj-tab {
		flex: none; display: inline-flex; align-items: center; gap: 8px;
		padding: 8px 10px 8px 12px;
		font-size: 10.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
		white-space: nowrap;
	}
	.pj-tab[aria-selected='true'] { background: var(--secondary); color: var(--primary); }
	.pj-tab-icon { display: grid; place-items: center; }
	.pj-tab-icon :global(svg) { width: 14px; height: 14px; stroke-width: 2; }
	.pj-tab-n {
		display: grid; place-items: center; min-width: 20px; height: 17px; padding: 0 4px;
		font-size: 9.5px; font-style: normal; letter-spacing: 0;
		color: var(--primary); background: var(--accent); border-radius: var(--r);
	}

	/* ============ THE CARDS ============ */
	/* Siblings of each other, so the shell's .section:last-child rules never match the
	   one on show — it would keep a bottom rule and no closing space. */
	.pj-panel { border-bottom: 0; padding-bottom: clamp(34px, 4vw, 56px); }

	.pj-grid {
		display: grid; gap: 18px;
		/* auto-fit + a capped track + centring: a subject with two projects sits under the
		   centred heading instead of hugging the left edge beside four empty columns. */
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 340px));
		justify-content: center;
		margin: 0; padding: 0; list-style: none;
	}
	.pj-card {
		position: relative;
		display: flex; flex-direction: column; min-width: 0;
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		transition: transform .12s ease, box-shadow .12s ease;
	}
	/* It opens something, so it moves like every other control on the site. */
	.pj-card:hover, .pj-card:focus-within { transform: translate(-2px, -2px); box-shadow: var(--pop); }
	.pj-card:active { transform: none; box-shadow: 0 0 0 var(--accent); }

	/* aspect-ratio on the img and placeholder themselves, as the /expo reel does — a
	   100%-height img inside an aspect-ratio box gets no height to fill. */
	.pj-shot {
		position: relative; margin: 0; overflow: hidden;
		background: var(--sink);
		border-bottom: var(--stroke) solid var(--secondary);
	}
	.pj-shot img, .pj-shot-empty { display: block; width: 100%; aspect-ratio: 4 / 3; }
	.pj-shot img { object-fit: cover; }
	.pj-shot-empty { display: none; place-items: center; color: var(--ink-40); }
	.pj-shot-empty :global(svg) { width: 28px; height: 28px; stroke-width: 1.4; }
	.pj-shot.is-empty img { display: none; }
