---
/**
 * Events admin. Same shape as Merch: a task rail on the left picks what you are doing,
 * the panes to its right change to suit. Edit mode adds the programme rail
 * (styles/catalogue-tree.css) so both sides of the site browse events identically.
 *
 * Writes go to the EVENTS Worker, which is a separate deployment from the merch API —
 * but reads the same admin_login table, so the session token in this tab authenticates
 * both. adminFetch takes the base as its third argument for exactly that.
 *
 * Two tables sit behind this, and they are not equally editable:
 *   events_scheduled — everything is editable, and the row can be deleted
 *   events_done      — the event already happened, so only the write-up it did not
 *                      have on the day (gallery link, summary) can be added
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import '../../styles/catalogue-tree.css';

import caretRight from 'lucide-static/icons/chevron-right.svg?raw';
import iAdd from 'lucide-static/icons/calendar-plus.svg?raw';
import iEdit from 'lucide-static/icons/square-pen.svg?raw';
import iPlus from 'lucide-static/icons/plus.svg?raw';
import iTrash from 'lucide-static/icons/trash-2.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';
---

<AdminLayout title="Events — Admin — Anvesha '26">
	<div class="a-wrap ev-shell" data-task="add">
		<!-- TASK RAIL -->
		<nav class="ev-tasks" aria-label="Event tasks">
			<button class="btn ev-task on" data-task-btn="add" aria-current="true" type="button">
				<span class="ev-task-icon" set:html={iAdd} />
				<span class="ev-task-label">Add event</span>
			</button>
			<button class="btn ev-task" data-task-btn="edit" type="button">
				<span class="ev-task-icon" set:html={iEdit} />
				<span class="ev-task-label">Edit event</span>
			</button>

		</nav>

		<div class="ev-panes">
			<!-- PROGRAMME — edit mode only -->
			<aside class="ev-list-pane" id="evListPane">
				<p class="a-eyebrow">Programme <b id="evCount">—</b></p>
				<div class="tree" id="evTree" role="tree" aria-label="Events"></div>
				<p class="a-err ev-list-err" id="evListErr" hidden></p>
			</aside>

			<!-- WORK AREA -->
			<section class="ev-work">
				<!-- ============ ADD ============
				     Several drafts staged, then sent in one go. Three bands: a fixed head,
				     the scrolling drafts, and a footer that stays put — with six sessions
				     staged, the submit button must not be a scroll away. -->
				<div class="ev-new" id="evNew">
					<div class="ev-head">
						<p class="a-eyebrow">New events</p>
						<p class="ev-hint">
							One card per session. Stage as many as you like, then send them together.
							Everything except the registration link is required.
						</p>
					</div>

					<div class="ev-scroll">
						<div id="evDrafts"></div>
						<button class="btn ev-draft-add" id="evDraftAdd" type="button">
							<span class="ev-add-icon" set:html={iPlus} />
							<span>ANOTHER EVENT</span>
						</button>
					</div>

					<div class="ev-foot">
						<!-- Kept in the footer: an error about a card scrolled off screen would
						     otherwise never be seen. -->
						<p class="a-err" id="nErr" hidden></p>
						<p class="ev-saved" id="nSaved" hidden></p>
						<div class="ev-actions">
							<button class="btn a-btn-primary ev-save" id="nSubmit" type="button">ADD TO SCHEDULE</button>
							<button class="btn a-btn-secondary" id="nClear" type="button">CLEAR ALL</button>
						</div>
					</div>
				</div>

				<!-- ============ EDIT ============ -->
				<p class="ev-empty" id="evEmpty" hidden>Pick an event from the rail to edit it.</p>

				<form class="ev-form" id="evForm" hidden novalidate>
					{/* The scroller and the bento are two elements on purpose. As one, the
					    grid inherited the scroller's fixed height and split it between its
					    rows — which on a phone squashed the poster and preview cells to
					    40px each while their contents overflowed. */}
					<div class="ev-scroll">
					<div class="ev-bento">
						<div class="ev-cell ev-cell-fields">
							<!-- Wire across the gap into the preview: this form feeds it. -->
							<span class="ev-wire" aria-hidden="true"></span>
							<div class="ev-cell-head">
								<p class="a-eyebrow">Details</p>
								<span class="ev-id" id="fId">EVT_</span>
							</div>

							<!-- Only ever shown for an archived event, where most of the record
							     is history and the API will not take a change to it. -->
							<p class="ev-locked" id="fLocked" hidden>
								Archived. Name, times and venue are the record of what happened and are
								read-only; add the write-up below.
							</p>

							<label class="field">
								<span class="field-label">Name</span>
								<input class="field-input" id="fName" type="text" maxlength="160" required />
							</label>

							<div class="ev-row2">
								<label class="field">
									<span class="field-label">Type</span>
									<input class="field-input" id="fType" type="text" maxlength="40" list="evTypes" required />
									<datalist id="evTypes"></datalist>
								</label>
								<label class="field">
									<span class="field-label">Venue</span>
									<input class="field-input" id="fVenue" type="text" maxlength="160" required />
								</label>
							</div>

							<div class="ev-row2">
								<label class="field">
									<span class="field-label">Starts</span>
									<input class="field-input" id="fStart" type="datetime-local" required />
								</label>
								<label class="field">
									<span class="field-label">Ends</span>
									<input class="field-input" id="fEnd" type="datetime-local" required />
								</label>
							</div>

							<label class="field ev-field-grow">
								<span class="field-label">Description</span>
								<textarea class="field-input" id="fDesc" maxlength="4000" rows="5" required></textarea>
							</label>

							<label class="field" id="fRegField">
								<span class="field-label">Registration link — optional</span>
								<input class="field-input" id="fReg" type="url" maxlength="500"
								       placeholder="https://…" />
							</label>

							<!-- Archive-only. The two things an event does not have until after it. -->
							<label class="field" id="fGalField" hidden>
								<span class="field-label">Gallery link — Drive folder</span>
								<input class="field-input" id="fGal" type="url" maxlength="500"
								       placeholder="https://drive.google.com/…" />
							</label>
							<label class="field" id="fSumField" hidden>
								<span class="field-label">Summary — what actually happened</span>
								<textarea class="field-input" id="fSum" maxlength="4000" rows="4"></textarea>
							</label>
						</div>

						{/* The right half is its own vertical bento: the poster on top, taller,
						    because it is the thing being judged; the storefront preview under it. */}
						<div class="ev-right">
						<aside class="ev-cell ev-poster-cell">
							<div class="ev-cell-head">
								<p class="a-eyebrow">Poster</p>
								<span class="ev-poster-state" id="fPosterState">None</span>
							</div>

							<label class="ev-drop ev-drop-lg" id="fPosterDrop">
								<input type="file" accept="image/jpeg,image/png,image/webp,image/avif"
								       id="fPosterInput" hidden />
								<img class="ev-drop-img" id="fPosterImg" alt="" hidden />
								<span class="ev-drop-text" id="fPosterText">Drop an image, or click to choose</span>
							</label>

							<p class="a-err ev-poster-err" id="fPosterErr" hidden></p>
							<div class="ev-poster-actions">
								<button class="btn a-btn-secondary" id="fPosterPick" type="button">CHOOSE FILE</button>
								<button class="btn a-btn-danger" id="fPosterDel" type="button" hidden>REMOVE</button>
							</div>
							<p class="ev-poster-hint">JPEG, PNG, WebP or AVIF · 6MB max · saved as soon as it is picked</p>
						</aside>

						<!-- What a visitor will see on /events. Redrawn on every keystroke. -->
						<aside class="ev-cell ev-preview">
							<p class="a-eyebrow">Storefront preview</p>

							<div class="pv-item">
								<time class="pv-time" id="pvTime">--:--</time>
								<span class="pv-rail" aria-hidden="true"><span class="pv-dot"></span></span>
								<div class="pv-card">
									<span class="pv-top">
										<span class="pv-chip" id="pvChip">TYPE</span>
										<span class="pv-venue" id="pvVenue">VENUE</span>
									</span>
									<span class="pv-head">
										<span class="pv-name" id="pvName">Event name</span>
									</span>
									<span class="pv-desc" id="pvDesc"></span>
								</div>
							</div>

							<dl class="pv-rows">
								<div class="pv-row"><dt>When</dt><span class="pv-lead"></span><dd id="pvWhen">—</dd></div>
								<div class="pv-row"><dt>Time</dt><span class="pv-lead"></span><dd id="pvClock">—</dd></div>
								<div class="pv-row"><dt>Length</dt><span class="pv-lead"></span><dd id="pvLen">—</dd></div>
							</dl>

							<p class="pv-cta" id="pvCta">No registration link — the button is hidden.</p>
						</aside>
						</div>
					</div>
					</div>

					<div class="ev-foot">
						<p class="a-err" id="eErr" hidden></p>
						<p class="ev-saved" id="eSaved" hidden>Saved.</p>
						<div class="ev-actions">
							<button class="btn a-btn-primary ev-save" id="eSave" type="submit">SAVE CHANGES</button>
							<button class="btn a-btn-secondary" id="eReset" type="button">REVERT</button>
							<button class="btn a-btn-danger" id="eDelete" type="button">DELETE EVENT</button>
						</div>
					</div>
				</form>
			</section>
		</div>
	</div>

	<!-- ============ DELETE CONFIRM ============ -->
	<div class="ov" id="delModal" hidden>
		<div class="ov-panel ov-narrow" role="dialog" aria-modal="true" aria-labelledby="delTitle">
			<div class="ov-head">
				<span class="ov-title" id="delTitle">DELETE EVENT</span>
				<button class="btn x" id="delClose" type="button" aria-label="Close" set:html={iX} />
			</div>
			<div class="ov-body">
				<p class="ov-warn">
					This removes the event from the schedule for good. It cannot be undone, and it
					will not appear in the archive — only events that actually ran get archived.
				</p>
				<p class="ov-id" id="delName">—</p>
				<p class="a-err" id="delErr" hidden></p>
			</div>
			<div class="ov-foot">
				<button class="btn a-btn-danger armed" id="delGo" type="button">DELETE EVENT</button>
				<button class="btn a-btn-secondary" id="delCancel" type="button">CANCEL</button>
			</div>
		</div>
	</div>

	<!-- One draft card. Cloned per event so the markup lives in one place. -->
	<template id="evDraftTpl">
	  <div class="ev-draft-row">
		<div class="ev-draft">
			<div class="ev-draft-head">
				<span class="ev-draft-n"></span>
				<button class="btn ev-draft-del" type="button" aria-label="Remove this event">
					<span set:html={iTrash} />
				</button>
			</div>

			<label class="field">
				<span class="field-label">Name</span>
				<input class="field-input" data-name type="text" maxlength="160" />
			</label>

			<div class="ev-row2">
				<label class="field">
					<span class="field-label">Type</span>
					<input class="field-input" data-type type="text" maxlength="40" list="evTypes"
					       placeholder="Talk, Workshop, Competition…" />
				</label>
				<label class="field">
					<span class="field-label">Venue</span>
					<input class="field-input" data-venue type="text" maxlength="160" />
				</label>
			</div>

			<div class="ev-row2">
				<label class="field">
					<span class="field-label">Starts</span>
					<input class="field-input" data-start type="datetime-local" />
				</label>
				<label class="field">
					<span class="field-label">Ends</span>
					<input class="field-input" data-end type="datetime-local" />
				</label>
			</div>

			<label class="field ev-field-grow">
				<span class="field-label">Description</span>
				<textarea class="field-input" data-desc maxlength="4000" rows="3"></textarea>
			</label>

			<label class="field">
				<span class="field-label">Registration link — optional</span>
				<input class="field-input" data-reg type="url" maxlength="500" placeholder="https://…" />
			</label>

			<p class="ev-draft-err" data-err hidden></p>
		</div>

		{/* Same bento as the editor: the poster on top, taller, and under it the row as
		    the storefront will draw it. A card with only a drop plate beside it could not
		    fill the pane, and there was no way to see what you were typing until after
		    it had been sent. */}
		<div class="ev-draft-right">
		<aside class="ev-poster-box">
			<p class="ev-poster-head">
				<span>Poster</span>
				<b data-postersize>optional</b>
			</p>

			<label class="ev-drop" data-drop>
				<input type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-poster hidden />
				<img class="ev-drop-img" data-preview alt="" hidden />
				<span class="ev-drop-text" data-droptext>Drop an image, or click to choose</span>
			</label>

			<button class="btn ev-drop-clear" type="button" data-posterclear hidden>REMOVE</button>
			<p class="ev-poster-hint">JPEG, PNG, WebP or AVIF · 6MB max</p>
		</aside>

		<aside class="ev-cell ev-preview ev-draft-preview">
			<p class="a-eyebrow">Storefront preview</p>

			<div class="pv-item">
				<time class="pv-time" data-pvtime>--:--</time>
				<span class="pv-rail" aria-hidden="true"><span class="pv-dot"></span></span>
				<div class="pv-card">
					<span class="pv-top">
						<span class="pv-chip" data-pvchip>TYPE</span>
						<span class="pv-venue" data-pvvenue>VENUE</span>
					</span>
					<span class="pv-head"><span class="pv-name" data-pvname>Event name</span></span>
					<span class="pv-desc" data-pvdesc></span>
				</div>
			</div>

			<dl class="pv-rows">
				<div class="pv-row"><dt>When</dt><span class="pv-lead"></span><dd data-pvwhen>—</dd></div>
				<div class="pv-row"><dt>Time</dt><span class="pv-lead"></span><dd data-pvclock>—</dd></div>
				<div class="pv-row"><dt>Length</dt><span class="pv-lead"></span><dd data-pvlen>—</dd></div>
			</dl>

			<p class="pv-cta" data-pvcta>No registration link — the button is hidden.</p>
		</aside>
		</div>
	  </div>
	</template>
</AdminLayout>

<script>
	import { adminFetch } from '../../lib/admin';
	import { EVENTS_API } from '../../lib/api';
	import caretRight from 'lucide-static/icons/chevron-right.svg?raw';

	type Row = {
		event_id: string; name: string; venue: string; description: string;
		starts_at: string; ends_at: string; event_type: string;
		registration_link?: string | null;
		gallery_link?: string | null;
		summary?: string | null;
		has_poster?: number | boolean;
	};
	type Rec = Row & { past: boolean };

	// Every write goes to the events Worker; the session token is the merch panel's.
	const evFetch = <T,>(path: string, init: RequestInit = {}) =>
		adminFetch<T>(path, init, EVENTS_API);

	// ---------- the IST clock ----------
	// The Worker stores naive IST ('2026-09-11 10:00') and <input type="datetime-local">
	// speaks 'YYYY-MM-DDTHH:MM'. One character apart, so the conversion is a swap rather
	// than a Date round-trip — which would reinterpret the stamp in the browser's own
	// timezone and shift every event by the offset.
	const toInput = (s: string) => (s || '').replace(' ', 'T').slice(0, 16);
	const fromInput = (s: string) => (s || '').replace('T', ' ').slice(0, 16);

	const IST_OFFSET_MIN = 330;
	const istNow = () =>
		new Date(Date.now() + IST_OFFSET_MIN * 60_000).toISOString().slice(0, 16).replace('T', ' ');
	const stampMs = (s: string) => Date.parse(s.replace(' ', 'T') + ':00Z');

	const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
	const WD = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
	/** Read as UTC so the calendar day typed into the form is the one that renders. */
	function dparts(iso: string) {
		const d = new Date(iso + 'T00:00:00Z');
		return { wd: WD[d.getUTCDay()], dd: String(d.getUTCDate()).padStart(2, '0'), mon: MON[d.getUTCMonth()] };
	}
	function runLength(a: string, b: string): string {
		const m = Math.round((stampMs(b) - stampMs(a)) / 60_000);
		if (!isFinite(m) || m <= 0) return '—';
		if (m < 60) return `${m} min`;
		const h = Math.floor(m / 60), r = m % 60;
		return r ? `${h} hr ${r} min` : `${h} hr`;
	}

	const esc = (s: unknown) =>
		String(s ?? '').replace(/[&<>"']/g, (c) =>
			({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

	/** The formats R2 serves back without transcoding — the Worker rejects the rest. */
	const POSTER_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/avif'];
	const MAX_POSTER_BYTES = 6 * 1024 * 1024;

	/** Null when the file is fine, a sentence when it is not. */
	function badPoster(f: File): string | null {
		if (!POSTER_TYPES.includes(f.type)) return `${f.type || 'That file'} is not a JPEG, PNG, WebP or AVIF`;
		if (f.size > MAX_POSTER_BYTES) return `That poster is ${(f.size / 1048576).toFixed(1)}MB — the limit is 6MB`;
		return null;
	}

	/** Cache-busted: the poster URL never changes, so a replaced image would otherwise
	 *  keep showing the old one for as long as the browser held it. */
	const posterUrl = (id: string, v: number | string = '') =>
		`${EVENTS_API}/api/events/${encodeURIComponent(id)}/poster${v ? `?v=${v}` : ''}`;

	/** http(s) only — the value lands in an href on the public page. */
	function badLink(v: string): string | null {
		if (!v.trim()) return null;
		try {
			const u = new URL(v.trim());
			if (u.protocol !== 'https:' && u.protocol !== 'http:') return 'Link must start with https://';
			return null;
		} catch {
			return 'Link must be a full URL starting with https://';
		}
	}

	// ponytail: same shape as the other panels — Astro module scripts run once per
	// session, so with the client router this must re-init against each swapped DOM.
	let inited: HTMLElement | null = null;

	function initEventsAdmin() {
		const shell = document.querySelector<HTMLElement>('.ev-shell');
		if (!shell || shell === inited) return;
		inited = shell;

		const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

		const tree = $('evTree'), evCount = $('evCount'), listErr = $('evListErr');
		const typesList = $<HTMLDataListElement>('evTypes');
		const emptyMsg = $('evEmpty'), form = $<HTMLFormElement>('evForm');
		const draftsBox = $('evDrafts'), draftTpl = $<HTMLTemplateElement>('evDraftTpl');

		const f = {
			id: $('fId'), name: $<HTMLInputElement>('fName'), type: $<HTMLInputElement>('fType'),
			venue: $<HTMLInputElement>('fVenue'), start: $<HTMLInputElement>('fStart'),
			end: $<HTMLInputElement>('fEnd'), desc: $<HTMLTextAreaElement>('fDesc'),
			reg: $<HTMLInputElement>('fReg'), gal: $<HTMLInputElement>('fGal'),
			sum: $<HTMLTextAreaElement>('fSum'),
			regField: $('fRegField'), galField: $('fGalField'), sumField: $('fSumField'),
			locked: $('fLocked'),
		};
		const poster = {
			drop: $('fPosterDrop'), input: $<HTMLInputElement>('fPosterInput'),
			img: $<HTMLImageElement>('fPosterImg'), text: $('fPosterText'),
			state: $('fPosterState'), err: $('fPosterErr'),
			pick: $<HTMLButtonElement>('fPosterPick'), del: $<HTMLButtonElement>('fPosterDel'),
		};
		const eErr = $('eErr'), eSaved = $('eSaved'), eSave = $<HTMLButtonElement>('eSave');
		const nErr = $('nErr'), nSaved = $('nSaved'), nSubmit = $<HTMLButtonElement>('nSubmit');

		let scheduled: Rec[] = [];
		let done: Rec[] = [];
		let openFolders = new Set<string>(['scheduled']);
		let current: Rec | null = null;

		// ---------- tasks ----------
		function setTask(task: string) {
			shell.dataset.task = task;
			for (const b of shell.querySelectorAll<HTMLElement>('[data-task-btn]')) {
				const on = b.dataset.taskBtn === task;
				b.classList.toggle('on', on);
				if (on) b.setAttribute('aria-current', 'true');
				else b.removeAttribute('aria-current');
			}
			if (task === 'edit' && !current) { emptyMsg.hidden = false; form.hidden = true; }
		}
		for (const b of shell.querySelectorAll<HTMLElement>('[data-task-btn]'))
			b.onclick = () => setTask(b.dataset.taskBtn!);

		// ---------- load ----------
		async function load(keepSelection = true) {
			try {
				const [a, b] = await Promise.all([
					fetch(EVENTS_API + '/api/events').then((r) => r.json()),
					fetch(EVENTS_API + '/api/events/past').then((r) => r.json()),
				]);
				scheduled = (a.events as Row[]).map((r) => ({ ...r, past: false }));
				done = (b.events as Row[]).map((r) => ({ ...r, past: true }));
				listErr.hidden = true;
			} catch (e) {
				// The rail is the only place this can be said, and it is visible in edit
				// mode at every width.
				listErr.textContent = 'Could not reach the events service.';
				listErr.hidden = false;
				return;
			}

			evCount.textContent = String(scheduled.length + done.length);

			// Types offered to both forms come from what is already in use, so the set
			// grows by someone typing a new one rather than by a deploy.
			const types = [...new Set([...scheduled, ...done].map((r) => r.event_type).filter(Boolean))].sort();
			typesList.innerHTML = types.map((t) => `<option value="${esc(t)}"></option>`).join('');

			renderTree();

			// A save re-reads the list; the row that was open should stay open.
			if (keepSelection && current) {
				const again = [...scheduled, ...done].find((r) => r.event_id === current!.event_id);
				if (again) select(again);
				else { current = null; form.hidden = true; emptyMsg.hidden = false; }
			}
		}

		// ---------- rail ----------
		function rowHTML(r: Rec, last: boolean) {
			const p = dparts(r.starts_at.slice(0, 10));
			return `<button class="tnode titem${last ? ' last' : ''}${current?.event_id === r.event_id ? ' active' : ''}"
				data-ev="${esc(r.event_id)}" role="treeitem" type="button">
				<i class="tnum">${esc(r.starts_at.slice(11))}</i>
				<span class="tname">${esc(r.name)}</span>
				<span class="tmeta">${esc(p.dd)} ${esc(p.mon)}</span>
			</button>`;
		}

		function folderHTML(key: string, label: string, rows: Rec[]) {
			const open = openFolders.has(key);
			return `<button class="tnode tcat${open ? ' open' : ''}" data-folder="${key}" type="button">
					<span class="tcaret">${caretRight}</span>
					<span class="tname">${esc(label)}</span>
					<span class="tmeta">${rows.length}</span>
				</button>
				<div class="tkids"${open ? '' : ' hidden'}>
					${rows.map((r, i) => rowHTML(r, i === rows.length - 1)).join('')}
				</div>`;
		}

		function renderTree() {
			tree.innerHTML =
				folderHTML('scheduled', 'Scheduled', scheduled) +
				folderHTML('archive', 'Archive', done);

			for (const b of tree.querySelectorAll<HTMLElement>('[data-folder]'))
				b.onclick = () => {
					const k = b.dataset.folder!;
					openFolders.has(k) ? openFolders.delete(k) : openFolders.add(k);
					renderTree();
				};
			for (const b of tree.querySelectorAll<HTMLElement>('[data-ev]'))
				b.onclick = () => {
					const r = [...scheduled, ...done].find((x) => x.event_id === b.dataset.ev);
					if (r) { setTask('edit'); select(r); }
				};
		}

		// ---------- editor ----------
		function select(r: Rec) {
			current = r;
			emptyMsg.hidden = true;
			form.hidden = false;
			eErr.hidden = true;
			eSaved.hidden = true;

			f.id.textContent = r.event_id;
			f.name.value = r.name;
			f.type.value = r.event_type ?? '';
			f.venue.value = r.venue ?? '';
			f.start.value = toInput(r.starts_at);
			f.end.value = toInput(r.ends_at);
			f.desc.value = r.description ?? '';
			f.reg.value = r.registration_link ?? '';
			f.gal.value = r.gallery_link ?? '';
			f.sum.value = r.summary ?? '';

			// An archived event is a record of something that already happened. The API
			// will only take gallery_link and summary for it, so the rest is shown as a
			// read-only record rather than as fields that silently fail to save.
			for (const el of [f.name, f.type, f.venue, f.start, f.end, f.desc]) el.readOnly = r.past;
			f.start.disabled = r.past;
			f.end.disabled = r.past;
			f.locked.hidden = !r.past;
			f.regField.hidden = r.past;
			f.galField.hidden = !r.past;
			f.sumField.hidden = !r.past;
			$<HTMLButtonElement>('eDelete').hidden = r.past;

			showPoster(r);
			paintPreview();
			renderTree();
		}

		/** The cell has exactly two states, and the buttons follow the picture. */
		function showPoster(r: Rec, bust: number | '' = '') {
			poster.err.hidden = true;
			poster.input.value = '';
			const has = Boolean(r.has_poster);
			poster.img.hidden = !has;
			poster.text.hidden = has;
			poster.del.hidden = !has;
			poster.state.textContent = has ? 'Uploaded' : 'None';
			poster.pick.textContent = has ? 'REPLACE' : 'CHOOSE FILE';
			disarmPosterDelete();
			if (has) poster.img.src = posterUrl(r.event_id, bust || Date.now());
			else poster.img.removeAttribute('src');
		}

		// REMOVE deletes an object out of R2, so it arms first. Two clicks, no dialog —
		// a modal for something one re-upload undoes is more ceremony than it is worth.
		let posterArmed = false;
		function disarmPosterDelete() {
			posterArmed = false;
			poster.del.classList.remove('armed');
			poster.del.textContent = 'REMOVE';
		}

		async function uploadPoster(id: string, file: File) {
			const body = new FormData();
			body.set('poster', file);
			// No Content-Type: the browser must set it itself so the multipart boundary
			// is included, or the Worker cannot parse the body at all.
			await evFetch(`/api/events/${id}/poster`, { method: 'POST', body });
		}

		poster.pick.onclick = () => poster.input.click();
		poster.input.onchange = async () => {
			const file = poster.input.files?.[0];
			if (!file || !current) return;
			const bad = badPoster(file);
			if (bad) { poster.err.textContent = bad; poster.err.hidden = false; poster.input.value = ''; return; }

			poster.err.hidden = true;
			poster.state.textContent = 'Uploading…';
			poster.pick.disabled = true;
			try {
				await uploadPoster(current.event_id, file);
				current.has_poster = 1;
				showPoster(current);
				await load();
			} catch (e) {
				poster.err.textContent = (e as Error).message;
				poster.err.hidden = false;
				showPoster(current);
			} finally {
				poster.pick.disabled = false;
			}
		};

		poster.del.onclick = async () => {
			if (!current) return;
			if (!posterArmed) {
				posterArmed = true;
				poster.del.classList.add('armed');
				poster.del.textContent = 'CONFIRM REMOVE';
				return;
			}
			poster.del.disabled = true;
			try {
				await evFetch(`/api/events/${current.event_id}/poster`, { method: 'DELETE' });
				current.has_poster = 0;
				showPoster(current);
				await load();
			} catch (e) {
				poster.err.textContent = (e as Error).message;
				poster.err.hidden = false;
			} finally {
				poster.del.disabled = false;
			}
		};

		// Drag and drop onto the plate, which is what anyone will try first.
		// No AbortSignal: unlike the storefront these listeners sit on page-local nodes
		// that the client router discards wholesale, and this function only ever runs
		// once per swapped DOM (the `inited` guard above).
		for (const ev of ['dragenter', 'dragover'] as const)
			poster.drop.addEventListener(ev, (e) => { e.preventDefault(); poster.drop.classList.add('over'); });
		for (const ev of ['dragleave', 'drop'] as const)
			poster.drop.addEventListener(ev, () => poster.drop.classList.remove('over'));
		poster.drop.addEventListener('drop', (e) => {
			e.preventDefault();
			const file = (e as DragEvent).dataTransfer?.files?.[0];
			if (!file) return;
			// Route through the same handler as the picker: one validation path, not two.
			const dt = new DataTransfer();
			dt.items.add(file);
			poster.input.files = dt.files;
			poster.input.dispatchEvent(new Event('change'));
		});

		/** The storefront's own timeline row, redrawn from the fields on every keystroke. */
		function paintPreview() {
			const start = fromInput(f.start.value), end = fromInput(f.end.value);
			$('pvTime').textContent = start.slice(11) || '--:--';
			$('pvChip').textContent = (f.type.value || 'Event').toUpperCase();
			$('pvVenue').textContent = (f.venue.value || 'VENUE').toUpperCase();
			$('pvName').textContent = f.name.value || 'Event name';
			$('pvDesc').textContent = f.desc.value || 'The description shows here, clamped to two lines.';

			const iso = start.slice(0, 10);
			if (iso.length === 10) {
				const p = dparts(iso);
				$('pvWhen').textContent = `${p.wd} ${p.dd} ${p.mon}`;
			} else $('pvWhen').textContent = '—';
			$('pvClock').textContent = start && end ? `${start.slice(11)} – ${end.slice(11)}` : '—';
			$('pvLen').textContent = start && end ? runLength(start, end) : '—';

			const cta = $('pvCta');
			if (current?.past) {
				cta.textContent = f.gal.value.trim()
					? 'VIEW GALLERY button shows, linking to the Drive folder.'
					: 'No gallery link — the button is hidden.';
			} else {
				cta.textContent = f.reg.value.trim()
					? 'REGISTER button shows, linking to the form.'
					: 'No registration link — the button is hidden.';
			}
		}
		for (const el of [f.name, f.type, f.venue, f.start, f.end, f.desc, f.reg, f.gal])
			el.addEventListener('input', paintPreview);

		$('eReset').onclick = () => { if (current) select(current); };

		form.onsubmit = async (e) => {
			e.preventDefault();
			if (!current) return;
			eErr.hidden = true;
			eSaved.hidden = true;

			try {
				if (current.past) {
					const bad = badLink(f.gal.value);
					if (bad) throw new Error(bad);
					await evFetch(`/api/events/past/${current.event_id}`, {
						method: 'PUT',
						body: JSON.stringify({ gallery_link: f.gal.value.trim(), summary: f.sum.value.trim() }),
					});
				} else {
					const body = readScheduled({
						name: f.name.value, event_type: f.type.value, venue: f.venue.value,
						starts_at: f.start.value, ends_at: f.end.value,
						description: f.desc.value, registration_link: f.reg.value,
					});
					await evFetch(`/api/events/${current.event_id}`, { method: 'PUT', body: JSON.stringify(body) });
				}
				// After load(), not before: load() re-selects the row it just refetched, and
				// select() clears this flag — so the confirmation flashed and vanished.
				await load();
				eSaved.hidden = false;
			} catch (err) {
				eErr.textContent = (err as Error).message;
				eErr.hidden = false;
			} finally {
				eSave.disabled = false;
			}
		};

		/** Client-side mirror of the Worker's own checks — the server still owns the rule,
		 *  this just says which field is wrong without a round trip. */
		function readScheduled(v: Record<string, string>) {
			const need: [string, string][] = [
				['name', 'Name'], ['event_type', 'Type'], ['venue', 'Venue'],
				['starts_at', 'Start time'], ['ends_at', 'End time'], ['description', 'Description'],
			];
			for (const [k, label] of need) if (!v[k]?.trim()) throw new Error(`${label} is required`);
			const starts_at = fromInput(v.starts_at), ends_at = fromInput(v.ends_at);
			if (ends_at <= starts_at) throw new Error('The end time must be after the start time');
			const bad = badLink(v.registration_link ?? '');
			if (bad) throw new Error(bad);
			return {
				name: v.name.trim(), event_type: v.event_type.trim(), venue: v.venue.trim(),
				description: v.description.trim(), starts_at, ends_at,
				registration_link: v.registration_link?.trim() || null,
			};
		}

		// ---------- delete ----------
		const delModal = $('delModal');
		const closeDel = () => { delModal.hidden = true; };
		$('eDelete').onclick = () => {
			if (!current || current.past) return;
			$('delName').textContent = current.name;
			$('delErr').hidden = true;
			delModal.hidden = false;
		};
		$('delClose').onclick = closeDel;
		$('delCancel').onclick = closeDel;
		delModal.onclick = (e) => { if (e.target === delModal) closeDel(); };
		$('delGo').onclick = async () => {
			if (!current) return;
			const btn = $<HTMLButtonElement>('delGo');
			btn.disabled = true;
			try {
				await evFetch(`/api/events/${current.event_id}`, { method: 'DELETE' });
				current = null;
				closeDel();
				form.hidden = true;
				emptyMsg.hidden = false;
				await load(false);
			} catch (err) {
				$('delErr').textContent = (err as Error).message;
				$('delErr').hidden = false;
			} finally {
				btn.disabled = false;
			}
		};

		// ---------- add: staged drafts ----------
		// Several cards filled in, then sent together, exactly like the merch panel. A
		// fest programme arrives as a day at a time, not one session at a time.
		function renumber() {
			[...draftsBox.children].forEach((d, i) => {
				(d.querySelector('.ev-draft-n') as HTMLElement).textContent = `EVENT ${String(i + 1).padStart(2, '0')}`;
				// The last card cannot be removed — an empty add pane has nothing to fill in.
				(d.querySelector('.ev-draft-del') as HTMLButtonElement).disabled = draftsBox.children.length === 1;
			});
		}

		/** The editor's preview, redrawn from a draft card's own fields. Same markup and
		 *  the same two-line clamp as the storefront, so what it shows is what will ship. */
		function paintDraftPreview(row: HTMLElement) {
			const v = (sel: string) => (row.querySelector(sel) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '';
			const set = (sel: string, text: string) => {
				const el = row.querySelector(sel) as HTMLElement | null;
				if (el) el.textContent = text;
			};
			const start = fromInput(v('[data-start]')), end = fromInput(v('[data-end]'));

			set('[data-pvtime]', start.slice(11) || '--:--');
			set('[data-pvchip]', (v('[data-type]') || 'Event').toUpperCase());
			set('[data-pvvenue]', (v('[data-venue]') || 'VENUE').toUpperCase());
			set('[data-pvname]', v('[data-name]') || 'Event name');
			set('[data-pvdesc]', v('[data-desc]') || 'The description shows here, clamped to two lines.');

			const iso = start.slice(0, 10);
			if (iso.length === 10) {
				const p = dparts(iso);
				set('[data-pvwhen]', `${p.wd} ${p.dd} ${p.mon}`);
			} else set('[data-pvwhen]', '—');
			set('[data-pvclock]', start && end ? `${start.slice(11)} – ${end.slice(11)}` : '—');
			set('[data-pvlen]', start && end ? runLength(start, end) : '—');
			set('[data-pvcta]', v('[data-reg]').trim()
				? 'REGISTER button shows, linking to the form.'
				: 'No registration link — the button is hidden.');
		}

		/** Staged, not uploaded: there is no event id to attach a poster to until the row
		 *  has been created, so the file waits in its input and goes up straight after. */
		function wirePosterDrop(row: HTMLElement) {
			const input = row.querySelector('[data-poster]') as HTMLInputElement;
			const img = row.querySelector('[data-preview]') as HTMLImageElement;
			const text = row.querySelector('[data-droptext]') as HTMLElement;
			const size = row.querySelector('[data-postersize]') as HTMLElement;
			const clear = row.querySelector('[data-posterclear]') as HTMLButtonElement;
			const drop = row.querySelector('[data-drop]') as HTMLElement;
			const err = row.querySelector('[data-err]') as HTMLElement;

			const paint = () => {
				const f = input.files?.[0];
				if (!f) {
					// revokeObjectURL: without it every re-pick leaks a blob for the life of
					// the tab, and a long add session can stage a dozen of them.
					if (img.src.startsWith('blob:')) URL.revokeObjectURL(img.src);
					img.hidden = true; img.removeAttribute('src');
					text.hidden = false; clear.hidden = true; size.textContent = 'optional';
					return;
				}
				if (img.src.startsWith('blob:')) URL.revokeObjectURL(img.src);
				img.src = URL.createObjectURL(f);
				img.hidden = false; text.hidden = true; clear.hidden = false;
				size.textContent = `${(f.size / 1048576).toFixed(1)}MB`;
			};

			input.onchange = () => {
				const f = input.files?.[0];
				if (f) {
					const bad = badPoster(f);
					if (bad) { err.textContent = bad; err.hidden = false; input.value = ''; }
					else err.hidden = true;
				}
				paint();
			};
			clear.onclick = (e) => { e.preventDefault(); input.value = ''; paint(); };

			for (const ev of ['dragenter', 'dragover'] as const)
				drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('over'); });
			for (const ev of ['dragleave', 'drop'] as const)
				drop.addEventListener(ev, () => drop.classList.remove('over'));
			drop.addEventListener('drop', (e) => {
				e.preventDefault();
				const f = (e as DragEvent).dataTransfer?.files?.[0];
				if (!f) return;
				const dt = new DataTransfer();
				dt.items.add(f);
				input.files = dt.files;
				input.dispatchEvent(new Event('change'));
			});
		}

		function addDraft(seed?: { starts_at?: string; ends_at?: string; venue?: string; event_type?: string }) {
			const node = draftTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
			// Carry the day, venue and type forward from the card above: entering a
			// programme means six sessions in one room on one date, and retyping the date
			// six times is the difference between this being usable and not.
			if (seed) {
				const q = <T extends HTMLElement>(s: string) => node.querySelector(s) as T;
				if (seed.starts_at) q<HTMLInputElement>('[data-start]').value = seed.starts_at;
				if (seed.ends_at) q<HTMLInputElement>('[data-end]').value = seed.ends_at;
				if (seed.venue) q<HTMLInputElement>('[data-venue]').value = seed.venue;
				if (seed.event_type) q<HTMLInputElement>('[data-type]').value = seed.event_type;
			}
			(node.querySelector('.ev-draft-del') as HTMLButtonElement).onclick = () => {
				if (draftsBox.children.length === 1) return;
				node.remove();
				renumber();
			};
			wirePosterDrop(node);
			// One listener on the card, not one per field: every input bubbles to here and
			// the preview is cheap to redraw whole.
			node.addEventListener('input', () => paintDraftPreview(node));
			paintDraftPreview(node);
			draftsBox.appendChild(node);
			renumber();
			return node;
		}

		$('evDraftAdd').onclick = () => {
			const last = draftsBox.lastElementChild as HTMLElement | null;
			const q = (s: string) => (last?.querySelector(s) as HTMLInputElement | null)?.value ?? '';
			// the new card starts where the previous one ended
			const prevEnd = q('[data-end]');
			addDraft({ starts_at: prevEnd, ends_at: '', venue: q('[data-venue]'), event_type: q('[data-type]') });
			draftsBox.lastElementChild?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		};

		$('nClear').onclick = () => {
			draftsBox.innerHTML = '';
			addDraft();
			nErr.hidden = true;
			nSaved.hidden = true;
		};

		nSubmit.onclick = async () => {
			nErr.hidden = true;
			nSaved.hidden = true;

			const cards = [...draftsBox.children] as HTMLElement[];
			const bodies: ReturnType<typeof readScheduled>[] = [];
			let firstBad: HTMLElement | null = null;

			// Validate everything BEFORE posting anything. Half a programme in the database
			// and half in a form is worse than nothing sent at all.
			for (const card of cards) {
				const q = (s: string) => (card.querySelector(s) as HTMLInputElement | HTMLTextAreaElement).value;
				const err = card.querySelector('[data-err]') as HTMLElement;
				err.hidden = true;
				try {
					bodies.push(readScheduled({
						name: q('[data-name]'), event_type: q('[data-type]'), venue: q('[data-venue]'),
						starts_at: q('[data-start]'), ends_at: q('[data-end]'),
						description: q('[data-desc]'), registration_link: q('[data-reg]'),
					}));
				} catch (e) {
					err.textContent = (e as Error).message;
					err.hidden = false;
					firstBad ??= card;
				}
			}

			if (firstBad) {
				nErr.textContent = 'Some cards are incomplete — see the message on each.';
				nErr.hidden = false;
				firstBad.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return;
			}

			nSubmit.disabled = true;
			nSubmit.textContent = 'SENDING…';
			let sent = 0;
			const posterFails: string[] = [];
			try {
				// Sequential, not Promise.all: if the fourth one is rejected the message has
				// to name which, and a parallel batch would leave three already written with
				// no way to say which card matched which failure.
				for (const body of bodies) {
					const made = await evFetch<{ event_id: string }>('/api/events', {
						method: 'POST', body: JSON.stringify(body),
					});
					// The poster can only go up once the row exists to hang it on. A failure
					// here must not lose the event that was just created, so it is reported
					// and the loop carries on — the poster can be added from Edit.
					const file = (cards[sent].querySelector('[data-poster]') as HTMLInputElement).files?.[0];
					if (file) {
						try { await uploadPoster(made.event_id, file); }
						catch (e) { posterFails.push(`${body.name}: ${(e as Error).message}`); }
					}
					cards[sent].remove();
					sent++;
				}
				nSaved.textContent = posterFails.length
					? `${sent} event${sent === 1 ? '' : 's'} added — but the poster failed on ${posterFails.length}. Add it from Edit.`
					: `${sent} event${sent === 1 ? '' : 's'} added.`;
				nSaved.hidden = false;
				addDraft();
				await load(false);
			} catch (err) {
				nErr.textContent = sent
					? `${sent} added, then: ${(err as Error).message}. The rest are still here.`
					: (err as Error).message;
				nErr.hidden = false;
				renumber();
				await load(false);
			} finally {
				nSubmit.disabled = false;
				nSubmit.textContent = 'ADD TO SCHEDULE';
			}
		};

		// ---------- go ----------
		addDraft();
		setTask('add');
		load(false);
	}

	document.addEventListener('astro:page-load', initEventsAdmin);
</script>

<style is:global>
	/* ponytail: the rail/pane chassis is a second copy of the merch panel's, under an
	   ev- prefix rather than a shared stylesheet. Extracting it would mean unpicking
	   ~30 rule blocks that are threaded through 1000 lines of merch-specific CSS with
	   .m-shell[data-task=…] combinators pointing at merch-only elements — a real
	   regression risk on a page that works, to save 40 lines here. The pieces that
	   already ARE shared files (catalogue-tree.css, admin-controls.css) are reused.
	   Extract the chassis the day a third panel needs it. */

	/* ---- shell: task rail | programme | work area ---- */
	/* One variable drives both rails, so they cannot drift out of alignment. */
	/* Two rails, two widths. One shared 280px value made the task rail — which holds two
	   labels — as wide as the programme rail, which holds an event name, a time and a
	   date and was wrapping names onto three lines to do it. */
	.ev-shell { flex-direction: row; --task-rail: 224px; --list-rail: 312px; }
	.ev-tasks {
		flex: none; width: var(--task-rail); box-sizing: border-box;
		display: flex; flex-direction: column; gap: 6px;
		padding: 20px 14px;
		border-right: var(--stroke) solid var(--secondary);
	}
	.ev-task {
		display: flex; align-items: center; gap: 10px;
		box-sizing: border-box; width: 100%;
		padding: 12px 13px; text-align: left;
		font-size: 12.5px; font-weight: 700;
	}
	.ev-task.on { background: var(--secondary); color: var(--primary); border-color: var(--secondary); }
	.ev-task-icon { display: grid; place-items: center; flex: none; }
	.ev-task-icon svg { width: 16px; height: 16px; stroke-width: 2; }
	.ev-task-label { flex: 1; }
	.ev-add-icon { display: grid; place-items: center; }
	.ev-add-icon svg { width: 14px; height: 14px; stroke-width: 2.6; }

	.ev-panes {
		flex: 1; min-height: 0;
		display: grid; grid-template-columns: var(--list-rail) minmax(0, 1fr);
	}
	/* The programme rail only belongs to the edit task; the work area takes the full
	   width for the other one rather than leaving a dead column. */
	.ev-shell:not([data-task='edit']) .ev-list-pane { display: none; }
	.ev-shell:not([data-task='edit']) .ev-panes { grid-template-columns: 1fr; }
