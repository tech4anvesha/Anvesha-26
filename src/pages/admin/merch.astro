	   is what closes the visible gap between them. */
	.rc-item::after {
		content: ''; position: absolute; left: 2.75px; top: 12px; bottom: -14px;
		width: 1.5px; background: var(--accent);
	}
	/* A single item has nothing to connect to, and the header is a label, not a step. */
	.rc-item:last-child::after { display: none; }
	.rc-item-head::before, .rc-item-head::after { display: none; }

	.rc-item-head {
		margin-bottom: 10px;
		font-size: 9.5px; letter-spacing: .12em; color: var(--ink-40);
	}
	/* The whole line is the timeline entry, so it carries the accent — the total below
	   stays in ink, which keeps it the one figure that reads as final. */
	.rc-item { color: var(--accent); }
	.rc-item-name { min-width: 0; word-break: break-word; }
	.rc-item-q { min-width: 34px; text-align: right; }
	.rc-item-amt { min-width: 62px; text-align: right; }
	/* The header is a column label, not an entry. */
	.rc-item-head { color: var(--ink-40); }

	/* Double rule above the total — the one line on a bill that always gets one. */
	.rc-total {
		display: flex; justify-content: space-between; align-items: baseline; gap: 14px;
		padding: 12px 0;
		border-top: 3px double var(--secondary); border-bottom: 3px double var(--secondary);
		letter-spacing: .12em;
	}
	.rc-total b {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 17px; letter-spacing: -.01em;
	}

	.rc-foot {
		margin: 14px 0 0; padding-top: 12px;
		border-top: 1.5px dashed var(--secondary);
		text-align: center; font-size: 9px; letter-spacing: .1em; line-height: 1.7;
		color: var(--ink-40);
	}

	.ov-warn { margin: 0 0 14px; font-size: 13px; line-height: 1.6; color: var(--ink-60); }
	.ov-id {
		margin: 0 0 12px; padding: 10px 12px;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 12px; word-break: break-all;
		background: var(--sink); border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}

	/* ---- add drafts ---- */
	/* No max-width: the card and its views box are a two-column pair and should use the
	   full pane, not sit in a narrow column with the rest of the page empty. */
	.m-new { display: flex; flex-direction: column; gap: 14px; }

	/* In add mode the pane hands its scrolling to .m-new-scroll — two nested scrollers
	   would fight, and the outer one is what carries the footer away. */
	.m-shell[data-task='add'] .m-edit-pane {
		overflow: hidden;
		display: flex; flex-direction: column;
	}
	.m-shell[data-task='add'] .m-new { flex: 1; min-height: 0; }

	.m-new-head { flex: none; display: flex; flex-direction: column; gap: 10px; }
	.m-new-scroll {
		flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
		display: flex; flex-direction: column; gap: 14px;
		/* room for the focus shadow on controls at the very edge */
		padding: 4px 6px 4px 4px; margin: -4px -6px -4px -4px;
	}
	.m-new-foot {
		flex: none;
		display: flex; flex-direction: column; gap: 10px;
		padding-top: 14px;
		/* The rule is what tells you the list above is scrolled, not ended. */
		border-top: var(--stroke) solid var(--secondary);
		background: var(--primary);
	}
	.m-new-hint { margin: -6px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--ink-60); }

	.m-draft {
		display: flex; flex-direction: column; gap: 12px;
		padding: 16px; margin-bottom: 12px;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.m-draft-head { display: flex; align-items: center; justify-content: space-between; }
	.m-draft-n {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10px; letter-spacing: .16em; color: var(--ink-40);
	}
	.m-draft-del { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; }
	.m-draft-del svg { width: 13px; height: 13px; stroke-width: 2.2; }
	.m-draft-body { display: grid; grid-template-columns: 116px 1fr; gap: 12px; align-items: start; }
	.m-drops { display: flex; flex-direction: column; gap: 8px; }

	/* ---- extra views: its own box, wired to the card ---- */
	/* --wire is the gap the connector has to cross; one value so the line and the
	   spacing can never disagree. */
	/* stretch, not start: the views box matches the card's height so the pair reads as
	   one unit rather than a tall form with a small tag hanging off it. */
	.m-draft-row {
		--wire: 30px;
		display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: var(--wire); align-items: stretch;
		margin-bottom: 14px;
	}
	.m-draft { margin-bottom: 0; }

	.m-views-box {
		position: relative; min-height: 0;
		display: flex; flex-direction: column; gap: 10px;
		padding: 14px;
		background: var(--sink);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	/* The connector, drawn the same way the catalogue tree draws its elbows: a border,
	   not a glyph, so it lines up regardless of font. Used by both the add card and the
	   editor's bento, which is why it hangs off the box rather than the thing beside it. */
	.m-views-box::before {
		content: ''; position: absolute;
		left: calc(var(--wire) * -1); top: 26px;
		width: var(--wire); height: 1.5px;
		background: var(--secondary);
	}
	/* The terminal node, marking where the wire lands. Same border-box maths as .m-wire:
	   a 10px node offset -4px straddles this box's own 2px border. */
	.m-views-box::after {
		content: ''; position: absolute; box-sizing: border-box;
		left: -4px; top: 22px;
		width: 10px; height: 10px;
		background: var(--accent);
		border: 1.5px solid var(--secondary); border-radius: var(--r);
	}

	.m-views-head {
		display: flex; align-items: center; justify-content: space-between; gap: 10px;
		margin: 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
	}
	.m-views-head b {
		display: inline-grid; place-items: center;
		min-width: 18px; height: 16px; padding: 0 4px;
		font-size: 9.5px; color: var(--primary); background: var(--accent);
		border-radius: var(--r);
	}

	/* Three across, rows at a FIXED height.
	   `1fr` rows only divide a definite height; this grid's height comes from its own
	   content, so fr degenerated to `auto` and every row grew to fit its tallest
	   picture — a portrait shot stretched the whole box. A fixed row height decouples
	   the layout from the images entirely. */
	.m-views-grid {
		--tgap: 10px; --tile: 88px;
		flex: 1; min-height: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-auto-rows: var(--tile);
		align-content: start;
		gap: var(--tgap);
		overflow-y: auto; overscroll-behavior: contain;
		padding-right: 2px;
	}
	.m-view-slot {
		appearance: none; -webkit-appearance: none;
		display: grid; place-items: center; overflow: hidden;
		/* height, not min-height: the row is fixed and the tile fills it, so nothing
		   inside can push it taller. */
		height: 100%; min-height: 0; padding: 0;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 19px; color: var(--ink-40);
		background: var(--primary);
		border: var(--stroke) dashed var(--secondary); border-radius: var(--r);
		cursor: pointer;
		transition: border-color .12s ease, color .12s ease;
	}
	.m-view-slot:hover { border-color: var(--accent); color: var(--accent); }
	/* A filled slot is a picture, not a target: solid border, no dashes, no pointer. */
	.m-view-slot.filled { position: relative; border-style: solid; padding: 0; cursor: default; }
	/* contain, not cover: the whole picture is scaled to fit the fixed tile rather than
	   being cropped to fill it — a tall poster stays recognisable in a wide slot. */
	.m-view-slot img {
		width: 100%; height: 100%; display: block; min-width: 0; min-height: 0;
		object-fit: contain; background: var(--sink);
	}
	.m-view-del {
		position: absolute; top: 3px; right: 3px;
		display: grid; place-items: center;
		width: 19px; height: 19px; padding: 0;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 13px; line-height: 1;
		color: var(--primary); background: var(--secondary);
		border: 1.5px solid var(--primary); border-radius: var(--r);
		cursor: pointer;
	}
	.m-view-del:hover { background: var(--accent); border-color: var(--primary); }

	/* Bottom-left, opposite the remove button, so the two can never be mis-hit. */
	.m-view-warn {
		position: absolute; bottom: 3px; left: 3px;
		display: grid; place-items: center;
		width: 19px; height: 19px; padding: 0;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 12px; font-weight: 500;
		line-height: 1;
		color: var(--primary); background: var(--accent);
		border: 1.5px solid var(--primary); border-radius: var(--r);
		cursor: pointer;
	}
	.m-view-warn:hover { background: var(--secondary); }
	.m-drop-warn { bottom: 5px; left: 5px; z-index: 1; }

	.m-note {
		margin: 0; padding: 9px 11px;
		font-size: 11.5px; line-height: 1.55;
		color: var(--primary); background: var(--accent);
		border-radius: var(--r);
	}

	.m-views-hint {
		margin: 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-40);
	}
	.m-views-hint.over { color: var(--accent); }

	/* Wired from ABOVE rather than the side: same line and node, rotated to match a
	   stacked layout instead of a side-by-side one. */
	.m-views-below::before {
		left: 34px; top: calc(var(--wire) * -1);
		width: 1.5px; height: var(--wire);
	}
	/* Straddling the top border instead of the left one, centred on the vertical wire. */
	.m-views-below::after { left: 30px; top: -4px; right: auto; }

	/* ---- storefront preview ---- */
	.m-preview { gap: 14px; min-height: 0; }
	.pv { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 12px; }

	/* The stage takes the slack, exactly as it does on the storefront — the copy and
	   the buy bar keep their natural height and the picture grows into whatever is left. */
	.pv-stage {
		flex: 1; min-height: 190px;
		display: grid; place-items: center; overflow: hidden;
		background: var(--sink);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.pv-stage > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
	.pv-stage img { display: none; width: 100%; height: 100%; object-fit: contain; }
	.pv-stage img.ok { display: block; }
	.pv-stage img.ok ~ .pv-icon { display: none; }
	.pv-icon { display: grid; place-items: center; color: var(--ink-40); }
	.pv-icon svg { width: 58px; height: 58px; stroke-width: 1.4; }

	.pv-label {
		margin: 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .16em; color: var(--ink-40);
	}

	.pv-views { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
	.pv-views::-webkit-scrollbar { display: none; }
	/* Landscape, like the frames on the storefront — a portrait chip reads as a button,
	   a wide one reads as a picture. */
	.pv-view {
		position: relative; overflow: hidden;
		appearance: none; flex: none;
		width: 124px; aspect-ratio: 16 / 11;
		display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px;
		padding: 10px; cursor: pointer;
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.pv-view.active { background: var(--secondary); }
	.pv-view-art { flex: 1; min-height: 0; width: 100%; display: grid; place-items: center; }
	.pv-view-art > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
	.pv-view-art img { display: none; max-width: 100%; max-height: 100%; object-fit: contain; }
	.pv-view-art img.ok { display: block; }
	.pv-view-art img.ok ~ .pv-view-icon { display: none; }
	.pv-view-icon { color: var(--ink-40); line-height: 0; }
	.pv-view.active .pv-view-icon { color: var(--primary); }
	.pv-view-icon svg { width: 26px; height: 26px; stroke-width: 1.6; }
	.pv-view-label {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 8.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-40);
		max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	.pv-view.active .pv-view-label { color: var(--primary); }
	/* Pinned to the corner and always ink-on-white-outline, so it stays legible whether
	   the tile behind it is white or filled. */
	.pv-view-n {
		/* Inset from the corner: at 0,0 the tile's own overflow:hidden clips the badge's
		   top and left borders and it reads as an open-sided box. */
		position: absolute; top: 5px; left: 5px; z-index: 1;
		padding: 3px 7px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; font-style: normal; letter-spacing: .06em;
		color: var(--primary); background: var(--secondary);
		border: 1px solid var(--primary); border-radius: var(--r);
	}

	/* ---- pager: arrows, scrub, counter ---- */
	.pv-pager { display: flex; align-items: center; gap: 10px; }
	.pv-arrow { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; }
	.pv-arrow svg { width: 14px; height: 14px; stroke-width: 2.2; }
	.pv-arrow:disabled { opacity: .3; cursor: not-allowed; }
	.pv-count {
		flex: none;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 9.5px;
		font-weight: 400; letter-spacing: .1em; color: var(--ink-40);
	}
	/* The live one sits at the head of the track and is the only part that changes. */
	.pv-cur { color: var(--secondary); }

	/* Native range — drag, keyboard and a11y for free; only the skin is ours, same as
	   the storefront's pager. */
	.pv-slider {
		flex: 1; appearance: none; -webkit-appearance: none;
		background: transparent; cursor: pointer; height: 18px; margin: 0; min-width: 40px;
	}
	.pv-slider::-webkit-slider-runnable-track {
		height: 2px; background: color-mix(in srgb, var(--secondary) 30%, transparent);
	}
	.pv-slider::-webkit-slider-thumb {
		appearance: none; -webkit-appearance: none;
		width: 13px; height: 13px; margin-top: -5.5px;
		background: var(--accent);
		border: 1.5px solid var(--secondary); border-radius: var(--r);
	}
	.pv-slider::-moz-range-track {
		height: 2px; background: color-mix(in srgb, var(--secondary) 30%, transparent);
	}
	.pv-slider::-moz-range-thumb {
		width: 13px; height: 13px; box-sizing: border-box;
		background: var(--accent);
		border: 1.5px solid var(--secondary); border-radius: var(--r);
	}
	.pv-slider:disabled { opacity: .35; cursor: not-allowed; }

	.pv-name {
		margin: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: 26px; line-height: .98; letter-spacing: -.02em;
		text-transform: uppercase; color: var(--secondary);
	}
	.pv-desc {
		margin: 0; font-style: italic; font-size: 12.5px; line-height: 1.55; color: var(--ink-60);
	}
	/* align-self, as on the storefront: the credit hangs off the right under the copy
	   rather than starting a new left-aligned line. */
	.pv-designer {
		align-self: flex-end;
		display: flex; align-items: center; gap: 8px; margin: 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-40);
	}
	.pv-designer:not(:empty)::before { content: ''; width: 16px; height: 1.5px; background: var(--accent); }
	.pv-designer b { font-weight: 500; color: var(--secondary); }

	.pv-sizes { display: flex; align-items: center; gap: 6px; }
	/* Labels the row the way the storefront's own size control does. */
	.pv-opt-label {
		margin-right: 4px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .14em; text-transform: uppercase;
		color: var(--ink-40);
		border-bottom: 1.5px solid var(--hair);
	}
	.pv-size {
		display: grid; place-items: center; min-width: 30px; padding: 6px 4px;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 10.5px;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.pv-size.on { color: var(--primary); background: var(--secondary); }

	.pv-buy {
		display: flex; align-items: center; justify-content: center; gap: 11px;
		padding: 13px;
		color: var(--primary); background: var(--secondary); border-radius: var(--r);
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 10.5px; letter-spacing: .14em;
	}
	.pv-dot { width: 5px; height: 5px; background: var(--accent); border-radius: 50%; }
	.pv-price { font-size: 15px; letter-spacing: -.01em; }

	.pv-hidden {
		margin: 0; padding: 7px 10px; text-align: center;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .12em; text-transform: uppercase;
		color: var(--primary); background: var(--accent); border-radius: var(--r);
	}
	.m-draft-fields { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
	.m-draft-toggles { display: flex; flex-direction: column; gap: 8px; justify-content: center; }
	.m-draft-err { margin: 0; font-size: 12px; color: var(--accent); }

	/* The whole tile is the file input's label, so the click target is the picture. */
	.m-drop {
		display: grid; place-items: center;
		height: 116px; cursor: pointer;
		background: var(--sink);
		border: var(--stroke) dashed var(--secondary); border-radius: var(--r);
		overflow: hidden;
	}
	.m-drop > * { grid-area: 1 / 1; min-width: 0; min-height: 0; }
	.m-drop:hover { border-color: var(--accent); }
	.m-drop-img { display: none; width: 100%; height: 116px; object-fit: cover; }
	.m-drop-img.ok { display: block; }
	.m-drop-text {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .12em; text-align: center; color: var(--ink-40);
		padding: 0 8px;
	}

	.m-draft-add {
		align-self: flex-start;
		display: flex; align-items: center; gap: 8px;
		padding: 11px 14px;
		font-size: 10.5px; font-weight: 800; letter-spacing: .12em;
	}

	/* ---- right: editor ---- */
	.m-edit-pane { min-height: 0; overflow-y: auto; padding: 24px 30px 30px; }
	.m-empty { margin: 0; font-size: 13px; color: var(--ink-40); }
	/* Same three bands as the add form: fixed head, scrolling body, pinned actions. */
	.m-form { display: flex; flex-direction: column; gap: 14px; min-height: 0; }
	.m-shell[data-task='edit'] .m-edit-pane {
		overflow: hidden;
		display: flex; flex-direction: column;
	}
	.m-shell[data-task='edit'] .m-form { flex: 1; }
	.m-edit-scroll {
		flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
		display: flex; flex-direction: column;
		padding: 4px 6px 4px 4px; margin: -4px -6px -4px -4px;
	}
	/* The bento fills the scroll area and both columns stretch to its full height. The
	   form itself stays content-sized; the views strip below it takes up the slack, so
	   the space goes to something useful instead of padding the form out. */
	.m-edit-scroll > .m-bento { flex: 1; min-height: 0; align-items: stretch; }
	.m-edit-left {
		display: flex; flex-direction: column; gap: var(--wire);
		min-width: 0; min-height: 0;
	}
	/* The form takes the slack now, not the views strip: the spare height goes into the
	   description, which is the field that actually benefits from being taller. */
	.m-edit-left > .m-cell-fields { flex: 1; min-height: 0; }
	.m-edit-left > .m-views-below { flex: none; }
	/* The description is the one field allowed to grow; everything else keeps its size. */
	.m-field-grow { flex: 1; min-height: 0; }
	.m-field-grow textarea { flex: 1; min-height: 90px; }

	/* Destructive, and styled to say so. Only fills once armed — a permanently red
	   button in a row of three is just noise until it matters. */
	.a-btn-danger {
		box-sizing: border-box; padding: 15px 18px;
		font-size: 11.5px; font-weight: 800; letter-spacing: .14em;
		color: var(--accent); border-color: var(--accent);
	}
	.a-btn-danger.armed { color: var(--primary); background: var(--accent); }
	.a-btn-danger:disabled { opacity: .45; cursor: wait; }

	/* ---- bento: details beside the pictures ---- */
	/* Wired the same way the add form is, and stretched so the two cells end level. */
	.m-bento {
		--wire: 30px;
		display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: var(--wire); align-items: stretch;
	}
	.m-cell {
		position: relative;
		display: flex; flex-direction: column; gap: 13px;
		padding: 18px; min-height: 0;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}

	/* A wire from a source box into the preview. An element rather than a pseudo because
	   each box needs both a line and a terminal node, and ::before/::after are already
	   spoken for on the views box by its vertical wire. */
	.m-wire {
		position: absolute; right: calc(var(--wire) * -1); top: 34px;
		width: var(--wire); height: 1.5px;
		background: var(--secondary);
	}
	/* border-box, or the 1.5px border makes the node 11px wide and it lands off-centre.
	   right:-6 on a 10px node puts its middle 1px past the wire's end — the centre of
	   the target's 2px border, so the dot sits ON the line rather than beside it. */
	.m-wire::after {
		content: ''; position: absolute; box-sizing: border-box;
		right: -6px; top: 50%; transform: translateY(-50%);
		width: 10px; height: 10px;
		background: var(--accent);
		border: 1.5px solid var(--secondary); border-radius: var(--r);
	}
