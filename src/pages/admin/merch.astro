---
/**
 * Merch admin. A task rail on the left picks what you are doing; the panes to its right
 * change to suit. Edit mode adds the storefront's own catalogue tree
 * (styles/catalogue-tree.css) so both sides of the site browse the catalogue identically.
 *
 * Every write broadcasts over the live socket, so other admins and every open
 * storefront tab update without a refresh.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import '../../styles/catalogue-tree.css';
import caretRight from 'lucide-static/icons/chevron-right.svg?raw';
import chevronLeft from 'lucide-static/icons/chevron-left.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import iPlus from 'lucide-static/icons/plus.svg?raw';
import iTrash from 'lucide-static/icons/trash-2.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';
import iEdit from 'lucide-static/icons/square-pen.svg?raw';
import iAdd from 'lucide-static/icons/package-plus.svg?raw';
import iOrders from 'lucide-static/icons/receipt-text.svg?raw';
import iDownload from 'lucide-static/icons/download.svg?raw';
import iLayers from 'lucide-static/icons/layers.svg?raw';
import iScan from 'lucide-static/icons/scan-line.svg?raw';
---

<AdminLayout title="Merch — Admin — Anvesha '26">
	<div class="a-wrap m-shell" data-task="edit">
		<!-- TASK RAIL -->
		<nav class="m-tasks" aria-label="Merch tasks">
			<button class="btn m-task" data-task-btn="edit" aria-current="true">
				<span class="m-task-icon" set:html={iEdit} />
				<span class="m-task-label">Edit merch</span>
			</button>
			<button class="btn m-task" data-task-btn="add">
				<span class="m-task-icon" set:html={iAdd} />
				<span class="m-task-label">Add merch</span>
			</button>
			<button class="btn m-task" data-task-btn="orders">
				<span class="m-task-icon" set:html={iOrders} />
				<span class="m-task-label">Orders</span>
			</button>
		</nav>

		<div class="m-panes">
			<!-- CATALOGUE — edit mode only -->
			<aside class="m-list-pane" id="mCataloguePane">
				<p class="a-eyebrow">Catalogue <b id="mCount">—</b></p>
				<div class="tree" id="mTree" role="tree" aria-label="Merch catalogue"></div>
			</aside>

			<!-- WORK AREA -->
			<section class="m-edit-pane scroll-y">
				<p class="m-empty" id="mEmpty">Pick an item to edit it.</p>

				<form class="m-form" id="mForm" hidden novalidate>
					<div class="m-edit-scroll">
						<!-- Bento: the form and its views strip on the left, a live
						     storefront preview on the right. -->
						<div class="m-bento">
						  <div class="m-edit-left">
							<div class="m-cell m-cell-fields">
								<!-- Wire across the gap into the preview: this form feeds it. -->
								<span class="m-wire" aria-hidden="true"></span>
								<p class="a-eyebrow">Details</p>

								<!-- Same shape as an add-merch card: picture left, key fields right. -->
								<div class="m-draft-body">
									<div class="m-drops">
										<div class="m-main-shot" id="mMainShot">
											<span class="m-shot-fallback">NO IMAGE</span>
										</div>
										<p class="m-id" id="mId">MER_</p>
									</div>

									<div class="m-draft-fields">
										<label class="field">
											<span class="field-label">Name</span>
											<input class="field-input" id="eName" type="text" maxlength="80" required />
										</label>
										<div class="m-row2">
											<label class="field">
												<span class="field-label">Price (₹)</span>
												<input class="field-input" id="ePrice" type="number" min="0.01" step="0.01" required />
											</label>
											<label class="field">
												<span class="field-label">Category</span>
												<input class="field-input" id="eCategory" type="text" maxlength="40"
												       list="catList" />
												<datalist id="catList"></datalist>
											</label>
										</div>
									</div>
								</div>

								<label class="field m-field-grow">
									<span class="field-label">Description</span>
									<textarea class="field-input" id="eDesc" maxlength="500" rows="4"></textarea>
								</label>
								<div class="m-row2">
									<label class="field">
										<span class="field-label">Designer</span>
										<input class="field-input" id="eDesigner" type="text" maxlength="80" />
									</label>
									<div class="m-draft-toggles">
										<label class="a-check">
											<input type="checkbox" id="eHasSize" />
											<span>Has sizes</span>
										</label>
										<label class="a-check">
											<input type="checkbox" id="eActive" />
											<span>Visible</span>
										</label>
									</div>
								</div>
							</div>

							<!-- Below the form, wired to it. Extras only — the primary lives
							     in Details, above. -->
							<aside class="m-cell m-cell-media m-views-box m-views-below">
								<!-- Second wire: the carousel in the preview comes from here. -->
								<span class="m-wire" aria-hidden="true"></span>
								<p class="m-views-head">
									<span>Extra views</span>
									<b id="mShotCount">0</b>
								</p>
								<div class="m-shots" id="mShots"></div>
								<p class="m-views-hint">Set at creation — not editable here yet</p>
							</aside>
						  </div>

						  <!-- What the shopper will see. Redrawn on every keystroke. -->
						  <aside class="m-cell m-preview">
							<p class="a-eyebrow">Storefront preview</p>

							<div class="pv">
								<div class="pv-stage">
									<img id="pvImg" alt="" />
									<span class="pv-icon" id="pvIcon"></span>
								</div>
								<p class="pv-label" id="pvLabel">01 / FRONT</p>

								<div class="pv-views" id="pvViews"></div>

								<!-- The storefront's pager: arrows that wrap, a scrub slider and
								     the frame counter. -->
								<!-- Counter split across the track: where you are at its start,
								     how many there are at its end. -->
								<div class="pv-pager">
									<button class="btn pv-arrow" id="pvPrev" type="button"
									        aria-label="Previous view" set:html={chevronLeft} />
									<b class="pv-count pv-cur" id="pvCur">01</b>
									<input class="pv-slider" id="pvSlider" type="range" min="1" max="1" value="1"
									       aria-label="View" />
									<span class="pv-count" id="pvTot">01</span>
									<button class="btn pv-arrow" id="pvNext" type="button"
									        aria-label="Next view" set:html={chevronRight} />
								</div>

								<h3 class="pv-name" id="pvName"></h3>
								<p class="pv-desc" id="pvDesc"></p>
								<p class="pv-designer" id="pvDesigner"></p>

								<div class="pv-sizes" id="pvSizes"></div>

								<div class="pv-buy">
									<span class="pv-buy-label">ADD TO BAG</span>
									<span class="pv-dot"></span>
									<b class="pv-price" id="pvPrice">₹0</b>
								</div>

								<p class="pv-hidden" id="pvHidden" hidden>Hidden from the storefront</p>
							</div>
						  </aside>
						</div>
					</div>

					<div class="m-new-foot">
						<p class="a-err" id="eErr" hidden></p>
						<p class="m-saved" id="eSaved" hidden>Saved.</p>

						<div class="m-actions">
							<button class="btn a-btn-primary m-save" id="eSave" type="submit">SAVE CHANGES</button>
							<button class="btn a-btn-secondary" id="eReset" type="button">REVERT</button>
							<button class="btn a-btn-danger" id="eDelete" type="button">DELETE MERCH</button>
						</div>
					</div>
				</form>

				<!-- ORDERS -->
				<div class="m-orders" id="mOrders" hidden>
					<div class="m-new-head">
						<div class="ord-bar">
							<div>
								<p class="a-eyebrow">Orders <b id="ordCount">0</b></p>
								<p class="m-new-hint ord-hint-wide">
									Newest first. Click an order's items to see the full slip.
								</p>
								<p class="m-new-hint ord-hint-narrow">
									The table reads far better on a desktop. Tap an order's items for the full slip.
								</p>
							</div>
							<div class="ord-tools">
								<button class="btn ord-tool ord-tool-go" id="ordDistribute" type="button">
									<span class="m-add-icon" set:html={iScan} />
									<span>DISTRIBUTION</span>
								</button>
								<button class="btn ord-tool" id="ordCollections" type="button">
									<span class="m-add-icon" set:html={iLayers} />
									<span>COLLECTIONS</span>
								</button>
								<button class="btn ord-tool" id="ordDownload" type="button">
									<span class="m-add-icon" set:html={iDownload} />
									<span>DOWNLOAD</span>
								</button>
							</div>
						</div>
					</div>

					<!-- The table scrolls in both directions inside this frame; the header
					     stays put so a column is never orphaned from its heading. -->
					<div class="ord-wrap">
						<table class="ord">
							<thead>
								<tr>
									<th>Order id</th>
									<th>Name</th>
									<th>Mail</th>
									<th>Phone</th>
									<th>Order info</th>
									<th>Transaction id</th>
									<th class="num">Amount</th>
									<th>Order time</th>
									<th>Collection</th>
									<th aria-label="Actions"></th>
								</tr>
							</thead>
							<tbody id="ordBody"></tbody>
						</table>
						<p class="ord-empty" id="ordEmpty" hidden>No orders yet.</p>
					</div>

					<p class="a-err" id="ordErr" hidden></p>
				</div>

				<!-- ADD MODE: several drafts staged, then sent in one go.
				     Three bands: a fixed head, the scrolling drafts, and a footer that
				     stays put — with ten items staged, the submit button must not be a
				     scroll away. -->
				<div class="m-new" id="mNew" hidden>
					<div class="m-new-head">
						<p class="a-eyebrow">New merch</p>
						<p class="m-new-hint">
							Fill in one card per item. Add as many as you like, then send them together.
						</p>
					</div>

					<div class="m-new-scroll">
						<div id="mDrafts"></div>

						<button class="btn m-draft-add" id="mDraftAdd" type="button">
							<span class="m-add-icon" set:html={iPlus} />
							<span>ANOTHER ITEM</span>
						</button>
					</div>

					<div class="m-new-foot">
						<!-- Kept in the footer: an error about a card scrolled off screen
						     would otherwise never be seen. -->
						<p class="a-err" id="nErr" hidden></p>
						<p class="m-saved" id="nSaved" hidden></p>

						<div class="m-actions">
							<button class="btn a-btn-primary m-save" id="nSubmit" type="button">ADD TO CATALOGUE</button>
							<button class="btn a-btn-secondary" id="nCancel" type="button">CANCEL</button>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>

	<!-- One draft card. Cloned per item so the markup lives in one place. -->
	<!-- ============ ORDER SLIP ============ -->
	<div class="ov" id="ordModal" hidden>
		<div class="ov-panel" role="dialog" aria-modal="true" aria-labelledby="ovTitle">
			<div class="ov-head">
				<span class="ov-title" id="ovTitle">ORDER</span>
				<button class="btn x" id="ovClose" type="button" aria-label="Close" set:html={iX} />
			</div>
			<div class="ov-body" id="ovBody"></div>
		</div>
	</div>

	<!-- ============ DISTRIBUTION ============ -->
	<div class="ov" id="distModal" hidden>
		<div class="ov-panel" role="dialog" aria-modal="true" aria-labelledby="distTitle">
			<div class="ov-head">
				<span class="ov-title" id="distTitle">DISTRIBUTION</span>
				<button class="btn x" id="distClose" type="button" aria-label="Close" set:html={iX} />
			</div>

			<div class="ov-body">
				<!-- SCANNER -->
				<div id="distScan">
					<div class="ds-stage">
						<video id="distVideo" playsinline muted></video>
						<span class="ds-reticle" aria-hidden="true"></span>
						<p class="ds-state" id="distState">Starting camera…</p>
					</div>

					<p class="ds-or">or enter the order id</p>
					<form class="ds-manual" id="distManualForm">
						<input class="field-input" id="distManual" type="text" autocomplete="off"
						       spellcheck="false" placeholder="ORD_…" />
						<button class="btn a-btn-secondary" id="distGo" type="submit">LOOK UP</button>
					</form>
					<p class="a-err" id="distErr" hidden></p>
				</div>

				<!-- RESULT -->
				<div id="distResult" hidden></div>
			</div>

			<div class="ov-foot" id="distFoot" hidden>
				<button class="btn a-btn-primary" id="distCollect" type="button" hidden>MARK COLLECTED</button>
				<button class="btn a-btn-secondary" id="distAgain" type="button">SCAN ANOTHER</button>
			</div>
		</div>
	</div>

	<!-- ============ COLLECTIONS ============ -->
	<div class="ov" id="colModal" hidden>
		<div class="ov-panel ov-file" role="dialog" aria-modal="true" aria-labelledby="colTitle">
			<!-- The tab reads as a folder pulled from a drawer rather than a dialog. -->
			<div class="fr-tab">RECORD</div>
			<div class="ov-head fr-head">
				<span class="ov-title" id="colTitle">COLLECTIONS</span>
				<button class="btn x" id="colClose" type="button" aria-label="Close" set:html={iX} />
			</div>
			<div class="ov-body" id="colBody"></div>
			<div class="ov-foot">
				<button class="btn a-btn-primary" id="colDownload" type="button">DOWNLOAD</button>
				<button class="btn a-btn-secondary" id="colDone" type="button">CLOSE</button>
			</div>
		</div>
	</div>

	<!-- ============ DELETE CONFIRM ============ -->
	<div class="ov" id="delModal" hidden>
		<div class="ov-panel ov-narrow" role="dialog" aria-modal="true" aria-labelledby="delTitle">
			<div class="ov-head">
				<span class="ov-title" id="delTitle">DELETE ORDER</span>
				<button class="btn x" id="delClose" type="button" aria-label="Close" set:html={iX} />
			</div>
			<div class="ov-body">
				<p class="ov-warn">
					This removes the order and its payment record for good. It cannot be undone.
				</p>
				<p class="ov-id" id="delId">ORD_</p>
				<p class="a-err" id="delErr" hidden></p>
			</div>
			<div class="ov-foot">
				<button class="btn a-btn-danger armed" id="delGo" type="button">DELETE ORDER</button>
				<button class="btn a-btn-secondary" id="delCancel" type="button">CANCEL</button>
			</div>
		</div>
	</div>

	<template id="draftTpl">
	  <div class="m-draft-row">
		<div class="m-draft">
			<div class="m-draft-head">
				<span class="m-draft-n"></span>
				<button class="btn m-draft-del" type="button" aria-label="Remove this item">
					<span set:html={iTrash} />
				</button>
			</div>

			<div class="m-draft-body">
				<div class="m-drops">
					<label class="m-drop" data-drop>
						<input type="file" accept="image/*" data-image hidden />
						<img class="m-drop-img" data-preview alt="" />
						<span class="m-drop-text" data-droptext>MAIN IMAGE</span>
						<button class="m-view-warn m-drop-warn" type="button" data-mainwarn hidden
						        aria-label="Problem with this image">!</button>
					</label>
				</div>

				<div class="m-draft-fields">
					<label class="field">
						<span class="field-label">Name</span>
						<input class="field-input" data-name type="text" maxlength="80" />
					</label>
					<div class="m-row2">
						<label class="field">
							<span class="field-label">Price (₹)</span>
							<input class="field-input" data-price type="number" min="0.01" step="0.01" />
						</label>
						<label class="field">
							<span class="field-label">Category</span>
							<input class="field-input" data-category type="text" maxlength="40" list="catList" />
						</label>
					</div>
				</div>
			</div>

			<label class="field">
				<span class="field-label">Description</span>
				<textarea class="field-input" data-description maxlength="500" rows="2"></textarea>
			</label>
			<div class="m-row2">
				<label class="field">
					<span class="field-label">Designer</span>
					<input class="field-input" data-designer type="text" maxlength="80" />
				</label>
				<div class="m-draft-toggles">
					<label class="a-check"><input type="checkbox" data-hassize /><span>Has sizes</span></label>
					<label class="a-check"><input type="checkbox" data-active checked /><span>Visible</span></label>
				</div>
			</div>
			<p class="m-draft-err" data-err hidden></p>
		</div>

		<!-- Extra carousel views, in their own box wired to the card beside it. -->
		<aside class="m-views-box">
			<p class="m-views-head">
				<span>Extra views</span>
				<b data-viewcount>0</b>
			</p>

			<!-- One input for the whole set: `multiple`, so a re-pick replaces the lot
			     rather than leaving half the slots from a previous choice. It sits
			     outside the grid because the grid is rebuilt on every change. -->
			<input type="file" accept="image/*" multiple data-images hidden />

			<!-- Slots are drawn by renderSlots(); nine empty ones to start. -->
			<div class="m-views-grid" data-thumbs></div>

			<p class="m-views-hint" data-extratext>Up to 12</p>
			<p class="m-note" data-note hidden></p>
		</aside>
	  </div>
	</template>
</AdminLayout>

<script>
	import { API, adminFetch, onCatalogueChange, toPaise, toRupees } from '../../lib/admin';
	import caretRight from 'lucide-static/icons/chevron-right.svg?raw';
	import iTrash from 'lucide-static/icons/trash-2.svg?raw';
	// BarcodeDetector is still missing from Safari and Firefox, which is most of the
	// phones a volunteer will actually be holding. A real decoder is the working choice.
	import jsQR from 'jsqr';
	// Same fallbacks the storefront uses, so the preview degrades identically.
	import icApparel from 'lucide-static/icons/shirt.svg?raw';
	import icAccessories from 'lucide-static/icons/shopping-bag.svg?raw';
	import icStationery from 'lucide-static/icons/notebook.svg?raw';
	import icPackage from 'lucide-static/icons/package.svg?raw';

	type Item = {
		id: string; name: string; description: string; designer: string; category: string;
		r2_path: string; price_paise: number; has_size: boolean; is_active: boolean;
		image_url: string; has_primary: boolean;
		views: { label: string; url: string }[];
	};

	const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;

	// Re-queried on every init: ClientRouter swaps in fresh nodes, so anything captured
	// once would point at elements that are no longer in the document.
	let treeEl: HTMLElement, countEl: HTMLElement, emptyEl: HTMLElement;
	let formEl: HTMLFormElement, errEl: HTMLElement, savedEl: HTMLElement;
	let saveBtn: HTMLButtonElement;

	let items: Item[] = [];
	let current: Item | null = null;
	let openCat: string | null = null;

	const escape = (s: string) =>
		s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

	/** Items grouped by category, categories in alphabetical order. */
	function grouped(): [string, Item[]][] {
		const map = new Map<string, Item[]>();
		for (const it of items) {
			const cat = it.category || 'General';
			(map.get(cat) ?? map.set(cat, []).get(cat)!).push(it);
		}
		return [...map.entries()].sort(([a], [b]) => a.localeCompare(b));
	}

	const pad = (n: number) => String(n).padStart(2, '0');

	/**
	 * Pictures for one item, split the way the layout is: the primary sits in Details,
	 * the rest fill the views box. An item created without any is normal.
	 */
	function renderShots(it: Item) {
		const views = it.views ?? [];
		const [primary, ...extras] = views;

		// ---- main image, in the details cell ----
		const main = $('mMainShot');
		main.className = 'm-main-shot';
		main.innerHTML = primary
			? `<img src="${API}${primary.url}" alt="${escape(it.name)}" />` +
				`<span class="m-shot-fallback">MISSING</span>`
			: `<span class="m-shot-fallback">NO IMAGE</span>`;
		// Load-gated, as on the storefront: the tile says MISSING until the file
		// actually arrives, so a dead object never shows as a broken-image box.
		main.querySelector('img')?.addEventListener('load', () => main.classList.add('ok'));

		// ---- extra views ----
		const host = $('mShots');
		host.innerHTML = '';
		$('mShotCount').textContent = String(extras.length);

		if (!extras.length) {
			host.innerHTML = `<p class="m-shot-empty">No extra views.</p>`;
			return;
		}

		for (const v of extras) {
			const fig = document.createElement('figure');
			fig.className = 'm-shot';
			fig.innerHTML =
				`<span class="m-shot-frame">` +
				// No loading="lazy": the tile is display:none until its load fires, and a
				// lazy image with no box is never fetched — see artHTML() on the storefront.
				`<img class="m-shot-img" src="${API}${v.url}" alt="${escape(v.label)}" />` +
				`<span class="m-shot-fallback">MISSING</span>` +
				`</span>` +
				`<figcaption class="m-shot-cap">${escape(v.label)}</figcaption>`;
			fig.querySelector('img')!.onload = () => fig.classList.add('ok');
			host.appendChild(fig);
		}
	}

	// ---- live storefront preview ----
	const SIZES = ['XS', 'S', 'M', 'L', 'XL'];
	const CAT_ICON: Record<string, string> = {
		apparel: icApparel, accessories: icAccessories, stationery: icStationery,
	};
	let pvIdx = 0; // which view the preview is showing

	/**
	 * Draws the hero the shopper would see, from the *form's current values* rather than
	 * the saved row — that is what makes it a preview of the edit rather than a copy of
	 * the database.
	 */
	function renderPreview() {
		if (!current) return;

		const name = $('eName').value.trim() || 'Untitled';
		const category = $('eCategory').value.trim();
		const icon = CAT_ICON[category.toLowerCase()] ?? icPackage;
		const views = current.views ?? [];
		if (pvIdx >= Math.max(views.length, 1)) pvIdx = 0;

		// stage
		const stageImg = $<HTMLImageElement>('pvImg');
		const view = views[pvIdx];
		$('pvIcon').innerHTML = icon;
		stageImg.classList.remove('ok');
		if (view) {
			stageImg.src = API + view.url;
			stageImg.onload = () => stageImg.classList.add('ok');
		} else {
			stageImg.removeAttribute('src');
		}
		$('pvLabel').textContent = views.length
			? `${String(pvIdx + 1).padStart(2, '0')} / ${views[pvIdx]?.label ?? 'FRONT'}`.toUpperCase()
			: 'NO IMAGE';

		// view strip — the storefront's boxes: art, label, frame number
		const strip = $('pvViews');
		strip.innerHTML = '';
		views.forEach((v, i) => {
			const b = document.createElement('button');
			b.type = 'button';
			b.className = 'pv-view' + (i === pvIdx ? ' active' : '');
			// Number first in source order — it is pinned to the corner, and reading it
			// before the picture is also the right order for a screen reader.
			b.innerHTML =
				`<i class="pv-view-n">${String(i + 1).padStart(2, '0')}</i>` +
				`<span class="pv-view-art"><img src="${API}${v.url}" alt="" />` +
				`<span class="pv-view-icon">${icon}</span></span>` +
				`<small class="pv-view-label">${escape(v.label)}</small>`;
			b.querySelector('img')!.onload = (e) => (e.target as HTMLElement).classList.add('ok');
			b.onclick = () => { pvIdx = i; renderPreview(); };
			strip.appendChild(b);
		});

		// pager. Arrows wrap, so they only go dead when there is nothing to move between
		// — same rule as the storefront.
		const n = views.length;
		const single = n < 2;
		$<HTMLButtonElement>('pvPrev').disabled = single;
		$<HTMLButtonElement>('pvNext').disabled = single;
		const slider = $<HTMLInputElement>('pvSlider');
		slider.max = String(Math.max(n, 1));
		slider.value = String(pvIdx + 1);
		slider.disabled = single;
		$('pvCur').textContent = String(pvIdx + 1).padStart(2, '0');
		$('pvTot').textContent = String(Math.max(n, 1)).padStart(2, '0');

		// copy. The storefront breaks the last word onto its own line.
		const parts = name.split(' ');
		$('pvName').innerHTML =
			parts.length > 1
				? `${escape(parts.slice(0, -1).join(' '))}<br />${escape(parts.at(-1)!)}`
				: escape(name);
		$('pvDesc').textContent = $<HTMLTextAreaElement>('eDesc').value.trim();
		const designer = $('eDesigner').value.trim();
		$('pvDesigner').innerHTML = designer ? `Design <b>${escape(designer)}</b>` : '';

		// sizes only exist for a sized item, exactly as on the storefront — and the
		// storefront labels the row, so the preview does too.
		const sizes = $('pvSizes');
		sizes.innerHTML = $('eHasSize').checked
			? `<span class="pv-opt-label">Size</span>` +
				SIZES.map((s, i) => `<span class="pv-size${i === 0 ? ' on' : ''}">${s}</span>`).join('')
			: '';
		sizes.hidden = !$('eHasSize').checked;

		const paise = toPaise($('ePrice').value);
		$('pvPrice').textContent = Number.isFinite(paise) && paise > 0 ? `₹${toRupees(paise)}` : '₹—';
		$('pvHidden').hidden = $('eActive').checked;
	}

	// ---- orders ----
	type Order = {
		order_id: string; name: string; email: string; phone: string;
		items: {
			merch_id: string; name: string; size: string | null;
			quantity: number; line_total_paise: number;
		}[];
		transaction_id: string | null; total_price_paise: number; payment_status: string;
		collected: boolean; collected_at: string | null; created_at: string;
	};

	let orders: Order[] = [];

	/** `2026-08-14 09:12:03` (UTC, from SQLite) -> a readable local stamp. */
	function stamp(sqlUtc: string): string {
		// SQLite's datetime('now') has no timezone marker; without the Z the browser
		// would read it as local and the times would drift by the offset.
		const d = new Date(sqlUtc.replace(' ', 'T') + 'Z');
		return Number.isNaN(d.getTime())
			? sqlUtc
			: d.toLocaleString(undefined, { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
	}

	const summarise = (o: Order) =>
		o.items.map((l) => `${l.name}${l.size ? ` · ${l.size}` : ''} × ${l.quantity}`).join(', ');

	function renderOrders() {
		const body = $('ordBody');
		body.innerHTML = '';
		$('ordCount').textContent = String(orders.length);
		$('ordEmpty').hidden = orders.length > 0;

		for (const o of orders) {
			const tr = document.createElement('tr');
			const paid = o.payment_status === 'paid';

			tr.innerHTML =
				`<td class="mono">${escape(o.order_id)}</td>` +
				`<td>${escape(o.name) || '<span class="ord-none">—</span>'}</td>` +
				`<td class="mono">${escape(o.email) || '<span class="ord-none">—</span>'}</td>` +
				`<td class="mono">${escape(o.phone) || '<span class="ord-none">—</span>'}</td>` +
				`<td><button type="button" class="ord-info" data-info>${escape(summarise(o))}</button></td>` +
				`<td class="mono">${escape(o.transaction_id ?? '') || '<span class="ord-none">—</span>'}</td>` +
				`<td class="num">₹${toRupees(o.total_price_paise)}` +
				(paid ? '' : `<span class="ord-tag">${escape(o.payment_status)}</span>`) +
				`</td>` +
				`<td class="mono">${escape(stamp(o.created_at))}</td>` +
				`<td>${
					o.collected
						? `<span class="ord-pill on">COLLECTED</span>`
						: `<span class="ord-pill">PENDING</span>`
				}</td>` +
				`<td><button type="button" class="btn ord-del" data-del aria-label="Delete order">` +
				`${iTrash}</button></td>`;

			tr.querySelector('[data-info]')!.addEventListener('click', () => openSlip(o));
			tr.querySelector('[data-del]')!.addEventListener('click', () => openDelete(o));
			body.appendChild(tr);
		}
	}

	async function loadOrders() {
		try {
			$('ordErr').hidden = true;
			const data = await adminFetch<{ orders: Order[] }>('/api/admin/orders');
			orders = data.orders;
			renderOrders();
		} catch (e) {
			$('ordErr').textContent = (e as Error).message;
			$('ordErr').hidden = false;
		}
	}

	// ---- modals ----
	function openModal(id: string, on: boolean) {
		$(id).hidden = !on;
		// The page behind must not scroll under an open dialog.
		document.body.classList.toggle('ov-open', on);
