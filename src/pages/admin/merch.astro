			)
			.join('');

		$('ovBody').innerHTML =
			`<div class="rc">` +
			`<div class="rc-head">` +
			`<p class="rc-brand">ANVESHA '26</p>` +
			`<p class="rc-sub">Merch counter · order slip</p>` +
			`</div>` +

			`<div class="rc-sec">` +
			row('ORDER', o.order_id) +
			row('PLACED', stamp(o.created_at)) +
			`</div>` +

			`<div class="rc-sec">` +
			row('NAME', o.name) +
			row('MAIL', o.email) +
			row('PHONE', o.phone) +
			`</div>` +

			`<div class="rc-sec">` +
			`<div class="rc-item rc-item-head">` +
			`<span class="rc-item-name">ITEM</span><span class="rc-item-q">QTY</span>` +
			`<span class="rc-item-amt">AMOUNT</span></div>` +
			lines +
			`</div>` +

			`<div class="rc-total"><span>TOTAL</span><b>₹${toRupees(o.total_price_paise)}</b></div>` +

			`<div class="rc-sec">` +
			row('PAYMENT', o.payment_status.toUpperCase()) +
			row('TXN', o.transaction_id ?? '') +
			row('COLLECTED', o.collected ? stamp(o.collected_at ?? '') : 'NOT YET') +
			`</div>` +

			`<p class="rc-foot">© ${new Date().getFullYear()} Anvesha · IISER Thiruvananthapuram<br />All rights reserved</p>` +
			`</div>`;

		openModal('ordModal', true);
	}

	/**
	 * Writes rows as a CSV file. Excel opens this natively — a real .xlsx would mean a
	 * zip writer and a spreadsheet schema for something every tool already reads.
	 */
	function downloadCsv(filename: string, rows: (string | number)[][]) {
		const cell = (v: string | number) => `"${String(v ?? '').replace(/"/g, '""')}"`;
		const csv = rows.map((r) => r.map(cell).join(',')).join('\r\n');
		// The BOM is load-bearing: without it Excel reads the file as its local codepage
		// and every ₹ and non-ASCII name arrives mangled.
		const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = filename;
		a.click();
		URL.revokeObjectURL(url);
	}

	const today = () => new Date().toISOString().slice(0, 10);

	function downloadOrders() {
		const rows: (string | number)[][] = [
			['Order ID', 'Name', 'Mail', 'Phone', 'Order info', 'Transaction ID',
			 'Amount paid (INR)', 'Payment status', 'Order time', 'Collection status'],
		];
		for (const o of orders)
			rows.push([
				o.order_id, o.name, o.email, o.phone, summarise(o), o.transaction_id ?? '',
				// A plain number, not "₹1,234" — a spreadsheet should be able to sum it.
				(o.total_price_paise / 100).toFixed(2),
				o.payment_status, o.created_at, o.collected ? 'Collected' : 'Pending',
			]);
		downloadCsv(`anvesha-orders-${today()}.csv`, rows);
	}

	// ---- collections ----
	type Tally = {
		id: string; name: string; category: string; image: string | null;
		qty: number; revenue: number;
	};

	/**
	 * What actually has to be produced, and what was taken for it.
	 *
	 * Paid orders only: an unpaid row is an abandoned cart, and printing tees against
	 * money that never arrived is the expensive kind of mistake.
	 */
	function collections() {
		const paid = orders.filter((o) => o.payment_status === 'paid');
		const byMerch = new Map<string, Tally>();

		for (const o of paid) {
			for (const l of o.items) {
				// Fall back to the name: the snapshot outlives the merch row, so a
				// deleted item still has to be counted.
				const key = l.merch_id || l.name;
				const rec = byMerch.get(key) ?? {
					id: key, name: l.name, category: 'Unknown', image: null, qty: 0, revenue: 0,
				};
				rec.qty += l.quantity;
				rec.revenue += l.line_total_paise;
				byMerch.set(key, rec);
			}
		}

		// Category and picture come from the live catalogue, which the snapshot omits.
		for (const rec of byMerch.values()) {
			const it = items.find((i) => i.id === rec.id);
			if (it) {
				rec.category = it.category || 'Unknown';
				rec.image = it.views?.[0]?.url ?? null;
			}
		}

		const tallies = [...byMerch.values()].sort((a, b) => b.qty - a.qty);
		const byCategory = new Map<string, number>();
		for (const t of tallies) byCategory.set(t.category, (byCategory.get(t.category) ?? 0) + t.revenue);

		return {
			tallies,
			categories: [...byCategory.entries()].sort((a, b) => b[1] - a[1]),
			units: tallies.reduce((n, t) => n + t.qty, 0),
			total: tallies.reduce((n, t) => n + t.revenue, 0),
			paidCount: paid.length,
		};
	}

	/** Laid out as a filed record: reference block, ruled ledger, then the totals. */
	function openCollections() {
		const c = collections();
		const now = new Date();

		const rows = c.tallies
			.map(
				(t, i) =>
					`<tr>` +
					`<td class="fr-n">${String(i + 1).padStart(2, '0')}</td>` +
					`<td class="fr-art-cell"><span class="col-art">` +
					(t.image ? `<img src="${API}${t.image}" alt="" loading="lazy" />` : '') +
					`<span class="col-art-fallback">—</span></span></td>` +
					`<td class="fr-item">${escape(t.name)}</td>` +
					`<td class="fr-cat">${escape(t.category)}</td>` +
					`<td class="fr-units">${t.qty}</td>` +
					`<td class="fr-amt">₹${toRupees(t.revenue)}</td>` +
					`</tr>`,
			)
			.join('');

		const cats = c.categories
			.map(
				([name, revenue]) =>
					`<div class="fr-sub"><span>${escape(name)}</span>` +
					`<span class="fr-dots"></span><b>₹${toRupees(revenue)}</b></div>`,
			)
			.join('');

		$('colBody').innerHTML =
			`<div class="fr-meta">` +
			`<div class="fr-field"><span class="fr-k">VIEWED</span><span class="fr-v">` +
			escape(
				now.toLocaleString(undefined, {
					day: '2-digit', month: 'short', year: 'numeric',
					hour: '2-digit', minute: '2-digit',
				}),
			) +
			`</span></div>` +
			`</div>` +

			`<p class="fr-legend">Units to produce</p>` +
			(c.tallies.length
				? `<div class="fr-scroll"><table class="fr-table"><thead><tr>` +
					`<th class="fr-n">#</th><th></th><th>Item</th><th>Category</th>` +
					`<th class="fr-units">Units</th><th class="fr-amt">Taken</th>` +
					`</tr></thead><tbody>${rows}</tbody></table></div>`
				: `<p class="ord-empty">Nothing paid for yet.</p>`) +

			`<p class="fr-legend">Per category</p>` +
			`<div class="fr-subs">${cats || '<span class="ord-none">—</span>'}</div>` +

			`<div class="fr-total">` +
			`<div><span class="fr-total-k">TOTAL EARNED</span>` +
			`<b class="fr-total-v">₹${toRupees(c.total)}</b></div>` +
			`<div><span class="fr-total-k">UNITS TO HAND OUT</span>` +
			`<b class="fr-total-v">${c.units}</b></div>` +
			`</div>`;

		openModal('colModal', true);
	}

	function downloadCollections() {
		const c = collections();
		const rows: (string | number)[][] = [['Item', 'Category', 'Units to produce', 'Amount taken (INR)']];
		for (const t of c.tallies) rows.push([t.name, t.category, t.qty, (t.revenue / 100).toFixed(2)]);

		// Blank row, then the summaries — one file, readable top to bottom in Excel.
		rows.push([], ['Category', 'Amount taken (INR)']);
		for (const [name, revenue] of c.categories) rows.push([name, (revenue / 100).toFixed(2)]);
		rows.push([], ['Total units', c.units], ['Total earned (INR)', (c.total / 100).toFixed(2)],
			['Paid orders', c.paidCount]);

		downloadCsv(`anvesha-collections-${today()}.csv`, rows);
	}

	// ---- distribution ----
	type Scan = {
		verdict: 'ok' | 'unpaid' | 'already_collected';
		collectable: boolean;
		order: {
			order_id: string;
			items: { name: string; size: string | null; quantity: number; line_total_paise: number }[];
			total_price_paise: number; payment_status: string;
			collected: boolean; collected_at: string | null; created_at: string;
		};
		payment: { razorpay_transaction_id: string | null; transaction_info: Record<string, unknown> } | null;
	};

	let stream: MediaStream | null = null;
	let scanTimer: number | undefined;
	let scanning = false;
	let scanned: Scan | null = null;

	/** Releases the camera. Called on every exit path — a live capture light left on
	 *  after the dialog closes is alarming and drains a volunteer's phone. */
	function stopCamera() {
		scanning = false;
		clearTimeout(scanTimer);
		stream?.getTracks().forEach((t) => t.stop());
		stream = null;
		const v = $<HTMLVideoElement>('distVideo');
		v.srcObject = null;
	}

	async function startCamera() {
		const video = $<HTMLVideoElement>('distVideo');
		const state = $('distState');
		try {
			// facingMode 'environment' asks for the rear camera on a phone; on a laptop
			// there is only one and the constraint is ignored rather than failing.
			stream = await navigator.mediaDevices.getUserMedia({
				video: { facingMode: 'environment' },
				audio: false,
			});
			video.srcObject = stream;
			await video.play();
			state.hidden = true;
			scanning = true;
			tick();
		} catch (e) {
			// No camera, denied permission, or an insecure origin. Manual entry is the
			// documented fallback, so this is a notice rather than a failure.
			state.hidden = false;
			state.textContent =
				(e as Error).name === 'NotAllowedError'
					? 'Camera blocked — use the order id box below.'
					: 'No camera available — use the order id box below.';
		}
	}

	/** Grabs a frame and looks for a QR in it. ~10/s is plenty and leaves the phone alone. */
	async function tick() {
		if (!scanning) return;
		const video = $<HTMLVideoElement>('distVideo');

		if (video.readyState === video.HAVE_ENOUGH_DATA) {
			const canvas = document.createElement('canvas');
			canvas.width = video.videoWidth;
			canvas.height = video.videoHeight;
			const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
			ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
			const px = ctx.getImageData(0, 0, canvas.width, canvas.height);
			const found = jsQR(px.data, px.width, px.height, { inversionAttempts: 'dontInvert' });
			if (found?.data) {
				scanning = false;
				await lookup(found.data.trim());
				return;
			}
		}
		scanTimer = setTimeout(tick, 100) as unknown as number;
	}

	/** Looks an order up and shows the verdict. Shared by the camera and the manual box. */
	async function lookup(orderId: string) {
		const err = $('distErr');
		err.hidden = true;
		try {
			const res = await adminFetch<Scan>('/api/admin/scan', {
				method: 'POST',
				body: JSON.stringify({ order_id: orderId }),
			});
			scanned = res;
			stopCamera();
			showResult(res);
		} catch (e) {
			// A 404 is the "this is not one of ours" case and deserves plain words.
			const msg = (e as Error).message;
			err.textContent = /no such order/i.test(msg)
				? `Not one of ours — no order ${orderId}`
				: msg;
			err.hidden = false;
			// Keep looking: the volunteer may just have caught a bad frame.
			if (stream) { scanning = true; tick(); }
		}
	}

	function showResult(s: Scan) {
		const paid = s.order.payment_status === 'paid';
		const info = s.payment?.transaction_info ?? {};
		const buyer = {
			name: String(info.name ?? ''),
			email: String(info.email ?? ''),
			phone: String(info.contact ?? ''),
		};

		const banner =
			s.verdict === 'ok'
				? `<p class="ds-verdict ok">Verified — hand it over</p>`
				: s.verdict === 'already_collected'
					? `<p class="ds-verdict warn">Merch has been collected` +
						(s.order.collected_at ? ` · ${escape(stamp(s.order.collected_at))}` : '') +
						`</p>`
					: `<p class="ds-verdict warn">Not paid — do not hand over</p>`;

		const lines = s.order.items
			.map(
				(l, i) =>
					`<li class="dc-item">` +
					`<i class="dc-item-n">${String(i + 1).padStart(2, '0')}</i>` +
					`<span class="dc-item-name">${escape(l.name)}` +
					(l.size ? `<em>${escape(l.size)}</em>` : '') +
					`</span>` +
					`<b class="dc-item-q">×${l.quantity}</b>` +
					`</li>`,
			)
			.join('');

		const tile = (k: string, v: string, mod = '') =>
			`<div class="dc-tile ${mod}"><span class="dc-tile-k">${k}</span>` +
			`<b class="dc-tile-v">${escape(v)}</b></div>`;

		$('distResult').innerHTML =
			banner +
			`<div class="dc">` +
			`<p class="dc-id">${escape(s.order.order_id)}</p>` +

			`<div class="dc-tiles">` +
			tile('Payment', s.order.payment_status.toUpperCase(), paid ? 'is-paid' : 'is-due') +
			tile('Total', `₹${toRupees(s.order.total_price_paise)}`) +
			tile('Placed', stamp(s.order.created_at)) +
			`</div>` +

			`<p class="dc-legend">Buyer</p>` +
			`<div class="dc-buyer">` +
			`<b class="dc-buyer-name">${escape(buyer.name) || 'Not recorded'}</b>` +
			`<span class="dc-buyer-line">${escape(buyer.email) || '—'}</span>` +
			`<span class="dc-buyer-line">${escape(buyer.phone) || '—'}</span>` +
			`</div>` +

			`<p class="dc-legend">Hand over</p>` +
			`<ul class="dc-items">${lines}</ul>` +
			`</div>`;

		$('distScan').hidden = true;
		$('distResult').hidden = false;
		$('distFoot').hidden = false;
		// The button only exists for a paid, uncollected order — an unpaid one must not
		// offer a way to hand merch over at all.
		$('distCollect').hidden = !(paid && s.collectable);
	}

	async function markCollected() {
		if (!scanned) return;
		const btn = $<HTMLButtonElement>('distCollect');
		btn.disabled = true;
		try {
			await adminFetch('/api/admin/collect', {
				method: 'POST',
				body: JSON.stringify({ order_id: scanned.order.order_id }),
			});
			$('distResult').innerHTML =
				`<p class="ds-verdict ok">Collected — ${escape(scanned.order.order_id)}</p>` +
				`<p class="ds-done">The order is now marked collected in the table.</p>`;
			btn.hidden = true;
			// The table behind is stale the moment this succeeds.
			if (task === 'orders') loadOrders();
		} catch (e) {
			$('distResult').insertAdjacentHTML(
				'afterbegin',
				`<p class="a-err">${escape((e as Error).message)}</p>`,
			);
		} finally {
			btn.disabled = false;
		}
	}

	function resetDistribution() {
		scanned = null;
		$('distResult').hidden = true;
		$('distResult').innerHTML = '';
		$('distScan').hidden = false;
		$('distFoot').hidden = true;
		$('distCollect').hidden = true;
		$('distErr').hidden = true;
		$<HTMLInputElement>('distManual').value = '';
	}

	function openDistribution(on: boolean) {
		openModal('distModal', on);
		if (on) { resetDistribution(); startCamera(); }
		else stopCamera();
	}

	let pendingDelete: Order | null = null;

	function openDelete(o: Order) {
		pendingDelete = o;
		$('delId').textContent = o.order_id;
		$('delErr').hidden = true;
		openModal('delModal', true);
	}

	async function confirmDelete() {
		if (!pendingDelete) return;
		const btn = $<HTMLButtonElement>('delGo');
		btn.disabled = true;
		try {
			await adminFetch(`/api/admin/orders/${pendingDelete.order_id}`, { method: 'DELETE' });
			openModal('delModal', false);
			pendingDelete = null;
			await loadOrders();
		} catch (e) {
			$('delErr').textContent = (e as Error).message;
			$('delErr').hidden = false;
		} finally {
			btn.disabled = false;
		}
	}

	/**
	 * Two-step delete. The first click arms the button and the second commits, so a
	 * mis-click cannot destroy an item and its images — there is no undo behind this.
	 */
	let armedDelete: string | null = null;
	let disarmTimer: number | undefined;

	function disarmDelete() {
		armedDelete = null;
		clearTimeout(disarmTimer);
		const btn = $<HTMLButtonElement>('eDelete');
		btn.textContent = 'DELETE MERCH';
		btn.classList.remove('armed');
	}

	async function onDelete() {
		if (!current) return;
		const btn = $<HTMLButtonElement>('eDelete');

		if (armedDelete !== current.id) {
			armedDelete = current.id;
			btn.textContent = 'CONFIRM DELETE';
			btn.classList.add('armed');
			// Re-arming is deliberate; leaving it armed indefinitely is how an unrelated
			// later click becomes a deletion.
			clearTimeout(disarmTimer);
			disarmTimer = setTimeout(disarmDelete, 5000) as unknown as number;
			return;
		}

		btn.disabled = true;
		errEl.hidden = true;
		try {
			await adminFetch(`/api/admin/merch/${current.id}`, { method: 'DELETE' });
			current = null;
			disarmDelete();
			await load();
			// Nothing left to edit if that was the last item.
			if (!items.length) { formEl.hidden = true; emptyEl.hidden = false; }
		} catch (e) {
			errEl.textContent = (e as Error).message;
			errEl.hidden = false;
			disarmDelete();
		} finally {
			btn.disabled = false;
		}
	}

	/** The storefront's own tree markup — .tcat / .tkids / .titem, same CSS file. */
	function renderTree() {
		treeEl.innerHTML = '';
		for (const [cat, list] of grouped()) {
			const open = cat === openCat;

			const folder = document.createElement('button');
			folder.className = 'tnode tcat' + (open ? ' open' : '');
			folder.setAttribute('role', 'treeitem');
			folder.setAttribute('aria-expanded', String(open));
			folder.innerHTML =
				`<span class="tcaret">${caretRight}</span>` +
				`<span class="tname">${escape(cat)}</span>` +
				`<span class="tmeta">${list.length} items</span>`;
			// Clicking the open category closes it, so the tree can collapse entirely.
			folder.onclick = () => { openCat = open ? null : cat; renderTree(); };
			treeEl.appendChild(folder);

			if (!open) continue;

			const kids = document.createElement('div');
			kids.className = 'tkids';
			list.forEach((it, ii) => {
				const b = document.createElement('button');
				b.className =
					'tnode titem' +
					(ii === list.length - 1 ? ' last' : '') +
					(current?.id === it.id ? ' active' : '') +
					(it.is_active ? '' : ' inactive');
				b.setAttribute('role', 'treeitem');
				b.innerHTML =
					`<i class="tnum">${pad(ii + 1)}</i>` +
					`<span class="tname">${escape(it.name)}</span>` +
					// A hidden item must be obvious here, or it gets "fixed" twice.
					(it.is_active
						? `<b class="tmeta tprice">₹${toRupees(it.price_paise)}</b>`
						: `<span class="toff">OFF</span>`);
				b.onclick = () => select(it.id);
				kids.appendChild(b);
			});
			treeEl.appendChild(kids);
		}
		countEl.textContent = String(items.length);

		// Category suggestions come from the data, so a typo can't silently create a
		// fourth category that renders as its own group on the storefront.
		$('catList').innerHTML = grouped()
			.map(([c]) => `<option value="${escape(c)}"></option>`)
			.join('');
	}

	function select(id: string) {
		current = items.find((i) => i.id === id) ?? null;
		if (!current) return;

		// Only reveal the editor if editing is what is on screen — a live update landing
		// while the add form is open must not shove the form aside.
		if (task === 'edit') {
			emptyEl.hidden = true;
			formEl.hidden = false;
		}
		errEl.hidden = true;
		savedEl.hidden = true;

		$('mId').textContent = current.id;
		$('eName').value = current.name;
		$<HTMLTextAreaElement>('eDesc').value = current.description ?? '';
		$('eDesigner').value = current.designer ?? '';
		$('eCategory').value = current.category ?? '';
		$('ePrice').value = toRupees(current.price_paise);
		$('eHasSize').checked = current.has_size;
		$('eActive').checked = current.is_active;

		renderShots(current);
		pvIdx = 0; // a new item starts on its first view
		renderPreview();
		// Switching items must never carry an armed delete across to the new one.
		disarmDelete();

		// Selecting an item always opens the category holding it, so the highlight is
		// never hidden inside a collapsed branch.
		openCat = current.category || 'General';
		renderTree();
	}

	async function save(e: Event) {
		e.preventDefault();
		if (!current) return;

		saveBtn.disabled = true;
		saveBtn.textContent = 'SAVING…';
		errEl.hidden = true;
		savedEl.hidden = true;

		try {
			const price = toPaise($('ePrice').value);
			if (!Number.isInteger(price) || price <= 0)
				throw new Error('Enter a price greater than zero');

			const body = {
				name: $('eName').value,
				description: $<HTMLTextAreaElement>('eDesc').value,
				designer: $('eDesigner').value,
				category: $('eCategory').value,
				price_paise: price,
				has_size: $('eHasSize').checked,
				is_active: $('eActive').checked,
			};

			await adminFetch(`/api/admin/merch/${current.id}`, {
				method: 'PUT',
				body: JSON.stringify(body),
			});

			// Update the local copy from what was actually sent, so the list and the
			// REVERT button reflect the saved state rather than the pre-edit one.
			Object.assign(current, body, { price_paise: price });
			renderTree();
			savedEl.hidden = false;
		} catch (err) {
			errEl.textContent = (err as Error).message;
			errEl.hidden = false;
		} finally {
			saveBtn.disabled = false;
			saveBtn.textContent = 'SAVE CHANGES';
		}
	}

	async function load(keepSelection = false) {
		try {
			const wanted = keepSelection ? current?.id : undefined;
			const data = await adminFetch<{ merch: Item[] }>('/api/admin/merch');
			items = data.merch;
			renderTree();
			// Re-select what was open if it still exists, so a live update from another
			// admin does not yank the editor out from under whoever is typing.
			const target = (wanted && items.some((i) => i.id === wanted) ? wanted : items[0]?.id) ?? null;
			if (target) select(target);
		} catch (e) {
			emptyEl.textContent = (e as Error).message;
		}
	}

	// ---- add mode ----
	let draftSeq = 0;
	// Mirrors the server's cap in admin.ts. Raised past 9 so the 3-wide grid actually
	// has something to scroll.
	const MAX_EXTRA = 12;
	// Empty slots drawn when fewer pictures than this are chosen — one full 3x3 screen.
	const SLOTS = 9;

	/** Extra views per draft card. Keyed by the card, so readDraft can find them again. */
	const draftFiles = new WeakMap<HTMLElement, File[]>();

	// One object URL per file, reused across re-renders. Minting a fresh one on every
	// redraw would leak a blob URL per keystroke-sized change.
	const previewUrls = new WeakMap<File, string>();
	function previewUrl(f: File): string {
		let url = previewUrls.get(f);
		if (!url) {
			url = URL.createObjectURL(f);
			previewUrls.set(f, url);
		}
		return url;
	}

	/**
	 * The storefront's magnified view is `--vf: clamp(240px, 42vh, 450px)` and the image
	 * fills 95% of it — so ~428 CSS px at the largest. Doubling that covers a 2x display
	 * with pixels to spare; anything beyond is downloaded and then thrown away by the
	 * browser's own scaler.
	 */
	const STAGE_MAX_PX = 428 * 2;
	const BIG_FILE_BYTES = 1_000_000;

	const dims = new WeakMap<File, { w: number; h: number }>();

	/** Reads the real pixel size. Resolves either way — a file we cannot decode is the
	 *  server's problem to reject, not a reason to block the form. */
	function measure(f: File): Promise<void> {
		return new Promise((done) => {
			const img = new Image();
			img.onload = () => {
				dims.set(f, { w: img.naturalWidth, h: img.naturalHeight });
				done();
			};
			img.onerror = () => done();
			img.src = previewUrl(f);
		});
	}

	/** What is wrong with this picture, if anything. */
	function imageWarning(f: File): string | null {
		const d = dims.get(f);
		const notes: string[] = [];
		if (d && (d.w > STAGE_MAX_PX || d.h > STAGE_MAX_PX))
			notes.push(
				`${d.w}×${d.h}px is larger than the storefront ever shows it. The magnified ` +
					`view tops out around ${STAGE_MAX_PX}px on a high-density screen, so the extra ` +
					`pixels are downloaded and then discarded — slower for every shopper.`,
			);
		if (f.size > BIG_FILE_BYTES)
			notes.push(`The file is ${(f.size / 1_048_576).toFixed(1)}MB. Under 1MB keeps the shop quick.`);
		return notes.length ? notes.join(' ') : null;
	}

	function addDraft() {
		const tpl = $<HTMLTemplateElement>('draftTpl');
		const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
		node.dataset.n = String(++draftSeq);

		const preview = node.querySelector<HTMLImageElement>('[data-preview]')!;
		const fileInput = node.querySelector<HTMLInputElement>('[data-image]')!;
		const dropText = node.querySelector<HTMLElement>('[data-droptext]')!;

		const mainWarn = node.querySelector<HTMLButtonElement>('[data-mainwarn]')!;
		fileInput.onchange = async () => {
			const f = fileInput.files?.[0];
			if (!f) return;
			// Local preview: nothing is uploaded until the whole batch is submitted.
			preview.src = previewUrl(f);
			preview.classList.add('ok');
			dropText.hidden = true;

			await measure(f);
			const warn = imageWarning(f);
			mainWarn.hidden = !warn;
			mainWarn.onclick = (e) => { e.preventDefault(); showNote(`${f.name} — ${warn}`); };
		};

		// Extra views — a fixed 3x3 of slots, filled as pictures are picked.
		const extraInput = node.querySelector<HTMLInputElement>('[data-images]')!;
		const grid = node.querySelector<HTMLElement>('[data-thumbs]')!;
		const countEl = node.querySelector<HTMLElement>('[data-viewcount]')!;
		const hint = node.querySelector<HTMLElement>('[data-extratext]')!;

		// The picked set is kept here, not read off the input. An <input type="file">
		// REPLACES its FileList on every pick, so reading it back would make the second
		// choice wipe the first — which is exactly what it did.
		const files: File[] = [];
		draftFiles.set(node, files);

		const noteEl = node.querySelector<HTMLElement>('[data-note]')!;
		/** Shows the reason behind a warning flag, in this card only. */
		function showNote(text: string) {
			// Clicking the same flag again puts it away.
			const same = noteEl.textContent === text && !noteEl.hidden;
			noteEl.textContent = text;
			noteEl.hidden = same;
		}

		/**
		 * Always draws at least nine cells so the grid reads as a set of slots waiting to
		 * be filled rather than a lone button. Anything past nine simply extends the grid
		 * and scrolls.
		 */
		function renderSlots() {
			grid.innerHTML = '';
			countEl.textContent = String(files.length);
			const over = files.length > MAX_EXTRA;
			hint.textContent = over ? `Too many — max ${MAX_EXTRA}` : `Up to ${MAX_EXTRA}`;
			hint.classList.toggle('over', over);

			for (let i = 0; i < Math.max(SLOTS, files.length); i++) {
				const f = files[i];
				if (f) {
					const cell = document.createElement('div');
					cell.className = 'm-view-slot filled';
					const img = document.createElement('img');
					img.src = previewUrl(f);
					img.alt = f.name;
					cell.appendChild(img);

					// Its own control, so clicking the picture cannot be mistaken for a
					// way to replace it — the only destructive action is the explicit ×.
					const del = document.createElement('button');
					del.type = 'button';
					del.className = 'm-view-del';
					del.textContent = '×';
					del.setAttribute('aria-label', `Remove ${f.name}`);
					del.onclick = () => {
						files.splice(i, 1);
						renderSlots();
					};
					cell.appendChild(del);

					// Oversized is a warning, not a rejection: the image still works, it
					// just costs every shopper more than it needs to.
					const warn = imageWarning(f);
					if (warn) {
						const flag = document.createElement('button');
						flag.type = 'button';
						flag.className = 'm-view-warn';
						flag.textContent = '!';
						flag.setAttribute('aria-label', `Problem with ${f.name}`);
						flag.onclick = () => showNote(`${f.name} — ${warn}`);
						cell.appendChild(flag);
					}
					grid.appendChild(cell);
				} else {
					const slot = document.createElement('button');
					slot.type = 'button';
					slot.className = 'm-view-slot';
					slot.innerHTML = '<span>+</span>';
					slot.setAttribute('aria-label', `Add view ${i + 1}`);
					slot.onclick = () => extraInput.click();
					grid.appendChild(slot);
				}
			}
		}

		extraInput.onchange = async () => {
			const added: File[] = [];
			for (const f of extraInput.files ?? []) {
				// Same file picked twice is almost certainly a slip, not two views.
				const dupe = files.some(
					(g) => g.name === f.name && g.size === f.size && g.lastModified === f.lastModified,
				);
				if (!dupe) { files.push(f); added.push(f); }
			}
			// Clearing the input is what lets the SAME file be chosen again after being
			// removed — without it the change event never fires a second time.
			extraInput.value = '';
			renderSlots(); // thumbnails first; measuring is a round trip through decode
			await Promise.all(added.map(measure));
			renderSlots(); // again, now that any warnings are known
		};
		renderSlots();

		node.querySelector<HTMLButtonElement>('.m-draft-del')!.onclick = () => {
			node.remove();
			renumberDrafts();
			// Never leave the form with nothing to fill in.
			if (!$('mDrafts').children.length) addDraft();
		};

		$('mDrafts').appendChild(node);
		renumberDrafts();
		// The list scrolls now, so a new card is created below the fold. Bring it into
		// view before focusing, or the caret lands somewhere the user cannot see.
		node.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
		node.querySelector<HTMLInputElement>('[data-name]')?.focus({ preventScroll: true });
	}

	function renumberDrafts() {
		[...$('mDrafts').children].forEach((el, i) => {
			el.querySelector('.m-draft-n')!.textContent = `ITEM ${pad(i + 1)}`;
		});
	}

	type Task = 'edit' | 'add' | 'orders';
	let task: Task = 'edit';

	/** One attribute on the shell drives which panes show — the CSS owns the switching. */
	function setTask(next: Task) {
		task = next;
		document.querySelector<HTMLElement>('.m-shell')!.dataset.task = task;

		$('mNew').hidden = task !== 'add';
		$('mOrders').hidden = task !== 'orders';
		formEl.hidden = task !== 'edit' || !current;
		emptyEl.hidden = task !== 'edit' || !!current;

		document.querySelectorAll<HTMLButtonElement>('[data-task-btn]').forEach((b) => {
			const on = b.dataset.taskBtn === task;
			b.classList.toggle('on', on);
			// aria-current, not just a class: the rail is a nav, and a screen reader
			// should be told which task is open.
			if (on) b.setAttribute('aria-current', 'true');
			else b.removeAttribute('aria-current');
		});

		if (task === 'add' && !$('mDrafts').children.length) addDraft();
		// Fetched on entry, not on load: orders change constantly and a list from ten
		// minutes ago is worse than one that takes a moment to arrive.
		if (task === 'orders') loadOrders();
	}

	/** Reads one draft card into a FormData, or returns an error message. */
	function readDraft(card: HTMLElement): FormData | string {
		const q = <T extends HTMLElement>(sel: string) => card.querySelector<T>(sel)!;
		const name = q<HTMLInputElement>('[data-name]').value.trim();
		const priceRaw = q<HTMLInputElement>('[data-price]').value.trim();

		if (!name) return 'Name is required';
		if (!priceRaw) return 'Price is required';
		const paise = toPaise(priceRaw);
		if (!Number.isInteger(paise) || paise <= 0) return 'Price must be greater than zero';

		const fd = new FormData();
		fd.set('name', name);
		fd.set('description', q<HTMLTextAreaElement>('[data-description]').value.trim());
		fd.set('designer', q<HTMLInputElement>('[data-designer]').value.trim());
		fd.set('category', q<HTMLInputElement>('[data-category]').value.trim() || 'General');
		fd.set('price_paise', String(paise));
		fd.set('has_size', String(q<HTMLInputElement>('[data-hassize]').checked));
		fd.set('is_active', String(q<HTMLInputElement>('[data-active]').checked));

		const file = q<HTMLInputElement>('[data-image]').files?.[0];
		if (file) fd.set('image', file, file.name);

		// From the card's own list, not the input — the input only ever holds the most
		// recent pick. append, not set: every extra view has to survive as its own part.
		const extras = draftFiles.get(card) ?? [];
		if (extras.length > MAX_EXTRA) return `At most ${MAX_EXTRA} extra views per item`;
		for (const f of extras) fd.append('image_extra', f, f.name);

		return fd;
	}

	async function submitDrafts() {
		const cards = [...$('mDrafts').children] as HTMLElement[];
		const btn = $<HTMLButtonElement>('nSubmit');
		const err = $('nErr'), saved = $('nSaved');
		err.hidden = true;
		saved.hidden = true;
		cards.forEach((c) => (c.querySelector<HTMLElement>('[data-err]')!.hidden = true));

		// Validate everything before sending anything: a half-applied batch is worse
		// than a rejected one, because it is not obvious which half landed.
		const payloads: { card: HTMLElement; fd: FormData }[] = [];
		let bad = false;
		for (const card of cards) {
			const out = readDraft(card);
			if (typeof out === 'string') {
				const e = card.querySelector<HTMLElement>('[data-err]')!;
				e.textContent = out;
				e.hidden = false;
				bad = true;
			} else payloads.push({ card, fd: out });
		}
		if (bad) {
			err.textContent = 'Fix the highlighted items first.';
			err.hidden = false;
			return;
		}

		btn.disabled = true;
		let done = 0;
		try {
			// Sequential, not parallel: ids are allocated MAX+1 server-side, so firing
			// these at once would make every request collide and retry against the others.
			for (const { card, fd } of payloads) {
				await adminFetch('/api/admin/merch', { method: 'POST', body: fd });
				done++;
				card.remove();
			}
			saved.textContent = `Added ${done} item${done === 1 ? '' : 's'}.`;
			saved.hidden = false;
			addDraft();
			await load();
		} catch (e) {
			err.textContent = `${(e as Error).message}${done ? ` (${done} already added)` : ''}`;
			err.hidden = false;
			if (done) await load();
		} finally {
			btn.disabled = false;
			renumberDrafts();
		}
	}

	/**
	 * Runs on every page load, including ClientRouter navigations. Without this the
	 * panel only worked on a hard load: coming back from Events swapped in a fresh,
	 * empty DOM that nothing ever populated, and the catalogue looked lost until reload.
	 */
	function initMerchAdmin() {
		// Bail if this page is not the one on screen — astro:page-load fires for every
		// route, and /admin/events has none of these nodes.
		const tree = document.getElementById('mTree');
		if (!tree) return;

		treeEl = tree;
		countEl = $('mCount');
		emptyEl = $('mEmpty');
		formEl = $<HTMLFormElement>('mForm');
		errEl = $('eErr');
		savedEl = $('eSaved');
		saveBtn = $<HTMLButtonElement>('eSave');

		formEl.onsubmit = save;
		$('eReset').onclick = () => current && select(current.id);
		$('eDelete').onclick = onDelete;

		// One delegated listener rather than one per control: the preview only ever
		// reads the form, so it does not care which field moved.
		formEl.addEventListener('input', renderPreview);
		formEl.addEventListener('change', renderPreview);

		// Carousel controls. Bound once — renderPreview only ever updates their values.
		const goView = (i: number) => {
			const n = current?.views?.length ?? 0;
			if (n < 1) return;
			pvIdx = ((i % n) + n) % n; // wrap both directions
			renderPreview();
		};
		$('pvPrev').onclick = () => goView(pvIdx - 1);
		$('pvNext').onclick = () => goView(pvIdx + 1);
		$<HTMLInputElement>('pvSlider').oninput = (e) =>
			goView(Number((e.target as HTMLInputElement).value) - 1);

		// task rail
		document.querySelectorAll<HTMLButtonElement>('[data-task-btn]').forEach((b) => {
			b.onclick = () => setTask(b.dataset.taskBtn as Task);
		});

		// distribution
		$('ordDistribute').onclick = () => openDistribution(true);
		$('distClose').onclick = () => openDistribution(false);
		$('distAgain').onclick = () => { resetDistribution(); startCamera(); };
		$('distCollect').onclick = markCollected;
		$<HTMLFormElement>('distManualForm').onsubmit = (e) => {
			e.preventDefault();
			const id = $<HTMLInputElement>('distManual').value.trim().toUpperCase();
			if (id) lookup(id);
		};

		// order tools
		$('ordDownload').onclick = downloadOrders;
		$('ordCollections').onclick = openCollections;
		$('colClose').onclick = () => openModal('colModal', false);
		$('colDone').onclick = () => openModal('colModal', false);
		$('colDownload').onclick = downloadCollections;

		// order modals
		$('ovClose').onclick = () => openModal('ordModal', false);
		$('delClose').onclick = () => openModal('delModal', false);
		$('delCancel').onclick = () => { pendingDelete = null; openModal('delModal', false); };
		$('delGo').onclick = confirmDelete;
		// Clicking the backdrop dismisses, but only the backdrop — a click that started
		// inside the panel and drifted out must not close it.
		// The distribution dialog holds a camera, so it always closes through its own
		// handler — openModal alone would hide it and leave the capture light on.
		const closeOverlay = (id: string) =>
			id === 'distModal' ? openDistribution(false) : openModal(id, false);

		for (const id of ['ordModal', 'delModal', 'colModal', 'distModal'])
			$(id).addEventListener('click', (e) => { if (e.target === $(id)) closeOverlay(id); });
		// Topmost first: the confirm can open over the others.
		addEventListener('keydown', (e) => {
			if (e.key !== 'Escape') return;
			for (const id of ['delModal', 'ordModal', 'colModal', 'distModal']) {
				if (!$(id).hidden) { closeOverlay(id); return; }
			}
		});
