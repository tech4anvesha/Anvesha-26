		$('nSubmit').onclick = submitDrafts;
		$('nCancel').onclick = () => { $('mDrafts').innerHTML = ''; draftSeq = 0; setTask('edit'); };
		setTask('edit');

		// State from a previous visit is stale by definition — someone else may have
		// edited the catalogue in between, so always re-fetch rather than re-render.
		current = null;
		load();

		// ---- live ----
		// Another admin's change lands here without a refresh. The selection is kept so
		// this cannot yank the editor away from whoever is mid-edit.
		stopLive?.();
		stopLive = onCatalogueChange(
			() => {
				load(true);
				// Only refresh the table if it is what is on screen.
				if (task === 'orders') loadOrders();
			},
			['catalogue', 'orders'],
		);
	}

	let stopLive: (() => void) | null = null;

	// Leaving the page must drop the socket and the camera, or every visit opens another
	// one and the capture light stays on after navigating away.
	document.addEventListener('astro:before-swap', () => {
		stopLive?.();
		stopLive = null;
		stopCamera();
	});
	document.addEventListener('astro:page-load', initMerchAdmin);
</script>

