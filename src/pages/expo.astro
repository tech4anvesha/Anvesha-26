---
/**
 * EXPO — Aficionados.
 *
 * One page, five blocks: the pitch and a countdown, last year's floor as a photograph,
 * the six subject halls with their coordinators, the practical details, and the forms.
 *
 * Everything below is data. The six halls, their domains and their coordinators all come
 * off one array, so adding a subject or a phone number is one entry and no markup.
 */
import SiteLayout from '../layouts/SiteLayout.astro';

import iDna from 'lucide-static/icons/dna.svg?raw';
import iAtom from 'lucide-static/icons/atom.svg?raw';
import iFlask from 'lucide-static/icons/flask-conical.svg?raw';
import iSigma from 'lucide-static/icons/sigma.svg?raw';
import iCpu from 'lucide-static/icons/cpu.svg?raw';
import iGlobe from 'lucide-static/icons/globe-2.svg?raw';
import iCalendar from 'lucide-static/icons/calendar-days.svg?raw';
import iMapPin from 'lucide-static/icons/map-pin.svg?raw';
import iArrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import iPhone from 'lucide-static/icons/phone.svg?raw';
import iUsers from 'lucide-static/icons/users.svg?raw';
import iSend from 'lucide-static/icons/send.svg?raw';
import iMessage from 'lucide-static/icons/message-circle.svg?raw';

// The floor opens on the 30th. The countdown targets 00:00 IST that morning, written as
// a UTC instant so it is the same moment for a reader in any timezone — IST is UTC+5:30,
// so midnight IST is 18:30 UTC the evening before.
// TODO(anvesha): one line to move if the opening shifts.
const OPENS_UTC = '2026-10-29T18:30:00Z';
const DATES = '30 & 31 October';
const VENUE = 'Indoor Stadium';

// Last year's floor, by subject. `n` is the project count; the domains are what those
// projects actually covered.
const HALLS = [
	{
		name: 'Biology', icon: iDna, n: 12,
		domains: ['Botany', 'Zoology', 'Microbiology', 'Immunology', 'Neurobiology',
		          'Pharmacology', 'Anatomy', 'Histology'],
		leads: [
			{ name: 'Sarbajit Pathak', batch: 'B24', phone: '+91 90028 59199' },
			{ name: 'Ankita Acharya',  batch: 'B24', phone: '+91 99862 18382' },
			{ name: 'Gargi Datta',     batch: 'B23', phone: '+91 94590 06255' },
		],
	},
	{
		name: 'Physics', icon: iAtom, n: 18,
		domains: ['Electrophysiology', 'Fluid Dynamics', 'Quantum Mechanics',
		          'Energy Harvesting', 'Transportation Engineering',
		          'Classical Mechanics / Geometry', 'Plasma Physics'],
		leads: [
			{ name: 'Akshara Somala Raju', batch: 'B24', phone: '+91 91138 33746' },
			{ name: 'Sambit Dutta',        batch: 'B24', phone: '+91 70442 67149' },
			{ name: 'Pranav Guptta V',     batch: 'B23', phone: '+91 63745 82319' },
		],
	},
	{
		name: 'Chemistry', icon: iFlask, n: 8,
		domains: ['Inorganic Chemistry', 'Analytical Chemistry', 'Biochemistry',
		          'Crystallography', 'Polymer Chemistry', 'Quantum Chemistry',
		          'Condensed Matter', 'Nanotechnology'],
		leads: [
			{ name: 'Mahalakshmi M',    batch: 'B24', phone: '+91 89218 90645' },
			{ name: 'Pavithra Praveen', batch: 'B24', phone: '+91 90360 53166' },
			{ name: 'Aditya Katti',     batch: 'B24', phone: '+91 90750 56705' },
		],
	},
	{
		name: 'Mathematics', icon: iSigma, n: 12,
		domains: ['Knot Theory', 'Topology', 'Financial Mathematics',
		          'Dynamical Systems (DMD)', 'Number Theory', 'Combinatorial Game Theory',
		          'Signal Processing', 'Fourier Analysis', 'Information Theory'],
		leads: [
			{ name: 'Akash N',          batch: 'B24', phone: '+91 63812 68497' },
			{ name: 'Arpan Koul',       batch: 'B24', phone: '+91 99993 76793' },
			{ name: 'Joel Jobby Jacob', batch: 'B24', phone: '+91 96338 23123' },
		],
	},
	{
		name: 'Data Science', icon: iCpu, n: 13,
		domains: ['Game Theory', 'Robotics & Autonomous Systems', 'Computer Vision',
		          'Signal Processing', 'Quantum Machine Learning', 'Bioinformatics',
		          'Embedded Systems'],
		leads: [
			{ name: 'Saurabh Kumar Singh', batch: 'B24', phone: '+91 83830 42485' },
		],
	},
	{
		name: 'Earth, Environmental & Sustainability Sciences', icon: iGlobe, n: 9,
		domains: ['Bioremediation', 'Atmospheric & Climate Science',
		          'Sustainable Materials Engineering', 'Physical Oceanography',
		          'Marine Ecology', 'Carbon Sequestration'],
		leads: [
			{ name: 'Sonavane Samiksha Nilesh',   batch: 'B24', phone: '+91 98927 05272' },
			{ name: 'Maheen Rituraj Buddhisagar', batch: 'B24', phone: '+91 76206 34810' },
		],
	},
];

const LINKS = [
	{ label: 'Participation form', note: 'Enter a project', icon: iSend,
	  href: 'https://docs.google.com/forms/d/e/1FAIpQLSeXSXF3gYAXDUrZcfX1_SOR-sIIjHj_vROL_wNPu-cnR8_vjQ/viewform?usp=dialog' },
	{ label: 'Mentor form', note: 'Offer to mentor a team', icon: iUsers,
	  href: 'https://forms.gle/Zg9RLvKmFnmwkj836' },
	{ label: 'WhatsApp community', note: 'Ask questions, find a team', icon: iMessage,
	  href: 'https://chat.whatsapp.com/HiHfSuBzF4f7kGCDwCO0Fw' },
];

// Derived, so the copy cannot drift from the table under it.
const lastYearTotal = HALLS.reduce((n, h) => n + h.n, 0);
const leadCount = HALLS.reduce((n, h) => n + h.leads.length, 0);
const THIS_YEAR = 60;
const pad = (n: number) => String(n).padStart(2, '0');
---

<SiteLayout title="Expo · Anvesha '26">
	<div class="page">
		{/* ---- the pitch ---- */}
		<header class="page-head xp-head" data-reveal>
			<p class="eyebrow">Aficionados · {DATES} · {VENUE}</p>
			<h1 class="page-title">Expo</h1>
			<p class="lede">
				{THIS_YEAR} student projects on the floor over two days. Aficionados is your chance
				to bring an idea into life — have one? Build it, and present it here. Walk in and
				ask anything: every exhibit is meant to be explained out loud, not read off a
				poster.
			</p>

			{/* ---- the countdown ----
			    Server-rendered as dashes and filled by script. The markup is the shape of the
			    thing, so nothing jumps when the numbers arrive, and a reader with no JS sees
			    the date on the strip below rather than a broken clock. */}
			<div class="xp-clock" id="xpClock" data-opens={OPENS_UTC} role="timer"
			     aria-label={`Countdown to the Expo floor opening on ${DATES}`}>
				{[
					['xpD', 'Days'], ['xpH', 'Hours'], ['xpM', 'Minutes'], ['xpS', 'Seconds'],
				].map(([id, label]) => (
					<div class="xp-cell">
						<span class="xp-n" id={id}>--</span>
						<span class="xp-l">{label}</span>
					</div>
				))}
			</div>
			<p class="xp-clock-note mono" id="xpNote">Doors open {DATES} · {VENUE}</p>
		</header>

		{/* ---- last year's floor ---- */}
		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Anvesha &rsquo;25</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta"><b>{lastYearTotal}</b> projects last year</span>
			</div>

			<figure class="xp-shot">
				<img src="/img/expo-2025.jpg" width="932" height="1400" loading="lazy"
				     alt="Photographs from the 2025 Expo floor: students demonstrating projects at
				          their tables, school groups walking the halls, and benches with
				          microscopes and tanks." />
				<figcaption class="mono">The floor, Anvesha &rsquo;25</figcaption>
			</figure>
		</section>

		{/* ---- the halls ----
		    Six subjects, each with what it covered last year and who to call about it. */}
		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Subjects</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta"><b>{HALLS.length}</b> subjects · <b>{leadCount}</b> coordinators</span>
			</div>

			<div class="xp-halls">
				{HALLS.map((h, i) => (
					<article class="xp-hall">
						<header class="xp-hall-top">
							<i class="xp-hall-n mono">{pad(i + 1)}</i>
							<span class="xp-hall-icon" set:html={h.icon} />
							<h2 class="xp-hall-name">{h.name}</h2>
							<span class="xp-hall-count mono"><b>{h.n}</b> projects</span>
						</header>

						<ul class="xp-domains">
							{h.domains.map((d) => <li>{d}</li>)}
						</ul>

						<div class="xp-leads">
							<p class="xp-leads-label mono">Coordinators</p>
							{h.leads.map((l) => (
								<a class="xp-lead" href={`tel:${l.phone.replace(/\s/g, '')}`}>
									<span class="xp-lead-name">{l.name}</span>
									<span class="xp-lead-batch mono">{l.batch}</span>
									<span class="xp-lead-phone mono">
										<span set:html={iPhone} />{l.phone}
									</span>
								</a>
							))}
						</div>
					</article>
				))}
			</div>
			<p class="xp-foot mono">
				Counts and domains are from Anvesha &rsquo;25 &mdash; {lastYearTotal} projects across
				{' '}{HALLS.length} subjects. This year&rsquo;s floor is built to {THIS_YEAR}.
			</p>
		</section>

		{/* ---- the practicals ---- */}
		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Visiting</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta">Free · open to all</span>
			</div>

			<div class="rows">
				{[
					{ label: 'When', value: `${DATES} 2026`, icon: iCalendar },
					{ label: 'Where', value: `${VENUE} · IISER Thiruvananthapuram`, icon: iMapPin },
					{ label: 'Who can exhibit', value: 'Any student, any subject, any year', icon: iUsers },
				].map((v, i) => (
					<div class="row-item">
						<i class="row-index">{pad(i + 1)}</i>
						<span class="row-icon" set:html={v.icon} />
						<div class="row-name">{v.label}</div>
						<div class="row-meta"><b>{v.value}</b></div>
					</div>
				))}
			</div>
		</section>

		{/* ---- the forms ---- */}
		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Take part</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta">Three ways in</span>
			</div>

			<div class="xp-links">
				{LINKS.map((l) => (
					<a class="xp-link" href={l.href} target="_blank" rel="noopener noreferrer">
						<span class="xp-link-icon" set:html={l.icon} />
						<span class="xp-link-body">
							<span class="xp-link-label">{l.label}</span>
							<span class="xp-link-note">{l.note}</span>
						</span>
						<span class="xp-link-go" set:html={iArrowRight} />
					</a>
				))}
			</div>
		</section>
	</div>
</SiteLayout>

<script>
	/**
	 * The countdown.
	 *
	 * Rebound on every client-router navigation and torn down through its own interval
	 * handle — otherwise a timer started on this page keeps ticking against elements that
	 * have been swapped out from under it.
	 *
	 * The target is an absolute UTC instant in the markup, not a local date built in
	 * script: `new Date('2026-10-30')` is midnight UTC, which is half past five in the
	 * morning in IST, and a reader abroad would be counting to a different moment again.
	 */
	let tick = 0;

	function countdown() {
		clearInterval(tick);

		const box = document.getElementById('xpClock');
		if (!box) return;

		const opens = Date.parse(box.dataset.opens ?? '');
		if (Number.isNaN(opens)) return;

		const cells = ['xpD', 'xpH', 'xpM', 'xpS'].map((id) => document.getElementById(id));
		const note = document.getElementById('xpNote');
		if (cells.some((c) => !c)) return;

		const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');

		const draw = () => {
			const left = opens - Date.now();

			if (left <= 0) {
				clearInterval(tick);
				box.classList.add('is-open');
				for (const c of cells) c!.textContent = '00';
				if (note) note.textContent = 'The floor is open — Indoor Stadium';
				return;
			}

			const s = Math.floor(left / 1000);
			// Days is not padded to two: a three-digit countdown is a real state this page
			// spends most of the year in.
			cells[0]!.textContent = String(Math.floor(s / 86400));
			cells[1]!.textContent = pad(Math.floor(s / 3600) % 24);
			cells[2]!.textContent = pad(Math.floor(s / 60) % 60);
			cells[3]!.textContent = pad(s % 60);
		};

		draw();
		tick = window.setInterval(draw, 1000);
	}

	document.addEventListener('astro:page-load', countdown);
	document.addEventListener('astro:before-swap', () => clearInterval(tick));
</script>

<style>
	/* ============ THE PITCH ============ */
	.xp-head { padding-bottom: clamp(26px, 3.4vw, 40px); }

	/* ---- the countdown ----
	   Four equal cells over one ink ground: the gap IS the divider, so no cell needs a
	   border of its own and there are no nth-child sums to keep in step. */
	.xp-clock {
		display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--stroke);
		max-width: 560px; margin: clamp(24px, 3vw, 34px) 0 0;
		background: var(--secondary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		overflow: hidden;
	}
	.xp-cell {
		display: flex; flex-direction: column; align-items: center; gap: 4px;
		padding: clamp(12px, 1.6vw, 18px) 6px;
		background: var(--primary);
	}
	.xp-n {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(26px, 4.4vw, 44px); line-height: 1;
		letter-spacing: -.03em;
		/* Tabular figures, or the whole row shifts every time a 1 ticks past. */
		font-variant-numeric: tabular-nums;
	}
	.xp-l {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .18em; text-transform: uppercase;
		color: var(--ink-60);
	}
	/* When it reaches zero the clock stops being a clock and becomes a sign. */
	.xp-clock.is-open .xp-n { color: var(--accent); }
	.xp-clock-note {
		margin: 10px 0 0;
		font-size: 10px; letter-spacing: .16em; text-transform: uppercase;
		color: var(--ink-60);
	}

	/* ============ LAST YEAR ============
	   The collage is tall and portrait, so it is capped by height rather than width — at
	   full width on a desktop it would be most of a screen of scrolling. */
	.xp-shot { margin: 0; display: flex; flex-direction: column; gap: 10px; align-items: center; }
	.xp-shot img {
		display: block; width: auto; max-width: 100%;
		max-height: min(78vh, 720px);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		box-shadow: var(--pop-lg);
	}
	.xp-shot figcaption {
		font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-60);
	}

	/* ============ THE SUBJECTS ============ */
	.xp-halls {
		display: grid; gap: 14px;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
	}
	.xp-hall {
		display: flex; flex-direction: column; gap: 14px;
		padding: clamp(16px, 1.9vw, 22px);
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.xp-hall-top {
		display: grid; grid-template-columns: auto auto 1fr auto;
		align-items: center; gap: 10px;
		padding-bottom: 12px; border-bottom: 1.5px solid var(--hair);
	}
	.xp-hall-n {
		display: grid; place-items: center; min-width: 22px; height: 17px;
		font-size: 9px; font-style: normal;
		color: var(--primary); background: var(--accent); border-radius: var(--r);
	}
	.xp-hall-icon { display: block; line-height: 0; color: var(--secondary); }
	.xp-hall-icon svg { width: 20px; height: 20px; stroke-width: 1.7; }
	.xp-hall-name {
		margin: 0; min-width: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 14px; line-height: 1.2; letter-spacing: -.01em;
	}
	.xp-hall-count { font-size: 10px; letter-spacing: .1em; color: var(--ink-60); white-space: nowrap; }
	.xp-hall-count b { color: var(--accent); font-weight: 500; }

	/* Domains as tags rather than a comma list: at nine of them a sentence is unreadable
	   and a bulleted column is four times the height. */
	.xp-domains {
		display: flex; flex-wrap: wrap; gap: 6px;
		margin: 0; padding: 0; list-style: none;
	}
	.xp-domains li {
		padding: 4px 9px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10.5px; letter-spacing: .02em; color: var(--ink-60);
		background: var(--sink);
		border: 1.5px solid var(--hair); border-radius: var(--r);
	}

	.xp-leads { margin-top: auto; display: flex; flex-direction: column; gap: 6px; }
	.xp-leads-label {
		margin: 0 0 2px;
		font-size: 9px; letter-spacing: .2em; text-transform: uppercase; color: var(--accent);
	}
	/* The whole row is the tel: link — a phone number you have to hit exactly is a phone
	   number nobody calls from a handset. */
	.xp-lead {
		display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 4px 10px;
		padding: 8px 10px;
		text-decoration: none; color: inherit;
		background: var(--sink);
		border: 1.5px solid var(--hair); border-radius: var(--r);
		transition: border-color .16s ease, background .16s ease;
	}
	.xp-lead:hover, .xp-lead:focus-visible {
		border-color: var(--accent); background: var(--primary);
	}
	.xp-lead-name { font-size: 13px; font-weight: 700; letter-spacing: -.01em; }
	.xp-lead-batch { font-size: 9.5px; letter-spacing: .12em; color: var(--ink-60); }
	.xp-lead-phone {
		grid-column: 1 / -1;
		display: flex; align-items: center; gap: 6px;
		font-size: 11px; letter-spacing: .04em; color: var(--ink-60);
	}
	.xp-lead-phone svg { width: 11px; height: 11px; stroke-width: 2; flex: none; }
	.xp-lead:hover .xp-lead-phone { color: var(--accent); }

	.xp-foot {
		margin: 16px 0 0;
		font-size: 10px; letter-spacing: .08em; line-height: 1.7; color: var(--ink-60);
	}

	/* ============ THE FORMS ============ */
	.xp-links {
		display: grid; gap: 12px;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
	}
	.xp-link {
		display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
		padding: 16px 18px;
		text-decoration: none; color: inherit;
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		transition: box-shadow .16s ease, transform .16s ease;
	}
	.xp-link:hover, .xp-link:focus-visible {
		transform: translate(-2px, -2px); box-shadow: var(--pop);
	}
	.xp-link-icon { display: block; line-height: 0; color: var(--accent); }
	.xp-link-icon svg { width: 22px; height: 22px; stroke-width: 1.8; }
	.xp-link-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
	.xp-link-label {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 13.5px; letter-spacing: -.01em;
	}
	.xp-link-note {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10px; letter-spacing: .1em; color: var(--ink-60);
	}
	.xp-link-go { display: block; line-height: 0; color: var(--secondary); }
	.xp-link-go svg { width: 16px; height: 16px; stroke-width: 2.2; }

	@media (prefers-reduced-motion: reduce) {
		.xp-link, .xp-lead { transition: none; }
		.xp-link:hover, .xp-link:focus-visible { transform: none; }
	}

	@media (max-width: 560px) {
		.xp-clock { max-width: none; }
		.xp-hall-top { grid-template-columns: auto auto 1fr; row-gap: 8px; }
		.xp-hall-count { grid-column: 1 / -1; }
	}
</style>
