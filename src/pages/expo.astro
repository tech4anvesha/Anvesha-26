---
/**
 * AFICIONADOS — the science fair. Routed at /expo; the nav keeps that word, the page
 * does not.
 *
 * One page, four blocks: the pitch and the way in to the projects, last year's floor
 * as a running reel, the six subjects with their coordinators, and the forms.
 *
 * Everything below is data. The six subjects, their domains and their coordinators all
 * come off one array, so adding a subject is one entry and no markup.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import { HALLS } from '../lib/expo';

import iCalendar from 'lucide-static/icons/calendar-days.svg?raw';
import iMapPin from 'lucide-static/icons/map-pin.svg?raw';
import iArrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import iUsers from 'lucide-static/icons/users.svg?raw';
import iSend from 'lucide-static/icons/send.svg?raw';
import iMessage from 'lucide-static/icons/message-circle.svg?raw';
import iCamera from 'lucide-static/icons/camera.svg?raw';

const DATES = '30 & 31 October';
const VENUE = 'Indoor Stadium';

const LINKS = [
	{ label: 'Participation form', note: 'Enter a project', icon: iSend,
	  href: 'https://docs.google.com/forms/d/e/1FAIpQLSeXSXF3gYAXDUrZcfX1_SOR-sIIjHj_vROL_wNPu-cnR8_vjQ/viewform?usp=dialog' },
	{ label: 'Mentor form', note: 'Offer to mentor a team', icon: iUsers,
	  href: 'https://forms.gle/Zg9RLvKmFnmwkj836' },
	{ label: 'WhatsApp community', note: 'Ask questions, find a team', icon: iMessage,
	  href: 'https://chat.whatsapp.com/HiHfSuBzF4f7kGCDwCO0Fw' },
];

// Derived, so the copy cannot drift from the table under it.
const lastYearTotal = HALLS.reduce((n, h) => n + h.n, 0);
const leadCount = HALLS.reduce((n, h) => n + h.leads.length, 0);

/**
 * The gallery — ten photographs from the '25 floor, split five and five.
 *
 * Two rows travelling opposite ways. One alone reads as a slideshow that got stuck; two
 * counter-running strips read as a floor going past. Each frame still falls back to a
 * drawn placeholder if its file 404s, so a typo degrades rather than leaving a
 * broken-image glyph on the page.
 */
// Named after their source, so the folder says what the banner draws from — nothing but
// the ten expo photographs is in here or reachable from here.
const SHOTS = Array.from({ length: 10 }, (_, i) => `/img/expo/expo${String(i + 1).padStart(2, '0')}.jpg`);
const ROWS = [
	{ dir: 'fwd', shots: SHOTS.slice(0, 5) },
	{ dir: 'rev', shots: SHOTS.slice(5) },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<SiteLayout
	title="Aficionados · Expo · Anvesha '26"
	description="Aficionados is the Anvesha '26 science expo: student projects across six subjects on the floor for two days at IISER Thiruvananthapuram. Bring an idea, build it, present it."
>
	<div class="page xp-page">
		{/* ---- the ground ----
		    Solaris, the same figure the home page opens with, turned right down.

		    A STICKY wrapper of zero height, not a fixed element: fixed positions against
		    the viewport, so the drawing spilled past the page's own frame and out over the
		    shell around it. Sticky stays put while the page scrolls under it exactly the
		    same way, but it is a child of .page — which is the scroller, and therefore
		    clips it to the frame.

		    aria-hidden and pointer-events:none throughout — it is weather, not content. */}
		<div class="xp-sky-wrap" aria-hidden="true">
		{/* ---- the left ----
		    The six subjects, as their own marks: a helix, an atom, a flask, a sigma, a chip
		    and a globe, strung together like a constellation. The right of the frame has a
		    planet turning in it and the left had nothing — but the answer to that is not a
		    second animation. This is one paint and never touched again.

		    Same six, in the same order, as the cards further down the page: what is drawn
		    out here is what the fair is made of. */}
		<svg class="xp-marks" viewBox="0 0 300 640" preserveAspectRatio="xMidYMid meet">
			{/* the strings first, so every mark draws over its own connector */}
			<g class="xp-link">
				<path d="M 78 96 L 214 156" />
				<path d="M 214 156 L 96 258" />
				<path d="M 96 258 L 228 352" />
				<path d="M 228 352 L 82 448" />
				<path d="M 82 448 L 206 548" />
			</g>

			{/* biology — a helix */}
			<g class="xp-mk xp-mk-1" transform="translate(78 70) scale(1.55)">
				<path d="M -9 -14 q 18 9 0 28" />
				<path d="M 9 -14 q -18 9 0 28" />
				<path d="M -6.8 -6.5 h 13.6" />
				<path d="M -6.8 6.5 h 13.6" />
			</g>

			{/* physics — an atom */}
			<g class="xp-mk xp-mk-2" transform="translate(214 156) scale(1.4)">
				<circle class="xp-mk-fill" cx="0" cy="0" r="3" />
				<ellipse cx="0" cy="0" rx="14" ry="5.5" />
				<ellipse cx="0" cy="0" rx="14" ry="5.5" transform="rotate(60)" />
				<ellipse cx="0" cy="0" rx="14" ry="5.5" transform="rotate(-60)" />
			</g>

			{/* chemistry — a flask */}
			<g class="xp-mk xp-mk-3" transform="translate(96 258) scale(1.5)">
				<path d="M -4 -13 v 8 L -11 7 a 3 3 0 0 0 2.6 4.6 h 16.8 A 3 3 0 0 0 11 7 L 4 -5 v -8 z" />
				<path d="M -6.6 -13 h 13.2" />
				<path d="M -8.4 4 h 16.8" />
			</g>

			{/* mathematics — a sigma */}
			<g class="xp-mk xp-mk-1" transform="translate(228 352) scale(1.55)">
				<path d="M 9 -12 H -8 L 2.5 0 -8 12 H 9" />
			</g>

			{/* data science — a chip */}
			<g class="xp-mk xp-mk-2" transform="translate(82 448) scale(1.5)">
				<rect x="-9" y="-9" width="18" height="18" rx="2" />
				<rect x="-3.6" y="-3.6" width="7.2" height="7.2" rx="1" />
				{[-4.5, 0, 4.5].map((o) => (
					<>
						<path d={`M -9 ${o} h -4`} />
						<path d={`M 9 ${o} h 4`} />
						<path d={`M ${o} -9 v -4`} />
						<path d={`M ${o} 9 v 4`} />
					</>
				))}
			</g>

			{/* earth — a globe */}
			<g class="xp-mk xp-mk-3" transform="translate(206 548) scale(1.35)">
				<circle cx="0" cy="0" r="13" />
				<ellipse cx="0" cy="0" rx="5.4" ry="13" />
				<path d="M -12.4 -4.6 h 24.8" />
				<path d="M -12.4 4.6 h 24.8" />
			</g>
		</svg>

		{/* The home page's Solaris, unchanged and simply larger — same geometry, same
		    colours, same three motions, and the rocket riding the tilted ring exactly as
		    it does there. The only difference is scale and that it sits behind a page
		    instead of beside a paragraph. */}
		<svg class="sol xp-sky" viewBox="0 0 400 400" role="presentation">
			<defs>
				<clipPath id="xpSolClip"><circle cx="200" cy="200" r="132" /></clipPath>
			</defs>

			<g class="sol-orbits">
				<ellipse class="sol-o1" cx="200" cy="200" rx="182" ry="182" />
				<ellipse class="sol-o2" cx="200" cy="200" rx="160" ry="60" />
			</g>

			<circle class="sol-rim" cx="200" cy="200" r="132" />

			<g clip-path="url(#xpSolClip)">
				{[
					{ y: 118, d: 26, s: 'a', c: 'coral' }, { y: 152, d: 20, s: 'b', c: 'coral' },
					{ y: 186, d: 30, s: 'c', c: 'rose'  }, { y: 220, d: 18, s: 'a', c: 'rose'  },
					{ y: 254, d: 24, s: 'b', c: 'plum'  }, { y: 288, d: 22, s: 'c', c: 'plum'  },
				].map((w) => (
					<path class={`sol-w sol-${w.s}`} style={`--wc:var(--flare-${w.c})`}
					      d={`M -400 ${w.y} q 50 -${w.d} 100 0 ${'t 100 0 '.repeat(13)}`} />
				))}
			</g>

			<line class="sol-cross" x1="200" y1="52" x2="200" y2="348" />
			<circle class="sol-dot" cx="200" cy="200" r="4" />

			<g class="sol-rocket">
				<g class="sol-rk-orbit">
					<path class="sol-rk-flame" d="M -8 0 h -6" />
					<path class="sol-rk" d="M -8 -4 L 1 -4 Q 10 0 1 4 L -8 4 Z" />
					<path class="sol-rk" d="M -5 -4 L -10 -8.5 L -8 -4 Z" />
					<path class="sol-rk" d="M -5 4 L -10 8.5 L -8 4 Z" />
					<circle class="sol-rk-eye" cx="-1" cy="0" r="1.7" />
				</g>
			</g>

			<g class="sol-mn-orbit">
				<g class="sol-mn-spin">
					<circle class="sol-mn" cx="0" cy="0" r="9" />
					<circle class="sol-mn-c" cx="-3.4" cy="-2.8" r="2.2" />
					<circle class="sol-mn-c" cx="3" cy="1.6" r="1.5" />
					<circle class="sol-mn-c" cx="-0.8" cy="4.4" r="1.1" />
				</g>
			</g>
		</svg>
		</div>

		{/* ---- the pitch ---- */}
		<header class="page-head xp-head" data-reveal>
			<p class="eyebrow">Expo &middot; Anvesha &rsquo;26</p>
			<h1 class="page-title">Aficionados</h1>
			<p class="lede">
				Multiple student projects on the floor over two days. Aficionados is your chance
				to bring an idea into life — have one? Build it, and present it here. Walk in and
				ask anything: every exhibit is meant to be explained out loud, not read off a
				poster.
			</p>

			{/* ---- the way in ----
			    The floor has closed, so the countdown gave way to what was on it. */}
			<a class="cta xp-cta" href="/projects">
				<span>View Projects</span>
				<span set:html={iArrowRight} />
			</a>

			{/* When and where stay in the header rather than a section further down: they
			    are the first two things anyone asks about a fair. */}
			<dl class="xp-facts">
				{[
					{ k: 'When', v: `${DATES} 2026`, icon: iCalendar },
					{ k: 'Where', v: VENUE, icon: iMapPin },
					{ k: 'Who can exhibit', v: 'Open to all', icon: iUsers },
				].map((f) => (
					<div class="xp-fact">
						<dt><span set:html={f.icon} />{f.k}</dt>
						<dd>{f.v}</dd>
					</div>
				))}
			</dl>
		</header>

		{/* ---- last year's floor ----
		    A reel, not a grid: a wall of thumbnails is a contact sheet, and this is meant
		    to read as the floor going past. Rendered TWICE and the track travels exactly
		    -50%, so the second copy lands where the first began and the loop has no seam. */}
		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Anvesha &rsquo;25</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta"><b>{lastYearTotal}</b> projects last year</span>
			</div>

			<div class="xp-reels">
				{ROWS.map((row) => (
					<div class="xp-reel" data-dir={row.dir}>
						<div class="xp-track">
							{[0, 1].map(() => (
								<div class="xp-run" aria-hidden="true">
									{row.shots.map((src) => (
										<figure class="xp-frame">
											{/* onerror rather than a build-time check: a broken-image
											    glyph is worse than a drawn frame. */}
											<img src={src} alt="" loading="lazy"
											     onerror="this.closest('.xp-frame').classList.add('is-empty')" />
											<span class="xp-frame-empty" set:html={iCamera} />
										</figure>
									))}
								</div>
							))}
						</div>
					</div>
				))}
			</div>
			<p class="xp-reel-note mono">Hover to hold it still.</p>
		</section>

		{/* ---- the halls ----
		    Six subjects, each with what it covered last year and who to call about it. */}
		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Subjects</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta"><b>{HALLS.length}</b> subjects · <b>{leadCount}</b> coordinators</span>
			</div>

			<div class="xp-halls">
				{HALLS.map((h, i) => (
					<article class="xp-hall">
						<header class="xp-hall-top">
							<i class="xp-hall-n mono">{pad(i + 1)}</i>
							<span class="xp-hall-icon" set:html={h.icon} />
							<h2 class="xp-hall-name">{h.name}</h2>
							<span class="xp-hall-count mono"><b>{h.n}</b> projects</span>
						</header>

						<p class="xp-blurb">{h.blurb}</p>

						{/* Names only. The full record — batch, roll, portrait — lives on the
						    teams page, where these fourteen are listed under Expo, and a phone
						    number on a public page is a number that gets scraped. */}
						<div class="xp-leads">
							<p class="xp-leads-label mono">Coordinators</p>
							<ul class="xp-lead-list">
								{h.leads.map((l) => <li class="xp-lead">{l}</li>)}
							</ul>
						</div>
					</article>
				))}
			</div>
			<p class="xp-foot mono">
				Project counts are from Anvesha &rsquo;25 &mdash; {lastYearTotal} across
				{' '}{HALLS.length} subjects.
			</p>
		</section>

		{/* ---- the forms ---- */}
		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Take part</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta">Three ways in</span>
			</div>

			<div class="xp-links">
				{LINKS.map((l) => (
					<a class="xp-link" href={l.href} target="_blank" rel="noopener noreferrer">
						<span class="xp-link-icon" set:html={l.icon} />
						<span class="xp-link-body">
							<span class="xp-link-label">{l.label}</span>
							<span class="xp-link-note">{l.note}</span>
						</span>
						<span class="xp-link-go" set:html={iArrowRight} />
					</a>
				))}
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	/* ============ THE GROUND ============
	   The home page's drawing, scaled up and put behind the page.

	   Three things here are about COST, not looks. At this size the naive version dropped
	   48 frames in 150 — measured, at 4x CPU throttle — and removing it dropped none:

	     1. No mask-image. A gradient mask over a large animated subtree forces the whole
	        masked area to repaint every frame. Plain opacity composites instead.
	     2. No vector-effect: non-scaling-stroke. It has to re-tessellate every stroke on
	        every transform, and the strokes here are six long wave paths.
	     3. contain + will-change on the animated groups, so each is its own layer and the
	        page around it is not repainted when they move.

	   Sized in vh rather than vw: it is a circle, and tying it to the taller axis keeps it
	   from swelling to absurdity on a wide monitor. */
	.xp-page { position: relative; z-index: 0; }
	.xp-sky-wrap {
		position: sticky; top: 0; z-index: -1;
		/* flex:none is load-bearing. .page is a flex column, so this is a flex ITEM and
		   its height is negotiable — it shrank to 4px while the -100vh margin still
		   subtracted a full screen, which hauled the header up out of view. */
		flex: none; height: 100vh; margin-bottom: -100vh;
		overflow: hidden; pointer-events: none;
		contain: strict;
	}
	/* Sized off the WIDTH of the right half it is meant to fill, with a vh ceiling so it
	   cannot outgrow a short window. Centred on 74% so the disc covers the right side
	   rather than sitting in the middle of it. */
	.xp-sky {
		position: absolute; top: 50%; left: 74%;
		width: min(66vw, 118vh); aspect-ratio: 1;
		transform: translate(-50%, -50%);
		opacity: .34;
		overflow: visible;
	}

	/* ---- the subject marks ----
	   No animation anywhere in here on purpose: the left of the frame needed something to
	   look at, and the page had just been taken from 48 dropped frames to none. A second
	   moving object would have spent that straight back.

	   Stroke-only and at the same weight as the planet's line work, so the two halves of
	   the frame read as one drawing rather than as a background and a decal. */
	.xp-marks {
		position: absolute; top: 50%; left: 15%;
		height: min(80vh, 660px); width: auto;
		transform: translate(-50%, -50%);
		opacity: .5;
	}
	.xp-marks :where(path, circle, ellipse, rect) { fill: none; }
	.xp-mk {
		stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}
	/* The three flare colours, cycled — the marks are the subjects, and the palette is the
	   theme's, so they belong to the same drawing as the planet. */
	.xp-mk-1 { stroke: color-mix(in srgb, var(--flare-plum) 46%, transparent); }
	.xp-mk-2 { stroke: color-mix(in srgb, var(--flare-rose) 44%, transparent); }
	.xp-mk-3 { stroke: color-mix(in srgb, var(--flare-coral) 40%, transparent); }
	.xp-mk-fill { fill: currentColor; stroke: none; }
	/* Strung together, the way a constellation is drawn between its stars. */
	.xp-link path {
		stroke: color-mix(in srgb, var(--flare-plum) 16%, transparent);
		stroke-width: 1.2; stroke-dasharray: 2 8;
	}

	@media (max-width: 900px) {
		/* Two drawings in a phone-width frame is clutter; the planet is the one that stays. */
		.xp-marks { display: none; }
	}
	.xp-sky :where(ellipse, circle, path, line) { fill: none; }

	.xp-sky .sol-o1, .xp-sky .sol-o2 {
		stroke-width: 1.5; stroke-dasharray: 3 9; transform-origin: 200px 200px;
		will-change: transform;
	}
	.xp-sky .sol-o1 {
		stroke: color-mix(in srgb, var(--flare-rose) 40%, transparent);
		animation: sol-spin 44s linear infinite;
	}
	.xp-sky .sol-o2 {
		stroke: color-mix(in srgb, var(--flare-coral) 46%, transparent);
		animation: sol-spin 30s linear infinite reverse;
	}
	.xp-sky .sol-rim { stroke: var(--flare-plum); stroke-width: 2; }
	.xp-sky .sol-w {
		stroke: color-mix(in srgb, var(--wc) 62%, transparent); stroke-width: 1.5;
		will-change: transform;
	}
	.xp-sky .sol-a { animation: sol-drift 19s linear infinite; }
	.xp-sky .sol-b { animation: sol-drift 27s linear infinite reverse; }
	.xp-sky .sol-c { animation: sol-drift 34s linear infinite; }
	.xp-sky .sol-cross { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 2 7; }
	.xp-sky .sol-dot { fill: var(--accent); stroke: none; }

	/* The rocket rides the tilted ring, which is itself turning — hence the carrier over
	   the top of the offset-path. offset-rotate: auto banks it through the turns. */
	.xp-sky .sol-rocket {
		transform-origin: 200px 200px;
		animation: sol-spin 30s linear infinite reverse;
		will-change: transform;
	}
	.xp-sky .sol-rk-orbit {
		offset-path: path('M 360 200 A 160 60 0 1 0 40 200 A 160 60 0 1 0 360 200');
		offset-rotate: auto;
		animation: sol-orbit 26s linear infinite;
		will-change: offset-distance;
	}
	.xp-sky .sol-rk { stroke: var(--flare-plum); stroke-width: 1.6; stroke-linejoin: round; }
	.xp-sky .sol-rk-eye { fill: var(--flare-coral); stroke: none; }
	.xp-sky .sol-rk-flame {
		stroke: var(--flare-coral); stroke-width: 2; stroke-linecap: round;
		animation: sol-burn 1.1s steps(2, jump-none) infinite alternate;
	}
	/* The moon's ring is a circle, and a circle turning about its own centre is the same
	   circle — so walking the path is the whole of its orbit, with no carrier. */
	.xp-sky .sol-mn-orbit {
		offset-path: path('M 382 200 A 182 182 0 1 0 18 200 A 182 182 0 1 0 382 200');
		offset-rotate: 0deg;
		animation: sol-orbit 34s linear infinite;
		will-change: offset-distance;
	}
	.xp-sky .sol-mn-spin {
		transform-box: fill-box; transform-origin: center;
		animation: sol-spin 11s linear infinite;
	}
	.xp-sky .sol-mn { stroke: var(--flare-plum); stroke-width: 1.6; }
	.xp-sky .sol-mn-c { fill: color-mix(in srgb, var(--flare-plum) 32%, transparent); stroke: none; }

	/* Exactly half the path's own width, so the loop cannot show a seam. */
	@keyframes sol-drift { to { transform: translateX(-400px); } }
	@keyframes sol-spin  { to { transform: rotate(360deg); } }
	@keyframes sol-orbit { from { offset-distance: 0%; } to { offset-distance: 100%; } }
	@keyframes sol-burn {
		from { opacity: .35; stroke-dasharray: 3 4; }
		to   { opacity: 1;   stroke-dasharray: 7 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.xp-sky * { animation: none !important; }
	}

	/* ============ THE PITCH ============
	   Centred: a title, one paragraph and one button read as a header, not a column. */
	.xp-head {
		padding-bottom: clamp(26px, 3.4vw, 40px);
		display: flex; flex-direction: column; align-items: center; text-align: center;
	}
	.xp-head .lede { max-width: 62ch; }

	.xp-cta { margin-top: clamp(24px, 3vw, 34px); }

	/* The three facts. One ink ground, the gap drawing every divider, so no cell needs a
	   border of its own. */
	.xp-facts {
		display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--stroke);
		width: 100%; max-width: 760px; margin: clamp(18px, 2.4vw, 26px) auto 0;
		background: var(--hair);
		border: 1.5px solid var(--hair); border-radius: var(--r);
		overflow: hidden;
	}
	.xp-fact {
		display: flex; flex-direction: column; align-items: center; gap: 6px;
		padding: 14px 12px;
		background: var(--primary);
	}
	.xp-fact dt {
		display: flex; align-items: center; gap: 7px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-60);
	}
	.xp-fact dt :global(svg) { width: 13px; height: 13px; stroke-width: 1.8; color: var(--accent); }
	.xp-fact dd {
		margin: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: clamp(12px, 1.15vw, 14.5px); letter-spacing: -.01em;
		text-wrap: balance;
	}
	@media (max-width: 620px) {
		.xp-facts { grid-template-columns: minmax(0, 1fr); }
	}

	/* ============ LAST YEAR ============
	   Two rows of five, travelling opposite ways. The frames in each row are rendered
	   TWICE and the track travels exactly -50%, so the second copy lands where the first
	   began and neither loop can show a seam.

	   No mask on these: a gradient mask over a moving strip repaints the whole masked band
	   every frame, which is what cost this page 48 frames in 150 when the sky had one. The
