---
import SiteLayout from '../layouts/SiteLayout.astro';

import iFlask from 'lucide-static/icons/flask-conical.svg?raw';
import iCalendar from 'lucide-static/icons/calendar-days.svg?raw';
import iArrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import iChevronDown from 'lucide-static/icons/chevron-down.svg?raw';
import iHandshake from 'lucide-static/icons/handshake.svg?raw';
import iMail from 'lucide-static/icons/mail.svg?raw';
import iImage from 'lucide-static/icons/image.svg?raw';
import iCamera from 'lucide-static/icons/camera.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';
import iChevL from 'lucide-static/icons/chevron-left.svg?raw';
import iChevR from 'lucide-static/icons/chevron-right.svg?raw';

// ============================================================
// PLACEHOLDER CONTENT — swap the copy, keep the shape.
// Everything below is scaffolding with plausible numbers in it, not researched fact.
// Each array drives one block of the scrolling story; adding or removing an entry
// needs no markup change.
// ============================================================

const THEME = {
	word: 'Solaris',
	// Kept as separate paragraphs: the first explains where the name comes from, the
	// second what it is doing here. Running them together buried the second.
	body: [
		'Drawn from the science-fiction world of a mysterious, living ocean that '
		+ 'continually defies scientific explanation.',
		'It reflects the essence of scientific inquiry — using every tool, theory and '
		+ 'method we have to explore questions that remain just beyond our understanding.',
	],
	// The line the whole theme turns on, so it is set apart rather than buried in prose.
	pull: 'Anvesha means quest. Solaris is what we are questing after: the pursuit of the '
		+ 'unknown, and the drive to understand what still lies beyond our reach.',
	// Closes the block: what the theme is dressed on. Set as a quote across the full
	// width rather than a dates/venue strip — the practical details live on the events
	// page, and repeating them here made the theme end on an admin note.
	//
	// Split here rather than left to the browser: the first line is sized to fill the rule
	// exactly and the second is centred under it, so where it breaks is a typesetting
	// decision and not whatever the measure happens to allow. The longer half goes first —
	// that is the one that has to fill the width.
	quote: [
		'Anvesha brings together thousands of students, educators and researchers from across the region',
		'for three days of exhibitions, keynote talks and student-led innovation.',
	],
};

/**
 * The sponsors, by what they actually gave.
 *
 * `logo` points at a file that need not exist yet: each tile falls back to the name set
 * in type if the image 404s, so dropping a file into public/img/sponsors/ is the whole
 * job — no markup change and no code change.
 *
 * Five marks are in: Domino's, Burger King and Wow! Momo from Wikimedia Commons, Natraj
 * and Imperial Life Sciences from their own sites. The other eight are small enough that
 * they publish no usable mark, and they show their name instead — nothing here is drawn
 * or approximated, because a logo we invented is worse than a wordmark.
 * TODO(anvesha): ask the remaining eight for a PNG.
 */
const SPONSORS = [
	{ cat: '3D Printing & Prototyping Partner', of: [
		{ name: '69 Rigs', logo: '/img/sponsors/69rigs.png' },
	] },
	{ cat: 'Stationery Partners', of: [
		{ name: 'Phoebus', logo: '/img/sponsors/phoebus.png' },
		{ name: 'August', logo: '/img/sponsors/august.png' },
	] },
	{ cat: 'Food Partners', of: [
		{ name: "Domino's", logo: '/img/sponsors/dominos.png' },
		{ name: 'Natraj', logo: '/img/sponsors/natraj.png' },
		{ name: 'Tasty', logo: '/img/sponsors/tasty.png' },
		{ name: 'Burger King', logo: '/img/sponsors/burger-king.png' },
		{ name: 'Wow! Momo', logo: '/img/sponsors/wow-momo.png' },
		{ name: 'Dinu Bakeries', logo: '/img/sponsors/dinu.png' },
	] },
	{ cat: 'Learning Partner', of: [
		{ name: 'Finlatics', logo: '/img/sponsors/finlatics.png' },
	] },
	{ cat: 'Trekking Partner', of: [
		{ name: 'Adventure Amas', logo: '/img/sponsors/adventure-amas.png' },
	] },
	{ cat: 'Science Education Partner', of: [
		{ name: 'Imperial Life Sciences', logo: '/img/sponsors/imperial-life-sciences.png' },
	] },
	{ cat: 'Hospitality Partner', of: [
		{ name: 'RinShi', logo: '/img/sponsors/rinshi.png' },
	] },
];
const sponsorCount = SPONSORS.reduce((n, g) => n + g.of.length, 0);

/**
 * The catalogue, numbered.
 *
 * Every entry gets a reference — A-01, B-02 — because that is what a catalogue is: a
 * thing you can point at a line of. The letter is the category, the number the entry
 * within it.
 *
 * Each category picks a column count that DIVIDES its own entry count, so its ribbon
 * always comes out as complete rows. A fixed four columns left one partner sitting beside
 * three empty cells, which reads as three sponsors we failed to sign rather than as one
 * sponsor — the grid should fit the list, not the list fill the grid.
 *
 * Four down to two, largest first; a count with no divisor in that range (five, seven)
 * falls back to four and is padded, which is the only case `fill` is ever non-zero.
 */
const LETTERS = 'ABCDEFGHIJ';
const colsFor = (n: number) => {
	for (let c = 4; c >= 2; c--) if (n % c === 0) return c;
	return Math.min(n, 4);
};
const CATALOGUE = SPONSORS.map((g, gi) => {
	const cols = colsFor(g.of.length);
	return {
		...g,
		no: String(gi + 1).padStart(2, '0'),
		of: g.of.map((sp, i) => ({
			...sp,
			ref: `${LETTERS[gi]}-${String(i + 1).padStart(2, '0')}`,
		})),
		cols,
		fill: (cols - (g.of.length % cols)) % cols,
	};
});

/**
 * Open day, counted at the door.
 *
 * `was` is the same figure a year earlier, where there is one — the interesting thing
 * about these numbers is not their size but that both of them roughly doubled, and a
 * single column of 2025 figures does not say that.
 */
const STATS = [
	{ value: 458,  suffix: '',  label: 'Registered for open day', was: '350 in 2024' },
	{ value: 2000, suffix: '+', label: 'Footfall on the day',     was: '1,000+ in 2024' },
	{ value: 428,  suffix: '',  label: 'Students among them',     was: '294 in 2024' },
	{ value: 11,   suffix: '',  label: 'Schools that came',       was: '6 in 2024' },
];

// The contact sheet — six frames from the '25 floor.
//
// Each `src` still falls back to a drawn placeholder if the file 404s, so swapping a
// photograph is the file and nothing else.
const GALLERY = [
	{ src: '/img/home/home1.jpeg', caption: 'Anvesha \u201925 \u00b7 frame 01' },
	{ src: '/img/home/home2.jpeg', caption: 'Anvesha \u201925 \u00b7 frame 02' },
	{ src: '/img/home/home3.jpeg', caption: 'Anvesha \u201925 \u00b7 frame 03' },
	{ src: '/img/home/home4.jpeg', caption: 'Anvesha \u201925 \u00b7 frame 04' },
	{ src: '/img/home/home5.jpeg', caption: 'Anvesha \u201925 \u00b7 frame 05' },
	{ src: '/img/home/home6.jpeg', caption: 'Anvesha \u201925 \u00b7 frame 06' },
];

// Lucide removed its brand marks, so these are drawn here in the same 24px stroke
// style as every other icon on the site rather than pulled from a second icon set.
// LinkedIn is absent because the fest has no LinkedIn page — an icon pointing at
// linkedin.com is worse than no icon.
const SOCIALS = [
	{ name: 'Instagram', href: 'https://www.instagram.com/anveshaiiser/',
	  svg: `<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>` },
	{ name: 'YouTube', href: 'https://www.youtube.com/@stciisertvm',
	  svg: `<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>` },
	{ name: 'X', href: 'https://x.com/Anvesha_IISER',
	  svg: `<path d="M4 4l16 16M20 4L4 20"/>` },
];


const WORD = 'ANVESHA';

// Ticker content. Repeated four times in the markup below so the strip is wider than
// any realistic viewport and can loop on a matching frame with no visible seam.
const TICKER = [
	'IISER THIRUVANANTHAPURAM',
	'ANNUAL SCIENCE FEST',
	'75+ PROJECTS',
	'20+ EVENTS',
	'OPEN TO ALL',
];
---

{/* The title carries the institute and the words "science fest" on purpose. Someone
    searching "anvesha" alone gets a Sanskrit dictionary and three unrelated companies;
    the words that separate this from those have to be IN the title, not only on the
    page. It stays under ~60 characters so Google does not truncate it. */}
<SiteLayout
	title="Anvesha '26 — IISER Thiruvananthapuram Science Fest"
	description="Anvesha is the annual science fest of IISER Thiruvananthapuram. Three days of exhibitions, keynote talks, competitions and student-led innovation — 11-13 September 2026, open to all."
>
	{/* Structured data. This is the difference between Google reading a page of words and
	    knowing there is a THING here called Anvesha, run by IISER TVM, happening on
	    specific dates at a specific place. It is also what feeds the knowledge panel when
	    somebody searches the name.

	    Two objects: the Organization is what the fest IS, the Event is what it is DOING
	    this year. sameAs is how Google connects the name to the social accounts already
	    ranking for it. */}
	<Fragment slot="head">
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'Organization',
					'@id': 'https://www.anvesha26.in/#organization',
					name: 'Anvesha',
					alternateName: "Anvesha '26",
					description: 'The annual science fest of IISER Thiruvananthapuram.',
					url: 'https://www.anvesha26.in/',
					email: 'hello@anvesha26.in',
					parentOrganization: {
						'@type': 'CollegeOrUniversity',
						name: 'Indian Institute of Science Education and Research Thiruvananthapuram',
						alternateName: 'IISER TVM',
						url: 'https://www.iisertvm.ac.in/',
					},
					sameAs: SOCIALS.map((s) => s.href),
				},
				{
					'@type': 'Event',
					name: "Anvesha '26",
					description: 'Three days of exhibitions, keynote talks, competitions and '
						+ 'student-led innovation at IISER Thiruvananthapuram.',
					startDate: '2026-09-11',
					endDate: '2026-09-13',
					eventStatus: 'https://schema.org/EventScheduled',
					eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
					url: 'https://www.anvesha26.in/',
					image: 'https://www.anvesha26.in/img/hero-flare.jpg',
					organizer: { '@id': 'https://www.anvesha26.in/#organization' },
					location: {
						'@type': 'Place',
						name: 'IISER Thiruvananthapuram',
						address: {
							'@type': 'PostalAddress',
							streetAddress: 'Maruthamala P.O., Vithura',
							addressLocality: 'Thiruvananthapuram',
							addressRegion: 'Kerala',
							postalCode: '695551',
							addressCountry: 'IN',
						},
					},
					// Free and open, said in the vocabulary Google reads.
					isAccessibleForFree: true,
				},
			],
		})} />
	</Fragment>
	<Fragment slot="head">
		{/* Hides the real wordmark before first paint, so it cannot flash in finished and
		    then be replaced by the particle build. Mirrors the shell's own [data-anim]
		    gate — and like that one, it only exists once JS has run, so a browser with
		    scripting off simply shows the heading.
		    The timeout is the failsafe: if the module never arrives, or throws before it
		    can hand over, the wordmark still appears on its own. */}
		<script is:inline>
			document.documentElement.dataset.hw = 'on';
			setTimeout(function () { document.documentElement.removeAttribute('data-hw'); }, 8000);
		</script>
	</Fragment>

	<div class="page home-page">
		<header class="page-head home-head">
			<p class="eyebrow" data-reveal>STC, IISER Thiruvananthapuram presents</p>

			<h1 class="home-word" id="homeWord">
				<span class="hw-stage">
					{/* The real type. Never removed — it is what a screen reader reads, what
					    search engines index, and what shows if any of the script below
					    fails. The canvas is only ever a curtain in front of it. */}
					<span class="hw-text">{WORD}</span>
					<span class="hw-year">'26</span>
					<canvas class="hw-canvas" aria-hidden="true"></canvas>
				</span>
			</h1>

			{/* Same rule—mark—rule divider, with a bouncing arrow where the ✕ was: the hero
			    now fills the whole card, so nothing below it is visible on open and this is
			    the only thing saying there is more. aria-hidden — it is a hint, not content;
			    the scrollbar is the accessible affordance. */}
			<div class="home-x" data-reveal aria-hidden="true">
				<span class="home-x-rule"></span>
				<span class="home-x-mark" set:html={iChevronDown} />
				<span class="home-x-rule"></span>
			</div>

			{/* Both carry an icon, so the pair reads as one set rather than a filled button
			    beside a bare one. Sponsors is a <button>, not a link: it opens a dialog on
			    this page rather than going anywhere, and a link that does not navigate is a
			    link that breaks middle-click, right-click and every other thing a reader
			    expects of one. */}
			<div class="home-actions" data-reveal>
				<a class="cta" href="/events">
					<span set:html={iCalendar} />
					<span>EVENTS</span>
					<span set:html={iArrowRight} />
				</a>
				<button class="btn home-alt" id="spOpen" type="button"
				        aria-haspopup="dialog" aria-controls="sp">
					<span set:html={iHandshake} />
					<span>SPONSORS</span>
				</button>
			</div>
		</header>

		{/* Marquee strip: the one piece of continuous motion left on the page once the
		    wordmark has settled, and the thing that stops the hero ending on a hard rule. */}
		<div class="home-ticker" aria-hidden="true">
			<div class="home-ticker-track">
				{[0, 1, 2, 3].map(() => (
					<span class="home-ticker-run">
						{TICKER.map((t) => (
							<>
								<span class="home-ticker-item">{t}</span>
								<span class="home-ticker-dot"></span>
							</>
						))}
					</span>
				))}
			</div>
		</div>

		{/* ---- below the fold ----
		    Four blocks, and deliberately not four of the same thing. The page used to run
		    alternating copy/illustration rows, which is the layout every fest site has:
		    it made every section read as equally important, which they are not. Each now
		    gets the shape its content wants — a statement, a theme, an instrument, a
		    running strip of film. */}
		<div class="home-scroll scroll-y" id="homeScroll">

			{/* ============ 1. THE THEME ============
			    Paper, not ink — the ticker above is already a black band, and a second one
			    directly under it made the top of the page one long dark slab.
			    The illustration is drawn here rather than sourced: a planet-ocean whose
			    surface never settles, which is the whole of Solaris in one figure. */}
			<section class="th" data-ab>
				<div class="th-in">
					<div class="th-copy">
						<p class="th-kick mono">This year&rsquo;s theme</p>
						<h2 class="th-word">{THEME.word}</h2>
						{THEME.body.map((para) => <p class="th-text">{para}</p>)}
						<blockquote class="th-pull"><p>{THEME.pull}</p></blockquote>
					</div>

					{/* aria-hidden: it says nothing the paragraphs beside it do not. */}
					<figure class="th-art" aria-hidden="true">
						<svg class="sol" viewBox="0 0 400 400" role="presentation">
							<defs>
								{/* The ocean is clipped to the sphere, so the waves can run far wider
								   than the planet and still loop without their ends showing. */}
								<clipPath id="solClip"><circle cx="200" cy="200" r="132" /></clipPath>
							</defs>

							{/* Two orbits, counter-rotating, drawn as dashes so the rotation reads
							   at all — a plain circle spinning is invisible. */}
							<g class="sol-orbits">
								<ellipse class="sol-o1" cx="200" cy="200" rx="182" ry="182" />
								<ellipse class="sol-o2" cx="200" cy="200" rx="160" ry="60" />
							</g>

							<circle class="sol-rim" cx="200" cy="200" r="132" />

							<g clip-path="url(#solClip)">
								{/* Six bands at different depths and speeds.
								   The path runs from -400 to 1000 — far wider than the 264px disc it
								   is clipped to. It has to: the drift travels 400px, so a path that
								   only just covered the circle at rest ran off its right edge by the
								   end of the cycle and left the ocean half empty.

								   Colour runs by depth, not by speed: coral at the top where the
								   light lands, through rose, to plum at the bottom. All three are
								   sampled off the hero wallpaper, so the drawing and the artwork
								   two screens up are lit by the same star. */}
								{[
									{ y: 118, d: 26, s: 'a', c: 'coral' }, { y: 152, d: 20, s: 'b', c: 'coral' },
									{ y: 186, d: 30, s: 'c', c: 'rose'  }, { y: 220, d: 18, s: 'a', c: 'rose'  },
									{ y: 254, d: 24, s: 'b', c: 'plum'  }, { y: 288, d: 22, s: 'c', c: 'plum'  },
								].map((w) => (
									<path class={`sol-w sol-${w.s}`} style={`--wc:var(--flare-${w.c})`}
									      d={`M -400 ${w.y} q 50 -${w.d} 100 0 ${'t 100 0 '.repeat(13)}`} />
								))}
							</g>

							{/* The one thing that is not moving: a fixed sight line across the disc,
							   so the drift has something to be measured against. */}
							<line class="sol-cross" x1="200" y1="52" x2="200" y2="348" />
							<circle class="sol-dot" cx="200" cy="200" r="4" />

							{/* Something out there looking at it. The group spins about the disc's
							   centre and the rocket is parked on the outer ring at (200, 18), so it
							   rides that exact orbit — no second path to keep in step with .sol-o1,
							   and it stays tangent because the whole frame turns with it. */}
							{/* The two of them, swapped: the rocket now runs the inner ellipse and
							   the moon the outer ring.

							   The rocket takes the harder path on purpose — the ellipse carries it
							   in front of the disc and back out behind it, which a circle never
							   does. It needs .sol-rocket over the top because that ellipse is
							   itself turning (.sol-o2), and an offset-path alone would leave the
							   rocket tracing a ring that is no longer there. offset-rotate: auto
							   points it along its own direction of travel, so it banks through the
							   turns for free.

							   The moon needs no such carrier. Its ring (.sol-o1) is a circle, and a
							   circle turning about its own centre is the same circle — so walking
							   the path is the whole of the orbit. Its two motions are the orbit and
							   its own axial spin; the craters are what make that second one visible
							   at all, since a spinning circle looks like nothing.

							   Both are drawn around (0,0): offset-path places the element at the
							   path point and its geometry is relative to that. */}
							<g class="sol-rocket">
								<g class="sol-rk-orbit">
									<path class="sol-rk-flame" d="M -8 0 h -6" />
									<path class="sol-rk" d="M -8 -4 L 1 -4 Q 10 0 1 4 L -8 4 Z" />
									<path class="sol-rk" d="M -5 -4 L -10 -8.5 L -8 -4 Z" />
									<path class="sol-rk" d="M -5 4 L -10 8.5 L -8 4 Z" />
									<circle class="sol-rk-eye" cx="-1" cy="0" r="1.7" />
								</g>
							</g>

							<g class="sol-mn-orbit">
								<g class="sol-mn-spin">
									<circle class="sol-mn" cx="0" cy="0" r="9" />
									<circle class="sol-mn-c" cx="-3.4" cy="-2.8" r="2.2" />
									<circle class="sol-mn-c" cx="3" cy="1.6" r="1.5" />
									<circle class="sol-mn-c" cx="-0.8" cy="4.4" r="1.1" />
								</g>
							</g>
						</svg>
					</figure>

					{/* What the theme is dressed on, across the full width, closing the
					    block. Not a heading: it is the one sentence a first-time visitor
					    needs, and it reads as a statement rather than as a label. */}
					<blockquote class="th-quote">
						<p>
							<span class="th-q1"><b class="th-qm">&ldquo;</b>{THEME.quote[0]}</span>
							<span class="th-q2">{THEME.quote[1]}<b class="th-qm">&rdquo;</b></span>
						</p>
					</blockquote>
				</div>
			</section>

			{/* ============ 2. LAST YEAR, IN FIGURES ============
			    A readout band between two rules, not four cards. Cards would have made
			    these compete with the theme above; a band reads as an instrument panel
			    and stays subordinate to it. */}
			<section class="fig" data-ab>
				<div class="fig-in">
					<header class="fig-head">
						<p class="fig-kick mono">Open day, in figures</p>
						<p class="fig-note">Counted at the door in 2025, against the same day in 2024.</p>
					</header>

					<div class="fig-band">
						{STATS.map((st, i) => (
							<div class="fig-cell">
								<span class="fig-i mono">{String(i + 1).padStart(2, '0')}</span>
								{/* The rendered text is the final value, so a reader with no JS or
								    a dead counter sees the number rather than a zero. */}
								<span class="fig-v" data-count={st.value} data-suffix={st.suffix}>
									{st.value.toLocaleString('en-IN')}{st.suffix}
								</span>
								<span class="fig-l">{st.label}</span>
								{/* The year-ago figure, small and under the label — it is context for
								    the number above it, not a number of its own. */}
								<span class="fig-was mono">{st.was}</span>
							</div>
						))}
					</div>
				</div>
			</section>

			{/* ============ 3. LAST YEAR, IN PHOTOGRAPHS ============
			    A bento, not eight equal thumbnails: equal cells said every frame mattered
			    the same, which is not how a contact sheet is read. The eight areas below
			    are fixed on purpose — the layout is the design, so it must not reshuffle
			    when a caption gets longer.

			    It is never still. Each cell carries its own --d, which staggers three
			    things off one number: the entrance, a slow pan across the photograph, and
			    a light that crosses the grid cell by cell. The light matters most right
			    now — every frame is a placeholder, and a placeholder cannot pan. */}
			<section class="cs" data-ab>
				<div class="cs-in">
					<header class="cs-head">
						<h2 class="cs-h">Glimpses into the archives</h2>
						<p class="cs-note">{GALLERY.length} frames. Hover one to read it; click to open it.</p>
					</header>

					{/* The bento sits ON a sheet of film rather than loose on the page: an
					    ink edge top and bottom with the sprockets punched out of it, and the
					    roll's own edge marking down the side. A real contact sheet is a
					    positive print, so the sheet itself is paper and only the film edge
					    is ink — which is how this stays a white block. */}
					<div class="cs-sheet">
						<span class="cs-perf" aria-hidden="true"></span>

						{/* aria-hidden on the numbers only: the caption is already on each
						    button's accessible name, so the grid reads as eight named buttons. */}
						<div class="cs-bento">
						{GALLERY.map((g, i) => (
							<div class="cs-cell" style={`--d:${(i * 0.11).toFixed(2)}s`}>
								<button class="cs-frame" type="button" data-shot={i}
								        aria-label={`Open frame ${i + 1}: ${g.caption}`}>
									<span class="cs-n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
									{/* onerror rather than a build-time check: the file may not exist
									    yet, and a broken-image glyph is worse than a frame. */}
									<img class="cs-img" src={g.src} alt="" loading="lazy"
									     onerror="this.closest('.cs-frame').classList.add('is-empty')" />
									<span class="cs-empty" aria-hidden="true">
										<span set:html={iCamera} />
									</span>
									<span class="cs-cap mono" aria-hidden="true">{g.caption}</span>
								</button>
							</div>
						))}
						</div>

						<span class="cs-perf" aria-hidden="true"></span>
						<p class="cs-edge mono" aria-hidden="true">
							ARCHIVE &nbsp;&middot;&nbsp; ROLL 01 &nbsp;&middot;&nbsp; {GALLERY.length} FRAMES
						</p>
					</div>
				</div>
			</section>
		</div>

		<footer class="home-foot">
			<nav class="foot-social" aria-label="Anvesha on social media">
				{SOCIALS.map((so) => (
					<a class="foot-ico" href={so.href} target="_blank" rel="noopener noreferrer"
					   aria-label={so.name} title={so.name}>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
						     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
						     set:html={so.svg} />
					</a>
				))}
			</nav>

			<a class="foot-mail mono" href="mailto:stc@iisertvm.ac.in">
				<span set:html={iMail} />
				<span>stc@iisertvm.ac.in</span>
			</a>
		</footer>
	</div>

	<Fragment slot="overlays">
		{/* ---- the sponsors ----
		    A catalogue sheet, not a list of cards: an ink masthead, a numbered strip per
		    category, and entries in a ruled grid. Every rule on the sheet is the ink ground
		    showing through the grid's own 2px gap — one background and one gap value draw
		    the whole table, so no cell carries a border and there are no nth-child sums to
		    keep in step when a category changes length.

		    In the overlays slot for the same reason the viewer is: .home-scroll is a scroll
		    container, and a fixed child of one is still clipped by it on some engines. */}
		<div class="sp" id="sp" hidden>
			<div class="sp-panel" role="dialog" aria-modal="true" aria-labelledby="spTitle">
				<header class="sp-head">
					<div class="sp-head-in">
						<span class="sp-kick mono"><span set:html={iHandshake} />Anvesha &rsquo;26</span>
						<h2 class="sp-title" id="spTitle">Sponsor catalogue</h2>
					</div>
					<dl class="sp-meta mono">
						<div><dt>Entries</dt><dd>{String(sponsorCount).padStart(2, '0')}</dd></div>
						<div><dt>Sections</dt><dd>{String(CATALOGUE.length).padStart(2, '0')}</dd></div>
						<div><dt>Edition</dt><dd>&rsquo;26</dd></div>
					</dl>
					<button class="btn x sp-close" id="spClose" type="button" aria-label="Close"
					        set:html={iX}></button>
				</header>

				<div class="sp-body">
					{CATALOGUE.map((g) => (
						<section class="sp-sec">
							<h3 class="sp-bar mono">
								<i class="sp-bar-n">{g.no}</i>
								<span class="sp-bar-t">{g.cat}</span>
								<span class="sp-bar-c">{String(g.of.length).padStart(2, '0')}</span>
							</h3>

							<div class="sp-grid" style={`--cols:${g.cols}`}>
								{g.of.map((sp) => (
									<article class="sp-cell">
										<i class="sp-ref mono">{sp.ref}</i>
										{/* onerror rather than a build-time check: the file may not
										    exist yet, and the name set in type is a better fallback
										    than a broken-image glyph — or than a logo we drew. */}
										<img class="sp-logo" src={sp.logo} alt={sp.name} loading="lazy"
										     onerror="this.closest('.sp-cell').classList.add('is-text')" />
										<span class="sp-name">{sp.name}</span>
									</article>
								))}
								{/* Blank stock, so the last row of the sheet is still ruled. */}
								{Array.from({ length: g.fill }, () => <span class="sp-cell is-blank" />)}
							</div>
						</section>
					))}
				</div>

				<footer class="sp-foot mono">
					<span>Partner with us</span>
					{/* The href keeps the real address; only the label is trimmed. A visible
					    string that is not a working address is one somebody types out by hand
					    and never hears back from. */}
					<a class="sp-mail" href="mailto:sponsors@anvesha26.in">sponsors@anvesha26</a>
				</footer>
			</div>
		</div>

		{/* The viewer. In the overlays slot because .home-scroll is a scroll container:
		    a fixed child of it would still be clipped by the scroller on some engines. */}
		<div class="lb" id="lb" hidden>
			<button class="lb-close btn x" id="lbClose" type="button" aria-label="Close" set:html={iX}></button>

			<button class="lb-nav lb-prev btn" id="lbPrev" type="button" aria-label="Previous frame"
			        set:html={iChevL}></button>

			<figure class="lb-fig" role="dialog" aria-modal="true" aria-label="Photograph">
				<div class="lb-stage">
					<img class="lb-img" id="lbImg" alt="" />
					<span class="lb-empty" id="lbEmpty" hidden set:html={iCamera} />
				</div>
				<figcaption class="lb-cap">
					<span class="lb-n mono" id="lbN">01 / 08</span>
					<span class="lb-t" id="lbT"></span>
				</figcaption>
			</figure>

			<button class="lb-nav lb-next btn" id="lbNext" type="button" aria-label="Next frame"
			        set:html={iChevR}></button>
		</div>

		<script type="application/json" id="lbData" set:html={JSON.stringify(GALLERY)} is:inline></script>
	</Fragment>
</SiteLayout>

<script>
	import { sampleInk } from '../scripts/ink';

	const WORD = 'ANVESHA';

	/**
	 * The wordmark: the nav's own ANVESHA'26 comes apart and rebuilds itself, full size,
	 * in the middle of the page. One continuous move — the grains that leave the menu bar
	 * are the grains that land on the hero.
	 *
	 *   1. LIFT      the nav wordmark is sampled, then hidden on the same frame the dust
	 *                appears on top of it, so it reads as coming apart rather than
	 *                being replaced
	 *   2. FLY       every grain travels from its letter in the bar to its letter in the
	 *                hero, staggered, so the word pulls apart and re-forms
	 *   3. HOLD      the word sits, drawn entirely out of dust
	 *   4. HAND OFF  the real type fades up underneath while the dust scatters off it
	 *
	 * The letter positions are not authored — the word is rendered once to an offscreen
	 * canvas in the page's own font and its ink is sampled, so the particles land on
	 * whatever Archivo Expanded actually draws at whatever size the viewport gives it.
	 *
	 * ponytail: one rAF loop over a flat array, not ~2000 tweens. Every particle runs the
	 * same three-phase function against one clock, so a frame costs a loop and a
	 * fillRect, and the canvas is thrown away the moment it has nothing left to draw.
	 */
	function wordmark() {
		const root = document.getElementById('homeWord');
		const done = () => {
			document.documentElement.removeAttribute('data-hw');
			root?.setAttribute('data-state', 'done');
		};
		if (!root) return done();

		const canvas = root.querySelector<HTMLCanvasElement>('.hw-canvas');
		const text = root.querySelector<HTMLElement>('.hw-text');
		if (!canvas || !text) return done();

		// Reduced motion gets the finished wordmark and nothing that moves.
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return done();

		// Covers a client-side navigation back to this page, where the inline head script
		// does not run again but the animation should still play from the start.
		root.setAttribute('data-state', 'run');
		document.documentElement.dataset.hw = 'on';

		// Fonts before metrics. Sampling before Archivo Expanded lands would build the
		// word out of the fallback's letterforms and put every particle in the wrong place.
		const ready = document.fonts?.ready ?? Promise.resolve();
		ready.then(() => build(root, canvas, text, done)).catch(done);
	}

	function build(root: HTMLElement, canvas: HTMLCanvasElement, text: HTMLElement, done: () => void) {
		// The step scales with the wordmark, so a phone and a desktop get a similar
		// particle COUNT rather than a similar density — one grain per 4px on a 190px
		// title would be a quarter of a million of them.
		const heroW = text.getBoundingClientRect().width;
		const step = Math.max(2, Math.round(Math.min(heroW, 1500) / 240));

		const hero = sampleInk(text, WORD, step);
		if (!hero) return done();

		// The bar's copy, if it is on screen. Sampled at step 1 — at 19px there is not much
		// ink to find, and a sparse source cloud makes the lift look like a fade.
		// Sampled as one flat string: the real node sets '26 as a <sup> at a smaller size,
		// which a single fillText cannot reproduce. At this size the difference is under a
		// grain, and the DOM node is hidden on the same frame the dust replaces it.
		const navWord = document.querySelector<HTMLElement>('.brand-solo .brand-word');
		const nav = navWord && navWord.getClientRects().length
			? sampleInk(navWord, WORD + "'26", 1)
			: null;

		// One canvas over the whole viewport, parented to <body>. The grains have to cross
		// from the menu bar to the middle of the page, so they cannot live in a box scoped
		// to the heading — and on <body> no ancestor's overflow, transform or stacking
		// context can clip them. Everything below is therefore in VIEWPORT coordinates.
		// z-index 55: over the bar and the card, under the mobile menu's 60, so a tap that
		// opens the menu mid-flight is not painted over by dust.
		const vw = document.documentElement.clientWidth;
		const vh = document.documentElement.clientHeight;
		const ctx = canvas.getContext('2d');
		if (!ctx) return done();

		// Capped at 2: past that the extra pixels are invisible and the fill rate is not.
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		canvas.width = Math.round(vw * dpr);
		canvas.height = Math.round(vh * dpr);
		canvas.style.cssText =
			`position:fixed;left:0;top:0;width:${vw}px;height:${vh}px;pointer-events:none;z-index:55`;
		document.body.appendChild(canvas);
		ctx.scale(dpr, dpr);

		// Sources sorted by x so a grain from the left of the bar lands on the left of the
		// hero. Picking at random instead would still assemble the word, but the flight
		// would read as a swarm rather than as the same word being pulled apart.
		const src = nav ? nav.pts.slice().sort((a, b) => a[0] - b[0]) : null;
		const srcN = src ? src.length : 0;
		// Centre of the bar wordmark, used to push each grain outward before it heads for
		// the hero — the "comes apart" half of the move.
		const navCx = nav ? nav.rect.left + nav.rect.width / 2 : 0;
		const navCy = nav ? nav.rect.top + nav.rect.height / 2 : 0;

		const P = hero.pts.map(([lx, ly]) => {
			// Hero target, in viewport space.
			const tx = hero.rect.left + lx;
			const ty = hero.rect.top + ly;

			let sx: number;
			let sy: number;
			if (src) {
				// Match on horizontal position within the word, with a little slop so the
				// grains do not travel in tidy parallel lines.
				const u = hero.w > 1 ? lx / hero.w : 0.5;
				const j = Math.round((Math.random() - 0.5) * srcN * 0.08);
				let i = Math.round(u * (srcN - 1)) + j;
				i = i < 0 ? 0 : i > srcN - 1 ? srcN - 1 : i;
				sx = nav!.rect.left + src[i][0];
				sy = nav!.rect.top + src[i][1];
			} else {
				// No bar wordmark to lift (a narrow viewport, or the node never rendered):
				// fall back to the original behaviour and gather in off every edge.
				const a = Math.random() * Math.PI * 2;
				const spread = 0.55 + Math.random();
				sx = tx + Math.cos(a) * hero.w * spread;
				sy = ty + Math.sin(a) * hero.h * spread * 2.6;
			}

			// Quadratic control point. Off to the side of the straight line and biased
			// upward, so the grain bursts off the bar and arcs down into the hero instead
			// of sliding along a chord — the difference between disintegrating and moving.
			let cx = (sx + tx) / 2;
			let cy = (sy + ty) / 2;
			if (src) {
				const ang = Math.atan2(sy - navCy, sx - navCx) + (Math.random() - 0.5) * 1.2;
				const burst = 30 + Math.random() * 110;
				cx = sx + Math.cos(ang) * burst;
				cy = sy + Math.sin(ang) * burst - 30 - Math.random() * 70;
			}

			return {
				tx, ty, sx, sy, cx, cy,
				// Where it goes when it blows off — outward from wherever it landed.
				bx: (lx - hero.w / 2) * 0.55 + (Math.random() - 0.5) * 90,
				by: (ly - hero.h / 2) * 0.9 + (Math.random() - 0.5) * 70 - 40,
				// Longer and more staggered than the old gather: this is a real journey
				// across the page, not a drop onto a letter a few pixels away.
				delay: Math.random() * 0.42,
				dur: 0.85 + Math.random() * 0.5,
				size: 1 + Math.random() * 1.6,
			};
		});

		// Derived, not guessed: the hold has to begin when the SLOWEST particle lands, or
		// the word never actually sits complete — the last grains would still be arriving
		// as the scatter starts. Reads off the same random values the loop animates.
		const GATHER = P.reduce((m, p) => Math.max(m, p.delay + p.dur), 0);
		const HOLD = 0.45;    // the word sits, drawn entirely out of dust
		const SCATTER = 0.85; // dust blows off while the real type comes up
		// How long the BAR wordmark sits before anything lifts. Without this the swap to
		// dust happens on the first animation frame — with the font cached that is about
		// two frames, so the thing that is supposed to come apart is never seen at all.
		// Only worth waiting for when there is a bar wordmark to look at.
		const DWELL = src ? 0.6 : 0;

		// The dust is drawn in whatever colour the real type is, read off the element
		// itself. Hardcoding --secondary painted black grains onto the dark hero, i.e.
		// nothing at all; this way the two can never disagree.
		ctx.fillStyle = getComputedStyle(text).color || '#fff';

		const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
		const clamp01 = (t: number) => (t < 0 ? 0 : t > 1 ? 1 : t);

		let raf = 0;
		let startMs = 0;
		let handedOver = false;
		let started = false;
		let lifted = false;

		const cleanup = () => {
			cancelAnimationFrame(raf);
			canvas.remove();
		};

		const frame = (now: number) => {
			// The clock starts on the FIRST frame, not at build time. Between the two sits
			// the font wait and the sampling, and starting the timeline before them would
			// spend part of the flight on a frame that was never drawn.
			if (!started) {
				started = true;
				startMs = now;
			}
			// Two clocks: `t` from the first frame, and `ft` — the flight — which does not
			// start until the bar wordmark has had its moment.
			const t = (now - startMs) / 1000;
			const ft = t - DWELL;

			if (ft < 0) {
				// The bar wordmark is still on screen, untouched. Nothing to draw yet.
				raf = requestAnimationFrame(frame);
				return;
			}
			if (!lifted) {
				lifted = true;
				// Handover frame: every grain is sitting exactly on the letterform it was
				// sampled from, so swapping the DOM text out here is invisible — what you
				// see next is that same word coming apart. Inline style so it beats the
				// html[data-hw] rule that revealed it.
				if (navWord) navWord.style.visibility = 'hidden';
			}

			ctx.clearRect(0, 0, vw, vh);

			const scatter = clamp01((ft - (GATHER + HOLD)) / SCATTER);
			const se = easeOut(scatter);

			// The real type comes up as the dust starts to leave, so there is never a
			// frame with no wordmark on screen.
			if (!handedOver && scatter > 0) {
				handedOver = true;
				done();
			}

			for (const p of P) {
				const local = clamp01((ft - p.delay) / p.dur);
				const e = easeOut(local);
				// Quadratic bezier src -> control -> target.
				const m = 1 - e;
				const x = m * m * p.sx + 2 * m * e * p.cx + e * e * p.tx + p.bx * se;
				const y = m * m * p.sy + 2 * m * e * p.cy + e * e * p.ty + p.by * se;
				// Fade in on approach, out on departure. min() stops a late particle
				// arriving at full opacity after the scatter has already begun.
				ctx.globalAlpha = Math.min(1, local * 2.4) * (1 - scatter);
				ctx.fillRect(x, y, p.size, p.size);
			}

			if (scatter < 1) {
				raf = requestAnimationFrame(frame);
			} else {
				// Nothing left to draw: drop the canvas rather than leave a full-viewport
				// transparent one composited over the page for the rest of the visit.
				cleanup();
				done();
			}
		};

		raf = requestAnimationFrame(frame);

		// ClientRouter swaps the DOM out from under a running loop; without this the rAF
		// keeps firing against a detached canvas until the tab is closed — and the canvas
		// now lives on <body>, so a swap would not take it away either.
		document.addEventListener('astro:before-swap', cleanup, { once: true });
	}

	document.addEventListener('astro:page-load', wordmark);

	/**
	 * Scroll choreography for the flow below the hero.
	 *
	 * Two things run off the middle pane: rows reveal once as they enter, and the
	 * illustrations drift inside their frames as it scrolls. The card scrolls
	 * INTERNALLY, so neither can use the window — an observer with the default root
	 * would call every row visible on load, and a window scroll listener would never
	 * fire at all.
	 *
	 * ponytail: class toggles driving CSS transitions plus one rAF-throttled scroll
	 * handler, not a tween per element. The observer unobserves on first hit.
	 */
	/**
	 * Run one [data-count] up to its own value. The final number is what the server
	 * rendered, so this only ever overwrites it on the way there and puts it back at the
	 * end — a dead counter, a reader with no JS, or reduced motion all still see the
	 * real figure.
	 */
	function countUp(el: HTMLElement) {
		if (el.dataset.counted) return;   // rows can re-enter the viewport; the count should not re-run
		el.dataset.counted = '1';

		const target = Number(el.dataset.count);
		const suffix = el.dataset.suffix ?? '';
		const fmt = (n: number) => n.toLocaleString('en-IN') + suffix;
		if (!Number.isFinite(target)) return;

		if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
			el.textContent = fmt(target);
			return;
		}

		// Long enough to read as counting, short enough that a scroll past does not leave
		// a number still climbing behind you.
		const DUR = 1100;
		const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
		const start = performance.now();

		const step = (now: number) => {
			const t = Math.min(1, (now - start) / DUR);
			el.textContent = fmt(Math.round(target * easeOut(t)));
			if (t < 1) requestAnimationFrame(step);
		};
		requestAnimationFrame(step);
	}

	function story() {
		// .page, not the middle pane: the hero no longer pins anything, so the whole page
		// is one scroller and that is what the observer roots on and the parallax reads.
		const scroller = document.querySelector<HTMLElement>('.home-page');
		const rows = document.querySelectorAll<HTMLElement>('[data-ab]');
		if (!rows.length) return;

		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		const show = (el: HTMLElement) => {
			el.classList.add('is-in');
			// Counters belong to the row they live in, so they start with its cascade.
			el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
		};

		if (!('IntersectionObserver' in window) || reduced) {
			rows.forEach(show);
			return;
		}

		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					show(e.target as HTMLElement);
					io.unobserve(e.target);
				}
			},
			// The bottom margin trims the trigger line up off the fold, so a row starts
			// moving as it appears rather than once it is already fully in view.
			{ root: scroller, rootMargin: '0px 0px -14% 0px', threshold: 0.12 },
		);
		rows.forEach((r) => io.observe(r));

	}

	/**
	 * The contact-sheet viewer.
	 *
	 * Rebound on every client-router navigation rather than once at module scope, and
	 * torn down through an AbortController — otherwise the key handler survives the
	 * page it belongs to and swallows Escape everywhere else on the site.
	 */
	let lbAc: AbortController | null = null;

	function viewer() {
		const lb = document.getElementById('lb');
		const data = document.getElementById('lbData');
		if (!lb || !data) return;

		lbAc?.abort();
		lbAc = new AbortController();
		const { signal } = lbAc;

		const shots: { src: string; caption: string }[] = JSON.parse(data.textContent || '[]');
		if (!shots.length) return;

		const img = document.getElementById('lbImg') as HTMLImageElement;
		const empty = document.getElementById('lbEmpty') as HTMLElement;
		const nEl = document.getElementById('lbN') as HTMLElement;
		const tEl = document.getElementById('lbT') as HTMLElement;
		const pad = (n: number) => String(n).padStart(2, '0');

		let at = 0;
		let opener: HTMLElement | null = null;

		function show(i: number) {
			// Wrap rather than clamp: at eight frames, hitting a dead arrow is more
			// annoying than looping.
			at = ((i % shots.length) + shots.length) % shots.length;
			const s = shots[at];
			empty.hidden = true;
			img.hidden = false;
			img.alt = s.caption;
			// The same fallback the sheet uses — a missing file shows the drawn frame
			// rather than a broken-image glyph.
			img.onerror = () => { img.hidden = true; empty.hidden = false; };
			img.src = s.src;
			nEl.textContent = `${pad(at + 1)} / ${pad(shots.length)}`;
			tEl.textContent = s.caption;
		}

		function open(i: number, from: HTMLElement) {
			opener = from;
			show(i);
			lb!.hidden = false;
			document.body.classList.add('lb-open');
			(document.getElementById('lbClose') as HTMLElement).focus();
		}

		function close() {
			lb!.hidden = true;
			document.body.classList.remove('lb-open');
			// Focus goes back to the frame that opened it, or the tab order restarts at
			// the top of the document.
			opener?.focus();
			opener = null;
		}

		for (const b of document.querySelectorAll<HTMLElement>('[data-shot]'))
			b.addEventListener('click', () => open(Number(b.dataset.shot), b), { signal });

		document.getElementById('lbClose')!.addEventListener('click', close, { signal });
		document.getElementById('lbPrev')!.addEventListener('click', () => show(at - 1), { signal });
		document.getElementById('lbNext')!.addEventListener('click', () => show(at + 1), { signal });
		// Backdrop only: a click that started on the photograph must not close it.
		lb.addEventListener('click', (e) => { if (e.target === lb) close(); }, { signal });

		addEventListener('keydown', (e) => {
			if (lb!.hidden) return;
			if (e.key === 'Escape') close();
			if (e.key === 'ArrowLeft') show(at - 1);
			if (e.key === 'ArrowRight') show(at + 1);
		}, { signal });
	}

	/**
	 * The sponsors dialog.
	 *
	 * Same shape as the viewer above and for the same reasons: bound on every client-router
	 * navigation and torn down through an AbortController, or the Escape handler outlives
	 * the page it belongs to and swallows Escape everywhere else on the site.
	 */
	let spAc: AbortController | null = null;

	function sponsors() {
		const sp = document.getElementById('sp');
		const open = document.getElementById('spOpen');
		if (!sp || !open) return;

		spAc?.abort();
		spAc = new AbortController();
		const { signal } = spAc;

		let opener: HTMLElement | null = null;

		const show = () => {
			// Fall back to the trigger itself: a click that did not move focus — a synthetic
			// one, or a browser that does not focus buttons on click — leaves activeElement
			// as <body>, and returning focus there on close strands the reader at the top of
			// the document instead of where they were.
			const active = document.activeElement as HTMLElement | null;
			opener = active && active !== document.body ? active : open;
			sp.hidden = false;
			document.body.classList.add('sp-open');
			// Focus moves into the dialog, or a keyboard reader is left outside a modal
			// they cannot reach and cannot close.
			document.getElementById('spClose')?.focus();
		};

		const hide = () => {
			sp.hidden = true;
			document.body.classList.remove('sp-open');
			opener?.focus();
		};

		open.addEventListener('click', show, { signal });
		document.getElementById('spClose')?.addEventListener('click', hide, { signal });
		// Backdrop only: a click that started inside the panel must not close it.
		sp.addEventListener('click', (e) => { if (e.target === sp) hide(); }, { signal });
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !sp.hidden) hide();
		}, { signal });
	}

	document.addEventListener('astro:page-load', story);
	document.addEventListener('astro:page-load', viewer);
	document.addEventListener('astro:page-load', sponsors);
</script>

<style is:global>
