	.art-ico svg { width: clamp(30px, 4vw, 46px); height: clamp(30px, 4vw, 46px); stroke-width: 1.4; }
	.art-tag {
		padding: 4px 10px; background: var(--secondary); color: var(--primary);
		font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase;
	}
	.art-cap {
		display: flex; align-items: center; gap: 7px; margin-top: 10px;
		font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-40);
	}
	.art-cap svg { width: 12px; height: 12px; stroke-width: 2; flex: none; }

	/* ---- timeline ---- */
	.tl { list-style: none; margin: 0; padding: 0; }
	.tl-row {
		position: relative;
		display: grid; grid-template-columns: 62px 16px 1fr; gap: 14px; align-items: start;
		padding: 0 0 22px;
	}
	/* The spine is drawn per row rather than as one rule behind them, so it grows with
	   the list and the last row can stop it cleanly. */
	.tl-row::before {
		content: ''; position: absolute; left: 83px; top: 14px; bottom: 0;
		width: 1.5px; background: var(--hair);
	}
	.tl-row:last-child { padding-bottom: 0; }
	.tl-row:last-child::before { display: none; }
	.tl-year { font-size: 12px; color: var(--ink-40); padding-top: 3px; }
	.tl-dot {
		width: 9px; height: 9px; margin-top: 7px; justify-self: center;
