	.fl-h {
		margin: 0 0 10px;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(20px, 2.3vw, 30px); line-height: 1.08;
		letter-spacing: -0.01em; text-transform: uppercase;
	}
	.fl-p { margin: 0 0 24px; font-size: 13.5px; line-height: 1.68; color: var(--ink-60); }
	.fl-cta { margin-top: 24px; align-self: start; }

	/* ---- the illustration frame ---- */
	.art { margin: 0; min-width: 0; }
	.art-frame {
		position: relative; overflow: hidden;
		aspect-ratio: 4 / 3;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		background: var(--sink);
		/* Same dot matrix as the page ground, so an empty frame reads as a reserved space
		   rather than a broken image. */
		background-image: radial-gradient(circle at center, var(--dot) 1.2px, transparent 1.4px);
		background-size: 16px 16px;
