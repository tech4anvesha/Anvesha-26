	.fl[data-side='left']  .art     { grid-column: 2; grid-row: 1; }
	.fl[data-side='right'] .fl-copy { grid-column: 2; grid-row: 1; }
	.fl[data-side='right'] .art     { grid-column: 1; grid-row: 1; }

	.fl-copy { min-width: 0; }
	.fl-kick {
		display: flex; align-items: center; gap: 10px; margin-bottom: 11px;
		font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--accent);
	}
