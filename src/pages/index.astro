	/* --iris is picked off the violet already in the artwork rather than --accent's
	   #0047ff. Measured over this crop: median 3.11:1, the best of the saturated purples
	   tested — #6d28d9 and #5b21b6 both read deeper but land under 2.8:1. */
	.home-head .hw-year { color: var(--iris); }

	/* Both buttons go ink now that the type has: the filled one is solid black with paper
	   type, the outline one a black rule. This is the shell's own default pairing, so
	   these rules exist only to override the dark-plate versions they replaced. */
	.home-head .cta { background: var(--secondary); color: var(--primary); }
	/* Filled paper, not a transparent outline. Outlined, this button read whatever was
	   behind it — over the dark half of the artwork it measured 1.04:1 and vanished. A
	   solid plate makes it independent of the crop, and black-on-white beside the filled
	   black button reads as a matched pair. */
	.home-head .home-alt {
		background: var(--primary); color: var(--secondary);
		border-color: var(--secondary);
	}
	.home-head .home-alt:hover {
		background: var(--secondary); color: var(--primary); border-color: var(--secondary);
