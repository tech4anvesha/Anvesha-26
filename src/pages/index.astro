		to   { opacity: 1;   stroke-dasharray: 7 0; }
	}

	/* Exactly half the path's own width: the second half of the wave lands where the
	   first began, so the loop cannot show a seam. */
	@keyframes sol-drift { to { transform: translateX(-400px); } }
	@keyframes sol-spin  { to { transform: rotate(360deg); } }

	/* Full width under both columns, so the block ends on a statement rather than on the
	   ragged bottom of a two-column grid. Ink at full strength — it is the plainest thing
	   said on the page and the only line here that is not about the theme. */
	/* Full width: the rule runs from the left margin to the far edge of the sphere, and
	   the sentence under it fills that same measure on ONE line. */
	.th-quote {
		grid-column: 1 / -1; grid-row: 2; margin: 0;
		padding-top: clamp(18px, 2.4vw, 28px);
		border-top: var(--stroke) solid var(--secondary);
		container-type: inline-size;
	}
	.th-quote p {
		margin: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; line-height: 1.32; letter-spacing: -0.02em;
		/* cqw, not px: the size is derived from the width the FIRST line has to fill, so
		   it lands on the rule's right end at every viewport instead of at one of them.
		   Tuned by measuring the rendered run. */
		font-size: 2.114cqw;
	}
	/* Two lines, neither of them breakable: the only break is the one in the markup. */
	.th-q1, .th-q2 { display: block; white-space: nowrap; }
	.th-q2 { text-align: center; }
	/* Marks inline at the two ends, not a block glyph above — that would have made this
	   three lines. Real elements rather than ::before/::after so the line can be measured
	   with everything that is actually on it. */
	.th-qm { font-weight: inherit; color: var(--flare-rose); }

	/* ---- 2. the figures ----
	   A band between two rules. Cards here would have competed with the theme above; a
	   band stays subordinate and still lets the numbers be large. */
	.fig { padding: clamp(40px, 5.5vw, 76px) clamp(20px, 3.5vw, 44px); }
	.fig-head { margin-bottom: clamp(20px, 3vw, 32px); }
	.fig-kick {
		margin: 0; display: flex; align-items: center; gap: 11px;
		font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--accent);
	}
	.fig-kick::before { content: ''; flex: none; width: 15px; height: 1.5px; background: var(--accent); }
	.fig-note { margin: 9px 0 0; font-size: 13px; line-height: 1.6; color: var(--ink-60); }

	.fig-band {
		display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5px;
		/* The gap IS the rule: one ink ground showing through the seams draws all three
		   dividers at once, with none to double up and none stranded at the ends. */
		background: var(--hair);
		border-top: var(--stroke) solid var(--secondary);
		border-bottom: var(--stroke) solid var(--secondary);
	}
	.fig-cell {
		display: flex; flex-direction: column; align-items: flex-start; gap: 6px;
		padding: clamp(20px, 2.6vw, 30px) clamp(14px, 1.8vw, 24px);
		background: var(--primary);
	}
	.fig-i { font-size: 9px; letter-spacing: .16em; color: var(--accent); }
	.fig-v {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(26px, 3.6vw, 50px); line-height: 1;
		letter-spacing: -0.03em; font-variant-numeric: tabular-nums;
	}
	.fig-l { font-size: 12px; line-height: 1.5; color: var(--ink-60); max-width: 22ch; }
	.fig-was {
		display: block; margin-top: 7px; padding-top: 7px;
		border-top: 1.5px solid var(--hair);
		font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-40);
	}

	/* ---- 3. the contact sheet ----
	   Paper, not ink. The theme above is already a light block and the figures between
	   them are lighter still, so this closes the page on the same ground rather than
	   dropping a black slab under it. --sink over pure paper for the same reason the
	   theme uses it: it separates the sheet from the figures without a second colour. */
	.cs {
		padding: clamp(40px, 5.5vw, 76px) clamp(20px, 3.5vw, 44px) clamp(52px, 6.5vw, 88px);
		background: var(--sink);
		border-top: 1.5px solid var(--hair);
	}
	.cs-head { margin-bottom: clamp(22px, 3vw, 34px); }
	.cs-h {
		margin: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(22px, 3vw, 38px); line-height: 1;
		letter-spacing: -0.02em; text-transform: uppercase;
	}
	.cs-note { margin: 10px 0 0; font-size: 13px; color: var(--ink-60); }

	/* ---- the sheet ----
	   The film the bento is printed on. A contact sheet is a positive print, so the sheet
	   is paper and only the edge is ink — the block stays white and still reads as film.
	   The perforations are one repeating gradient rather than N elements: decoration that
	   has to survive any width. */
	.cs-sheet {
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		padding: 0 0 clamp(8px, 1vw, 12px);
	}
	/* Ink band, holes punched out of it. Sized and centred rather than full-height, so
	   they read as sprockets in a film edge and not as a dashed rule. */
	.cs-perf {
		display: block; height: 15px;
		background-color: var(--secondary);
		background-image: repeating-linear-gradient(to right,
			transparent 0 7px, var(--primary) 7px 16px);
		background-size: 100% 7px;
		background-position: center;
		background-repeat: no-repeat;
	}
	/* The roll's own marking, in the margin under the frames where a lab prints it. */
	.cs-edge {
		margin: clamp(8px, 1vw, 12px) 0 0; padding: 0 clamp(10px, 1.4vw, 16px);
		font-size: 8.5px; letter-spacing: .22em; text-transform: uppercase;
		color: var(--ink-60);
	}

	/* Named areas, not auto-flow: the six shapes ARE the design, so they must not
	   reshuffle when a caption changes length. Rows are a fixed fraction of the viewport
	   width, which keeps every cell the ratio it was drawn at rather than letting content
	   set the height.

	   The two the sheet is built around take the two big areas — `b` is a 2x2 square and
	   `f` a 3x2 landscape. */
	.cs-bento {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-auto-rows: clamp(96px, 12vw, 168px);
		grid-template-areas:
			'a b b c'
			'a b b c'
			'd f f f'
			'e f f f';
		gap: clamp(8px, 1vw, 14px);
		padding: clamp(10px, 1.4vw, 16px);
	}
	/* home2 lands on `b` and home6 on `f` — the two largest areas — because the cells are
	   assigned in array order. */
	.cs-cell:nth-child(1) { grid-area: a; }
	.cs-cell:nth-child(2) { grid-area: b; }
	.cs-cell:nth-child(3) { grid-area: c; }
	.cs-cell:nth-child(4) { grid-area: d; }
	.cs-cell:nth-child(5) { grid-area: e; }
	.cs-cell:nth-child(6) { grid-area: f; }

	.cs-frame {
		position: relative; display: block; width: 100%; height: 100%; padding: 0;
		overflow: hidden; cursor: pointer; appearance: none;
		background: color-mix(in srgb, var(--secondary) 7%, var(--primary));
		border: 1.5px solid color-mix(in srgb, var(--secondary) 55%, transparent);
		border-radius: 1px;
		transition: transform .22s cubic-bezier(.2, .8, .3, 1),
		            border-color .22s ease, box-shadow .22s ease;
	}
	.cs-frame:hover, .cs-frame:focus-visible {
		transform: translateY(-3px); border-color: var(--accent); box-shadow: var(--pop);
	}
	.cs-frame:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

	.cs-img { display: block; width: 100%; height: 100%; object-fit: cover; }

	/* Frame number, burnt into the corner the way a real sheet has it. On an ink chip
	   rather than in ink: it has to sit on both a photograph and an empty pale frame,
	   and only one of those will hold plain type. */
	.cs-n {
		position: absolute; left: 6px; top: 6px; z-index: 4;
		padding: 2px 5px; border-radius: 1px;
		font-size: 8.5px; letter-spacing: .1em;
		color: var(--primary);
		background: color-mix(in srgb, var(--secondary) 74%, transparent);
	}
	.cs-empty {
		position: absolute; inset: 0; display: none; place-items: center;
		color: color-mix(in srgb, var(--secondary) 26%, transparent);
	}
	.cs-empty svg { width: 26px; height: 26px; stroke-width: 1.4; }
	/* Set by the img's own onerror, so a frame with no file yet still reads as a frame. */
	.cs-frame.is-empty .cs-img { display: none; }
	.cs-frame.is-empty .cs-empty { display: grid; }
	/* An empty frame is the state this grid is actually in today. Tinted so the ground the
	   glyph drifts over is not flat white. */
	.cs-frame.is-empty { background: color-mix(in srgb, var(--flare-plum) 6%, var(--sink)); }
	/* Captions ride inside the cell and only on hover — eight standing captions under
	   eight unequal boxes broke the grid back into a list. The text is not lost: it is
	   on each button's accessible name and in the viewer. */
	.cs-cap {
		position: absolute; right: 0; bottom: 0; left: 0; z-index: 4;
		padding: 16px 8px 6px;
		font-size: 9.5px; line-height: 1.4; letter-spacing: .04em; text-align: left;
		color: var(--primary);
		background: linear-gradient(to top,
			color-mix(in srgb, var(--secondary) 88%, transparent), transparent);
		white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
		opacity: 0; transform: translateY(6px);
		transition: opacity .2s ease, transform .2s ease;
	}
	.cs-frame:hover .cs-cap, .cs-frame:focus-visible .cs-cap { opacity: 1; transform: none; }

	@media (max-width: 760px) {
		/* Two across. The four-column areas collapse to a 2x… ladder that keeps the
		   alternation of wide and square instead of becoming eight identical squares. */
		.cs-bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-auto-rows: clamp(104px, 26vw, 150px);
			grid-template-areas:
				'a b'
				'a b'
				'c d'
				'e e'
				'f f'
				'f f';
		}
	}

	/* ============ THE SPONSORS ============
	   A catalogue sheet. Every rule on it is the ink ground showing through the grid's own
	   2px gap — one background and one gap draw the entire table, so no cell needs a
	   border of its own and nothing has to be recounted when a category changes length. */
	.sp {
		position: fixed; inset: 0; z-index: 60;
		display: grid; place-items: center;
		padding: clamp(12px, 4vw, 48px);
		background: color-mix(in srgb, var(--secondary) 88%, transparent);
	}
	.sp[hidden] { display: none; }
	body.sp-open { overflow: hidden; }

	.sp-panel {
		display: flex; flex-direction: column;
		width: min(100%, 900px); max-height: 100%;
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		box-shadow: var(--pop-lg);
		overflow: hidden;
	}

	/* ---- the masthead ---- */
	.sp-head {
		position: relative; flex: none;
		display: flex; align-items: flex-end; justify-content: space-between;
		gap: 20px; flex-wrap: wrap;
		padding: clamp(16px, 2.4vw, 24px) clamp(58px, 7vw, 74px) clamp(14px, 2vw, 20px)
		         clamp(16px, 2.4vw, 28px);
		background: var(--secondary); color: var(--primary);
		overflow: hidden;
	}
	/* The page's own dot matrix, raked off the corner so it never sits under the type. */
	.sp-head::before {
		content: ''; position: absolute; inset: 0; pointer-events: none;
		background-image: radial-gradient(circle at center,
			color-mix(in srgb, var(--primary) 16%, transparent) 1.2px, transparent 1.4px);
		background-size: 20px 20px;
		mask-image: linear-gradient(250deg, #000 0%, transparent 66%);
	}
	.sp-head-in { position: relative; min-width: 0; }
	.sp-kick {
		display: flex; align-items: center; gap: 9px;
		font-size: 10px; letter-spacing: .2em; text-transform: uppercase;
		color: color-mix(in srgb, var(--accent) 60%, var(--primary));
	}
	.sp-kick svg { width: 14px; height: 14px; stroke-width: 2; }
	.sp-title {
		margin: 9px 0 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(20px, 3vw, 30px); line-height: 1;
		letter-spacing: -.02em; text-transform: uppercase;
	}
	/* The plate a catalogue carries: what it holds, in how many sections, which edition. */
	.sp-meta {
		position: relative; display: flex; gap: clamp(14px, 2.4vw, 28px);
		margin: 0;
	}
	.sp-meta dt {
		font-size: 8.5px; letter-spacing: .18em; text-transform: uppercase;
		color: color-mix(in srgb, var(--primary) 52%, transparent);
	}
	.sp-meta dd {
		margin: 3px 0 0; font-size: 15px; letter-spacing: .04em;
		font-variant-numeric: tabular-nums;
	}
	.sp-close {
		position: absolute; top: 13px; right: 13px; width: 36px; height: 36px; padding: 0;
		background: var(--primary);
	}
	.sp-close svg { width: 15px; height: 15px; stroke-width: 2.4; }

	/* ---- the sheet ---- */
	.sp-body {
		flex: 1; min-height: 0; overflow-y: auto;
		scrollbar-width: thin; scrollbar-color: var(--secondary) transparent;
	}
	.sp-sec { border-bottom: var(--stroke) solid var(--secondary); }
	.sp-sec:last-child { border-bottom: 0; }

	/* The section strip: number, name, count — read like a row in an index. */
	.sp-bar {
		display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px;
		margin: 0; padding: 9px clamp(14px, 2vw, 20px);
		background: var(--sink);
		font-size: 9.5px; font-weight: 400; letter-spacing: .2em; text-transform: uppercase;
	}
	.sp-bar-n {
		display: grid; place-items: center; min-width: 22px; height: 17px;
		font-style: normal; font-size: 9px;
		color: var(--primary); background: var(--accent); border-radius: var(--r);
	}
	.sp-bar-t { min-width: 0; color: var(--secondary); }
	.sp-bar-c { color: var(--ink-40); font-variant-numeric: tabular-nums; }

	/* Four across, and the gap IS the ruling.
	   Inset from the panel and boxed on all four sides, so each category's entries read as
	   a ribbon with end walls rather than as a band running off both edges of the sheet.
	   The border is the same ink as the gap, so the walls and the inner rules are one
	   weight and one colour. */
	.sp-grid {
		display: grid; grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
		gap: var(--stroke);
		margin: clamp(10px, 1.4vw, 14px) clamp(12px, 1.8vw, 20px) clamp(12px, 1.8vw, 18px);
		background: var(--secondary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		overflow: hidden;
	}
	.sp-cell {
		position: relative;
		display: grid; place-items: center;
		min-height: 62px; padding: 18px 10px 10px;
		background: var(--primary);
	}
	/* Blank stock, and it is the GREY one. Filled cells are paper and empty cells are the
	   sheet showing through, which is the way round a form reads — the other way, three
	   blanks beside one entry looked like three entries that had failed to load. */
	.sp-cell.is-blank { background: var(--sink); min-height: 0; }
	.sp-ref {
		position: absolute; top: 7px; left: 9px;
		font-style: normal; font-size: 8px; letter-spacing: .14em;
		color: var(--ink-40);
	}
	.sp-logo { display: block; max-width: 100%; max-height: 44px; object-fit: contain; }
	/* The name is the fallback, not a caption: hidden while a logo is showing, and it
	   takes the cell when there is none. Set by the img's own onerror. */
	.sp-name {
		display: none; text-align: center; text-wrap: balance;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 12.5px; line-height: 1.25; letter-spacing: -.01em;
	}
	.sp-cell.is-text .sp-logo { display: none; }
	.sp-cell.is-text .sp-name { display: block; }

	.sp-foot {
		flex: none;
		display: flex; align-items: center; justify-content: space-between;
		gap: 14px; flex-wrap: wrap;
		padding: 12px clamp(16px, 2.4vw, 28px);
		border-top: var(--stroke) solid var(--secondary);
		background: var(--sink);
		font-size: 9.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-60);
	}
	.sp-mail { color: var(--accent); text-decoration: none; letter-spacing: .1em; }
	.sp-mail:hover { text-decoration: underline; }

	@media (max-width: 620px) {
		/* Two across at most — a six-wide ribbon on a phone is six slivers. min() rather
		   than a flat 2, so a solo partner still gets the whole ribbon instead of half of
		   one with a blank beside it. */
		.sp-grid { grid-template-columns: repeat(min(var(--cols, 4), 2), minmax(0, 1fr)); }
		.sp-head { padding-right: clamp(52px, 14vw, 64px); }
		.sp-meta { gap: 16px; }
	}

	/* ---- the viewer ---- */
	.lb {
		position: fixed; inset: 0; z-index: 60;
		display: grid; grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center; gap: clamp(8px, 2vw, 24px);
		padding: clamp(46px, 6vw, 70px) clamp(12px, 3vw, 34px);
		background: color-mix(in srgb, var(--secondary) 88%, transparent);
	}
	.lb[hidden] { display: none; }
	body.lb-open { overflow: hidden; }
	.lb-close { position: absolute; top: 16px; right: 16px; width: 38px; height: 38px; padding: 0; }
	.lb-close svg, .lb-nav svg { width: 16px; height: 16px; stroke-width: 2.4; }
	.lb-nav { width: 42px; height: 42px; padding: 0; display: grid; place-items: center; }

	.lb-fig { margin: 0; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
	/* fit-content, not a stretched grid: the stage took the full column and left ink bars
	   either side of every photograph that was not exactly the column's ratio, which read
	   as letterboxing rather than as a frame. */
	.lb-stage {
		width: fit-content; max-width: 100%;
		display: grid; place-items: center; min-height: 0;
		background: var(--secondary);
		border: var(--stroke) solid var(--primary); border-radius: var(--r);
		line-height: 0;
	}
	.lb-img { display: block; max-width: 100%; max-height: 74vh; width: auto; height: auto; }
	.lb-empty { display: grid; place-items: center; padding: 18vh 0; color: color-mix(in srgb, var(--primary) 30%, transparent); }
	.lb-empty svg { width: 40px; height: 40px; stroke-width: 1.2; }
	.lb-cap {
		display: flex; align-items: baseline; gap: 14px; justify-content: center;
		color: var(--primary);
	}
	.lb-n { font-size: 10px; letter-spacing: .16em; color: var(--accent); }
	.lb-t { font-size: 12.5px; color: color-mix(in srgb, var(--primary) 78%, transparent); }

	/* ---- the reveal ----
	   Each block lifts as one. The old page slid two halves in from opposite edges,
	   which only made sense when every row was two halves. */
	.th-in, .fig-in, .cs-in {
		opacity: 0; transform: translateY(20px);
		transition: opacity .6s ease, transform .6s cubic-bezier(.22, .8, .3, 1);
	}
	.th.is-in .th-in, .fig.is-in .fig-in, .cs.is-in .cs-in { opacity: 1; transform: none; }

	/* Cells inside a block cascade rather than arriving together. The bento reuses each
	   cell's own --d for the delay, so the entrance, the pan and the sweep are all
	   staggered off one number set once in the markup. */
	.fig-cell, .cs-cell {
		opacity: 0; transform: translateY(14px) scale(.97);
		transition: opacity .5s ease, transform .5s cubic-bezier(.2, .8, .3, 1);
	}
	.fig.is-in .fig-cell, .cs.is-in .cs-cell { opacity: 1; transform: none; }
	.fig.is-in .fig-cell:nth-child(1) { transition-delay: .16s; }
	.fig.is-in .fig-cell:nth-child(2) { transition-delay: .22s; }
	.fig.is-in .fig-cell:nth-child(3) { transition-delay: .28s; }
	.fig.is-in .fig-cell:nth-child(4) { transition-delay: .34s; }
	.cs.is-in .cs-cell { transition-delay: calc(.12s + var(--d)); }

	@media (prefers-reduced-motion: reduce) {
		.th-in, .fig-in, .cs-in, .fig-cell, .cs-cell {
			opacity: 1; transform: none; transition: none;
		}
		.cs-frame { transition: none; }
		.cs-frame:hover, .cs-frame:focus-visible { transform: none; }
		/* The sheet stands still. The script checks the same query and never starts the
		   flow field, so --fx/--fy/--fr/--fs keep their defaults and this is a plain
		   contact sheet — which is what it should be. */
		/* Same for the ocean: the drawing is legible standing still. */
		.sol-w, .sol-o1, .sol-o2, .sol-rocket, .sol-rk-flame,
		.sol-rk-orbit, .sol-mn-orbit, .sol-mn-spin { animation: none; }
		.foot-ico { transition: none; }
		.foot-ico:hover { transform: none; }
	}

	@media (max-width: 860px) {
		/* Two across, not four — below this the figures were 90px wide. */
		.fig-band { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		/* The theme stacks, and the figure goes first: a 116px word above a drawing that
		   has been squeezed into a third of the width reads worse than the reverse. */
		.th-in { grid-template-columns: minmax(0, 1fr); }
		.th-copy, .th-quote { grid-column: 1; grid-row: auto; }
		.th-art { grid-column: 1; grid-row: auto; order: -1; max-width: 320px; margin: 0 auto; }

	}

	/* One line only works while there is a line's worth of width. A 1120px container sets
	   it at 13.9px and it shrinks with the column from there; measured, 1250px of viewport
	   is where it reaches 13px, and below that it would keep shrinking to keep the promise.
	   It wraps and balances instead. */
	@media (max-width: 1250px) {
		.th-quote p { font-size: clamp(15px, 2.2vw, 20px); text-align: center; }
		/* Narrow, the two lines stop being two lines and go back to being one sentence. */
		.th-q1, .th-q2 { display: inline; white-space: normal; text-wrap: balance; }
	}

	@media (max-width: 560px) {
		.fig-band { grid-template-columns: minmax(0, 1fr); }
		.fig-l { max-width: none; }
		/* Stacked, the arrows sit under the photograph as a pair rather than flanking it.
		   Two explicit columns, not one: with a single track the two buttons could not
		   share row 2, so the grid invented an implicit column and threw them into the
		   corner with the photograph beside them. */
