	   flying, so the path under it stays the path that is drawn. */
	.sol-rocket { transform-origin: 200px 200px; animation: sol-spin 30s linear infinite reverse; }
	/* rx 160, ry 60 about (200, 200) — .sol-o2's ellipse as two arcs. auto, not 0deg: a
	   rocket that does not point where it is going is a rocket being dragged. */
	.sol-rk-orbit {
		offset-path: path('M 360 200 A 160 60 0 1 0 40 200 A 160 60 0 1 0 360 200');
		offset-rotate: auto;
		animation: sol-orbit 26s linear infinite;
	}
