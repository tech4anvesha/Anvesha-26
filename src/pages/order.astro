---
/**
 * ORDER STATUS — where a student finds their pass when the email did not arrive.
 *
 * Payment is reviewed by hand, so there is a gap between paying and being confirmed,
 * and the collection pass only exists on the far side of it. This page is the window
 * onto that gap: what was submitted, whether anyone has looked at it yet, and — once
 * they have — the same ticket the confirmation email carries.
 *
 * Roll number AND phone. The QR is a bearer token, and roll numbers are trivially
 * enumerable (IMS24001, IMS24002, …), so a roll-only lookup would let anyone walk the
 * range and collect other people's merch. The phone is the second factor: known to the
 * student, not derivable from the roll.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/ticket.css';
// The QR + reference + screenshot block, shared with the checkout popup.
import '../styles/paystep.css';
import iSearch from 'lucide-static/icons/search.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';
import iDownload from 'lucide-static/icons/download.svg?raw';
import iCopy from 'lucide-static/icons/copy.svg?raw';

// Where the money goes. Kept identical to the checkout page's — one account, and the
// resubmit form has to point at the same place the first attempt did.
const UPI_ID = 'sbibhim.022211900804305-ym662729@sbipay';
---

<SiteLayout
	title="Your order · Anvesha '26"
	description="Look up an Anvesha '26 merch order and collection pass with your roll number and mobile."
>
	<div class="page od-page">
		<div class="od-split" id="odSplit">
		<div class="od-left">
		<header class="page-head od-head" data-reveal>
			<p class="eyebrow">Merch &middot; Collection pass</p>
			<h1 class="page-title">Your order</h1>
			<p class="lede">
				Payments are checked by hand against our statement, so your pass appears here
				once someone has confirmed it. The same thing arrives by email &mdash; this is
				for when that goes astray.
			</p>

			<form class="od-form" id="odForm">
				<div class="od-fields">
					<label class="field">
						<span class="field-label">Roll number</span>
						{/* No pattern — IMS is not the only roll scheme on campus. Uppercased
						    on the way in so it matches the stored form. */}
						<input class="field-input roll-input" id="oRoll" name="roll_number" type="text"
						       autocomplete="off" spellcheck="false" maxlength="20" placeholder="IMS24101"
						       required />
					</label>
					<label class="field">
						<span class="field-label">Mobile you ordered with</span>
						<input class="field-input" id="oPhone" name="phone" type="tel"
						       inputmode="numeric" autocomplete="tel" placeholder="10-digit mobile" required />
					</label>
				</div>
				<p class="pay-err" id="odErr" hidden></p>
				<button class="btn od-go" id="odGo" type="submit">
					<span set:html={iSearch} /><span id="odGoLabel">FIND MY ORDER</span>
				</button>
				{/* Both, because roll alone is guessable — IMS24001, IMS24002 — and the QR
				    below is a bearer token. */}
				<p class="od-why">Both fields must match the order. Nothing else will find it.</p>
			</form>
		</header>

		{/* Stays put whether or not there is an answer on screen. It is the explanation
		    for a PENDING order as much as an introduction — and hiding it was what left
		    the left column half empty the moment a result arrived. */}
		<section class="section od-how" id="odHow" data-reveal>
			<div class="sechead">
				<span class="sechead-label">How this works</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta">Three steps</span>
			</div>
			<ol class="od-steps">
				<li><b>1</b><span><strong>You pay</strong> by UPI and send us the reference and a screenshot.</span></li>
				<li><b>2</b><span><strong>We check it</strong> against our bank statement by hand. Usually within a day.</span></li>
				<li><b>3</b><span><strong>Your pass arrives</strong> by email, and shows up on this page. Show its QR at the merch desk.</span></li>
			</ol>
		</section>
		</div>

		{/* The answer. Empty until a lookup returns something, at which point the page
		    gives up a column to it. */}
		<div class="od-right">
		<section class="section od-results" id="odResults" hidden data-reveal>
			<div class="sechead">
				<span class="sechead-label">Found</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta" id="odMeta"></span>
			</div>
			<div class="od-list" id="odList"></div>
		</section>
		</div>
		</div>
	</div>

	<Fragment slot="overlays">
		{/* Resubmit. The same QR, reference and screenshot the checkout popup asks for —
		    a second attempt should not look like a different product. */}
		<div id="reModal" class="ov" hidden>
			<div class="ov-panel ov-re" role="dialog" aria-modal="true" aria-labelledby="reTitle">
				<div class="ov-head">
					<span class="ov-title" id="reTitle">SUBMIT PAYMENT AGAIN</span>
					<button class="btn x" id="reClose" type="button" aria-label="Close" set:html={iX} />
				</div>

				<div class="ov-body">
					<p class="re-for mono">Order <b id="reOrder">ORD_</b></p>

					<form id="reForm" class="pay-step">
						<div class="pay-card">
							<p class="upi-step mono"><b>1</b> Pay in your UPI app</p>
							<div class="upi-main">
								<div class="upi-qr" id="reQrBox">
									<img src="/img/pay/upi-qr.png" alt="UPI payment QR code for Anvesha '26"
									     width="200" height="200" />
									<canvas id="reQr" class="upi-qr-live" width="220" height="220"
									        aria-label="UPI payment QR code with the amount filled in"></canvas>
								</div>
								<div class="upi-side">
									<p class="tk-eyebrow">Amount</p>
									<b class="upi-amount" id="reAmount">₹0</b>
									<p class="tk-eyebrow upi-vpa-label">UPI ID</p>
									<button class="upi-vpa mono" id="reVpa" type="button" title="Copy this UPI ID">
										<span>{UPI_ID}</span>
										<i class="upi-copy" aria-hidden="true" set:html={iCopy} />
									</button>
								</div>
							</div>
							<a class="btn upi-dl" id="reDl" href="/img/pay/upi-qr.png"
							   download="anvesha-upi-qr.png">
								<span set:html={iDownload} />SAVE QR
							</a>
							<p class="upi-hint">If you have already paid previously, please resubmit the details following the instructions given again.</p>
						</div>

						<div class="pay-card">
							<p class="upi-step mono"><b>2</b> Then tell us about it</p>

							<label class="field">
								<span class="field-label">Transaction / UTR reference</span>
								<input class="field-input mono" id="reTxn" type="text" autocomplete="off"
								       spellcheck="false" minlength="4" maxlength="64"
								       placeholder="from your UPI app" required />
							</label>

							<label class="field">
								<span class="field-label">Payment screenshot</span>
								<span class="proof" id="reProofBox">
									<input id="reProof" type="file" accept="image/jpeg,image/png,image/webp" required />
									<img class="proof-img" id="reProofImg" alt="" />
									<span class="proof-hint">
										<b>Tap to attach</b>
										<span>a screenshot showing the payment succeeded with <strong>the transaction id visible clearly</strong>: Screenshots without visible transaction id will not be accepted</span>
									</span>
									<span class="proof-name mono" id="reProofName"></span>
								</span>
							</label>
						</div>

						<p class="pay-err" id="reErr" hidden></p>
						<button class="btn od-go" id="reGo" type="submit">
							<span id="reGoLabel">SUBMIT PAYMENT</span>
						</button>
					</form>

					{/* Same 14-tile bar the checkout uses, so the wait reads the same way. */}
					<div id="reBusy" class="processing" hidden>
						<p class="proc-label">Sending your payment details</p>
						<div id="reProgress" class="pay-progress" role="progressbar"
						     aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
							{Array.from({ length: 14 }).map(() => <span class="seg" />)}
						</div>
					</div>

					<div id="reDone" class="re-done" hidden>
						<span class="recv-mark" aria-hidden="true"></span>
						<h3 class="recv-title">Resubmission accepted</h3>
						<p class="recv-text">
							We&rsquo;ve got your new payment details. Someone checks them against our
							statement, usually within a day, and your collection pass lands in your
							inbox the moment it&rsquo;s confirmed.
						</p>
						<button class="btn orderback" id="reDoneBtn" type="button">DONE</button>
					</div>
				</div>
			</div>
		</div>
	</Fragment>
</SiteLayout>

<script>
	import { API } from '../lib/api';
	import { type ReceiptData, drawQR, saveReceipt } from '../lib/ticket';

	type Line = { name: string; size: string | null; quantity: number; line_total_paise: number; collected: 0 | 1 };
	type Order = {
		order_id: string;
		items: Line[];
		total_price_paise: number;
		payment_status: string;
		review_status: 'none' | 'pending' | 'confirmed' | 'rejected';
		payment_ref: string | null;
		review_note: string | null;
		collection_status: 'pending' | 'partial' | 'collected';
		created_at: string;
		name: string;
		/** The order id, and only once an admin has confirmed. Null otherwise. */
		qr_payload: string | null;
	};

	// Astro module scripts run once per browser session; with the client router a second
	// visit swaps in fresh nodes that nothing would have wired. Everything re-runs on
	// astro:page-load, same as every other page here.
	let inited: HTMLElement | null = null;
	let ac: AbortController | null = null;

	function initOrder() {
		const form = document.getElementById('odForm') as HTMLFormElement | null;
		if (!form || form === inited) return;
		inited = form;
		// Drops the previous visit's window-level listeners; without it every
		// ClientRouter return would stack another Escape handler on the document.
		ac?.abort();
		ac = new AbortController();
		const { signal } = ac;

		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const rollEl = $<HTMLInputElement>('oRoll'), phoneEl = $<HTMLInputElement>('oPhone');
		const errEl = $('odErr'), goBtn = $<HTMLButtonElement>('odGo');
		const resultsEl = $('odResults'), listEl = $('odList'), metaEl = $('odMeta');
		const goLabel = $('odGoLabel'), splitEl = $('odSplit');

		// Uppercased as it is typed, so what the student sees matches what is stored.
		// The caret is restored because assigning .value sends it to the end, which makes
		// correcting the middle of a roll number impossible.
		rollEl.addEventListener('input', () => {
			const at = rollEl.selectionStart;
			rollEl.value = rollEl.value.toUpperCase();
			rollEl.setSelectionRange(at, at);
		});

		const rupees = (paise: number) =>
			'₹' + (paise % 100 === 0 ? String(paise / 100) : (paise / 100).toFixed(2));
		const esc = (s: string) =>
			s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

		/** What the student is waiting on, in their words rather than the schema's. */
		function statusOf(o: Order): { pill: string; cls: string; line: string } {
			if (o.payment_status === 'paid')
				return o.collection_status === 'collected'
					? { pill: 'COLLECTED', cls: 'done', line: 'Picked up. Nothing left on this order.' }
					: o.collection_status === 'partial'
						? { pill: 'PART COLLECTED', cls: 'on', line: 'Some of this order is still at the desk — the QR below is still good.' }
						: { pill: 'READY', cls: 'on', line: 'Confirmed. Show the QR at the merch desk to collect.' };
			if (o.review_status === 'pending')
				return { pill: 'CHECKING', cls: 'wait', line: 'We have your payment and are matching it against our statement. Usually within a day.' };
			if (o.review_status === 'rejected')
				return {
					pill: 'NOT CONFIRMED', cls: 'bad',
					line: o.review_note
						? `We could not match that payment. ${o.review_note}`
						: 'We could not match that payment. Submit it again, or ask at the merch desk.',
				};
			return { pill: 'NOT PAID', cls: 'wait', line: 'No payment has been sent for this order yet.' };
		}

		const stamp = (iso: string) => {
			const d = new Date(iso.replace(' ', 'T') + 'Z');
			return Number.isNaN(d.getTime())
				? iso
				: d.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' });
		};

		function render(orders: Order[]) {
			listEl.innerHTML = '';
			metaEl.innerHTML = `<b>${orders.length}</b> ${orders.length === 1 ? 'order' : 'orders'}`;

			for (const o of orders) {
				const st = statusOf(o);
				const paid = Boolean(o.qr_payload);

				const card = document.createElement('article');
				card.className = 'od-card';
				card.innerHTML =
					// The state leads. It is the one thing everyone came to find out, and
					// burying it inside the ticket made it the last thing read.
					`<div class="od-state ${st.cls}">` +
						`<span class="od-pill">${st.pill}</span>` +
						`<p class="od-line">${esc(st.line)}</p>` +
					`</div>` +

					`<div class="ticket">` +
						`<div class="tk-head">` +
							`<span class="tk-brand">ANVESHA<sup>'26</sup></span>` +
							`<span class="tk-kind">${paid ? 'COLLECTION PASS' : 'ORDER'}</span>` +
						`</div>` +
						`<div class="tk-body">` +
							`<p class="tk-eyebrow">Order no.</p>` +
							`<p class="tk-id">${esc(o.order_id)}</p>` +
							`<ul class="order-items">` +
								o.items.map((l) =>
									`<li><span>${esc(l.name)}${l.size ? ' · ' + esc(l.size) : ''} × ${l.quantity}` +
									(l.collected ? ' <i class="od-got">picked up</i>' : '') +
									`</span><b>${rupees(l.line_total_paise)}</b></li>`).join('') +
							`</ul>` +
							`<div class="tk-meta">` +
								`<div class="tk-cell"><span>Bearer</span><b>${esc(o.name)}</b></div>` +
								`<div class="tk-cell tk-cell-paid"><span>Total</span><b>${rupees(o.total_price_paise)}</b></div>` +
							`</div>` +
						`</div>` +
						`<div class="tk-rip" aria-hidden="true"></div>` +
						`<div class="tk-stub">` +
							(paid
								// 220 is a pre-layout placeholder; drawQR resizes the canvas.
								? `<canvas class="qr" width="220" height="220" aria-label="Collection QR code"></canvas>`
								// Keeps the stub's shape so the card does not jump size when
								// an order is confirmed, and says what is missing rather than
								// looking like an image that failed.
								: `<span class="od-wait"><i></i><b>PASS<br />PENDING</b></span>`) +
							`<div class="tk-stub-side">` +
								`<p class="tk-eyebrow">${paid ? 'Present at counter' : 'Ordered'}</p>` +
								`<p class="tk-txn">${paid ? 'Scan this at the merch desk.' : esc(stamp(o.created_at))}</p>` +
								(o.payment_ref ? `<p class="tk-serial">REF ${esc(o.payment_ref)}</p>` : '') +
							`</div>` +
						`</div>` +
					`</div>` +
					(paid ? `<button class="btn qrdl" type="button">DOWNLOAD PASS</button>` : '') +
					// A rejected payment is the one state the student can act on: fix it,
					// or be rid of it. Anything else is waiting, and offers nothing.
					(o.review_status === 'rejected'
						? `<div class="od-act">` +
							`<button class="btn od-redo" type="button" data-redo>SUBMIT AGAIN</button>` +
							`<button class="btn od-cancel" type="button" data-cancel>CANCEL ORDER</button>` +
						`</div>`
						: '');

				// The QR is drawn, not templated — the canvas has to exist first.
				if (paid) {
					const canvas = card.querySelector('canvas') as HTMLCanvasElement;
					drawQR(canvas, o.qr_payload!);

					const receipt: ReceiptData = {
						order_id: o.order_id,
						transaction_id: o.payment_ref ?? '',
						total_price_paise: o.total_price_paise,
						items: o.items,
						name: o.name,
						roll_number: rollEl.value.toUpperCase(),
					};
					(card.querySelector('.qrdl') as HTMLButtonElement).onclick = () => {
						void saveReceipt(receipt).catch((e) => console.warn('pass download failed', e));
					};
				}

				card.querySelector('[data-redo]')?.addEventListener('click', () => openResubmit(o));
				card.querySelector('[data-cancel]')?.addEventListener('click', () => cancelOrder(o));

				listEl.appendChild(card);
			}

			// The page gives up a column to put the answer beside the form. The
			// explainer stays: for a PENDING order it is the answer to "why no pass yet".
			resultsEl.hidden = false;
			splitEl.classList.add('is-split');
		}

		// ---- cancel ----
		async function cancelOrder(o: Order) {
			if (!confirm(
				`Cancel order ${o.order_id}?\n\nIt is removed for good, along with the screenshot you sent. ` +
				`If you did pay and we simply could not match it, use SUBMIT AGAIN instead.`,
			)) return;

			try {
				const res = await fetch(`${API}/api/orders/${encodeURIComponent(o.order_id)}`, { method: 'DELETE' });
				const data = await res.json();
				if (!res.ok) throw new Error(data.message || data.error || 'Could not cancel that order');
				// `removed: false` means it stopped being cancellable between the click and
				// the request — an admin confirming it, most likely. Re-reading is the only
				// honest answer; the card will come back showing whatever is now true.
				if (!data.removed) alert('That order can no longer be cancelled — it has just been confirmed.');
				await lookup();
			} catch (err) {
				errEl.textContent = (err as Error).message;
				errEl.hidden = false;
			}
		}

		// ---- resubmit ----
		const reModal = $('reModal'), reForm = $<HTMLFormElement>('reForm');
		const reBusy = $('reBusy'), reDone = $('reDone');
		const reTxn = $<HTMLInputElement>('reTxn'), reProof = $<HTMLInputElement>('reProof');
		const reProofBox = $('reProofBox'), reProofImg = $<HTMLImageElement>('reProofImg');
		const reProofName = $('reProofName'), reErr = $('reErr');
		const reGo = $<HTMLButtonElement>('reGo'), reGoLabel = $('reGoLabel');
		const reQr = $<HTMLCanvasElement>('reQr'), reQrBox = $('reQrBox');
		const reVpa = $<HTMLButtonElement>('reVpa'), reDl = $<HTMLAnchorElement>('reDl');
		const UPI_ID = reVpa.querySelector('span')!.textContent!.trim();
		const PROOF_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
		const MAX_PROOF_BYTES = 5 * 1024 * 1024;

		let redoOrder: Order | null = null;
		let proofUrl: string | null = null;
		let reDlUrl: string | null = null;

		const segs = [...$('reProgress').querySelectorAll<HTMLElement>('.seg')];
		let segTimer = 0;
		function setSegs(n: number) {
			segs.forEach((el, i) => el.classList.toggle('on', i < n));
			$('reProgress').setAttribute('aria-valuenow', String(Math.round((n / segs.length) * 100)));
		}
		/** Lights tiles one at a time, holding the last one back until the server answers. */
		function startProgress() {
			setSegs(0);
			let i = 0;
			clearInterval(segTimer);
			segTimer = setInterval(() => { if (i < segs.length - 1) setSegs(++i); }, 110) as unknown as number;
		}
		const finishProgress = () => { clearInterval(segTimer); setSegs(segs.length); };
		const resetProgress = () => { clearInterval(segTimer); setSegs(0); };

		function showProof(file: File | null) {
			if (proofUrl) { URL.revokeObjectURL(proofUrl); proofUrl = null; }
			reProofBox.classList.toggle('has-file', Boolean(file));
			reProofName.textContent = file ? file.name : '';
			if (!file) { reProofImg.removeAttribute('src'); return; }
			proofUrl = URL.createObjectURL(file);
			reProofImg.src = proofUrl;
		}

		function reFace(face: 'form' | 'busy' | 'done') {
			reForm.hidden = face !== 'form';
			reBusy.hidden = face !== 'busy';
			reDone.hidden = face !== 'done';
			$<HTMLButtonElement>('reClose').disabled = face === 'busy';
		}

		function openResubmit(o: Order) {
			redoOrder = o;
			$('reOrder').textContent = o.order_id;
			$('reAmount').textContent = rupees(o.total_price_paise);
			reTxn.value = '';
			reProof.value = '';
			showProof(null);
			reErr.hidden = true;
			reGoLabel.textContent = 'SUBMIT PAYMENT';
			reFace('form');
			resetProgress();
			paintUpiQr(o.order_id, o.total_price_paise);
			openOverlay('reModal', true);
			reTxn.focus();
		}

		/**
		 * The same UPI intent URI the checkout draws, for the same order.
		 *
		 * `am` means the student confirms an amount rather than typing one, and `tn`
		 * puts the order id in the bank narration so the admin checking the statement a
		 * second time can see which order a credit belongs to.
		 */
		function paintUpiQr(orderId: string, paise: number) {
			const amount = (paise / 100).toFixed(2);
			// The underscore is kept: the whole point of the note is that it matches the
			// order id exactly on the statement.
			const note = `Anvesha26 ${orderId}`.replace(/[^A-Za-z0-9 _-]/g, '-').slice(0, 50);
			const uri =
				`upi://pay?pa=${encodeURIComponent(UPI_ID)}` +
				`&pn=${encodeURIComponent("Anvesha '26")}` +
				`&am=${amount}&cu=INR&tn=${encodeURIComponent(note)}`;
			try {
				drawQR(reQr, uri);
				reQrBox.classList.add('live');
			} catch (e) {
				// The static QR underneath is still on screen; it just carries no amount.
				console.warn('[order] could not draw the UPI QR, falling back to the static one', e);
				return;
			}
			reQr.toBlob((blob) => {
				if (!blob) return;
				if (reDlUrl) URL.revokeObjectURL(reDlUrl);
				reDlUrl = URL.createObjectURL(blob);
				reDl.href = reDlUrl;
				reDl.download = `anvesha-upi-${orderId}.png`;
			}, 'image/png');
		}

		reVpa.onclick = async () => {
			try {
				await navigator.clipboard.writeText(UPI_ID);
				reVpa.classList.add('copied');
				setTimeout(() => reVpa.classList.remove('copied'), 1400);
			} catch {
				// Insecure origin or a denied permission: select it so it can be copied by hand.
				const r = document.createRange();
				r.selectNodeContents(reVpa.querySelector('span')!);
				const sel = getSelection();
				sel?.removeAllRanges();
				sel?.addRange(r);
			}
		};

		reProof.onchange = () => {
			const file = reProof.files?.[0] ?? null;
			reErr.hidden = true;
			// The same two rules the worker enforces, so a bad file fails instantly
			// instead of after a 5MB upload.
			if (file && !PROOF_TYPES.includes(file.type)) {
				reErr.textContent = 'That file type will not work — use a JPG, PNG or WebP screenshot.';
				reErr.hidden = false;
				reProof.value = '';
				return showProof(null);
			}
			if (file && file.size > MAX_PROOF_BYTES) {
				reErr.textContent = 'That screenshot is over 5MB. A normal phone screenshot is well under it.';
				reErr.hidden = false;
				reProof.value = '';
				return showProof(null);
			}
			showProof(file);
		};

		reForm.onsubmit = async (e) => {
			e.preventDefault();
			if (!redoOrder) return;
			const file = reProof.files?.[0] ?? null;
			if (!file) {
				reErr.textContent = 'Attach a screenshot of the successful payment.';
				reErr.hidden = false;
				return;
			}

			reGo.disabled = true;
			reErr.hidden = true;
			reFace('busy');
			startProgress();

			try {
				const body = new FormData();
				body.append('payment_ref', reTxn.value.trim());
				body.append('proof', file);
				// Same endpoint as the first attempt. The server allows it precisely
				// because reject left payment_status at 'unpaid' — the order never
				// stopped being payable.
				const res = await fetch(`${API}/api/orders/${encodeURIComponent(redoOrder.order_id)}/payment`, {
					method: 'POST',
					body,
				});
				const data = await res.json();
				if (!res.ok) throw new Error(data.message || data.error || 'Could not submit that payment');

				finishProgress();
				await new Promise((r) => setTimeout(r, 420));
				reFace('done');
			} catch (err) {
				// Back to the form with the reference intact — a rejected file or a
				// dropped connection should not cost the student their typing.
				reFace('form');
				reErr.textContent = (err as Error).message;
				reErr.hidden = false;
			} finally {
				reGo.disabled = false;
				resetProgress();
			}
		};

		function closeResubmit() {
			openOverlay('reModal', false);
			showProof(null);
			redoOrder = null;
			// Re-read, so the card behind the modal shows CHECKING rather than the
			// rejection the student just dealt with.
			void lookup();
		}
		$('reClose').onclick = closeResubmit;
		$('reDoneBtn').onclick = closeResubmit;
		reModal.addEventListener('click', (e) => { if (e.target === reModal) closeResubmit(); }, { signal });
		addEventListener('keydown', (e) => {
			// Not while the upload is in flight: closing then would leave the student
			// unsure whether their screenshot ever arrived.
			if (e.key === 'Escape' && !reModal.hidden && reBusy.hidden) closeResubmit();
		}, { signal });

		function openOverlay(id: string, on: boolean) {
			$(id).hidden = !on;
			document.body.classList.toggle('ov-open', on);
		}

		/** Re-reads this student's orders and repaints. The one place that fetches. */
		async function lookup() {
			goBtn.disabled = true;
			errEl.hidden = true;
			goLabel.textContent = 'LOOKING…';

			try {
				const res = await fetch(`${API}/api/orders/lookup`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ roll_number: rollEl.value, phone: phoneEl.value }),
				});
				const data = await res.json();
				// A wrong phone and an unknown roll come back identically, on purpose — the
				// server will not say which, and neither does this.
				if (!res.ok) throw new Error(data.message || data.error || 'Could not find that order');
				render(data.orders as Order[]);
			} catch (err) {
				// Back to one column: with nothing to show, a narrow header beside an
				// empty half is worse than the plain stack it started as.
				resultsEl.hidden = true;
				splitEl.classList.remove('is-split');
				errEl.textContent = (err as Error).message;
				errEl.hidden = false;
			} finally {
				goBtn.disabled = false;
				goLabel.textContent = 'FIND MY ORDER';
			}
		}

		form.onsubmit = (e) => { e.preventDefault(); void lookup(); };
	}

	document.addEventListener('astro:page-load', initOrder);
</script>

<style>
	/* The page's own dot matrix, the same one /outreach and the home theme block use.
