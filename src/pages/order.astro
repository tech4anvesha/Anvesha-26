---
/**
 * ORDER STATUS — where a student finds their pass when the email did not arrive.
 *
 * Payment is reviewed by hand, so there is a gap between paying and being confirmed,
 * and the collection pass only exists on the far side of it. This page is the window
 * onto that gap: what was submitted, whether anyone has looked at it yet, and — once
 * they have — the same ticket the confirmation email carries.
 *
 * Roll number AND phone. The QR is a bearer token, and roll numbers are trivially
 * enumerable (IMS24001, IMS24002, …), so a roll-only lookup would let anyone walk the
 * range and collect other people's merch. The phone is the second factor: known to the
 * student, not derivable from the roll.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/ticket.css';
import iSearch from 'lucide-static/icons/search.svg?raw';
---

<SiteLayout
	title="Your order · Anvesha '26"
	description="Look up an Anvesha '26 merch order and collection pass with your roll number and mobile."
>
	<div class="page od-page">
		<div class="od-split" id="odSplit">
		<header class="page-head od-head" data-reveal>
			<p class="eyebrow">Merch &middot; Collection pass</p>
			<h1 class="page-title">Your order</h1>
			<p class="lede">
				Payments are checked by hand against our statement, so your pass appears here
				once someone has confirmed it. The same thing arrives by email &mdash; this is
				for when that goes astray.
			</p>

			<form class="od-form" id="odForm">
				<div class="od-fields">
					<label class="field">
						<span class="field-label">Roll number</span>
						<input class="field-input roll-input" id="oRoll" name="roll_number" type="text"
						       autocomplete="off" spellcheck="false" maxlength="8" placeholder="IMS24101"
						       pattern="[Ii][Mm][Ss][0-9]{5}"
						       title="IMS followed by 5 digits, e.g. IMS24101" required />
					</label>
					<label class="field">
						<span class="field-label">Mobile you ordered with</span>
						<input class="field-input" id="oPhone" name="phone" type="tel"
						       inputmode="numeric" autocomplete="tel" placeholder="10-digit mobile" required />
					</label>
				</div>
				<p class="pay-err" id="odErr" hidden></p>
				<button class="btn od-go" id="odGo" type="submit">
					<span set:html={iSearch} /><span id="odGoLabel">FIND MY ORDER</span>
				</button>
				{/* Both, because roll alone is guessable — IMS24001, IMS24002 — and the QR
				    below is a bearer token. */}
				<p class="od-why">Both fields must match the order. Nothing else will find it.</p>
			</form>
		</header>

		{/* The right half. One of these two is on screen at a time: the explainer until
		    there is an answer, the answer after. */}
		<div class="od-right">
		{/* Answers the question almost everyone arrives with: why is there no pass yet.
		    Hidden once results are on screen — by then it has done its job. */}
		<section class="section od-how" id="odHow" data-reveal>
			<div class="sechead">
				<span class="sechead-label">How this works</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta">Three steps</span>
			</div>
			<ol class="od-steps">
				<li><b>1</b><span><strong>You pay</strong> by UPI and send us the reference and a screenshot.</span></li>
				<li><b>2</b><span><strong>We check it</strong> against our bank statement by hand. Usually within a day.</span></li>
				<li><b>3</b><span><strong>Your pass arrives</strong> by email, and shows up on this page. Show its QR at the merch desk.</span></li>
			</ol>
		</section>

		<section class="section od-results" id="odResults" hidden data-reveal>
			<div class="sechead">
				<span class="sechead-label">Found</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta" id="odMeta"></span>
			</div>
			<div class="od-list" id="odList"></div>
		</section>
		</div>
		</div>
	</div>
</SiteLayout>

<script>
	import { API } from '../lib/api';
	import { type ReceiptData, drawQR, saveReceipt } from '../lib/ticket';

	type Line = { name: string; size: string | null; quantity: number; line_total_paise: number; collected: 0 | 1 };
	type Order = {
		order_id: string;
		items: Line[];
		total_price_paise: number;
		payment_status: string;
		review_status: 'none' | 'pending' | 'confirmed' | 'rejected';
		payment_ref: string | null;
		review_note: string | null;
		collection_status: 'pending' | 'partial' | 'collected';
		created_at: string;
		name: string;
		/** The order id, and only once an admin has confirmed. Null otherwise. */
		qr_payload: string | null;
	};

	// Astro module scripts run once per browser session; with the client router a second
	// visit swaps in fresh nodes that nothing would have wired. Everything re-runs on
	// astro:page-load, same as every other page here.
	let inited: HTMLElement | null = null;

	function initOrder() {
		const form = document.getElementById('odForm') as HTMLFormElement | null;
		if (!form || form === inited) return;
		inited = form;

		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const rollEl = $<HTMLInputElement>('oRoll'), phoneEl = $<HTMLInputElement>('oPhone');
		const errEl = $('odErr'), goBtn = $<HTMLButtonElement>('odGo');
		const resultsEl = $('odResults'), listEl = $('odList'), metaEl = $('odMeta');
		const howEl = $('odHow'), goLabel = $('odGoLabel'), splitEl = $('odSplit');

		// Uppercased as it is typed, so what the student sees matches what is stored.
		// The caret is restored because assigning .value sends it to the end, which makes
		// correcting the middle of a roll number impossible.
		rollEl.addEventListener('input', () => {
			const at = rollEl.selectionStart;
			rollEl.value = rollEl.value.toUpperCase();
			rollEl.setSelectionRange(at, at);
		});

		const rupees = (paise: number) =>
			'₹' + (paise % 100 === 0 ? String(paise / 100) : (paise / 100).toFixed(2));
		const esc = (s: string) =>
			s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

		/** What the student is waiting on, in their words rather than the schema's. */
		function statusOf(o: Order): { pill: string; cls: string; line: string } {
			if (o.payment_status === 'paid')
				return o.collection_status === 'collected'
					? { pill: 'COLLECTED', cls: 'done', line: 'Picked up. Nothing left on this order.' }
					: o.collection_status === 'partial'
						? { pill: 'PART COLLECTED', cls: 'on', line: 'Some of this order is still at the desk — the QR below is still good.' }
						: { pill: 'READY', cls: 'on', line: 'Confirmed. Show the QR at the merch desk to collect.' };
			if (o.review_status === 'pending')
				return { pill: 'CHECKING', cls: 'wait', line: 'We have your payment and are matching it against our statement. Usually within a day.' };
			if (o.review_status === 'rejected')
				return {
					pill: 'NOT CONFIRMED', cls: 'bad',
					line: o.review_note
						? `We could not match that payment. ${o.review_note}`
						: 'We could not match that payment. Submit it again, or ask at the merch desk.',
				};
			return { pill: 'NOT PAID', cls: 'wait', line: 'No payment has been sent for this order yet.' };
		}

		const stamp = (iso: string) => {
			const d = new Date(iso.replace(' ', 'T') + 'Z');
			return Number.isNaN(d.getTime())
				? iso
				: d.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' });
		};

		function render(orders: Order[]) {
			listEl.innerHTML = '';
			metaEl.innerHTML = `<b>${orders.length}</b> ${orders.length === 1 ? 'order' : 'orders'}`;

			for (const o of orders) {
				const st = statusOf(o);
				const paid = Boolean(o.qr_payload);

				const card = document.createElement('article');
				card.className = 'od-card';
				card.innerHTML =
					// The state leads. It is the one thing everyone came to find out, and
					// burying it inside the ticket made it the last thing read.
					`<div class="od-state ${st.cls}">` +
						`<span class="od-pill">${st.pill}</span>` +
						`<p class="od-line">${esc(st.line)}</p>` +
					`</div>` +

					`<div class="ticket">` +
						`<div class="tk-head">` +
							`<span class="tk-brand">ANVESHA<sup>'26</sup></span>` +
							`<span class="tk-kind">${paid ? 'COLLECTION PASS' : 'ORDER'}</span>` +
						`</div>` +
						`<div class="tk-body">` +
							`<p class="tk-eyebrow">Order no.</p>` +
							`<p class="tk-id">${esc(o.order_id)}</p>` +
							`<ul class="order-items">` +
								o.items.map((l) =>
									`<li><span>${esc(l.name)}${l.size ? ' · ' + esc(l.size) : ''} × ${l.quantity}` +
									(l.collected ? ' <i class="od-got">picked up</i>' : '') +
									`</span><b>${rupees(l.line_total_paise)}</b></li>`).join('') +
							`</ul>` +
							`<div class="tk-meta">` +
								`<div class="tk-cell"><span>Bearer</span><b>${esc(o.name)}</b></div>` +
								`<div class="tk-cell tk-cell-paid"><span>Total</span><b>${rupees(o.total_price_paise)}</b></div>` +
							`</div>` +
						`</div>` +
						`<div class="tk-rip" aria-hidden="true"></div>` +
						`<div class="tk-stub">` +
							(paid
								// 220 is a pre-layout placeholder; drawQR resizes the canvas.
								? `<canvas class="qr" width="220" height="220" aria-label="Collection QR code"></canvas>`
								// Keeps the stub's shape so the card does not jump size when
								// an order is confirmed, and says what is missing rather than
								// looking like an image that failed.
								: `<span class="od-wait"><i></i><b>PASS<br />PENDING</b></span>`) +
							`<div class="tk-stub-side">` +
								`<p class="tk-eyebrow">${paid ? 'Present at counter' : 'Ordered'}</p>` +
								`<p class="tk-txn">${paid ? 'Scan this at the merch desk.' : esc(stamp(o.created_at))}</p>` +
								(o.payment_ref ? `<p class="tk-serial">REF ${esc(o.payment_ref)}</p>` : '') +
							`</div>` +
						`</div>` +
					`</div>` +
					(paid ? `<button class="btn qrdl" type="button">DOWNLOAD PASS</button>` : '');

				// The QR is drawn, not templated — the canvas has to exist first.
				if (paid) {
					const canvas = card.querySelector('canvas') as HTMLCanvasElement;
					drawQR(canvas, o.qr_payload!);

					const receipt: ReceiptData = {
						order_id: o.order_id,
						transaction_id: o.payment_ref ?? '',
						total_price_paise: o.total_price_paise,
						items: o.items,
						name: o.name,
						roll_number: rollEl.value.toUpperCase(),
					};
					(card.querySelector('.qrdl') as HTMLButtonElement).onclick = () => {
						void saveReceipt(receipt).catch((e) => console.warn('pass download failed', e));
					};
				}

				listEl.appendChild(card);
			}

			// The explainer has done its job once there is a real answer on screen, and
			// the page gives up a column to put that answer beside the form.
			howEl.hidden = true;
			resultsEl.hidden = false;
			splitEl.classList.add('is-split');
		}

		form.onsubmit = async (e) => {
			e.preventDefault();
			goBtn.disabled = true;
			errEl.hidden = true;
			goLabel.textContent = 'LOOKING…';

			try {
				const res = await fetch(`${API}/api/orders/lookup`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ roll_number: rollEl.value, phone: phoneEl.value }),
				});
				const data = await res.json();
				// A wrong phone and an unknown roll come back identically, on purpose — the
				// server will not say which, and neither does this.
				if (!res.ok) throw new Error(data.message || data.error || 'Could not find that order');
				render(data.orders as Order[]);
			} catch (err) {
				// Back to one column: with nothing to show, a narrow header beside an
				// empty half is worse than the plain stack it started as.
				resultsEl.hidden = true;
				howEl.hidden = false;
				splitEl.classList.remove('is-split');
				errEl.textContent = (err as Error).message;
				errEl.hidden = false;
			} finally {
				goBtn.disabled = false;
				goLabel.textContent = 'FIND MY ORDER';
			}
		};
	}

	document.addEventListener('astro:page-load', initOrder);
</script>

<style>
	/* The page's own dot matrix, the same one /outreach and the home theme block use.
	   Fades out down the page so it is texture behind the form and nothing behind the
	   reading. Painted rather than stacked: a negative z-index would drop it behind the
	   card's own background entirely. */
	.od-page { position: relative; }
	.od-page::before {
		content: ''; position: absolute; inset: 0; pointer-events: none;
		background-image: radial-gradient(circle at center, var(--dot) 1.2px, transparent 1.4px);
		background-size: 22px 22px;
		mask-image: linear-gradient(#000 0%, #000 26%, transparent 66%);
	}
	.od-page > * { position: relative; }

	/* ---- the layout ----
	   One column until there is something to show. The page opens as a plain stack —
	   header, form, then the explainer underneath — and only splits in two once a
	   lookup has actually returned an order, at which point the header gives up its
	   width and the result sits beside it.

	   `1 0 auto` so the split grows into the card's spare height but a long list of
	   orders can still overflow and scroll. */
	.od-split {
		flex: 1 0 auto;
		display: grid; grid-template-columns: minmax(0, 1fr);
	}
	.od-head { display: flex; flex-direction: column; }
	.od-head .lede { max-width: 56ch; }

	/* The split state.
	   The left column is deliberately wide enough to hold the lede at its full 56ch and
	   the form at its full 520px, so NOTHING on the left reflows when a result arrives —
	   it keeps the exact width it already occupied, and the answer simply fills the
	   empty space that was always beside it. A narrower column would re-wrap the lede
	   and shrink the form, which looks like the page rearranged itself.

	   The dividing rule is the left column's own border, not an element — same
	   construction the storefront's .hero uses. */
	.od-split.is-split {
		/* The floor is the form's 520px plus the section's widest padding (52px a side),
		   so the column can never be too narrow to hold it at any viewport. */
		grid-template-columns: clamp(630px, 44vw, 740px) minmax(0, 1fr);
		align-items: start;
	}
	.od-split.is-split .od-head {
		/* Stays put while a long list of orders scrolls past it — the form is what you
		   come back to when the first roll number was the wrong one. */
		position: sticky; top: 0;
		/* The vertical rule now does the dividing; a bottom border too would stop dead
		   halfway across the page. */
		border-right: var(--stroke) solid var(--secondary);
		border-bottom: 0;
	}
	/* The right half owns its own section borders, so the two columns do not double up
	   on rules where they meet. */
	.od-right > .section:last-child { border-bottom: 0; }
	/* A card, because it is the only thing to do on this page — floating fields on bare
	   paper read as part of the header rather than as the task. */
	.od-form {
		box-sizing: border-box; width: 100%; max-width: 520px;
		margin: clamp(22px, 3vw, 30px) 0 0; padding: clamp(16px, 2.4vw, 20px);
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		box-shadow: var(--pop);
	}
	.od-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
	.field { display: flex; flex-direction: column; gap: 6px; }
	.field-label {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
	}
	.field-input {
		appearance: none; -webkit-appearance: none;
		/* border-box because this project has no global reset: without it `width: 100%`
		   plus padding and border overflows its container. */
		box-sizing: border-box; width: 100%;
		padding: 12px 13px; margin: 0;
		font-family: 'Archivo', sans-serif; font-size: 13.5px;
		color: var(--secondary); background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.field-input::placeholder { color: var(--ink-40); }
	.field-input:focus { outline: none; transform: translate(-2px, -2px); box-shadow: var(--pop); }
	.roll-input { font-family: 'DM Mono', ui-monospace, monospace; letter-spacing: .08em; }

	.pay-err { margin: 12px 0 0; font-size: 12.5px; line-height: 1.5; color: var(--accent); }
	.od-go {
		display: flex; align-items: center; justify-content: center; gap: 9px;
		box-sizing: border-box; width: 100%; margin-top: 14px; padding: 14px;
		font-size: 11.5px; font-weight: 800; letter-spacing: .14em;
		color: var(--primary); background: var(--secondary); border-color: var(--secondary);
	}
	.od-go:hover:not(:disabled) { background: var(--accent); border-color: var(--accent); }
	.od-go:disabled { opacity: .5; cursor: wait; }
	.od-go svg { width: 15px; height: 15px; stroke-width: 2.2; }
	.od-why {
		margin: 10px 0 0; text-align: center;
		font-size: 10.5px; line-height: 1.5; color: var(--ink-40);
	}

	/* ---- how this works ---- */
	.od-steps {
		display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;
		margin: 0; padding: 0; list-style: none; counter-reset: none;
	}
	.od-steps li {
		display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start;
		padding: 15px 16px;
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.od-steps b {
		display: grid; place-items: center; width: 22px; height: 22px;
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 11px;
		color: var(--primary); background: var(--secondary); border-radius: 999px;
	}
	.od-steps span { font-size: 12.5px; line-height: 1.6; color: var(--ink-60); text-wrap: pretty; }
	.od-steps strong { color: var(--secondary); font-weight: 700; }

	/* ---- results ----
	   Everything below the list is wrapped in :global(). The cards are built with
	   innerHTML at runtime, and Astro scopes styles by stamping a data-astro-cid-*
	   attribute onto elements it compiles — which JS-created nodes never get. Scoped
	   selectors would compile fine, match nothing, and the cards would render bare. */

	/* Capped at 360 so a single order does not stretch into a banner, and auto-fit so
	   two sit side by side once the right column is wide enough. */
	.od-list {
		display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 360px)); gap: 18px;
	}
	:global(.od-card) { display: flex; flex-direction: column; gap: 0; }

	/* The state, above the ticket rather than inside it. It is what everyone came for,
	   and it sat last when it lived in the stub. */
	:global(.od-state) {
		display: flex; flex-direction: column; gap: 7px;
		padding: 13px 14px;
		border: var(--stroke) solid var(--secondary);
		border-bottom: 0; border-radius: var(--r) var(--r) 0 0;
		background: var(--sink);
	}
	:global(.od-state.on) { background: var(--accent); }
	:global(.od-state.done) { background: var(--secondary); }
	:global(.od-pill) {
		align-self: flex-start; padding: 3px 8px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .16em;
		color: var(--primary); background: var(--secondary); border-radius: var(--r);
	}
	:global(.od-line) { margin: 0; font-size: 12px; line-height: 1.55; color: var(--ink-60); }
	/* On the two inked grounds the type has to invert, and the pill with it. */
	:global(.od-state.on .od-pill) { color: var(--accent); background: var(--primary); }
	:global(.od-state.on .od-line) { color: var(--primary); }
	:global(.od-state.done .od-pill) { color: var(--secondary); background: var(--primary); }
	:global(.od-state.done .od-line) { color: color-mix(in srgb, var(--primary) 70%, var(--secondary)); }
	:global(.od-state.bad .od-pill) { background: var(--accent); }
	:global(.od-state.bad .od-line) { color: var(--secondary); }

	/* The ticket joins the band above it rather than floating under it. */
	:global(.od-card .ticket) { border-radius: 0 0 var(--r) var(--r); }

	:global(.od-card .qrdl) {
		width: 100%; margin-top: 10px; padding: 13px;
		font-size: 11.5px; font-weight: 800; letter-spacing: .14em;
		color: var(--primary); background: var(--accent); border-color: var(--accent);
	}

	/* Stands in for the QR before there is one, so the stub keeps its shape and the card
	   does not resize when an order is confirmed. */
	:global(.od-wait) {
		display: grid; place-items: center; gap: 7px; align-content: center;
		width: 124px; height: 124px;
		background: var(--sink);
		border: var(--stroke) dashed var(--secondary); border-radius: var(--r);
	}
	/* A clock face, drawn: a bordered circle and one pseudo-element for the hand. */
	:global(.od-wait i) {
		display: block; position: relative;
		width: 26px; height: 26px;
		border: 2px solid var(--ink-40); border-radius: 999px;
	}
	:global(.od-wait i::after) {
		content: ''; position: absolute; left: 50%; top: 22%;
		width: 2px; height: 32%; background: var(--ink-40);
		transform-origin: bottom center; transform: translateX(-50%) rotate(40deg);
	}
	:global(.od-wait b) {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 8.5px; letter-spacing: .14em; line-height: 1.5;
		text-align: center; color: var(--ink-40);
	}

	:global(.od-got) {
		font-style: normal; font-size: 9px; letter-spacing: .08em;
		text-transform: uppercase; color: var(--ink-40);
	}

	/* Below this the two columns have nothing left to give: the form's own fields are
	   about to stack, which makes the left column as tall as the right one anyway. */
	/* Below this there is no empty space left to put anything in — the left column alone
	   is already the whole width — so the answer goes back under the form. */
	@media (max-width: 1100px) {
		.od-split.is-split { grid-template-columns: minmax(0, 1fr); }
		.od-split.is-split .od-head {
			position: static;
			border-right: 0; border-bottom: var(--stroke) solid var(--secondary);
		}
	}

	@media (max-width: 560px) {
		.od-fields { grid-template-columns: minmax(0, 1fr); }
	}
</style>
