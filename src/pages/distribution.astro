---
/**
 * The merch counter, opened from a copied link — `/distribution#<session-id>`.
 *
 * Deliberately outside AdminLayout: whoever stands at the counter is not an admin and
 * has no password, so there is no sign-in to gate, no panel nav to show and nothing
 * here that edits the catalogue. The session id in the link is the whole credential,
 * and the Worker re-checks that it is still open on every scan and every hand-over.
 *
 * That credential lives in the fragment, which is what makes this one plain static
 * page rather than a dynamic route: the server never receives the id, so there is
 * nothing to route on and no rewrite rule to keep in step with a build config. The
 * same property is why the id stays out of server logs and Referer headers.
 */
import Layout from '../layouts/Layout.astro';
import '../styles/theme.css';
import '../styles/admin-controls.css';
---

<Layout title="Distribution — Anvesha '26">
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Archivo+Expanded:wght@700;800;900&family=DM+Mono:wght@400;500&display=swap"
		/>
	</Fragment>

	<main class="dp">
		<header class="dp-head">
			<span class="dp-brand">ANVESHA '26</span>
			<span class="dp-title">MERCH COUNTER</span>
			<span class="dp-since" id="dpSince" hidden></span>
		</header>

		<div class="dp-card">
			<!-- GATE: shown until the Worker says the session is live, and again if it dies. -->
			<div id="dpGate">
				<p class="ds-state dp-gate-state" id="dpGateMsg">Checking the link…</p>
			</div>

			<!-- SCANNER -->
			<div id="distScan" hidden>
				<div class="ds-stage">
					<video id="distVideo" playsinline muted></video>
					<span class="ds-reticle" aria-hidden="true"></span>
					<p class="ds-state" id="distState">Starting camera…</p>
				</div>

				<p class="ds-or">or enter the order id</p>
				<form class="ds-manual" id="distManualForm">
					<input class="field-input" id="distManual" type="text" autocomplete="off"
					       spellcheck="false" placeholder="ORD_…" />
					<button class="btn a-btn-secondary" id="distGo" type="submit">LOOK UP</button>
				</form>
				<p class="a-err" id="distErr" hidden></p>
			</div>

			<!-- RESULT -->
			<div id="distResult" hidden></div>

			<div class="dp-foot" id="distFoot" hidden>
				<button class="btn a-btn-primary" id="distCollect" type="button" hidden>MARK COLLECTED</button>
				<button class="btn a-btn-secondary" id="distAgain" type="button">SCAN ANOTHER</button>
			</div>
		</div>
	</main>
</Layout>

<script>
	import { API } from '../lib/api';
	// BarcodeDetector is still missing from Safari and Firefox, which is most of the
	// phones a volunteer will actually be holding. A real decoder is the working choice.
	import jsQR from 'jsqr';

	const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;

	const escape = (s: string) =>
		s.replace(/[&<>"']/g, (c) =>
			({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
		);

	// D1 stamps datetime('now'), which is UTC with no zone marker; without the Z the
	// browser reads it as local time and every timestamp lands hours off.
	const stamp = (sqlUtc: string) =>
		new Date(sqlUtc.replace(' ', 'T') + 'Z').toLocaleString('en-IN', {
			day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit',
		});

	const toRupees = (paise: number) => (paise / 100).toFixed(2);

	type Scan = {
		verdict: 'ok' | 'unpaid' | 'already_collected';
		collectable: boolean;
		order: {
			order_id: string;
			items: { name: string; size: string | null; quantity: number; line_total_paise: number }[];
			total_price_paise: number; payment_status: string;
			collected: boolean; collected_at: string | null; created_at: string;
		};
		payment: { razorpay_transaction_id: string | null; transaction_info: Record<string, unknown> } | null;
	};

	/**
	 * The session id, read off the fragment — `/distribution#DST_…`.
	 *
	 * The fragment, not the path or the query, for two reasons. It is never sent to a
	 * server, so the id stays out of Vercel's access logs, any CDN log, and the Referer
	 * header of every request this page makes. And because the server never sees it,
	 * one static page serves every session with no rewrite rule anywhere.
	 */
	const SESSION = decodeURIComponent(location.hash.slice(1)).trim().toUpperCase();

	/** fetch against this session's routes. A 401/403/404/410 means the link is dead —
	 *  ended, mistyped, or never real — and all four end the same way: stop scanning. */
	async function api<T = unknown>(path: string, init: RequestInit = {}): Promise<T> {
		const res = await fetch(`${API}/api/distribution/${SESSION}${path}`, {
			...init,
			headers: { 'Content-Type': 'application/json', ...(init.headers ?? {}) },
		});
		const data = (await res.json().catch(() => ({}))) as { message?: string; error?: string };
		if (!res.ok) {
			const err = new Error(data.message ?? `Request failed (${res.status})`);
			(err as Error & { status?: number }).status = res.status;
			throw err;
		}
		return data as T;
	}

	// ---- camera ----
	let stream: MediaStream | null = null;
	let scanTimer: number | undefined;
	let scanning = false;
	let scanned: Scan | null = null;
	// The code the message on screen belongs to. A rejected QR is still sitting in front
	// of the lens, so without this the loop re-decodes it every 100ms and every lookup
	// clears the message before its own round trip puts it back — the notice blinks.
	let rejected = '';

	/** Releases the camera. Called on every exit path — a live capture light left on
	 *  after the page is done is alarming and drains a volunteer's phone. */
	function stopCamera() {
		scanning = false;
		clearTimeout(scanTimer);
		stream?.getTracks().forEach((t) => t.stop());
		stream = null;
		$<HTMLVideoElement>('distVideo').srcObject = null;
	}

	async function startCamera() {
		const video = $<HTMLVideoElement>('distVideo');
		const state = $('distState');
		try {
			// facingMode 'environment' asks for the rear camera on a phone; on a laptop
			// there is only one and the constraint is ignored rather than failing.
			stream = await navigator.mediaDevices.getUserMedia({
				video: { facingMode: 'environment' },
				audio: false,
			});
			video.srcObject = stream;
			await video.play();
			state.hidden = true;
			scanning = true;
			tick();
		} catch (e) {
			// No camera, denied permission, or an insecure origin. Manual entry is the
			// documented fallback, so this is a notice rather than a failure.
			state.hidden = false;
			state.textContent =
				(e as Error).name === 'NotAllowedError'
					? 'Camera blocked — use the order id box below.'
					: 'No camera available — use the order id box below.';
		}
	}

	/** Grabs a frame and looks for a QR in it. ~10/s is plenty and leaves the phone alone. */
	async function tick() {
		if (!scanning) return;
		const video = $<HTMLVideoElement>('distVideo');

		if (video.readyState === video.HAVE_ENOUGH_DATA) {
			const canvas = document.createElement('canvas');
			canvas.width = video.videoWidth;
			canvas.height = video.videoHeight;
			const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
			ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
			const px = ctx.getImageData(0, 0, canvas.width, canvas.height);
			const found = jsQR(px.data, px.width, px.height, { inversionAttempts: 'dontInvert' });
			// Anything but the code we already rejected: the lens stays live so pointing it
			// at the next ticket just works, but the verdict on screen holds still.
			if (found?.data && found.data.trim() !== rejected) {
				scanning = false;
				await lookup(found.data.trim());
				return;
			}
		}
		scanTimer = setTimeout(tick, 100) as unknown as number;
	}

	/** Looks an order up and shows the verdict. Shared by the camera and the manual box. */
	async function lookup(orderId: string) {
		const err = $('distErr');
		err.hidden = true;
		try {
			const res = await api<Scan>('/scan', {
				method: 'POST',
				body: JSON.stringify({ order_id: orderId }),
			});
			scanned = res;
			rejected = '';
			stopCamera();
			showResult(res);
		} catch (e) {
			if (isDead(e)) return;
			// A 404 on the order is the "this is not one of ours" case and deserves plain words.
			const msg = (e as Error).message;
			err.textContent = /no such order/i.test(msg) ? `Not one of ours — no order ${orderId}` : msg;
			err.hidden = false;
			rejected = orderId;
			// Keep looking: the volunteer may just have caught a bad frame.
			if (stream) { scanning = true; tick(); }
		}
	}

	function showResult(s: Scan) {
		const paid = s.order.payment_status === 'paid';
		const info = s.payment?.transaction_info ?? {};
		const buyer = {
			name: String(info.name ?? ''),
			email: String(info.email ?? ''),
			phone: String(info.contact ?? ''),
		};

		const banner =
			s.verdict === 'ok'
				? `<p class="ds-verdict ok">Verified — hand it over</p>`
				: s.verdict === 'already_collected'
					? `<p class="ds-verdict warn">Merch has been collected` +
						(s.order.collected_at ? ` · ${escape(stamp(s.order.collected_at))}` : '') +
						`</p>`
					: `<p class="ds-verdict warn">Not paid — do not hand over</p>`;

		const lines = s.order.items
			.map(
				(l, i) =>
					`<li class="dc-item">` +
					`<i class="dc-item-n">${String(i + 1).padStart(2, '0')}</i>` +
					`<span class="dc-item-name">${escape(l.name)}` +
					(l.size ? `<em>${escape(l.size)}</em>` : '') +
					`</span>` +
					`<b class="dc-item-q">×${l.quantity}</b>` +
					`</li>`,
			)
			.join('');

		const tile = (k: string, v: string, mod = '') =>
			`<div class="dc-tile ${mod}"><span class="dc-tile-k">${k}</span>` +
			`<b class="dc-tile-v">${escape(v)}</b></div>`;

		$('distResult').innerHTML =
			banner +
			`<div class="dc">` +
			`<p class="dc-id">${escape(s.order.order_id)}</p>` +

			`<div class="dc-tiles">` +
			tile('Payment', s.order.payment_status.toUpperCase(), paid ? 'is-paid' : 'is-due') +
			tile('Total', `₹${toRupees(s.order.total_price_paise)}`) +
			tile('Placed', stamp(s.order.created_at)) +
			`</div>` +

			`<p class="dc-legend">Buyer</p>` +
			`<div class="dc-buyer">` +
			`<b class="dc-buyer-name">${escape(buyer.name) || 'Not recorded'}</b>` +
			`<span class="dc-buyer-line">${escape(buyer.email) || '—'}</span>` +
			`<span class="dc-buyer-line">${escape(buyer.phone) || '—'}</span>` +
			`</div>` +

			`<p class="dc-legend">Hand over</p>` +
			`<ul class="dc-items">${lines}</ul>` +
			`</div>`;

		$('distScan').hidden = true;
		$('distResult').hidden = false;
		$('distFoot').hidden = false;
		// The button only exists for a paid, uncollected order — an unpaid one must not
		// offer a way to hand merch over at all.
		$('distCollect').hidden = !(paid && s.collectable);
	}

	async function markCollected() {
		if (!scanned) return;
		const btn = $<HTMLButtonElement>('distCollect');
		btn.disabled = true;
		try {
			await api('/collect', {
				method: 'POST',
				body: JSON.stringify({ order_id: scanned.order.order_id }),
			});
			$('distResult').innerHTML =
				`<p class="ds-verdict ok">Collected — ${escape(scanned.order.order_id)}</p>` +
				`<p class="ds-done">The order is now marked collected.</p>`;
			btn.hidden = true;
		} catch (e) {
			if (isDead(e)) return;
			$('distResult').insertAdjacentHTML(
				'afterbegin',
				`<p class="a-err">${escape((e as Error).message)}</p>`,
			);
		} finally {
			btn.disabled = false;
		}
	}

	function resetScan() {
		scanned = null;
		rejected = '';
		$('distResult').hidden = true;
		$('distResult').innerHTML = '';
		$('distScan').hidden = false;
		$('distFoot').hidden = true;
		$('distCollect').hidden = true;
		$('distErr').hidden = true;
		$<HTMLInputElement>('distManual').value = '';
	}

	// ---- the session gate ----
	/** Shows the dead-link screen and shuts everything down. Returns true if it handled
	 *  the error, so callers can bail rather than also printing their own message. */
	function isDead(e: unknown): boolean {
		const status = (e as Error & { status?: number }).status;
		if (status !== 404 && status !== 410) return false;
		stopCamera();
		showGate(
			status === 410
				? 'This distribution has ended. Ask an admin to start a new one.'
				: 'This link is not valid. Ask an admin for a fresh one.',
		);
		return true;
	}

	function showGate(message: string) {
		$('dpGateMsg').textContent = message;
		$('dpGate').hidden = false;
		$('distScan').hidden = true;
		$('distResult').hidden = true;
		$('distFoot').hidden = true;
		$('dpSince').hidden = true;
	}

	async function initCounter() {
		if (!SESSION) {
			showGate('No session in this link. Ask an admin for a fresh one.');
			return;
		}
		try {
			const { session } = await api<{ session: { start_time: string } }>('');
			$('dpSince').textContent = `OPEN SINCE ${stamp(session.start_time)}`;
			$('dpSince').hidden = false;
			$('dpGate').hidden = true;
			resetScan();
			startCamera();
		} catch (e) {
			// A dead link has its own wording; anything else is the network or the Worker,
			// and saying so is more use than a generic failure.
			if (!isDead(e)) showGate((e as Error).message);
		}
	}

	function initPage() {
		$('distAgain').onclick = () => { resetScan(); startCamera(); };
		$('distCollect').onclick = markCollected;
		$<HTMLFormElement>('distManualForm').onsubmit = (e) => {
			e.preventDefault();
			const id = $<HTMLInputElement>('distManual').value.trim().toUpperCase();
			// Typing it out is a deliberate retry, so the camera's skip does not apply.
			rejected = '';
			if (id) lookup(id);
		};
		initCounter();
	}

	// ClientRouter swaps the DOM without re-running module scripts, so this binds on
	// astro:page-load — which fires on first load too, making it the only hook needed.
	document.addEventListener('astro:page-load', initPage);
	document.addEventListener('astro:before-swap', stopCamera);
	// Backgrounding the tab must drop the camera too: iOS suspends the stream anyway
	// and comes back to a frozen frame that scans nothing.
	addEventListener('pagehide', stopCamera);
</script>

<style is:global>
	/* The UA stylesheet's [hidden]{display:none} loses to any author `display` rule of
	   equal specificity, so `el.hidden = true` silently does nothing to anything
	   carrying a `display: flex`. */
	[hidden] { display: none !important; }

	/* The button primitive, same chassis as the rest of the site. Copied rather than
	   imported because it lives in SiteLayout, and this page deliberately has no shell. */
	.btn {
		appearance: none; -webkit-appearance: none; margin: 0;
		font-family: 'Archivo', sans-serif;
		border: var(--stroke) solid var(--secondary);
		border-radius: var(--r);
		background: var(--primary);
		color: var(--secondary);
		cursor: pointer;
		text-decoration: none;
		transition: transform .1s ease, box-shadow .1s ease, background .12s ease, color .12s ease;
	}
	.btn:hover:not(:disabled) { transform: translate(-2px, -2px); box-shadow: var(--pop); }
	.btn:active:not(:disabled) { transform: translate(0, 0); box-shadow: 0 0 0 var(--accent); }

	/* ---- the counter itself ---- */
	.dp {
		box-sizing: border-box;
		min-height: 100dvh;
		display: flex; flex-direction: column; gap: 14px;
		padding: clamp(12px, 3vw, 28px);
		background: var(--sink);
		background-image: radial-gradient(circle at center, var(--dot) 1.2px, transparent 1.4px);
		background-size: 22px 22px;
		font-family: 'Archivo', system-ui, sans-serif;
		color: var(--secondary);
	}

	.dp-head {
		display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 12px;
		padding: 0 2px;
	}
	.dp-brand {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: 13px; letter-spacing: .1em;
	}
	.dp-title, .dp-since {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
	}
	/* Pushed to the far end so the session's age is the last thing on the line rather
	   than running into the page name. */
	.dp-since { margin-left: auto; }

	.dp-card {
		box-sizing: border-box;
		width: min(560px, 100%); margin: 0 auto;
		padding: clamp(14px, 3vw, 22px);
		background: var(--primary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}

	/* Free-standing rather than pinned inside the camera stage the class usually sits in. */
	.dp-gate-state {
		position: static; display: block;
		line-height: 1.6; text-transform: none; letter-spacing: .02em;
	}

	.dp-foot { display: flex; flex-direction: column; gap: 8px; margin-top: 18px; }
	.dp-foot .a-btn-secondary { width: 100%; }

	.ds-stage {
		position: relative; display: grid; place-items: center; overflow: hidden;
		aspect-ratio: 4 / 3; margin-bottom: 16px;
		background: var(--secondary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.ds-stage video { width: 100%; height: 100%; object-fit: cover; display: block; }
	/* A frame to aim through — the QR does not have to fill it, it just tells the
	   volunteer where to point. */
	.ds-reticle {
		position: absolute; inset: 18% 22%;
		border: 2px solid var(--primary); border-radius: var(--r);
		box-shadow: 0 0 0 100vmax color-mix(in srgb, var(--secondary) 55%, transparent);
	}
	.ds-state {
		position: absolute; margin: 0; padding: 9px 12px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10px; letter-spacing: .1em; text-align: center;
		color: var(--primary); background: var(--secondary);
		border: 1.5px solid var(--primary); border-radius: var(--r);
	}

	.ds-or {
		display: flex; align-items: center; gap: 10px; margin: 0 0 10px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
	}
	.ds-or::before, .ds-or::after { content: ''; flex: 1; height: 1.5px; background: var(--hair); }

	.ds-manual { display: flex; gap: 8px; margin-bottom: 12px; }
	.ds-manual .field-input {
		font-family: 'DM Mono', ui-monospace, monospace; font-size: 12px;
		text-transform: uppercase;
	}
	.ds-manual .a-btn-secondary { flex: none; padding: 12px 14px; }

	.ds-verdict {
		display: flex; align-items: center; gap: 10px;
		margin: 0 0 18px; padding: 14px 15px;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 12.5px; letter-spacing: .1em; text-transform: uppercase;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	/* A marker square, the same device the eyebrows use — it makes the banner read as
	   a status line rather than a coloured slab. */
	.ds-verdict::before {
		content: ''; flex: none; width: 9px; height: 9px;
		background: var(--primary); border-radius: var(--r);
	}
	.ds-verdict.ok { color: var(--primary); background: var(--secondary); }
	/* Accent, not a new colour: the palette is three colours and a warning is still
	   one of them. The wording carries the meaning. */
	.ds-verdict.warn { color: var(--primary); background: var(--accent); border-color: var(--accent); }
	.ds-done { margin: 0; font-size: 13px; line-height: 1.6; color: var(--ink-60); }

	/* ---- scan result: a verification card, not a receipt ---- */
	.dc { display: flex; flex-direction: column; gap: 16px; }

	.dc-id {
		margin: 0; padding: 11px 13px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 12px; letter-spacing: .04em; word-break: break-all;
		background: var(--sink);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}

	/* Three facts, three boxes — the shape the panel uses everywhere else. */
	.dc-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
	.dc-tile {
		display: flex; flex-direction: column; gap: 5px;
		padding: 11px 12px; min-width: 0;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
	}
	.dc-tile-k {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 8.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
	}
	.dc-tile-v {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 14px; letter-spacing: -.01em;
		overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	/* The payment tile is the one a volunteer reads first, so it is filled rather than
	   outlined — and its two states are the only place the colour changes. */
	.dc-tile.is-paid { background: var(--secondary); border-color: var(--secondary); }
	.dc-tile.is-paid .dc-tile-k { color: color-mix(in srgb, var(--primary) 55%, transparent); }
	.dc-tile.is-paid .dc-tile-v { color: var(--primary); }
	.dc-tile.is-due { background: var(--accent); border-color: var(--accent); }
	.dc-tile.is-due .dc-tile-k { color: color-mix(in srgb, var(--primary) 65%, transparent); }
	.dc-tile.is-due .dc-tile-v { color: var(--primary); }

	.dc-legend {
		display: flex; align-items: center; gap: 10px; margin: 0 0 -6px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
	}
	.dc-legend::after { content: ''; flex: 1; height: 1.5px; background: var(--hair); }

	.dc-buyer { display: flex; flex-direction: column; gap: 3px; }
	.dc-buyer-name {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 800; font-size: 19px; letter-spacing: -.01em;
	}
	.dc-buyer-line {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 11.5px; color: var(--ink-60); word-break: break-all;
	}

	.dc-items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
	.dc-item {
		display: flex; align-items: center; gap: 11px;
