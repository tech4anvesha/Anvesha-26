	/* The one line each of them wrote themselves, and the only thing on this card that is
	   not a field off a form — so it is set as a quotation rather than as another
	   paragraph of grey body copy. Ink at full strength, a rule down the left in accent,
	   and a hanging quote mark in the margin the padding leaves for it. */
	/* The mark used to be absolutely positioned at left:10px, which put it on top of the
	   first line's first word at every width. It sits ABOVE the text now, in flow, with
	   the negative margin pulling the quote up under it — nothing overlaps and the
	   indent no longer has to leave a hole for it.
	   No max-width in ch either: that was capping the line well short of the column and
	   breaking it early. The measure is now the readout's own width. */
	.sc-quote {
		position: relative;
		margin: 22px 0 0;
		padding: 2px 0 2px 22px;
		border-left: 4px solid var(--accent);
	}
	.sc-quote::before {
		content: '\201C';
		display: block; margin: -6px 0 -14px;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: 34px; line-height: 1; color: var(--accent);
		opacity: .25;
	}
	.sc-bio {
		position: relative; margin: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		/* cqw, not vw: the readout is a fraction of the card, which is a fraction of the
		   viewport, so a vw-sized quote was still 16px in a 330px column at 1280 and the
		   longest six overflowed into the scroller. Sized off the column it actually sits
		   in, it steps down where the column is narrow and back up where it is not. */
		font-weight: 700; font-size: clamp(14.5px, 4.2cqw, 18px); line-height: 1.45;
		letter-spacing: -.01em; color: var(--secondary);
		text-wrap: pretty;
	}
	/* A dash and the name under the line, the way a pull quote is attributed. Kept short —
	   the full name is already the headline six lines above it. */
	.sc-quote-by {
		display: block; margin: 7px 0 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .16em; text-transform: uppercase;
		color: var(--ink-60);
	}

	/* ---- the short form ----
	   The institute rows have a portrait, a name and a title. Printing the crew card for
	   them meant five fields reading "—" and an empty quote rule, which says "this record
	   is incomplete" when in fact it is complete — that is simply all there is. So the
	   card drops what does not apply and spends the room on the two things that do. */
	.sc.is-faculty .sc-fields,
	.sc.is-faculty .sc-quote { display: none; }
	/* The caption under the plate is the roll number, and faculty have none — it was
	   printing the em dash that stands in for one. */
	.sc.is-faculty .sc-photo-tag { visibility: hidden; }
	.sc.is-faculty .sc-info {
		display: flex; flex-direction: column; justify-content: center;
	}
	.sc.is-faculty .sc-name { font-size: clamp(22px, 2.6vw, 38px); }
	.sc.is-faculty .sc-role {
		margin-top: 14px;
		font-size: clamp(12px, 1.15vw, 15px); letter-spacing: .14em;
		color: var(--accent);
	}
	/* A rule under the title, because with the fields grid gone there is nothing else
	   holding the block together. */
	/* Shown only in the short form: the crew card has a DEPARTMENT field for this and the
	   students' school was never collected, so there is nothing to put here for them. */
	.sc-school { display: none; }
	.sc.is-faculty .sc-school {
		display: block; margin: 10px 0 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: clamp(11px, 1vw, 13px); letter-spacing: .1em; color: var(--ink-60);
	}
	.sc.is-faculty .sc-school::after {
		content: ''; display: block; width: 52px; height: var(--stroke);
		margin-top: 18px; background: var(--secondary);
	}

	/* ---- the issue strip ---- */
	.sc-strip {
		position: relative; flex: none;
		display: flex; align-items: center; justify-content: space-between; gap: 16px;
		margin: 16px 0 0; padding-top: 12px;
		border-top: 1.5px solid var(--secondary);
	}
	/* One element per bar, widths off the roll number — see barsOf(). Decoration: it is
	   aria-hidden and encodes nothing, which is deliberate, since a scannable roll number
	   printed on a public page is a worse idea than it looks.
	   overflow:hidden lets the strip take whatever width it is given and simply stop
	   drawing bars, instead of the row growing to fit forty-six of them. */
	.sc-code {
		flex: 1; min-width: 90px; height: 26px;
		display: flex; align-items: stretch; overflow: hidden;
	}
	/* :global on the bar, and it is required, not tidiness. The bars are rebuilt in script
	   on every selection, so they never carry the scope attribute Astro stamps on markup
	   it rendered — a plain `.sc-code i` compiles to an attribute selector that matches
	   the server-rendered set and nothing the script creates. Measured before the fix:
	   width 0, background transparent, 46 bars present and none of them visible. */
	.sc-code :global(i) {
		flex: none; width: var(--w); margin-right: var(--g);
		background: var(--secondary);
		/* Printed, not faded in: each bar is either struck or it is not. The script sets
		   this per bar on a stagger, so the code prints left to right. */
		opacity: 0;
	}
	.sc-code :global(i.on) { opacity: 1; }
	@media (prefers-reduced-motion: reduce) {
		.sc-code :global(i) { opacity: 1; }
	}
	.sc-issue {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
		white-space: nowrap;
	}

	/* ---- phone ----
	   The rail becomes a picker plus a short scrolling member list, and the card sits
	   under it. Two rows visible: enough to show there is a list, short enough that the
	   card stays on the same screen. */
	@media (max-width: 860px) {
		/* The panel stops being a box and becomes the stack that holds two of them. */
		.tm-side {
			height: auto; border: 0; background: none; overflow: visible;
			display: flex; flex-direction: column; gap: 12px;
		}
		.tm-box {
			display: flex; flex-direction: column;
			border: var(--stroke) solid var(--secondary); border-radius: var(--r);
			background: var(--primary); overflow: hidden;
		}
		.tm-list-bar { display: flex; }
		.tm-pick { display: block; padding: 12px; }

		/* The count is already on the MEMBERS bar and in the picker, so the section meta is
		   a third copy taking a whole line on a 390px screen. The label keeps its rule. */
		.sechead-meta { display: none; }
		.sechead-label { white-space: nowrap; }

		.tm-tree { max-height: none; padding: 10px; overflow: visible; }
		.tm-tree .tcat { display: none; }
		/* No folder row above them, so the connector rules and their indent have nothing
		   to hang off. */
		.tm-tree .titem { padding-left: 12px; }
		.tm-tree .titem::before,
		.tm-tree .titem::after { display: none; }

		.tm-tree .tkids { display: none; }
		.tm-tree .tkids.open {
			display: block; visibility: visible;
			/* three 32px rows plus the 1.5px borders — the whole of a three-person
			   department, and a scroll the moment one has four. */
			max-height: 99px; overflow-y: auto; overscroll-behavior: contain;
			border: 1.5px solid var(--hair); border-radius: var(--r);
			transition: none;                 /* the 0fr->1fr wipe needs the grid it replaced */
		}
		.tm-tree .tkids-in > .titem { opacity: 1; transition: none; }

		/* Four, not seven: the band is a third of the width here and seven read as a swarm.
		   The tails go with them, or three lines would keep drawing themselves. */
		.tm-bot:nth-of-type(n+5),
		.tm-trail polyline:nth-of-type(n+5) { display: none; }
	}

	/* Stacked: the card no longer has a rail to match, so it sizes to its content and the
	   portrait becomes a band across the top rather than a 40% sliver. */
	@media (max-width: 860px) {
		.sc { min-height: 460px; }
		.sc-split { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
		.sc-photo {
			padding: 20px 18px 22px;
