	/* Scanlines. 1px on, 2px off — any denser and it turns the type grey on a
	   non-integer device pixel ratio. */
	.sc-px {
		position: absolute; inset: 0; pointer-events: none;
		background: repeating-linear-gradient(
			to bottom,
			color-mix(in srgb, var(--secondary) 7%, transparent) 0 1px,
			transparent 1px 3px
		);
	}

	.sc-info { position: relative; flex: 1; min-height: 0; min-width: 0; overflow-y: auto; }
	.sc-dept {
		display: flex; align-items: center; gap: 9px; margin: 0 0 8px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--accent);
	}
	.sc-dept::before { content: ''; flex: none; width: 16px; height: 1.5px; background: var(--accent); }
	/* min-width:0 on the flex row too — a flex item's default min-width is its content,
	   which is the other half of how a long name escaped the card. */
	.sc-nameline { display: flex; align-items: center; gap: 9px; min-width: 0; }
	/* [hidden] loses to a display rule, so it has to be restated at higher specificity —
	   otherwise the ⓘ shows on every member. */
	.sc-more {
		display: grid; place-items: center; flex: none;
		width: 18px; height: 18px; line-height: 0;
		color: var(--accent);
		transition: transform .14s ease, color .14s ease;
	}
	.sc-more[hidden] { display: none; }
	/* :global — set:html content carries no scope attribute, so a scoped `.sc-more svg`
	   matches nothing and the icon renders at its own 24px inside an 18px box. */
	.sc-more :global(svg) { width: 15px; height: 15px; stroke-width: 2.4; display: block; }
	.sc-more:hover { transform: translateY(-2px); color: var(--secondary); }

	/* min-width:0 and the break rules are load-bearing, not defensive: the readout column
	   is a grid child, so without them the longest name in the roster sets the column's
	   minimum width and pushes its own tail out past the card's edge. "PROF. R
	   SANKARANARAYANAN" is the one that finds it. */
	.sc-name {
		margin: 0; min-width: 0;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(18px, 2.1vw, 29px);
		line-height: .98; letter-spacing: -.02em; text-transform: uppercase;
		overflow-wrap: break-word; hyphens: auto;
	}
	.sc-role {
		margin: 8px 0 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-60);
	}

	/* ---- the data block, drawn 8-bit ----
	   No border and no radius. The frame is four offset shadows, which leaves the corners
	   notched — the way a sprite-drawn box has to look when it is built out of square
	   pixels and cannot round anything. --px is the pixel; everything blocky on this card
	   is a multiple of it, so the whole panel rescales from one number.
	   The gap IS the inner rule: one ink background behind a 3px grid gap draws every line
	   at once, so cells carry no borders and nothing is switched off at the edges. */
	.sc-fields {
		--px: 3px;
		margin: 18px var(--px) 0;
		display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--px);
		background: var(--secondary);
		border: 0; border-radius: 0;
		box-shadow:
			0 calc(var(--px) * -1) 0 0 var(--notch, var(--secondary)),
			0 var(--px) 0 0 var(--notch, var(--secondary)),
			calc(var(--px) * -1) 0 0 0 var(--notch, var(--secondary)),
			var(--px) 0 0 0 var(--notch, var(--secondary));
	}
	.sc-field-wide { grid-column: 1 / -1; }
	.sc-field {
		min-width: 0; padding: 9px 11px 10px;
		background: var(--primary);
		font-family: 'DM Mono', ui-monospace, monospace;
	}
	/* A lit pixel before every label, the way a stat screen marks its rows. */
	.sc-field dt {
		display: flex; align-items: center; gap: 6px;
		font-size: 8px; letter-spacing: .16em; color: var(--ink-40);
	}
	.sc-field dt::before {
		content: ''; flex: none; width: 4px; height: 4px; background: var(--accent);
	}
	.sc-field dd {
		margin: 4px 0 0 10px; min-width: 0;
		font-size: 12px; letter-spacing: .02em; overflow-wrap: anywhere;
	}
	.sc-field dd a { color: var(--secondary); text-decoration: none; }
	.sc-field dd a:hover { color: var(--accent); }
	@media (max-width: 1180px) {
		.sc-fields { grid-template-columns: 1fr; }
