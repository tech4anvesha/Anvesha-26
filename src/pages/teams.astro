		/* the caret, drawn rather than shipped as an icon */
		background-image:
			linear-gradient(45deg, transparent 50%, var(--secondary) 50%),
			linear-gradient(135deg, var(--secondary) 50%, transparent 50%);
		background-position: right 17px center, right 12px center;
		background-size: 5px 5px, 5px 5px;
		background-repeat: no-repeat;
	}

	/* ============ THE RAIL ============ */
	.tm-side {
		display: flex; flex-direction: column;
		/* Fills the row rather than setting it — see .tm-shell. */
		height: 100%; min-height: 0;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		background: var(--primary);
		overflow: hidden;
	}
	/* Transparent on a wide screen; the phone rules below turn each into its own box. */
	.tm-box { display: contents; }
	.tm-side-bar { display: flex; }
	.tm-list-bar { display: none; }

	/* An ink title bar, the way a device labels its own panel. `display` is set per-bar
