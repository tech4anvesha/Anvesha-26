const pad = (n: number) => String(n).padStart(2, '0');
const crewTotal = DEPTS.reduce((n, d) => n + d.members.length, 0);

// Derived, not typed out forty-five times: the institute address is name-based and the
// batch year disambiguates it, exactly as iisertvm.ac.in issues them.
const emailOf = (name: string, batch: string) => {
	const stem = name.replace(/^(prof|dr)\.?\s+/i, '').toLowerCase()
		.replace(/[^a-z\s]/g, '').trim().split(/\s+/).join('.');
	return `${stem}${batch.startsWith('B') ? batch.slice(1) : ''}@iisertvm.ac.in`;
};
// TODO(anvesha): real numbers. Deliberately in the 90000 0xxxx block so no placeholder
// on this page can ring an actual phone before the real ones go in.
let phoneSeq = 0;
const phoneOf = () => `+91 90000 ${String(++phoneSeq).padStart(5, '0')}`;

const ROWS = DEPTS.map((d, di) => d.members.map((m, mi) => ({
	...m, di, mi, dept: d.name, no: pad(di + 1),
	email: emailOf(m.name, m.batch), phone: phoneOf(),
})));

const first = ROWS[0][0];
