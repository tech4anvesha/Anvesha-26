	   left/top stay 0; the loop writes a transform, which is the only thing that should
	   move. Sits above the drawn ground but under .tm-line, so it passes behind the
	   sentence rather than over it. */
	.tm-bot {
		position: absolute; left: 0; top: 0; z-index: 0;
		line-height: 0; pointer-events: none;
		will-change: transform;
	}
	/* The wrapper carries position and heading; the svg carries the idle wobble, so the
	   two compose instead of fighting over one transform. */
	.tm-bot svg { display: block; overflow: visible; transform-origin: 50% 55%; }
	.tm-bot.is-idle svg { animation: bot-idle 1.5s ease-in-out infinite; }
	@keyframes bot-idle {
		0%, 100% { transform: rotate(-7deg) translateY(0); }
		50%      { transform: rotate(7deg) translateY(-4px); }
	}

	.bot-body { fill: var(--accent); }
