	.tm-tree .titem::before,
	.tm-tree .titem::after { background: color-mix(in srgb, var(--secondary) 30%, transparent); }
	.tm-tree .titem .tname { font-weight: 500; letter-spacing: .01em; }
	.tm-tree .titem .tmeta { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
	.tm-tree .tnum { background: var(--secondary); font-size: 9.5px; }
	.tm-tree .titem.active .tnum { background: var(--accent); }

	/* ============ THE STATUS CARD ============ */
	.sc {
		display: flex; flex-direction: column; min-height: 0;
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		background: var(--primary);
		box-shadow: var(--pop-lg);
		overflow: hidden;
	}
	.sc-top {
		flex: none;
		display: flex; align-items: center; gap: 10px;
		padding: 10px 14px;
		background: var(--secondary); color: var(--primary);
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10px; letter-spacing: .18em;
	}
	.sc-led {
		flex: none; width: 8px; height: 8px; border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 26%, transparent);
	}
	.sc-model { flex: 1; }
	.sc-model b { font-weight: 500; color: var(--accent); }
	.sc-no { color: color-mix(in srgb, var(--primary) 62%, transparent); }
	/* The HUD meter: one square per person in the department, filled up to the one on
	   screen. Square, hard-edged and 4px — a lit pixel, not a dot. */
	.sc-pips { display: flex; gap: 3px; }
	/* :global on the child — select() rebuilds these <i>s, and markup made at runtime
	   carries no scope attribute, so a scoped rule would style the first three and
	   nothing after the first click. */
	.sc-pips :global(i) {
		width: 7px; height: 7px;
		background: color-mix(in srgb, var(--primary) 26%, transparent);
	}
	.sc-pips :global(i.on) { background: var(--accent); }

	/* 40/60 — the portrait panel and the readout. */
	/* A bounded column, not a percentage. The plate caps at 420px wide, so past a certain
	   card width a percentage column just grows the empty margin either side of it while
	   the readout stays cramped. min() of both: an even split while the card is narrow, and
	   once half the card is wider than the plate can use, the column stops there and every
	   pixel after it goes to the readout. A flat 468 starved the readout to 192px at
	   1280. */
	.sc-split {
		flex: 1; min-height: 0;
		display: grid; grid-template-columns: min(50%, 468px) 1fr;
		border-top: var(--stroke) solid var(--secondary);
	}

	/* ---- the portrait panel ----
	   A framed box centred on its panel, holding the submitted portrait. Initials are the
	   fallback underneath, for the institute rows and any missing file. */
	/* The plate is bounded — it has to be, or it drags the card past the rail — so the
	   panel around it will always have room to spare on one axis. Left white that read as
	   the layout having failed; given the page's own graph paper it reads as the mount the
	   photograph is stuck to, which is what an ID card actually is. Same 46px grid as the
	   header band up top, so it is the page's ground and not a new pattern. */
	/* Paper, with Solaris drawn on it. The plate is capped, so this panel always has room
	   to spare on one axis; blank it read as unfinished, and in ink it read as a hole cut
	   in the card. Concentric dashed orbits in the flare colours, centred behind the
	   plate, give the space something to be — and it is the same figure the home page
	   opens with, so the year's theme is what the portrait is mounted on.
	   All gradients: an SVG here would be a second copy of a drawing that already exists.
	   min-height/overflow are the belt to the plate's braces — whatever the arithmetic
	   works out to, nothing leaves this panel. */
	.sc-photo {
		position: relative;
		display: flex; flex-direction: column; align-items: stretch; justify-content: center;
		gap: 12px; min-width: 0; min-height: 0; overflow: hidden;
		padding: clamp(14px, 1.8vw, 24px);
		border-right: var(--stroke) solid var(--secondary);
		background: var(--primary);
	}
	.sc-photo::before {
		content: ''; position: absolute; inset: -20%; pointer-events: none;
		background:
			/* the ocean's own glow, off-centre so the composition is not a bullseye */
			radial-gradient(circle at 50% 44%,
				color-mix(in srgb, var(--flare-rose) 13%, transparent) 0 22%,
				transparent 62%),
			/* the orbits */
			repeating-radial-gradient(circle at 50% 44%,
				transparent 0 34px,
				color-mix(in srgb, var(--flare-plum) 26%, transparent) 34px 35.5px);
		mask-image: radial-gradient(circle at 50% 44%, #000 30%, transparent 78%);
	}
	/* One tilted ring, the way .sol-o2 sits across the planet on the home page. */
	.sc-photo::after {
		content: ''; position: absolute; left: 50%; top: 44%; pointer-events: none;
		width: 118%; aspect-ratio: 2.7; transform: translate(-50%, -50%) rotate(-13deg);
		border: 1.5px dashed color-mix(in srgb, var(--flare-coral) 34%, transparent);
		border-radius: 50%;
	}
	/* The plate and its caption sit over the drawing, not under it. */
	.sc-box, .sc-photo-tag { position: relative; z-index: 1; }
	/* Same notched-corner frame as the data block, one pixel heavier — it is the larger
	   object, and an even border on both would make the box read as the lighter one. */
	/* 3:4, and that is the fix for the crop. The plate used to take whatever shape the
	   panel had, which came out around 0.56 — far narrower than any of the photographs,
	   which run 0.56 to 1.50 and sit at 0.75 in the median. A 1.5 landscape shot lost
	   nearly two thirds of its width to that plate, which is why people were being cut in
	   half. At 3:4 the plate matches the median submission, so most crop barely at all.
	   Measured across all 33 before and after. */
	.sc-box {
		--px: 4px;
		position: relative; display: grid; place-items: center;
		aspect-ratio: 3 / 4; flex: none;
		/* Width-driven, and it has to be. Driving it off height instead — height:100% with
		   a max-width ceiling — looked like it would fill the panel, but when that ceiling
		   clamps against a definite height it is the ASPECT RATIO that gives: measured
		   0.39 to 0.59 instead of 0.75, which is the over-tall plate that was cropping
		   people in the first place. Width is the axis that can be honoured exactly.
		   The leftover height is handled by the panel's ground instead.
		   The third term is what stops the plate overflowing: --row is the card's own
		   height, 130px of it goes to the title bar, padding and the caption, and 3/4 of
		   what is left is the widest plate that still fits. Without it, at 1600x900 the
		   plate wanted 620px inside a 532px panel — the panel's grid row grew to its
		   content, took the readout with it, and pushed the barcode strip clean out of the
		   bottom of the card. */
		width: min(
			calc(100% - var(--px) * 2),
			460px,
			calc((var(--row, 640px) - 130px) * 0.75)
		);
		min-height: 0; margin: var(--px) auto;
		border: 0; border-radius: 0;
		box-shadow:
			0 calc(var(--px) * -1) 0 0 var(--notch, var(--secondary)),
			0 var(--px) 0 0 var(--notch, var(--secondary)),
			calc(var(--px) * -1) 0 0 0 var(--notch, var(--secondary)),
			var(--px) 0 0 0 var(--notch, var(--secondary));
		/* the shell's own dot matrix, so the empty plate still belongs to the page */
		background:
			radial-gradient(circle at center, color-mix(in srgb, var(--secondary) 15%, transparent) 1.1px, transparent 1.3px)
			0 0 / 8px 8px,
			var(--primary);

		overflow: hidden;
	}
	.sc-init {
		position: relative;
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(42px, 7.5vw, 108px); line-height: 1;
	}
	/* Laid over the initials rather than replacing them: hiding the image is all it takes
	   to fall back, which is what the institute rows and any failed upload need.
	   Absolutely positioned so it fills the plate without the grid centring it — the box
	   has no aspect ratio of its own and cover is what keeps every face the same size. */
	.sc-img {
		position: absolute; inset: 0; z-index: 1;
		width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%;
		display: block;
	}
	.sc-img[hidden] { display: none; }
	.sc-photo-tag {
		flex: none; text-align: center;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9px; letter-spacing: .16em; color: var(--ink-60);
	}

	/* ---- the readout ---- */
	.sc-screen {
		position: relative; min-width: 0; min-height: 0;
		/* The quote sizes off this, not off the viewport — see .sc-bio. */
		container-type: inline-size;
		display: flex; flex-direction: column;
		padding: clamp(16px, 2vw, 26px);
		background: var(--sink);
