	/* An ink title bar, the way a device labels its own panel. `display` is set per-bar
	   below, not here: this shared rule sits after the .tm-list-bar reset and would
	   otherwise turn the phone-only bar back on for every screen. */
	.tm-side-bar, .tm-list-bar {
		flex: none;
		align-items: center; gap: 9px;
		padding: 10px 12px;
		background: var(--secondary); color: var(--primary);
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 10px; letter-spacing: .18em;
	}
	.tm-led {
		flex: none; width: 7px; height: 7px; border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 2.5px color-mix(in srgb, var(--accent) 28%, transparent);
	}
	.tm-side-title { flex: 1; }
	.tm-side-n { color: color-mix(in srgb, var(--primary) 62%, transparent); }

	/* ---- retro skin over styles/catalogue-tree.css ----
	   The rail's geometry — connector rules, indents, the grid on each row — is inherited
	   whole. Only the surface changes here: mono type throughout, a typed caret instead of
	   an icon, and connectors in ink rather than a hairline so they read as drawn. */
	.tm-tree {
		flex: 1; min-height: 0;
		padding: 6px; margin: 0;
		scrollbar-width: thin; scrollbar-color: var(--secondary) transparent;
	}
	.tm-tree::-webkit-scrollbar { display: block; width: 6px; }
	.tm-tree button.tnode { font-family: 'DM Mono', ui-monospace, monospace; }

	.tm-tree .tcat { grid-template-columns: 14px 1fr auto; padding: 10px 9px 10px 6px; }
	.tm-tree .tcaret {
		width: 14px; font-size: 11px; line-height: 1;
		color: var(--ink-40);
		transition: transform .16s ease, color .16s ease;
	}
	.tm-tree .tcat.open .tcaret { transform: rotate(90deg); color: var(--accent); }
	.tm-tree .tcat .tname { font-size: 10.5px; letter-spacing: .1em; font-weight: 700; }
	.tm-tree .tcat .tmeta { font-size: 9.5px; letter-spacing: .1em; }

