		   make the second of two stacked boxes as tall as the first for no reason. */
		.tm-shell { grid-template-columns: 1fr; grid-auto-rows: auto; }
	}

	/* The picker is a native <select> on purpose: a phone renders it as the OS wheel,
	   which beats any list this page could draw for fifteen options. */
	.tm-pick { display: none; }
	.tm-pick-label {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 8.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-40);
	}
	.tm-pick select {
		appearance: none; -webkit-appearance: none;
		width: 100%; margin-top: 5px; padding: 11px 34px 11px 12px;
		background: var(--primary); color: var(--secondary);
		border: var(--stroke) solid var(--secondary); border-radius: var(--r);
		font-family: 'DM Mono', ui-monospace, monospace;
