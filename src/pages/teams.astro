<SiteLayout title="Teams · Anvesha '26">
	<div class="page">
		<header class="page-head tm-head" data-reveal>
			{/* The comma marks are decoration, not punctuation — aria-hidden so a screen
			    reader is not read a stray comma either side of the sentence. */}
			{/* Outlined geometry over the graph paper. viewBox + slice, so the shapes keep
			    their proportions and the composition crops with the band instead of
			    stretching with it. */}
			<svg class="tm-geo" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
				<polygon class="geo" points="150,215 190,140 230,215" />
				<rect class="geo" x="292" y="52" width="54" height="54" transform="rotate(18 319 79)" />
				<circle class="geo" cx="470" cy="238" r="26" />
				<polygon class="geo geo-accent" points="742,58 762,78 742,98 722,78" />
				<polygon class="geo" points="905,120 941,141 941,183 905,204 869,183 869,141" />
				<circle class="geo" cx="1078" cy="86" r="38" />
				<line class="geo" x1="1010" y1="236" x2="1122" y2="196" />
			</svg>

			{/* One short dotted tail per robot. A dashed stroke with round caps and a zero
			    dash length draws the dots — one polyline per robot beats a stream of nodes,
			    and being in the template it keeps the scoped stylesheet. */}
			<svg class="tm-trail" id="tmTrail" aria-hidden="true">
				{[0, 1, 2, 3, 4, 5, 6].map(() => <polyline />)}
			</svg>

			{/* Seven of them, drifting the band behind the line. Decoration only: aria-hidden,
			    pointer-events:none, and they park themselves if the reader has asked for
			    reduced motion. Blink delays are staggered so they do not blink in unison. */}
			{[0, 1, 2, 3, 4, 5, 6].map((i) => (
				<div class="tm-bot" aria-hidden="true" style={`--blink:${(i * 0.71).toFixed(2)}s`}>
					<svg viewBox="0 0 64 62" width="46" height="45">
						{/* antenna, arms and base first — the head draws over the ends that
						    tuck under it, so nothing needs a mask or a clip */}
						<rect class="bot-stalk" x="30.5" y="2" width="3" height="10" rx="1.5" />
						<circle class="bot-tip" cx="32" cy="3" r="3.5" />
						<circle class="bot-arm" cx="8" cy="33" r="6" />
						<circle class="bot-arm" cx="56" cy="33" r="6" />
						<rect class="bot-arm" x="22" y="46" width="20" height="9" rx="4.5" />
						<rect class="bot-body" x="12" y="9" width="40" height="40" rx="13" />
						<rect class="bot-visor" x="18" y="21" width="28" height="15" rx="7.5" />
						<g class="bot-eyes">
							<circle cx="26" cy="28.5" r="3.2" />
							<circle cx="38" cy="28.5" r="3.2" />
						</g>
					</svg>
				</div>
			))}

			<p class="tm-line" aria-label="Meet the crew steering this year's scientific voyage...">
				<span class="tm-q" aria-hidden="true">&ldquo;</span><span
					class="tm-text" id="tmText">Meet the crew steering this year's scientific voyage...</span><span
					class="tm-cur" id="tmCur" aria-hidden="true">_</span><span
					class="tm-q tm-qend" id="tmQend" aria-hidden="true">,,</span>
			</p>
		</header>

		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">The crew</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta"><b>{DEPTS.length}</b> departments · <b>{crewTotal}</b> people</span>
			</div>

			<div class="tm-shell">
				{/* ---- the rail ---- */}
				<aside class="tm-side">
					{/* display:contents on a wide screen, so these two are one panel there and
					    two stacked boxes on a phone — without a second copy of the markup. */}
					<div class="tm-box">
					<div class="tm-side-bar">
						<span class="tm-led" aria-hidden="true"></span>
						<span class="tm-side-title">THE COMMITTEE</span>
						<span class="tm-side-n">{pad(DEPTS.length)}</span>
					</div>

					{/* Phone only. The rail's folder rows are hidden there and this drives the
					    same open/close, so there is one source of truth for what is open.
					    Grouped the same way the rail is: the institute is not a department a
					    reader is picking between, so it does not sit in that list. */}
					<label class="tm-pick">
						<span class="tm-pick-label">Jump to</span>
						<select id="tmPick">
							<option value="0">{INSTITUTE.name}</option>
							<optgroup label="Departments">
								{DEPTS.map((d, i) => <option value={i + INST_N}>{d.name}</option>)}
							</optgroup>
						</select>
					</label>
					</div>

					<div class="tm-box">
					<div class="tm-list-bar">
						<span class="tm-led" aria-hidden="true"></span>
						<span class="tm-side-title">Members</span>
						<span class="tm-side-n" id="tmCount">03</span>
					</div>

					<div class="tree tm-tree" id="tmTree" role="tree" aria-label="The committee">
						{GROUPS.map((d, di) => (
							<>
								{/* One heading, not two. The institute sits above this rule on its own
								    and the row is already called Institute, so labelling it as well
								    just said the word twice; the rule under it is what actually
								    separates the two kinds of thing. Presentational — the rows stay
								    siblings in one tree, so keyboard order and the phone select are
								    unchanged. */}
								{di === INST_N && <p class="tm-group" aria-hidden="true">Departments</p>}

								<button class:list={['tnode', 'tcat', di === 0 && 'open']} type="button"
								        role="treeitem" aria-expanded={di === 0 ? 'true' : 'false'}
								        data-cat={di}>
									<span class="tcaret" aria-hidden="true">&#9656;</span>
									<span class="tname">{d.name}</span>
									<span class="tmeta">{pad(d.members.length)}</span>
								</button>

								<div class:list={['tkids', di === 0 && 'open']} data-kids={di}>
									<div class="tkids-in">
									{ROWS[di].map((m, mi) => (
										<>
										{/* A section heading wherever `section` changes — Expo is the
										    only department that has them, so every other list draws
										    straight through. Presentational, like the Institute and
										    Departments rules above it: the rows stay siblings, so
										    keyboard order and the counts are untouched. */}
										{m.section && m.section !== ROWS[di][mi - 1]?.section && (
											<p class="tm-sub" aria-hidden="true">{m.section}</p>
										)}
										<button
											class:list={['tnode', 'titem', m.mi === d.members.length - 1 && 'last',
											             di === 0 && m.mi === 0 && 'active']}
											type="button" role="treeitem"
											data-name={m.name}
											data-role={m.role}
											data-roll={m.roll}
											data-batch={m.batch}
											data-email={m.email}
											data-photo={(m as { photo?: string }).photo}
											data-bars={m.bars}
											data-faculty={m.faculty ? '1' : undefined}
											data-school={(m as { school?: string }).school}
											data-dept={m.dept}
											data-bio={m.bio}
											data-no={m.no}
											data-idx={m.mi + 1}
											data-of={d.members.length}
											data-more={(m as { more?: string }).more}
										>
											<i class="tnum">{pad(m.mi + 1)}</i>
											<span class="tname">{m.name}</span>
											<span class="tmeta">{m.meta}</span>
										</button>
										</>
									))}
									</div>
								</div>
							</>
						))}
					</div>
					</div>
				</aside>

				{/* ---- the status card ----
				    Pre-filled from the first member so the panel is never an empty box, and so
				    the page is complete before a single line of script runs. */}
				<article class:list={['sc', first.faculty && 'is-faculty']} id="scCard" aria-live="polite">
					<div class="sc-top">
						<span class="sc-led" aria-hidden="true"></span>
						<span class="sc-model">ANVESHA <b>CREW</b></span>
						{/* Which of the department's people is on screen, drawn as pixels. */}
						<span class="sc-pips" id="scPips" aria-hidden="true"><i class="on"></i><i></i><i></i></span>
						<span class="sc-no" id="scNo">NO. 01</span>
					</div>

					<div class="sc-split">
						{/* The portrait is a framed box on its panel, not a full-bleed fill.
						    The initials stay underneath as the fallback: the institute rows have
						    no photograph, and a submission whose file failed to convert would
						    otherwise leave a hole. */}
						<div class="sc-photo" aria-hidden="true">
							<div class="sc-box">
								<span class="sc-px"></span>
								<span class="sc-init" id="scInit">{initialsOf(first.name)}</span>
								<img class="sc-img" id="scImg"
								     src={(first as { photo?: string }).photo}
								     alt="" hidden={!(first as { photo?: string }).photo} />
							</div>
							<span class="sc-photo-tag" id="scPhotoTag">
								{(first as { photo?: string }).photo ? first.roll : 'NO PHOTO ON FILE'}
							</span>
						</div>

						<div class="sc-screen">
							<span class="sc-px" aria-hidden="true"></span>

							<div class="sc-info">
								<p class="sc-dept" id="scDept">{first.dept}</p>
								<div class="sc-nameline">
									<h2 class="sc-name" id="scName">{first.name}</h2>
									{/* Shown only for a member carrying `more`. Server-rendered hidden so
									    it never flashes on for the row that loads first. */}
									<a class="sc-more" id="scMore" href="/creator" hidden
									   aria-label="More about this person" set:html={iInfo} />
								</div>
								<p class="sc-role" id="scRole">{first.role}</p>
								{/* Faculty only — the crew's own school was never collected, and this
								    is the line that says which part of the institute a name sits in. */}
								<p class="sc-school" id="scSchool">{(first as { school?: string }).school}</p>

								{/* An ID card's data block: boxed cells, label over value. The grid gap
								    is the ink showing through — one background and a 1.5px gap draw
								    every rule, so no cell needs its own borders or nth-child sums. */}
								<dl class="sc-fields">
									<div class="sc-field" id="scRollField">
										<dt>ROLL No.</dt>
										<dd id="scRoll">{first.roll}</dd>
									</div>
									<div class="sc-field">
										<dt>BATCH</dt>
										<dd id="scBatch">{first.batch}</dd>
									</div>
									<div class="sc-field">
										<dt>DEPARTMENT</dt>
										<dd id="scDept2">{first.dept}</dd>
									</div>
									<div class="sc-field">
										<dt>POSITION</dt>
										<dd id="scPos">{first.role}</dd>
									</div>
									<div class="sc-field sc-field-wide" id="scEmailField">
										<dt>INSTITUTE EMAIL</dt>
										<dd><a id="scEmail" href={`mailto:${first.email}`}>{first.email}</a></dd>
									</div>
								</dl>

								<blockquote class="sc-quote">
									<p class="sc-bio" id="scBio">{first.bio}</p>
									<cite class="sc-quote-by" id="scBy">&mdash; {first.name}</cite>
								</blockquote>
							</div>

							{/* The strip along the bottom of every ID card ever issued. */}
							<div class="sc-strip">
								{/* Bars are elements, not a repeating gradient: a gradient cannot be
								    this person's rather than everyone's, and it cannot be printed
								    one bar at a time. */}
								<span class="sc-code" id="scCode" aria-hidden="true">
									{first.bars.split(' ').map((pair) => (
										<i style={`--w:${pair[0]}px;--g:${pair[1]}px`}></i>
									))}
								</span>
								<span class="sc-issue" id="scBar">ANVESHA '26 · IISER TVM</span>
							</div>
						</div>
					</div>
				</article>
			</div>
		</section>
	</div>
</SiteLayout>

<script>
	/**
	 * Types the header line out on arrival.
	 *
	 * The full sentence is server-rendered and the <p> carries it as aria-label, so this
	 * only ever removes and restores what is already there — a reader with JS off, or a
	 * crawler, or a screen reader mid-type all still get the whole line.
	 * The ellipsis rides at a slower beat than the words: three dots at typing speed read
	 * as a stutter rather than a trailing off.
	 */
	function typeLine() {
		const el = document.getElementById('tmText');
		const cur = document.getElementById('tmCur');
		const qend = document.getElementById('tmQend');
		if (!el || !cur || !qend) return;

		const full = el.textContent ?? '';
		const done = () => { el.textContent = full; cur.hidden = true; qend.hidden = false; };

		if (matchMedia('(prefers-reduced-motion: reduce)').matches) { done(); return; }

		qend.hidden = true;
		el.textContent = '';
		let i = 0;
		const step = () => {
			el.textContent = full.slice(0, ++i);
			if (i >= full.length) {
				// Let the caret blink a beat before the closing mark lands.
				setTimeout(done, 420);
				return;
			}
			setTimeout(step, full[i] === '.' ? 190 : 26);
		};
		setTimeout(step, 260);
	}

	/**
	 * Flies the robots around the header band.
	 *
	 * Three states on a timer — CRUISE, DASH and REST — because constant motion at one
	 * speed is what made the first version read as a machine on rails. Each robot keeps
	 * its own state and picks its own beats, so they never move as a formation.
	 *
	 * ponytail: one rAF for all of them, not one each — the per-frame work is a transform
	 * write per robot, and four loops would just be four places to stop.
	 * No cancel bookkeeping either: it stops itself the frame the elements leave the
	 * document, which is exactly what a client-side navigation does to them.
	 */
	function flyBot() {
		const head = document.querySelector<HTMLElement>('.tm-head');
		const bots = Array.from(document.querySelectorAll<HTMLElement>('.tm-bot'));
		if (!head || !bots.length) return;

		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		const tails = Array.from(document.querySelectorAll<SVGPolylineElement>('.tm-trail polyline'));
		const TAIL = 16;              // ≈ 30px of dots at cruise — a hint, not a comet

		const crew = bots.map((el, i) => ({
			el,
			tail: tails[i] ?? null,
			pts: [] as { x: number; y: number }[],
			// Spread across the band rather than stacked in one corner.
			x: head.clientWidth * (0.07 + i * 0.135),
			y: head.clientHeight * (i % 2 ? 0.62 : 0.16),
			a: (i * Math.PI * 2) / 7 + 0.4,
			shown: 0,
			speed: 0,
			target: 2,
			until: 0,
			resting: false,
		}));

		if (reduced) {
			for (const b of crew) b.el.style.transform = `translate(${b.x}px, ${b.y}px)`;
			return;
		}

		type Bot = (typeof crew)[number];
		const pick = (b: Bot, t: number) => {
			// A rest is the shortest of the three: standing still is a beat, not a pause.
			const r = Math.random();
			if (r < 0.24) { b.resting = true; b.target = 0; b.until = t + 900 + Math.random() * 900; }
			else if (r < 0.42) { b.resting = false; b.target = 4.4; b.until = t + 700 + Math.random() * 700; }
			else { b.resting = false; b.target = 1.7 + Math.random() * 0.9; b.until = t + 1600 + Math.random() * 2200; }
			b.el.classList.toggle('is-idle', b.resting);
		};

		const step = (t: number) => {
			if (!bots[0].isConnected) return;

			for (const b of crew) {
				if (t > b.until) {
					if (b.resting) b.a += (Math.random() - 0.5) * 2.4;   // leaves facing somewhere new
					pick(b, t);
				}

				const maxX = Math.max(0, head.clientWidth - b.el.offsetWidth);
				const maxY = Math.max(0, head.clientHeight - b.el.offsetHeight);

				// Ease toward the state's speed rather than snapping — the ramp is most of
				// what makes a stop read as deceleration instead of a freeze.
				b.speed += (b.target - b.speed) * 0.045;

				// Wander harder at low speed, so it turns tightly as it slows and holds a
				// line when it is moving fast.
				b.a += (Math.random() - 0.5) * (0.05 + 0.16 / (1 + b.speed));
				b.x += Math.cos(b.a) * b.speed;
				b.y += Math.sin(b.a) * b.speed;

				// Steer away from a wall instead of bouncing: a reflection reads as a collision.
				if (b.x < 0 || b.x > maxX) { b.a = Math.PI - b.a; b.x = Math.min(Math.max(b.x, 0), maxX); }
				if (b.y < 0 || b.y > maxY) { b.a = -b.a; b.y = Math.min(Math.max(b.y, 0), maxY); }

				// The sprite stands upright, so its nose is -90° from the heading. Eased, and
				// by the short way round, or it unwinds a full turn every time it crosses ±180°.
				if (b.speed > 0.25) {
					let d = (b.a + Math.PI / 2) - b.shown;
					d = Math.atan2(Math.sin(d), Math.cos(d));
					b.shown += d * 0.09;
				}
				b.el.style.transform =
					`translate(${b.x.toFixed(1)}px, ${b.y.toFixed(1)}px) rotate(${(b.shown * 180 / Math.PI).toFixed(1)}deg)`;

				// Only while moving — a resting robot should not keep stamping one point, and
				// its tail keeps retreating into it instead.
				if (b.speed > 0.3) {
					b.pts.push({ x: b.x + b.el.offsetWidth / 2, y: b.y + b.el.offsetHeight / 2 });
					if (b.pts.length > TAIL) b.pts.shift();
				} else if (b.pts.length) {
					b.pts.shift();
				}
				b.tail?.setAttribute('points',
					b.pts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' '));
			}

			requestAnimationFrame(step);
		};
		requestAnimationFrame((t) => { for (const b of crew) pick(b, t); step(t); });
	}

	// ponytail: same re-init shape as /merch and /events — module scripts run once per
	// session, so with the client router this has to bind against each swapped DOM.
	let inited: HTMLElement | null = null;

	function initTeams() {
		const tree = document.getElementById('tmTree');
		if (!tree || tree === inited) return;
		inited = tree;

		const $ = (id: string) => document.getElementById(id)!;

		typeLine();
		flyBot();
		const scNo = $('scNo'), scDept = $('scDept'), scDept2 = $('scDept2'), scName = $('scName');
		const scRole = $('scRole'), scPos = $('scPos'), scRoll = $('scRoll'), scBatch = $('scBatch');
		const scSchool = $('scSchool');
		const scRollField = $('scRollField'), scEmailField = $('scEmailField');
		const scQuote = document.querySelector<HTMLElement>('.sc-quote')!;
		const scBio = $('scBio'), scBy = $('scBy'), scInit = $('scInit');
		const scImg = $('scImg') as HTMLImageElement, scPhotoTag = $('scPhotoTag');
		const scCode = $('scCode');
		const scCard = $('scCard');
		const scEmail = $('scEmail') as HTMLAnchorElement;
		const scPips = $('scPips');
		const scMore = $('scMore') as HTMLAnchorElement;

		const initials = (name: string) =>
			name.replace(/^(Prof|Dr)\.?\s+/i, '')          // a title is not an initial
				.split(/\s+/).slice(0, 2)
				.map((w) => w[0] ?? '').join('').toUpperCase();

		// The barcode prints rather than appears. One timer, cancelled on the way in, so
		// clicking through the rail quickly cannot leave two codes printing over the top
		// of each other into the same strip.
		let printTimer = 0;
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

		function printCode(bars: string) {
			clearInterval(printTimer);
			scCode.replaceChildren(...bars.split(' ').map((pair) => {
				const b = document.createElement('i');
				b.style.setProperty('--w', `${pair[0]}px`);
				b.style.setProperty('--g', `${pair[1]}px`);
				return b;
			}));

			const bs = [...scCode.children] as HTMLElement[];
			if (reducedMotion) { for (const b of bs) b.classList.add('on'); return; }

			// Three at a time: one per tick reads as a progress bar filling, which is a
			// different thing from a head striking a line.
			let i = 0;
			printTimer = window.setInterval(() => {
				for (let n = 0; n < 3 && i < bs.length; n++, i++) bs[i].classList.add('on');
				if (i >= bs.length) clearInterval(printTimer);
			}, 16);
		}

		function select(row: HTMLElement) {
			for (const r of tree!.querySelectorAll('.titem.active')) r.classList.remove('active');
			row.classList.add('active');

			const d = row.dataset;
			// Institute rows carry no roll, batch, email or one-liner — the card drops
			// those blocks rather than printing a column of em dashes.
			scCard.classList.toggle('is-faculty', d.faculty === '1');
			scInit.textContent = initials(d.name!);
			scDept.textContent = d.dept!;
			scDept2.textContent = d.dept!;
			scName.textContent = d.name!;
			scMore.hidden = !d.more;
			if (d.more) scMore.href = d.more;
			scRole.textContent = d.role!;
			scPos.textContent = d.role!;
			scSchool.textContent = d.school ?? '';
			scRoll.textContent = d.roll!;
			scBatch.textContent = d.batch!;
			scBio.textContent = d.bio!;

			// Most of the subject coordinators never filled in the crew form, so they have
			// a name, a batch and a subject and nothing else. A field printing an em dash
			// and an empty mailto: reads as a broken record rather than a short one — the
			// card drops what it has no answer for instead.
			scRollField.hidden = !d.roll || d.roll === '\u2014';
			scEmailField.hidden = !d.email;
			scQuote.hidden = !d.bio;
			scBy.textContent = `— ${d.name}`;

			// The initials sit under the photo, so they only need swapping — hiding the
			// <img> is what reveals them, and clearing src first stops the previous
			// person's face showing for a frame while the next one decodes.
			scImg.hidden = !d.photo;
			scImg.src = d.photo ?? '';
			scPhotoTag.textContent = d.photo ? d.roll! : 'NO PHOTO ON FILE';
			printCode(d.bars!);
			scNo.textContent = `NO. ${d.no}`;
			// One pixel per person in the department, the current one lit.
			scPips.innerHTML = Array.from({ length: +d.of! },
				(_, i) => `<i class="${i < +d.idx! ? 'on' : ''}"></i>`).join('');

			scEmail.textContent = d.email!;
			scEmail.href = `mailto:${d.email}`;

			// Stacked layout: the card sits below a rail that is most of a screen tall, so
			// picking a name would otherwise update something the reader cannot see.
			if (matchMedia('(max-width: 860px)').matches)
				document.querySelector('.sc')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
		}

		/** One open department at a time — opening any other closes the one before it. */
		function openCat(cat: HTMLElement, open: boolean) {
			cat.classList.toggle('open', open);
			cat.setAttribute('aria-expanded', String(open));
			// A class, not [hidden]: display:none cannot transition, and the rail's open
			// and close are the page's only real motion.
			tree!.querySelector<HTMLElement>(`[data-kids="${cat.dataset.cat}"]`)?.classList.toggle('open', open);
		}

		const pick = document.getElementById('tmPick') as HTMLSelectElement | null;
		pick?.addEventListener('change', () => {
			const cat = tree.querySelector<HTMLElement>(`.tcat[data-cat="${pick.value}"]`);
			if (!cat) return;
			for (const other of tree.querySelectorAll<HTMLElement>('.tcat.open'))
				if (other !== cat) openCat(other, false);
			openCat(cat, true);
			const rows = tree.querySelectorAll<HTMLElement>(`[data-kids="${pick.value}"] .titem`);
			const count = document.getElementById('tmCount');
			if (count) count.textContent = String(rows.length).padStart(2, '0');
			// Land on someone rather than an open list with a stale card under it.
			if (rows[0]) select(rows[0]);
		});

		tree.addEventListener('click', (e) => {
			const el = e.target as HTMLElement;

			const cat = el.closest<HTMLElement>('.tcat');
			if (cat) {
				const open = !cat.classList.contains('open');
				for (const other of tree.querySelectorAll<HTMLElement>('.tcat.open'))
					if (other !== cat) openCat(other, false);
				openCat(cat, open);
				return;
			}

			const row = el.closest<HTMLElement>('.titem');
			if (row) select(row);
		});
	}

	document.addEventListener('astro:page-load', initTeams);
	initTeams();
</script>

<style>
	/* ============ HEADER ============
	   One centred line where the title and lede were, hung between purple comma marks.
	   No max-width: the measure was what pushed it onto two lines. */
	/* A definite height so the robot has a band to cross rather than a strip the height of
	   one line of type. */
	.tm-head {
		position: relative; overflow: hidden; text-align: center;
		display: grid; place-items: center;
		min-height: clamp(132px, 18vh, 184px);
	}

	/* ---- the ground behind the line ----
	   Graph paper and one ranging ring, both drawn in CSS: it is a science fest, and a
	   plotted grid says that without an image to load. The mask fades everything out
	   before it reaches the type, so nothing competes with the sentence itself. */
	.tm-head::before,
	.tm-head::after { content: ''; position: absolute; inset: 0; pointer-events: none; }
	.tm-head::before {
		background:
			repeating-linear-gradient(90deg, var(--hair) 0 1px, transparent 1px 46px),
			repeating-linear-gradient(0deg, var(--hair) 0 1px, transparent 1px 46px);
		/* two stops, not one: a single radial leaves a hard ring where the fade ends */
		mask-image: radial-gradient(ellipse 62% 90% at 50% 50%, transparent 12%, #000 58%, transparent 96%);
	}
	/* Concentric rings, off to one side so the composition is not a bullseye. */
	.tm-head::after {
		background: repeating-radial-gradient(
			circle at 12% 50%,
			transparent 0 38px,
			color-mix(in srgb, var(--accent) 22%, transparent) 38px 39.5px
