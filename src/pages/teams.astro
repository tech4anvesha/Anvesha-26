	}
	.tm-side-title { flex: 1; }
	.tm-side-n { color: color-mix(in srgb, var(--primary) 62%, transparent); }

	/* ---- retro skin over styles/catalogue-tree.css ----
	   The rail's geometry — connector rules, indents, the grid on each row — is inherited
	   whole. Only the surface changes here: mono type throughout, a typed caret instead of
	   an icon, and connectors in ink rather than a hairline so they read as drawn. */
	.tm-tree {
		flex: 1; min-height: 0;
		padding: 8px; margin: 0;
		scrollbar-width: thin; scrollbar-color: var(--secondary) transparent;
	}
	.tm-tree::-webkit-scrollbar { display: block; width: 6px; }
	.tm-tree button.tnode { font-family: 'DM Mono', ui-monospace, monospace; }

	/* The one thing separating the institute from the departments. A rule with the label
	   sitting on it, so it reads as a divider in the rail rather than as another row you
	   could click. The first one needs no top margin — it is already at the top. */
	.tm-group {
		display: flex; align-items: center; gap: 8px;
		margin: 16px 6px 6px; padding: 0;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 9.5px; letter-spacing: .2em; text-transform: uppercase;
		color: var(--ink-60);
	}
	.tm-group:first-child { margin-top: 2px; }

	/* One level in from .tm-group: this divides a department's own list, so it is indented
	   to the members' column and set a step smaller and quieter than the rules that
	   separate the institute from the departments.

	   One level, not two. Expo's subjects were a second, deeper heading under a first, and
	   two labels stacked six pixels apart read as a table header rather than a hierarchy.
	   The subject is folded into the section's own label instead — "Subject Expo
	   (Chemistry)" — so there is one kind of divider in this rail and it always looks the
	   same.

	   The space is PADDING, not margin, and that matters: the tree's spine is drawn by each
	   row as a full-height ::before, so anything sitting between rows that does not draw
	   its own segment leaves a gap in the line. Padding keeps the space inside this
	   element's box, where its own segment can cover it. */
	.tm-sub {
		position: relative;
		display: flex; align-items: center; gap: 8px;
		margin: 0 10px 0 40px; padding: 18px 0 6px;
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 8.5px; letter-spacing: .18em; text-transform: uppercase;
		color: var(--accent);
	}
	/* The spine, continued. Same x, width and colour as .titem::before in
	   catalogue-tree.css — this element is indented 40px, so -20px puts it back on the
	   line the rows draw, and the list reads as one unbroken tree. */
	.tm-sub::before {
		content: ''; position: absolute; left: -20px; top: 0; bottom: 0;
		width: 1.5px; background: var(--hair);
	}
	.tm-sub::after {
		content: ''; flex: 1; height: 1px;
		background: color-mix(in srgb, var(--accent) 30%, transparent);
	}
	.tm-sub:first-child { padding-top: 6px; }

	.tm-tree .tcat { grid-template-columns: 16px 1fr auto; padding: 13px 11px 13px 7px; }
	.tm-tree .tcaret {
		width: 16px; font-size: 13px; line-height: 1;
		color: var(--ink-40);
		transition: transform .16s ease, color .16s ease;
	}
	.tm-tree .tcat.open .tcaret { transform: rotate(90deg); color: var(--accent); }
	.tm-tree .tcat .tname { font-size: 12.5px; letter-spacing: .09em; font-weight: 700; }
	.tm-tree .tcat .tmeta { font-size: 10.5px; letter-spacing: .1em; }

	/* ---- open / close ----
	   0fr -> 1fr on a one-row grid: the browser animates to the row's own content height
	   with no JS measuring it and no hard-coded number to go stale. .tkids already clips,
	   which is what turns the row collapsing into a wipe.
	   visibility flips at the far end of the close so collapsed rows leave the tab order,
	   and instantly on open so they are focusable before the wipe finishes. */
	.tm-tree .tkids {
		display: grid; grid-template-rows: 0fr;
		visibility: hidden;
		transition: grid-template-rows .26s cubic-bezier(.25, .1, .25, 1), visibility 0s .26s;
	}
	.tm-tree .tkids.open {
		grid-template-rows: 1fr;
		visibility: visible;
		transition: grid-template-rows .26s cubic-bezier(.25, .1, .25, 1), visibility 0s;
	}
