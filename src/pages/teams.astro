const pad = (n: number) => String(n).padStart(2, '0');

// One flat list for the rail, the card and every index — but the FIRST entry is the
// institute and the rest are departments, which is the whole point of the split. The
// rail draws a heading before each run rather than treating them as one kind of thing.
const GROUPS = [INSTITUTE, ...DEPTS];
const INST_N = 1;
const crewTotal = GROUPS.reduce((n, g) => n + g.members.length, 0);

// The barcode. Derived from the roll number so it is that person's and nobody else's,
// stable across builds, and computed here rather than in the script so the row already
// carries it — the client only has to draw what it is handed.
//
// It encodes nothing. A real Code 39 of a roll number would be a scannable identifier
// printed on a public page, which is a worse idea than it looks; this is the look of a
// barcode over a hash of the same string.
const barsOf = (seed: string) => {
	// xorshift off a string hash: same seed, same bars, every time.
	let h = 2166136261;
	for (let i = 0; i < seed.length; i++) {
		h ^= seed.charCodeAt(i);
		h = Math.imul(h, 16777619);
	}
	const next = () => {
		h ^= h << 13; h ^= h >>> 17; h ^= h << 5;
		return (h >>> 0) / 4294967296;
	};
	// Pairs of bar/gap widths, 1-3px each — the mix of widths is what reads as a barcode
	// rather than as a comb.
	return Array.from({ length: 46 }, () =>
		`${1 + Math.floor(next() * 3)}${1 + Math.floor(next() * 2)}`).join(' ');
};

// Emails come straight from the intake form now — they are the institute addresses the
// crew gave for exactly this, so there is nothing left to derive.
//
// Phone numbers are NOT here. The form collected them, but a personal mobile on a public
// page is a number that gets scraped, and consenting to a form is not consenting to that.
// The institute address reaches everyone on this page.
// Faculty carry a name, a title and a portrait and nothing else, so the fields the form
// collected are filled in here rather than left undefined — the card hides them anyway,
// and a stray `undefined` in a data attribute is a bug waiting to be rendered.
const ROWS = GROUPS.map((g, di) => g.members.map((m, mi) => {
	const r = m as {
		roll?: string; batch?: string; email?: string; bio?: string;
		section?: string; subject?: string; meta?: string;
	};
	return {
		...m, di, mi, dept: g.name, no: pad(di + 1),
		faculty: (g as { faculty?: boolean }).faculty === true,
		roll: r.roll ?? '—', batch: r.batch ?? 'Faculty',
		email: r.email ?? '', bio: r.bio ?? '',
		// The rail's divider label. The subject folds into the section rather than
		// becoming a second heading under it — see .tm-sub.
		section: r.subject ? `${r.section} (${r.subject})` : r.section,
		// The rail's right-hand label. Under a heading that already names the thing, the
		// full role says it twice — "CHEMISTRY COORDINATOR" one line below CHEMISTRY — so
		// the heading takes the qualifier and the row keeps only the job. An explicit
		// `meta` wins, then the subject rule, then the role as written. The card always
		// shows the full title regardless.
		meta: r.meta ?? (r.subject ? 'Coordinator' : m.role),
		bars: barsOf(`${r.roll ?? m.name}-${m.name}`),
	};
}));

const first = ROWS[0][0];

// Also computed in the script for the rows the reader picks — same rule both sides: a
// title is not an initial.
const initialsOf = (name: string) =>
	name.replace(/^(Prof|Dr)\.?\s+/i, '').split(/\s+/).slice(0, 2)
		.map((w) => w[0] ?? '').join('').toUpperCase();
