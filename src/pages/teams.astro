	}

	/* ---- the geometry ----
	   Outlines only, and the same radial fade as the grid so nothing crowds the sentence.
	   A shade up from --hair: these are drawn ON the paper, not part of its ruling. */
	.tm-geo {
		position: absolute; inset: 0; z-index: 0;
		width: 100%; height: 100%; pointer-events: none;
		mask-image: radial-gradient(ellipse 66% 96% at 50% 50%, transparent 10%, #000 52%, transparent 98%);
	}
	.geo {
		fill: none;
		stroke: color-mix(in srgb, var(--secondary) 18%, transparent);
		stroke-width: 1.6;
	}
	.geo-accent {
		fill: color-mix(in srgb, var(--accent) 30%, transparent);
		stroke: color-mix(in srgb, var(--accent) 55%, transparent);
	}

	/* ---- the tails ----
	   stroke-dasharray '0 8' with a round cap is a dot every 8px: the zero-length dash
	   collapses to nothing and the cap draws it as a circle. */
	.tm-trail {
		position: absolute; inset: 0; z-index: 0;
		width: 100%; height: 100%;
		pointer-events: none; overflow: visible;
