---
import SiteLayout from '../layouts/SiteLayout.astro';

import iCheck from 'lucide-static/icons/check.svg?raw';
import iUsers from 'lucide-static/icons/users.svg?raw';
import iSchool from 'lucide-static/icons/school.svg?raw';
import iGlobe from 'lucide-static/icons/globe.svg?raw';
import iCamera from 'lucide-static/icons/camera.svg?raw';
import iMail from 'lucide-static/icons/mail.svg?raw';
import iArrowRight from 'lucide-static/icons/arrow-right.svg?raw';

const REACH = [
	{ value: '18,000+', label: 'Footfall across three days', icon: iUsers },
	{ value: '140+', label: 'Institutions represented', icon: iSchool },
	{ value: '260k', label: 'Combined social reach', icon: iGlobe },
	{ value: '32', label: 'Press & media accreditations', icon: iCamera },
];

// ponytail: `featured` drives the highlighted tier — no duplicated markup for the one
// card that looks different.
const TIERS = [
	{
		name: 'Community', amount: '₹25,000', slots: 'Open',
		perks: ['Logo on the website', 'Named in the fest booklet', 'Two exhibitor passes'],
	},
	{
		name: 'Silver', amount: '₹75,000', slots: '6 available',
		perks: ['Everything in Community', 'Logo on stage backdrops', 'Stall at the Expo concourse', 'Six passes with hall access'],
	},
	{
		name: 'Gold', amount: '₹2,00,000', slots: '3 available', featured: true,
		perks: ['Everything in Silver', 'Naming rights on one competition', 'Speaking slot in the opening session', 'Logo on all merch', 'Fifteen passes with hall access'],
	},
	{
		name: 'Title', amount: 'On request', slots: '1 available',
		perks: ['Everything in Gold', 'Fest presented-by billing', 'Naming rights on a full Expo hall', 'Dedicated recruitment desk', 'Year-round Outreach co-branding'],
	},
];
---

<SiteLayout title="Sponsorships · Anvesha '26">
	<div class="page">
		<header class="page-head" data-reveal>
			<p class="eyebrow">Partner with Anvesha '26</p>
			<h1 class="page-title">Sponsorships</h1>
			<p class="lede">
				Anvesha is run by students, funded by partners, and free to attend for everyone who
				walks in. Sponsorship pays for the halls, the equipment, and the outreach that
				carries on long after the fest ends.
			</p>
		</header>

		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">The reach</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta">2025 figures</span>
			</div>

			<div class="tiles reach">
				{REACH.map((r) => (
					<div class="tile">
						<span class="tile-icon" set:html={r.icon} />
						<div class="reach-value">{r.value}</div>
						<div class="tile-meta">{r.label}</div>
					</div>
				))}
			</div>
		</section>

		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Tiers</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta"><b>{TIERS.length}</b> levels</span>
			</div>

			<div class="tiles tiers">
				{TIERS.map((t) => (
					<article class:list={['tile', 'tier', t.featured && 'tier-featured']}>
						{t.featured && <i class="tile-num">MOST TAKEN</i>}
						<div class="tile-meta">{t.slots}</div>
						<div class="tier-name">{t.name}</div>
						<div class="tier-amount">{t.amount}</div>
						<ul class="tier-perks">
							{t.perks.map((perk) => (
								<li><span class="tier-check" set:html={iCheck} />{perk}</li>
							))}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section class="section" data-reveal>
			<div class="sechead">
				<span class="sechead-label">Talk to us</span>
				<span class="sechead-rule"></span>
				<span class="sechead-meta">Deck on request</span>
			</div>
			<p class="lede" style="margin-top:0">
				Tiers are a starting point, not a menu. If you want something built around a
				specific goal — recruitment, a product demo, a prize in your name — say so and we
				will put it together.
			</p>
			<a class="cta" href="mailto:sponsors@anvesha26.in" style="margin-top:22px">
				<span set:html={iMail} />
				<span>REQUEST THE DECK</span>
				<span set:html={iArrowRight} />
			</a>
		</section>
	</div>
</SiteLayout>

<style is:global>
	.reach { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
	.reach-value {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: clamp(26px, 3vw, 38px);
		line-height: 1; letter-spacing: -0.02em;
	}

	.tiers { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-items: start; }
	.tier { gap: 8px; }
	.tier-name {
		font-family: 'Archivo Expanded', 'Archivo', sans-serif;
		font-weight: 900; font-size: 20px; letter-spacing: .01em; text-transform: uppercase;
	}
	.tier-amount {
		font-family: 'DM Mono', ui-monospace, monospace;
		font-size: 15px; color: var(--accent); margin-bottom: 6px;
	}
	.tier-perks {
		list-style: none; margin: 0; padding: 14px 0 0;
		border-top: 1.5px solid var(--hair);
		display: flex; flex-direction: column; gap: 9px;
	}
	.tier-perks li {
		display: grid; grid-template-columns: 15px 1fr; gap: 9px; align-items: start;
		font-size: 12.5px; line-height: 1.5; color: var(--ink-60);
	}
	.tier-check { display: block; line-height: 0; margin-top: 2px; color: var(--accent); }
	.tier-check svg { width: 14px; height: 14px; stroke-width: 2.4; }

	/* the featured tier inverts rather than growing — no layout shift, and it matches
	   the black-fill selection language used across the site */
	.tier-featured { background: var(--secondary); color: var(--primary); }
	.tier-featured .tile-meta,
	.tier-featured .tier-perks li { color: color-mix(in srgb, var(--primary) 72%, transparent); }
	.tier-featured .tier-perks { border-top-color: color-mix(in srgb, var(--primary) 26%, transparent); }
	.tier-featured .tile-num { background: var(--accent); color: var(--primary); }
</style>
