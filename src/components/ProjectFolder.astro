---
/**
 * The project folder — the card a project opens into on /projects, and the live
 * preview on /admin/expo. Empty here; scripts/folder.ts fills it.
 *
 * `preview` drops what only the real popup needs: the dialog role, the close button
 * and the title's id (the popup labels its dialog by it; a page has only one).
 */
import '../styles/project-folder.css';
import iCamera from 'lucide-static/icons/camera.svg?raw';
import iX from 'lucide-static/icons/x.svg?raw';

interface Props {
	preview?: boolean;
}
const { preview = false } = Astro.props;
const dialog = preview ? {} : { role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pmTitle' };
---

<div class="pm" {...dialog}>
	<span class="pm-tab mono"><span class="pm-tab-icon" data-f="icon"></span><span data-f="code"></span></span>
	{!preview && <button class="btn pm-x" id="pmClose" type="button" aria-label="Close" set:html={iX} />}

	<figure class="pm-media is-empty" data-f="media">
		<img data-f="img" alt="" />
		<span class="pm-media-empty" set:html={iCamera} />
	</figure>

	<div class="pm-body">
		<h2 class="pm-title" id={preview ? undefined : 'pmTitle'} data-f="title"></h2>
		<div class="pm-cols">
			<p class="pm-summary" data-f="summary"></p>
			<div class="pm-team">
				<p class="pm-label mono">Team</p>
				<ol class="pm-members" data-f="team"></ol>
			</div>
		</div>
	</div>

	<dl class="pm-fields">
		<div><dt>Subject</dt><dd data-f="subject"></dd></div>
		<div><dt>Exhibit</dt><dd data-f="exhibit"></dd></div>
		<div><dt>Members</dt><dd data-f="count"></dd></div>
	</dl>
</div>
